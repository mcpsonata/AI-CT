# Production Environment Variables Template
# Copy this to .env and fill in the values

# ============================================
# CRITICAL SECURITY SETTINGS (REQUIRED)
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECURE_RANDOM_KEY_HERE

# Azure Front Door domain (e.g., myapp.azurefd.net)
FRONTEND_DOMAIN=your-frontdoor-domain.azurefd.net

# ============================================
# APPLICATION ENVIRONMENT
# ============================================

# Set to 'production' for production deployment
FLASK_ENV=production

# URL scheme for generated URLs (should be https in production)
PREFERRED_URL_SCHEME=https

# Enable if behind Azure Front Door (should be true in production)
BEHIND_PROXY=true

# ============================================
# AZURE OPENAI CONFIGURATION
# ============================================

PROJECT_ENDPOINT=https://bit-aifoundry.cognitiveservices.azure.com
MODEL_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ============================================
# AZURE KEY VAULT CONFIGURATION
# ============================================

Key_Vault_Name=MCPKeyValut
Key_Vault_URI=https://MCPKeyValut.vault.azure.net
Cognitive_Service_Secret_Name=cognitiveserviceaccesstoken
Power_BI_Secret_Name=powerbiaccesstoken
Fabric_Secret_Name=fabricaccesstoken

# ============================================
# AZURE RESOURCE CONFIGURATION
# ============================================

Resource_Group_Name=BITRG
User_Assigned_Managed_Identity=BIT-UAMI
User_Assigned_Managed_Identity_Client_Id=2c0599ac-a195-4f6b-938c-966484fff2cd
User_Assigned_Managed_Identity_Object_Id=d1106a79-97b0-40fe-9964-fd4fe521dbd4
Location=West US
ACR_Name=AICTRegistry

# ============================================
# APPLICATION SETTINGS
# ============================================

Use_Local_Auth=1
Function_App_Secret_Name=FunctionAppKey
Skip_Create_Tokens=True

# Container port (internal)
PORT=80
HOST=0.0.0.0
