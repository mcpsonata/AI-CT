        def _discover_potential_relationships(tables_list: list) -> list:
            """Discover potential missing relationships using simple rule-based analysis"""
            potential_rels = []
            
            try:
                # Simple discovery based on common naming patterns
                for from_table in tables_list:
                    if 'fact' in from_table.lower():
                        # Look for dimension tables that might connect to this fact table
                        for to_table in tables_list:
                            if 'dim' in to_table.lower():
                                # Simple key matching (ProductKey, CustomerKey, etc.)
                                potential_rels.append({
                                    "from_table": from_table,
                                    "from_column": "Key",  # Placeholder
                                    "to_table": to_table,
                                    "to_column": "Key",    # Placeholder
                                    "suggested_cardinality": "Many-to-One",
                                    "suggested_cross_filter": "Single",
                                    "suggested_active": True,
                                    "confidence_score": 0.5
                                })
                
                # Return only first few for AI analysis (avoid overwhelming)
                return potential_rels[:10]
                
            except Exception as e:
                logger.warning(f"Failed to discover potential relationships: {e}")
                return []

        def _get_column_data_type(table_name: str, column_name: str) -> str:   
            """Get the data type of a specific column from the Power BI dataset"""
            try:
                # Get table schema/columns information using existing method
                table_columns = self.tabular_editor.list_table_columns(table_name, include_data_type=True)
                
                # Find the matching column and return its data type
                for column in table_columns:
                    if column.get("column_name", "").lower() == column_name.lower():
                        # Map Power BI data types to readable format
                        data_type = column.get("data_type", "Unknown")
                        return _map_powerbi_datatype(data_type)
                
                # If column not found, try alternative approach with DAX
                logger.warning(f"Column {column_name} not found in table {table_name} schema, attempting DAX approach")
                return _get_column_datatype_via_dax(table_name, column_name)
                
            except Exception as e:
                logger.warning(f"Could not get data type for {table_name}.{column_name}: {e}")
                return "Unknown"

        def _map_powerbi_datatype(powerbi_type: str) -> str:
            """Map Power BI internal data types to readable format"""
            type_mapping = {
                "System.Int64": "Integer",
                "System.Double": "Decimal", 
                "System.String": "Text",
                "System.DateTime": "Date/Time",
                "System.Boolean": "True/False",
                "System.Decimal": "Decimal Number",
                "System.Currency": "Currency",
                "System.Binary": "Binary",
                "Whole Number": "Integer",
                "Decimal Number": "Decimal",
                "Fixed Decimal Number": "Decimal",
                "Date/Time": "Date/Time",
                "Date": "Date",
                "Time": "Time",
                "Text": "Text",
                "True/False": "Boolean",
                "Currency": "Currency",
                "Binary": "Binary"
            }
            return type_mapping.get(powerbi_type, powerbi_type)

        def _get_column_datatype_via_dax(table_name: str, column_name: str) -> str:
            """Alternative method to get column data type using DAX query"""
            try:
                # Escape table name if it contains spaces
                escaped_table = f"'{table_name}'" if ' ' in table_name else table_name
                
                # Use DAX to determine data type by examining the column values
                dax_query = f"""
                EVALUATE
                SUMMARIZECOLUMNS(
                    "DataType_Check", "Type_Analysis",
                    "Sample_Value", SELECTCOLUMNS(TOPN(1, {escaped_table}), "SampleValue", {escaped_table}[{column_name}])
                )
                """
                
                result = self.tabular_editor.execute_dax_query(dax_query)
                if result and len(result) > 0:
                    sample_value = result[0].get('[Sample_Value]', None)
                    if sample_value is not None:
                        # Infer type from sample value
                        if isinstance(sample_value, int):
                            return "Integer"
                        elif isinstance(sample_value, float):
                            return "Decimal"
                        elif isinstance(sample_value, str):
                            return "Text"
                        elif str(type(sample_value)).find('datetime') != -1:
                            return "Date/Time"
                        elif isinstance(sample_value, bool):
                            return "Boolean"
                        else:
                            return "Mixed"
                
                return "Unknown"
                
            except Exception as e:
                logger.warning(f"DAX data type detection failed for {table_name}.{column_name}: {e}")
                return "Unknown"

        # ================================================================================================
        # MAIN AI-POWERED RELATIONSHIP ANALYSIS - 8 PHASE PROCESS
        # ================================================================================================
        # Phase 1: Initial Setup & Validation
        # Phase 2: Smart Table & Relationship Discovery  
        # Phase 3: Data Collection & Preparation
        # Phase 4: AI Batch Processing
        # Phase 5: Scoring & Categorization
        # Phase 6: CSV Generation & Storage
        # Phase 7: Statistical Analysis
        # Phase 8: Results Assembly
        # ================================================================================================

        if not self.tabular_editor.connected:
            raise Exception("Tabular server is not connected. Please connect to a dataset first.")

        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"relationships_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing AI services")
            
            # Check TabularEditor connection to Power BI dataset
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Not connected to any dataset. Please connect first."}

            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "Failed to initialize AI client. Please check authentication."}

            # Extract workspace and dataset information for context and file naming
            try:
                actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
            except:
                actual_dataset_id = 'Unknown'
                actual_workspace_id = 'Unknown'
            
            # Create workspace information structure for context and CSV generation
            workspace_info = {
                "WorkspaceID": actual_workspace_id,
                "WorkspaceName": getattr(self.tabular_editor, 'current_workspace', 'Unknown'),
                "DatasetID": actual_dataset_id,
                "DatasetName": getattr(self.tabular_editor, 'current_database', 'Unknown')
            }

            # Check for user cancellation at the start
            if self._check_cancellation("Table linking evaluation"):
                return {"error": "Analysis stopped by user", "cancelled": True}
            
            # Initialize containers for analysis results and get all available tables
            analysis_results = []
            all_tables = self.tabular_editor.model.Tables
            
            # ================================================================================================
            # PHASE 2: SMART TABLE & RELATIONSHIP DISCOVERY
            # ================================================================================================
            # Apply intelligent table selection and relationship discovery
            
            if tables_to_analyze:
                # User-specified table selection
                available_tables = [t.Name for t in all_tables]
                invalid_tables = [t for t in tables_to_analyze if t not in available_tables]
                if invalid_tables:
                    raise Exception(f"Tables not found: {invalid_tables}")
                tables = tables_to_analyze
                logger.info(f"🎯 Analyzing specific tables: {tables}")
            else:
                # Default: analyze all available tables
                tables = [t.Name for t in all_tables]
                logger.info(f"🔍 Analyzing all {len(tables)} tables")
                logger.info(f"📋 First 10 tables: {tables[:10]}")
           
            if not tables:
                raise Exception("No tables found to analyze")
           
            # Initialize debug tracking
            debug_info = {"function_started": True}

            # ================================================================================================
            # PHASE 3: DATA COLLECTION & PREPARATION
            # ================================================================================================
            # Gather relationship metadata and prepare data structures for AI analysis

            # Initialize analysis results
            recommendations = []
            existing_relationships_detailed = []
            
            logger.info(f"📊 Starting analysis of {len(tables)} tables for existing relationships...")

            # Step 1: Get existing relationships using TabularEditor
            logger.info("📊 PHASE 3: Collecting existing Power BI relationships...")
            try:
                debug_info["step1_started"] = True
                
                # Get current relationships
                current_relationships = self.tabular_editor.list_all_relationships()
                existing_rels = current_relationships.get("relationships", [])
                logger.info(f"� Found {len(existing_rels)} existing relationships")
                
                debug_info["relationships_found"] = len(existing_rels)
                debug_info["method_call_success"] = True
                
                # Process existing relationships for AI analysis
                all_relationships_data = []
                
                for rel in existing_rels:
                    # Get data types for from and to columns
                    from_column_data_type = _get_column_data_type(rel["from_table"], rel["from_column"])
                    to_column_data_type = _get_column_data_type(rel["to_table"], rel["to_column"])
                    # Prepare relationship data for AI analysis
                    relationship_data = {
                        "from_table": rel["from_table"],
                        "from_column": rel["from_column"],
                        "to_table": rel["to_table"],
                        "to_column": rel["to_column"],
                        "from_column_data_type": from_column_data_type,
                        "to_column_data_type": to_column_data_type,
                        "cardinality": rel.get("cardinality", "Unknown"),
                        "cross_filter_direction": rel.get("cross_filter_direction", "Single"),
                        "is_active": rel.get("is_active", True),
                        "relationship_type": "EXISTING"
                    }
                    
                    all_relationships_data.append(relationship_data)
                
                # Also discover potential missing relationships
                logger.info("� Discovering potential missing relationships...")
                try:
                    potential_relationships = _discover_potential_relationships(tables)
                except Exception as e:
                    logger.warning(f"Could not discover potential relationships: {e}")
                    potential_relationships = []
                
                for pot_rel in potential_relationships:
                    # Get data types for from and to columns for potential relationships
                    from_column_data_type = _get_column_data_type(pot_rel["from_table"], pot_rel["from_column"])
                    to_column_data_type = _get_column_data_type(pot_rel["to_table"], pot_rel["to_column"])
                    relationship_data = {
                        "from_table": pot_rel["from_table"],
                        "from_column": pot_rel["from_column"], 
                        "to_table": pot_rel["to_table"],
                        "to_column": pot_rel["to_column"],
                        "from_column_data_type": from_column_data_type,
                        "to_column_data_type": to_column_data_type,
                        "cardinality": pot_rel.get("suggested_cardinality", "Unknown"),
                        "cross_filter_direction": pot_rel.get("suggested_cross_filter", "Single"),
                        "is_active": pot_rel.get("suggested_active", True),
                        "relationship_type": "MISSING_POTENTIAL"
                    }
                    
                    all_relationships_data.append(relationship_data)
                
                debug_info["processed_count"] = len(all_relationships_data)
                logger.info(f"📊 Successfully processed {len(all_relationships_data)} total relationships for AI analysis")
                    
            except Exception as e:
                debug_info["method_call_success"] = False
                debug_info["error"] = str(e)
                logger.warning(f"Could not retrieve relationships: {e}")
                all_relationships_data = []

            # ================================================================================================
            # MEASURE ANALYSIS FOR INACTIVE RELATIONSHIP USAGE (RL-003 Enhancement)
            # ================================================================================================
            # Collect all measures and analyze their DAX expressions for USERELATIONSHIP usage
            
            logger.info("📊 PHASE 3.5: Analyzing measures for inactive relationship usage...")
            
            def get_all_measures_from_model():
                """Get all measures from all tables in the model with their DAX expressions"""
                all_measures = []
                try:
                    for table in self.tabular_editor.model.Tables:
                        if hasattr(table, 'Measures'):
                            for measure in table.Measures:
                                measure_info = {
                                    "table_name": table.Name,
                                    "measure_name": measure.Name,
                                    "dax_expression": getattr(measure, 'Expression', ''),
                                    "description": getattr(measure, 'Description', ''),
                                    "is_hidden": getattr(measure, 'IsHidden', False)
                                }
                                all_measures.append(measure_info)
                    logger.info(f"📊 Found {len(all_measures)} measures across all tables")
                    return all_measures
                except Exception as e:
                    logger.warning(f"Failed to retrieve measures: {e}")
                    return []

            def parse_userelationship_usage(dax_expression: str, relationships_list: list) -> list:
                """Parse DAX expression to find USERELATIONSHIP usage with specific relationships"""
                import re
                
                if not dax_expression:
                    return []
                
                used_relationships = []
                
                # Pattern to match USERELATIONSHIP function calls
                # USERELATIONSHIP ( TableName[ColumnName], TableName[ColumnName] )
                userel_pattern = r'USERELATIONSHIP\s*\(\s*([^,\[\]]+)\[([^\]]+)\]\s*,\s*([^,\[\]]+)\[([^\]]+)\]\s*\)'
                
                matches = re.findall(userel_pattern, dax_expression, re.IGNORECASE)
                
                for match in matches:
                    from_table = match[0].strip().strip("'\"")
                    from_column = match[1].strip()
                    to_table = match[2].strip().strip("'\"")
                    to_column = match[3].strip()
                    
                    # Check if this matches any of our relationships
                    for rel in relationships_list:
                        rel_from_table = rel.get("from_table", "").strip()
                        rel_from_column = rel.get("from_column", "").strip()
                        rel_to_table = rel.get("to_table", "").strip()
                        rel_to_column = rel.get("to_column", "").strip()
                        
                        # Check both directions of the relationship
                        if ((from_table.lower() == rel_from_table.lower() and from_column.lower() == rel_from_column.lower() and
                             to_table.lower() == rel_to_table.lower() and to_column.lower() == rel_to_column.lower()) or
                            (from_table.lower() == rel_to_table.lower() and from_column.lower() == rel_to_column.lower() and
                             to_table.lower() == rel_from_table.lower() and to_column.lower() == rel_from_column.lower())):
                            
                            used_relationships.append({
                                "from_table": rel_from_table,
                                "from_column": rel_from_column,
                                "to_table": rel_to_table,
                                "to_column": rel_to_column,
                                "usage_context": f"USERELATIONSHIP({from_table}[{from_column}], {to_table}[{to_column}])"
                            })
                
                return used_relationships

            def analyze_relationship_usage_in_measures(relationships_list: list, measures_list: list) -> dict:
                """Analyze which relationships are used in measures via USERELATIONSHIP"""
                relationship_usage = {}
                
                for rel in relationships_list:
                    rel_key = f"{rel['from_table']}.{rel['from_column']} -> {rel['to_table']}.{rel['to_column']}"
                    relationship_usage[rel_key] = {
                        "relationship": rel,
                        "used_in_measures": [],
                        "usage_count": 0,
                        "is_used": False
                    }
                
                # Analyze each measure's DAX expression
                for measure in measures_list:
                    dax_expression = measure.get("dax_expression", "")
                    if dax_expression:
                        used_rels = parse_userelationship_usage(dax_expression, relationships_list)
                        
                        for used_rel in used_rels:
                            rel_key = f"{used_rel['from_table']}.{used_rel['from_column']} -> {used_rel['to_table']}.{used_rel['to_column']}"
                            
                            if rel_key in relationship_usage:
                                relationship_usage[rel_key]["used_in_measures"].append({
                                    "table_name": measure["table_name"],
                                    "measure_name": measure["measure_name"],
                                    "usage_context": used_rel["usage_context"],
                                    "dax_expression": dax_expression[:200] + "..." if len(dax_expression) > 200 else dax_expression
                                })
                                relationship_usage[rel_key]["usage_count"] += 1
                                relationship_usage[rel_key]["is_used"] = True
                
                return relationship_usage

            # Execute measure analysis
            all_measures = get_all_measures_from_model()
            relationship_usage_analysis = analyze_relationship_usage_in_measures(existing_rels, all_measures)
            
            # Log summary of measure analysis
            total_used_relationships = sum(1 for usage in relationship_usage_analysis.values() if usage["is_used"])
            total_measure_usages = sum(usage["usage_count"] for usage in relationship_usage_analysis.values())
            logger.info(f"📊 Measure Analysis Complete: {total_used_relationships} relationships used in {total_measure_usages} measure expressions")
            
            # Enhance relationship data with actual measure usage information
            for rel_data in all_relationships_data:
                rel_key = f"{rel_data['from_table']}.{rel_data['from_column']} -> {rel_data['to_table']}.{rel_data['to_column']}"
                
                if rel_key in relationship_usage_analysis:
                    usage_info = relationship_usage_analysis[rel_key]
                    rel_data["measure_usage"] = {
                        "is_used_in_measures": usage_info["is_used"],
                        "usage_count": usage_info["usage_count"],
                        "used_in_measures": usage_info["used_in_measures"]
                    }
                else:
                    rel_data["measure_usage"] = {
                        "is_used_in_measures": False,
                        "usage_count": 0,
                        "used_in_measures": []
                    }
            
            # ================================================================================================
            # ISOLATED TABLES DETECTION AND ADDITION
            # ================================================================================================
            # Fetch isolated tables (tables with no relationships) and add them to analysis
            # This ensures all tables are included in the relationship analysis, not just connected ones

            def get_isolated_tables_for_relationship_analysis():
                """Get isolated tables and format them for relationship analysis inclusion"""
                isolated_tables_data = []
                
                try:
                    # Get all tables in the model
                    all_tables = [t.Name for t in self.tabular_editor.model.Tables]
                    
                    # Get tables that are already in relationships
                    tables_with_relationships = set()
                    for rel in existing_rels:  # existing_rels from the current relationship fetching
                        tables_with_relationships.add(rel["from_table"])
                        tables_with_relationships.add(rel["to_table"])
                    
                    # Find isolated tables (tables not in any relationship)
                    isolated_tables = [table for table in all_tables if table not in tables_with_relationships]
                    
                    logger.info(f"📊 Found {len(isolated_tables)} isolated tables: {isolated_tables}")
                    
                    # Format isolated tables for relationship analysis
                    for isolated_table in isolated_tables:
                        # Add isolated table as both From_Table and To_Table to ensure it appears in analysis
                        isolated_entry = {
                            "from_table": isolated_table,
                            "from_column": "NO_RELATIONSHIPS",  # Special marker
                            "to_table": "ISOLATED",  # Special marker
                            "to_column": "NO_RELATIONSHIPS",  # Special marker
                            "from_column_data_type": "Not Applicable",
                            "to_column_data_type": "Not Applicable",
                            "cardinality": "ISOLATED",
                            "cross_filter_direction": "None",
                            "is_active": False,
                            "relationship_type": "ISOLATED_TABLE",
                            "measure_usage": {
                                "is_used_in_measures": False,
                                "usage_count": 0,
                                "used_in_measures": []
                            }
                        }
                        isolated_tables_data.append(isolated_entry)
                    
                    return isolated_tables_data, isolated_tables
                    
                except Exception as e:
                    logger.error(f"Failed to fetch isolated tables: {e}")
                    return [], []

            # Call the function to get isolated tables
            isolated_tables_data, isolated_table_names = get_isolated_tables_for_relationship_analysis()

            # Add isolated tables to the main relationship data for AI analysis
            if isolated_tables_data:
                logger.info(f"📊 Adding {len(isolated_tables_data)} isolated tables to relationship analysis")
                all_relationships_data.extend(isolated_tables_data)
                
                # Update the total count
                total_relationships = len(all_relationships_data)
                logger.info(f"📊 Total relationships for analysis (including isolated tables): {total_relationships}")
                
                # Store isolated table names for summary reporting
                workspace_info["isolated_tables"] = isolated_table_names
                workspace_info["isolated_tables_count"] = len(isolated_table_names)
            else:
                logger.info("📊 No isolated tables found - all tables have relationships")
                workspace_info["isolated_tables"] = []
                workspace_info["isolated_tables_count"] = 0        

            # ================================================================================================
            # PHASE 4: AI BATCH PROCESSING
            # ================================================================================================
            # Send relationship data to GPT-4o in optimized batches for intelligent analysis
            
            # Configure batch processing parameters
            batch_size = 8  # Smaller batches for relationship analysis (more complex data)
            total_relationships = len(all_relationships_data)
            
            logger.info(f"🤖 Starting AI analysis of {total_relationships} relationships in batches of {batch_size}")
            
            # Build dataset context for AI analysis
            dataset_context = {
                "workspace_name": workspace_info["WorkspaceName"],
                "dataset_name": workspace_info["DatasetName"],
                "total_tables": len(tables),
                "total_relationships": total_relationships,
                "analysis_type": "AI-Powered Relationship Quality Assessment"
            }
            
            # Calculate total number of AI processing batches
            total_batches = (total_relationships + batch_size - 1) // batch_size if total_relationships > 0 else 0
            
            # Start analysis tracking with comprehensive information
            ui_tracker.start_analysis(
                analysis_name="AI-Powered Relationship Quality Analysis",
                total_items=total_relationships,
                total_batches=total_batches
            )
            
            # Create batch progress tracker for detailed batch management
            batch_tracker = create_batch_tracker(ui_tracker, batch_size) if total_relationships > 0 else None
            
            # Process relationships through GPT-4o in manageable batches
            if total_relationships > 0:
                for i in range(0, total_relationships, batch_size):
                    batch_start = i
                    batch_end = min(i + batch_size, total_relationships)
                    batch_relationships = all_relationships_data[batch_start:batch_end]
                    current_batch = (batch_start // batch_size) + 1
                    
                    # Check for user cancellation before each AI batch
                    if self._check_cancellation(f"AI relationship analysis batch {current_batch}"):
                        ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                        break
                    
                    # Start batch processing with detailed tracking
                    batch_tracker.start_batch(current_batch, total_batches, batch_relationships)
                    ui_tracker.set_phase("AI Batch Processing", f"Processing batch {current_batch} of {total_batches}")
                    
                    # Log batch processing message for UI parsing (specific pattern required by UI regex)
                    logger.info(f"🤖 AI analyzing batch {current_batch} of {total_batches} ({len(batch_relationships)} relationships)")
                    
                    # Also update UI tracker for comprehensive tracking
                    ui_tracker.update_progress(
                        f"Processing relationships batch {current_batch} of {total_batches}",
                        current=current_batch,
                        total=total_batches
                    )
                    
                    # Send batch to GPT-4o for AI-powered analysis against relationship quality rules
                    ai_results = analyze_relationships_with_ai(ai_client, batch_relationships, dataset_context)
                    
                    # ================================================================================================
                    # PHASE 5: SCORING & CATEGORIZATION
                    # ================================================================================================
                    # Process AI responses and calculate severity levels based on scoring rules
                    
                    # Transform AI results into structured analysis entries
                    for ai_result in ai_results:
                        # Find the original relationship data to get data types
                        original_rel_data = None
                        for rel_data in batch_relationships:
                            if (rel_data["from_table"] == ai_result.get("from_table") and
                                rel_data["from_column"] == ai_result.get("from_column") and
                                rel_data["to_table"] == ai_result.get("to_table") and
                                rel_data["to_column"] == ai_result.get("to_column")):
                                original_rel_data = rel_data
                                break
                            
                        # Extract AI-calculated rule scores (NEW 4-RULE SYSTEM)
                        DataType_Score = float(ai_result.get("DataType_Score", 0.0))  # Data types matching (max 0.3)
                        Cardinality_Score = float(ai_result.get("Cardinality_Score", 0.0))  # Logical accuracy validation (max 0.35)
                        Active_Inactive_Score = float(ai_result.get("Active/Inactive_Score", 0.0))  # Inactive relationship usage (max 0.2)
                        CrossFilterDirectional_Score = float(ai_result.get("CrossFilterDirectional_Score", 0.0))  # Bi-directional evaluation (max 0.15)
                        
                        # Calculate composite scores for severity determination
                        calculated_total_score = DataType_Score + Cardinality_Score + Active_Inactive_Score + CrossFilterDirectional_Score
                        calculated_max_score = 0.3 + 0.35 + 0.2 + 0.15  # Sum of max possible scores (1.0)
                        
                        # Determine issue severity based on overall score percentage
                        score_percentage = (calculated_total_score / calculated_max_score) if calculated_max_score > 0 else 0
                        
                        # Apply severity thresholds with color coding for UI display (UPDATED THRESHOLDS)
                        if score_percentage <= 0.59:
                            issue_severity = "critical"     # ≤59% - Critical issues requiring immediate attention
                            severity_priority = 1
                            severity_color_code = "🔴 CRITICAL"
                            severity_hex_color = "#FF0000"
                        elif 0.60 <= score_percentage <= 0.74:
                            issue_severity = "issue"        # 60-74% - Significant improvements needed
                            severity_priority = 2
                            severity_color_code = "🟠 ISSUE"
                            severity_hex_color = "#FF8C00"
                        elif 0.75 <= score_percentage <= 0.84:
                            issue_severity = "warning"      # 75-84% - Minor optimizations recommended
                            severity_priority = 3
                            severity_color_code = "🟡 WARNING"
                            severity_hex_color = "#FFD700"
                        else:  # 85%+
                            issue_severity = "good"         # 85%+ - Excellent relationship design
                            severity_priority = 4
                            severity_color_code = "🟢 GOOD"
                            severity_hex_color = "#32CD32"
                        
                        # Calculate Score_Category using same logic as original method for backward compatibility
                        if calculated_total_score >= 0.8:
                            score_category = "Excellent"
                        elif calculated_total_score >= 0.6:
                            score_category = "Good" 
                        elif calculated_total_score >= 0.4:
                            score_category = "Fair"
                        else:
                            score_category = "Poor"
                        
                        # Build comprehensive result entry with NEW 4-RULE SYSTEM fields
                        result_entry = {
                            "From_Table": ai_result.get("from_table", "Unknown"),
                            "From_Column": ai_result.get("from_column", "Unknown"),
                            "From_Column_DataType": original_rel_data.get("from_column_data_type", "Unknown") if original_rel_data else "Unknown",
                            "To_Table": ai_result.get("to_table", "Unknown"),
                            "To_Column": ai_result.get("to_column", "Unknown"),
                            "To_Column_DataType": original_rel_data.get("to_column_data_type", "Unknown") if original_rel_data else "Unknown",
                            "Relationship_Type": ai_result.get("relationship_type", "Unknown"),
                            "Issue_Severity": issue_severity,
                            "Is_Active": ai_result.get("is_active_detailed", ai_result.get("is_active", "Unknown")),
                            "Cardinality": ai_result.get("cardinality", "Unknown"),
                            "Cross_Filter_Direction": ai_result.get("cross_filter_direction", "Unknown"),
                            "Data_Type_Compatibility": ai_result.get("data_type_compatibility_detailed", ai_result.get("data_type_compatibility", "Unknown")),
                            # Additional fields for backward compatibility and analysis
                            "Logical_Accuracy": ai_result.get("business_justification", "Unknown"),
                            "Inactive_Usage_Justification": self.extract_inactive_usage_from_detailed(ai_result.get("is_active_detailed", "")),
                            "Bidirectional_Purpose": self.extract_bidirectional_purpose_from_detailed(ai_result.get("cross_filter_direction", "")),
                            # NEW 4-RULE SCORING SYSTEM
                            "DataType_Score": DataType_Score,
                            "DataType_Max_Score": 0.3,
                            "Cardinality_Score": Cardinality_Score,
                            "Cardinality_Max_Score": 0.35,
                            "Active/Inactive_Score": Active_Inactive_Score,
                            "Active/Inactive_Max_Score": 0.2,
                            "CrossFilterDirectional_Score": CrossFilterDirectional_Score,
                            "CrossFilterDirectional_Max_Score": 0.15,
                            "Overall_Score": calculated_total_score,
                            "Max_Score": calculated_max_score,
                            "Score_Percentage": round(score_percentage * 100, 1),
                            "Score_Rationale": ai_result.get("detailed_recommendation", "AI analysis incomplete"),
                            "Severity_Priority": severity_priority,
                            "Severity_Color": severity_color_code,
                            "Severity_Hex_Color": severity_hex_color,
                            "Severity_Visual": f"{severity_color_code}: {issue_severity}"
                        }
                        
                        # Add processed entry to final results collection
                        analysis_results.append(result_entry)
                        existing_relationships_detailed.append(result_entry)
                        
                        # Debug: Log cardinality info for first few entries
                        if len(analysis_results) <= 3:
                            logger.info(f"🔍 DEBUG Entry {len(analysis_results)}: Cardinality = '{result_entry.get('Cardinality', 'MISSING_KEY')}', AI cardinality = '{ai_result.get('cardinality', 'MISSING_AI_KEY')}'")
                    
                    # Complete batch processing with comprehensive statistics using UI tracker
                    batch_tracker.complete_batch(
                        batch_number=current_batch,
                        total_batches=total_batches,
                        processing_results=ai_results
                    )
                
                # Log processing completion for UI parsing (specific pattern required by UI regex)
                logger.info(f"🤖 Processed AI analysis of {total_batches} batches ({total_relationships} relationships)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Completed relationship analysis - {total_relationships} relationships processed",
                    current=total_batches,
                    total=total_batches
                )
            
            else:
                logger.info("📊 No relationships detected in dataset - generating recommendations for potential relationships")
                
                # Generate suggested relationships when no existing ones are found
                all_relationships_data = self._generate_suggested_relationships(tables)
                total_relationships = len(all_relationships_data)
                logger.info(f"📊 Generated {total_relationships} suggested relationships for analysis")
            # Generate recommendations for existing relationships
            for existing in existing_relationships_detailed:
                recommendations.append({
                    "priority": "OPTIMIZE",
                    "category": "AI-Enhanced Relationship Quality",
                    "from_table": existing["From_Table"],
                    "to_table": existing["To_Table"],
                    "relationship_type": "Power BI Relationship",
                    "description": f"AI-analyzed relationship '{existing['From_Table']}.{existing['From_Column']}' → '{existing['To_Table']}.{existing['To_Column']}'",
                    "action": f"Review AI recommendations: {existing['Score_Rationale'][:100]}...",
                    "quality_score": existing["Overall_Score"]
                })

            # ================================================================================================
            # PHASE 6: CSV GENERATION & STATISTICAL ANALYSIS
            # ================================================================================================
            # Create comprehensive CSV output with statistical analysis and insights
            
            logger.info("� PHASE 6: Generating comprehensive CSV output with statistical analysis...")
            ui_tracker.set_phase("CSV Generation", "Creating comprehensive relationship analysis report")
            
            # Initialize statistical tracking variables
            stats = {
                "total_relationships": len(analysis_results),
                "severity_counts": {"critical": 0, "issue": 0, "warning": 0, "good": 0},
                "relationship_type_counts": {},
                "cardinality_distribution": {},
                "business_pattern_counts": {},
                "avg_scores": {"column_compatibility": 0.0, "cardinality": 0.0, "naming": 0.0, "cross_filter": 0.0, "performance": 0.0, "overall": 0.0}
            }
            
            # Calculate detailed statistics for analysis report
            if analysis_results:
                # Count relationships by severity level
                for result in analysis_results:
                    severity = result.get("Issue_Severity", "unknown")
                    stats["severity_counts"][severity] = stats["severity_counts"].get(severity, 0) + 1
                    
                    # Track relationship type distribution
                    rel_type = result.get("Relationship_Type", "Unknown")
                    stats["relationship_type_counts"][rel_type] = stats["relationship_type_counts"].get(rel_type, 0) + 1
                    
                    # Track cardinality distribution
                    cardinality = result.get("Cardinality", "Unknown")
                    stats["cardinality_distribution"][cardinality] = stats["cardinality_distribution"].get(cardinality, 0) + 1
                    
                    # Track business pattern distribution
                    pattern = result.get("Business_Pattern", "generic")
                    stats["business_pattern_counts"][pattern] = stats["business_pattern_counts"].get(pattern, 0) + 1
                
                # Calculate average scores for insight generation
                total_column_compatibility = sum(result.get("Column_Compatibility_Score", 0) for result in analysis_results)
                total_cardinality = sum(result.get("Cardinality_Score", 0) for result in analysis_results)
                total_naming = sum(result.get("Naming_Score", 0) for result in analysis_results)
                total_cross_filter = sum(result.get("Cross_Filter_Score", 0) for result in analysis_results)
                total_performance = sum(result.get("Performance_Score", 0) for result in analysis_results)
                total_overall = sum(result.get("Overall_Score", 0) for result in analysis_results)
                result_count = len(analysis_results)
                
                stats["avg_scores"]["column_compatibility"] = total_column_compatibility / result_count
                stats["avg_scores"]["cardinality"] = total_cardinality / result_count
                stats["avg_scores"]["naming"] = total_naming / result_count
                stats["avg_scores"]["cross_filter"] = total_cross_filter / result_count
                stats["avg_scores"]["performance"] = total_performance / result_count
                stats["avg_scores"]["overall"] = total_overall / result_count
                
                # Initialize CSV variables (ensure they're available for final results)
            csv_filename = None
            csv_filepath = None
            csv_content = None
           
            # Create CSV output with comprehensive analysis data
            if analysis_results:
                try:
                    # Generate timestamp for unique file naming
                    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                    workspace_name = self._sanitize_filename(workspace_info.get("WorkspaceName", "Unknown"))
                    dataset_name = self._sanitize_filename(workspace_info.get("DatasetName", "Unknown"))
                    csv_filename = f"AI_Relationship_Analysis_{workspace_name}_{dataset_name}_{timestamp}.csv"
                    csv_filepath = os.path.join(KB_FOLDER, csv_filename)
                    
                    # Define CSV columns to match new 4-rule scoring system
                    # CSV columns in your exact requested order (excluding UI-only fields)
                    csv_columns = [
                        'From_Table', 'From_Column', 'From_Column_DataType', 
                        'To_Table', 'To_Column', 'To_Column_DataType', 
                        'Issue_Severity', 'Is_Active', 'Cardinality', 'Cross_Filter_Direction', 
                        'Data_Type_Compatibility',  
                        'DataType_Score', 'DataType_Max_Score',
                        'Cardinality_Score', 'Cardinality_Max_Score', 
                        'Active/Inactive_Score', 'Active/Inactive_Max_Score', 
                        'CrossFilterDirectional_Score', 'CrossFilterDirectional_Max_Score',
                        'Overall_Score', 'Max_Score', 'Score_Rationale'
                    ]
                    # Note: Relationship_Type, Score_Percentage, Severity_Priority, Severity_Color, 
                    # Severity_Hex_Color, Severity_Visual are kept in result_entry for UI functionality 
                    # but excluded from CSV as requested
                    
                    # Create DataFrame with comprehensive analysis results using more robust approach
                    # First, ensure all entries have all required keys (fill missing keys with default values)
                    for result in analysis_results:
                        for col in csv_columns:
                            if col not in result:
                                result[col] = "Unknown"  # Default value for missing columns
                    
                    # Create DataFrame with all specified columns
                    relationship_df = pd.DataFrame(analysis_results)
                    
                    # Reorder columns to match the desired CSV structure
                    relationship_df = relationship_df.reindex(columns=csv_columns, fill_value="Unknown")
                    
                    # Debug: Log column information to verify all columns are included
                    logger.info(f"📊 Expected CSV Columns ({len(csv_columns)}): {csv_columns}")
                    logger.info(f"📊 Actual DataFrame Columns ({len(relationship_df.columns)}): {list(relationship_df.columns)}")
                    
                    # Verify critical columns
                    missing_cols = [col for col in csv_columns if col not in relationship_df.columns]
                    if missing_cols:
                        logger.error(f"❌ Missing columns: {missing_cols}")
                    else:
                        logger.info(f"✅ All expected columns confirmed in DataFrame")
                        
                    # Check Cardinality column specifically
                    if 'Cardinality' in relationship_df.columns:
                        logger.info(f"✅ Cardinality column confirmed - sample values: {relationship_df['Cardinality'].head().tolist()}")
                    else:
                        logger.error(f"❌ Cardinality column MISSING from DataFrame")
                    
                    # Sort by Issue_Severity priority for better readability
                    severity_order = {"critical": 1, "issue": 2, "warning": 3, "good": 4}
                    relationship_df['severity_sort'] = relationship_df['Issue_Severity'].map(severity_order)
                    relationship_df = relationship_df.sort_values(['severity_sort', 'Overall_Score']).drop('severity_sort', axis=1)
                    
                    # Ensure KnowledgeBase directory exists before saving CSV
                    os.makedirs(KB_FOLDER, exist_ok=True)
                    
                    # Create Excel file with color formatting for Issue_Severity column
                    excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(relationship_df, csv_filename, 'Issue_Severity')
                    
                    if excel_content and excel_filename and csv_text_content:
                        # Save Excel file to KnowledgeBase folder
                        excel_filepath = self._save_excel_file(excel_content, excel_filename)
                        logger.info(f"✅ Generated AI-powered relationship analysis Excel file: {excel_filepath}")
                        logger.info(f"📊 Saved {len(analysis_results)} relationship analysis results to {excel_filename}")
                        
                        # Update variables for later reference
                        csv_filepath = excel_filepath
                        csv_filename = excel_filename
                        csv_content = csv_text_content  # CSV text for UI parsing
                        excel_content_for_download = excel_content  # Excel binary for download
                    else:
                        logger.error("❌ Failed to generate Excel file")
                        csv_filepath = None
                        csv_filename = None
                        excel_content_for_download = None
                    
                    # Log statistical summary for UI parsing (matches dataset columns pattern)
                    logger.info(f"📊 RELATIONSHIP STATS: Critical: {stats['severity_counts']['critical']}, Issues: {stats['severity_counts']['issue']}, Warnings: {stats['severity_counts']['warning']}, Good: {stats['severity_counts']['good']}")
                    
                except Exception as excel_error:
                    logger.error(f"❌ Failed to generate Excel file: {excel_error}")
                    csv_filepath = None
                    csv_filename = None
            else:
                logger.info("📊 No relationship results to export to Excel")
                csv_filepath = None
                csv_filename = None

            # ================================================================================================
            # PHASE 7: STATISTICAL INSIGHTS & PATTERN ANALYSIS
            # ================================================================================================
            # Generate comprehensive insights based on statistical analysis of relationship patterns
            
            logger.info("📊 PHASE 7: Generating statistical insights and pattern analysis...")
            ui_tracker.set_phase("Statistical Analysis", "Analyzing patterns and generating insights")
            
            # Generate insights based on statistical analysis
            insights = []
            
            if analysis_results:
                # Severity distribution insights
                critical_count = stats["severity_counts"]["critical"]
                issue_count = stats["severity_counts"]["issue"]
                warning_count = stats["severity_counts"]["warning"]
                good_count = stats["severity_counts"]["good"]
                total_count = stats["total_relationships"]
                
                # Overall health assessment
                critical_percentage = (critical_count / total_count * 100) if total_count > 0 else 0
                issue_percentage = (issue_count / total_count * 100) if total_count > 0 else 0
                
                if critical_percentage > 30:
                    insights.append(f"⚠️ Critical: {critical_percentage:.1f}% of relationships have critical quality issues requiring immediate attention")
                elif issue_percentage > 40:
                    insights.append(f"⚠️ Attention needed: {issue_percentage:.1f}% of relationships have significant issues that should be addressed")
                elif good_count / total_count > 0.7:
                    insights.append(f"✅ Excellent: {(good_count / total_count * 100):.1f}% of relationships demonstrate high-quality design patterns")
                
                # Business pattern analysis insights
                if stats["business_pattern_counts"]:
                    most_common_pattern = max(stats["business_pattern_counts"], key=stats["business_pattern_counts"].get)
                    pattern_count = stats["business_pattern_counts"][most_common_pattern]
                    insights.append(f"📈 Most common business pattern: {most_common_pattern} ({pattern_count} relationships)")
                
                # Cardinality distribution insights
                if stats["cardinality_distribution"]:
                    optimal_cardinalities = ["One-to-Many", "Many-to-One"]
                    optimal_count = sum(stats["cardinality_distribution"].get(card, 0) for card in optimal_cardinalities)
                    if optimal_count > 0:
                        insights.append(f"📊 {optimal_count} relationships use optimal cardinality patterns")
                
                # Score-based insights
                avg_overall = stats["avg_scores"]["overall"]
                if avg_overall < 0.6:
                    insights.append(f"⚠️ Dataset average quality score is {avg_overall:.2f} - significant improvements recommended")
                elif avg_overall > 0.8:
                    insights.append(f"✅ Dataset demonstrates strong relationship quality with average score of {avg_overall:.2f}")
                
                # Relationship type distribution insights
                if stats["relationship_type_counts"]:
                    existing_count = sum(count for rel_type, count in stats["relationship_type_counts"].items() if rel_type.startswith("EXISTING"))
                    missing_count = sum(count for rel_type, count in stats["relationship_type_counts"].items() if rel_type.startswith("MISSING"))
                    if missing_count > 0:
                        insights.append(f"🔍 {missing_count} potential missing relationships identified for consideration")
                    if existing_count > 0:
                        insights.append(f"📊 {existing_count} existing relationships analyzed for optimization opportunities")

            # ================================================================================================
            # PHASE 8: FINAL RESULTS ASSEMBLY
            # ================================================================================================
            # Assemble comprehensive results with all analysis components
            
            logger.info("📊 PHASE 8: Assembling final comprehensive results...")
            ui_tracker.set_phase("Results Assembly", "Finalizing comprehensive analysis results")
            
            # Complete the analysis using UI tracker
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=f"Successfully analyzed {len(analysis_results)} relationships",
                results_data={
                    "total_relationships": len(analysis_results),
                    "csv_filename": csv_filename if analysis_results else None,
                    "existing_relationships": len([r for r in analysis_results if r.get("Relationship_Type") == "Existing"]),
                    "potential_relationships": len([r for r in analysis_results if r.get("Relationship_Type") == "Potential"])
                }
            )
            
            # Build comprehensive final results
            final_results = {
                "status": "success",
                "method": "AI-Powered Relationship Analysis",
                "analysis_type": "relationship_analysis",
                "workspace_info": workspace_info,
                "timestamp": datetime.now().isoformat(),
                "processing_summary": {
                    "total_tables_analyzed": len(tables),
                    "total_relationships_found": len(analysis_results),
                    "ai_batches_processed": total_batches,
                    "processing_method": "GPT-4o AI Analysis with Statistical Insights"
                },
                "results": analysis_results,
                "existing_relationships": existing_relationships_detailed,
                "recommendations": recommendations,
                "statistical_analysis": stats,
                "insights": insights,
                "debug_info": debug_info,
                "analysis_statistics": analysis_stats
            }
            
            # Add CSV content to result (following standard pattern used by other functions)
            if csv_filename and csv_content:
                final_results["csv_filename"] = csv_filename
                final_results["csv_file_path"] = csv_filepath
                final_results["csv_content"] = csv_content  # CSV text for UI parsing
                if 'excel_content_for_download' in locals() and excel_content_for_download:
                    final_results["excel_content"] = excel_content_for_download  # Excel binary for download
                final_results["csv_generation_status"] = "SUCCESS"
            else:
                final_results["csv_generation_error"] = "Failed to generate Excel file - check logs for details"
                final_results["csv_generation_status"] = "FAILED"
            
            # ================================================================================================
            # GENERATE HIGH-LEVEL SUMMARY FOR FRONTEND DASHBOARD
            # ================================================================================================
            # Create analysis_summary structure that matches what _generate_relationship_summary expects
            
            analysis_summary_for_summary = {
                "workspace": workspace_info["WorkspaceName"],
                "dataset": workspace_info["DatasetName"],
                "tables_analyzed": len(tables),
                "total_relationships_analyzed": len(analysis_results),
                "existing_relationships": len([r for r in analysis_results if r["Relationship_Type"].startswith("EXISTING")]),
                "missing_relationships": len([r for r in analysis_results if r["Relationship_Type"].startswith("MISSING")]),
                "analysis_timestamp": datetime.now().isoformat(),
                "csv_rows_generated": len(analysis_results)
            }
            
            # Map analysis_results to relationship format for summary generation
            relationships_for_summary = []
            for result in analysis_results:
                relationship_entry = {
                    "from_table": result.get("From_Table", "Unknown"),
                    "from_column": result.get("From_Column", "Unknown"),
                    "to_table": result.get("To_Table", "Unknown"),
                    "to_column": result.get("To_Column", "Unknown"),
                    "relationship_type": result.get("Relationship_Type", "Unknown"),
                    "score_category": result.get("Score_Category", "Unknown"),
                    "score_rationale": result.get("Score_Rationale", ""),
                    "total_score": result.get("Overall_Score", 0.0),
                    "cardinality": result.get("Cardinality", "Unknown")
                }
                relationships_for_summary.append(relationship_entry)
            
            # Build relationship types for summary
            relationship_types_for_summary = list(set(result.get("Business_Pattern", "generic") for result in analysis_results))
            
            # Create detailed breakdown for summary
            detailed_breakdown_for_summary = {
                "total_relationships_analyzed": analysis_summary_for_summary["total_relationships_analyzed"],
                "existing_relationships": analysis_summary_for_summary["existing_relationships"],
                "missing_relationships": analysis_summary_for_summary["missing_relationships"]
            }
            
            # Update final_results structure to match what generate_analysis_summary expects
            final_results.update({
                "analysis_summary": analysis_summary_for_summary,
                "relationships_detailed": relationships_for_summary,
                "relationship_types_found": relationship_types_for_summary,
                "detailed_breakdown": detailed_breakdown_for_summary
            })
            
            # Generate high-level summary for dashboard display using the relationship_analysis method
            logger.info("📊 Generating high-level summary for dashboard display...")
            high_level_summary = self.tabular_editor.generate_analysis_summary("relationship_analysis", final_results)
            
            # Attach high-level summary to main result
            final_results["high_level_summary"] = high_level_summary
            
            # Extract and set issue counts at top level for frontend accessibility - DIRECTLY FROM ANALYSIS RESULTS
            # Count issues directly from analysis_results to match CSV output exactly
            critical_count = len([r for r in analysis_results if r.get("Issue_Severity") == "critical"])
            issue_count = len([r for r in analysis_results if r.get("Issue_Severity") == "issue"])
            warning_count = len([r for r in analysis_results if r.get("Issue_Severity") == "warning"])
            good_count = len([r for r in analysis_results if r.get("Issue_Severity") == "good"])
            total_issues = critical_count + issue_count + warning_count
            
            # Set issue counts at multiple levels for frontend compatibility
            final_results["critical_issues"] = critical_count
            final_results["issue_issues"] = issue_count
            final_results["warning_issues"] = warning_count
            final_results["good_issues"] = good_count
            final_results["total_issues"] = total_issues
            
            # Also ensure they're in the high_level_summary if it exists
            if high_level_summary:
                high_level_summary["critical_issues"] = critical_count
                high_level_summary["issue_issues"] = issue_count
                high_level_summary["warning_issues"] = warning_count
                high_level_summary["good_issues"] = good_count
                high_level_summary["total_issues"] = total_issues
                
                # NOTE: Don't override detailed_issues here - they're already properly generated in generate_analysis_summary
                # Let the enhanced detailed issues from _generate_relationship_summary stay intact
                # high_level_summary["detailed_issues"] is already set by generate_analysis_summary with proper details
            
            logger.info(f"📊 Issue counts generated (matching CSV): Critical: {critical_count}, Issues: {issue_count}, Warning: {warning_count}, Good: {good_count}, Total: {total_issues}")
            
            # Log final completion status
            total_time = time.time() - start_time
            logger.info(f"✅ AI-Powered Relationship Analysis completed successfully in {total_time:.2f} seconds")
            logger.info(f"📊 Final Results: {len(analysis_results)} relationships analyzed, {len(insights)} insights generated")
            
            return final_results
        
        except Exception as e:
            logger.error(f"Failed to evaluate table linking: {e}")
            return {
                "analysis_summary": {
                    "workspace": "Unknown",
                    "dataset": "Unknown", 
                    "total_relationships_analyzed": 0,
                    "existing_relationships": 0,
                    "missing_relationships": 0,
                    "analysis_timestamp": datetime.now().isoformat(),
                    "error": str(e)
                },
                "debug_info": {"error": str(e), "function_failed": True},
                "results": [],
                "existing_relationships": [],
                "recommendations": [],
                "relationship_types_found": [],
                "csv_filename": None,
                "csv_content": None,
                "csv_generation_status": "FAILED",
                "error_details": str(e)
            }
           
        except Exception as e:
            logger.error(f"Failed to evaluate SMART table linking: {e}")
            raise Exception(f"Failed to evaluate SMART table linking: {e}")
    
    def evaluate_table_hierarchies(self, tables_to_analyze: List[str] = None, progress_callback=None) -> Dict[str, Any]:
        """
        Enhanced AI-Powered hierarchy evaluation with existing fact/dimension analysis integration and direction analysis for EXISTING hierarchies only.
        
        Evaluates EXISTING hierarchies against ONLY these 2 specific rules with comprehensive AI enhancements:
        - HQ-001 (0.4pts): Table type alignment using existing fact/dimension analysis (Dimension gets 0.4, Fact gets 0.0)
        - HQ-002 (0.6pts): Business pattern quality using Microsoft standards with AI-determined direction analysis
        
        INTEGRATED FACT/DIMENSION ANALYSIS:
        - Uses the existing comprehensive evaluate_fact_dimension_analysis() method
        - Provides detailed AI-powered classification with confidence scores
        - Analyzes relationship patterns, measure density, and business context
        - Includes detailed reasoning for each classification decision
        - Supports all advanced table classification features already in the system
        
        AI HIERARCHY DIRECTION ANALYSIS:
        - Semantic Analysis: AI examines level names for semantic meaning and scope
        - Business Logic Assessment: Determines optimal flow direction (High-to-Low vs Low-to-High)
        - Pattern Recognition: Matches against common business hierarchy patterns
        - Direction Optimization: Provides recommendations for improving hierarchy direction
        - Confidence Scoring: Indicates confidence level in direction determination
        
        STRICT CONSTRAINTS:
        - Only analyzes EXISTING hierarchies (no suggested hierarchies)
        - Uses AI-powered table classification for accurate HQ-001 scoring
        - Only uses the two specified scoring rules
        - No additional scoring criteria are applied
        
        Args:
            tables_to_analyze: Optional list of specific tables to analyze. If None, analyzes all tables.
            progress_callback: Optional callback function for progress updates

        Returns:
            Dictionary containing AI-powered hierarchy analysis with enhanced table classification for existing hierarchies only
        """
        import re
        import pandas as pd
        import os
        import json
        import io
        import time
        from datetime import datetime
        
        # Initialize timing and constants
        start_time = time.time()
        # Get absolute path to KnowledgeBase folder 
        current_dir = os.path.dirname(os.path.abspath(__file__))  # src folder
        root_dir = os.path.dirname(current_dir)  # go up one level to root
        KB_FOLDER = os.path.join(root_dir, "KnowledgeBase")  # Define knowledge base folder constant
        
        # Ensure KnowledgeBase folder exists
        os.makedirs(KB_FOLDER, exist_ok=True)
        
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker
        
        def get_ai_client():
            """Get Azure OpenAI client from authentication manager"""
            try:
                auth_manager = AuthenticationManager.get_instance()
                return auth_manager.get_openai_client()
            except Exception as e:
                logger.error(f"Failed to get OpenAI client: {e}")
                return None
        
        def analyze_hierarchy_direction_with_ai(client, hierarchy_info: dict) -> dict:
            """
            AI-powered hierarchy direction analysis to determine if hierarchy flows High-to-Low or Low-to-High
            
            Args:
                client: OpenAI client for AI analysis
                hierarchy_info: Dictionary containing hierarchy metadata (name, levels, column_path)
                
            Returns:
                Dictionary containing direction analysis results
            """
            try:
                direction_prompt = f"""You are an expert Power BI hierarchy analyst specializing in hierarchy direction analysis. Analyze this hierarchy and determine if it flows HIGH-TO-LOW or LOW-TO-HIGH based on semantic analysis of level names and business logic.

HIERARCHY DIRECTION RULES:

HIGH-TO-LOW (Drill-Down Pattern - Most Common):
- Flows from broad/general to specific/detailed
- Examples: Country → State → City → Store
- Examples: Year → Quarter → Month → Day  
- Examples: Division → Department → Team → Employee
- Examples: Category → Subcategory → Brand → Product
- Examples: Region → Area → Territory → Account

LOW-TO-HIGH (Roll-Up Pattern - Less Common):
- Flows from specific/detailed to broad/general
- Examples: Product → Brand → Subcategory → Category
- Examples: Employee → Team → Department → Division
- Examples: Day → Month → Quarter → Year

ANALYSIS CRITERIA:
1. Semantic Analysis: Examine level names for semantic meaning and scope
2. Business Logic: Consider typical business reporting patterns
3. Granularity Assessment: Identify which levels are more granular vs aggregated
4. Pattern Recognition: Match against common business hierarchy patterns

HIERARCHY TO ANALYZE:
{json.dumps(hierarchy_info, indent=2)}

ANALYSIS INSTRUCTIONS:
1. Parse each level name and analyze its semantic meaning
2. Determine the relative scope/granularity of each level
3. Identify the business pattern (Geography, Time, Organization, Product, etc.)
4. Determine the logical flow direction based on business intuition
5. Provide confidence level for your assessment

Return this EXACT JSON structure:
{{
  "hierarchy_name": "hierarchy_name",
  "direction": "High to Low/Low to High/Mixed/Unknown",
  "confidence": "high/medium/low",
  "business_pattern_detected": "geography/time/organizational/product/customer/generic",
  "level_analysis": [
    {{"level_position": 1, "level_name": "name", "scope": "broad/medium/specific", "granularity": "high/medium/low"}},
    {{"level_position": 2, "level_name": "name", "scope": "broad/medium/specific", "granularity": "high/medium/low"}}
  ],
  "direction_reasoning": "detailed explanation of why this direction was determined",
  "business_intuition": "explanation of how this aligns with typical business reporting patterns",
  "recommended_direction": "High to Low/Low to High/Keep Current",
  "optimization_suggestions": "specific suggestions for improving hierarchy direction if needed"
}}"""

                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": "You are an expert Power BI hierarchy direction analyst. Analyze hierarchy level progression to determine optimal direction flow."},
                        {"role": "user", "content": direction_prompt}
                    ],
                    temperature=0.1,
                    response_format={"type": "json_object"},
                    max_tokens=1200
                )
                
                ai_response = json.loads(response.choices[0].message.content)
                return ai_response
                
            except Exception as e:
                logger.error(f"AI hierarchy direction analysis failed: {e}")
                return {
                    "hierarchy_name": hierarchy_info.get("hierarchy_name", "Unknown"),
                    "direction": "Unknown",
                    "confidence": "low",
                    "direction_reasoning": f"Analysis failed: {str(e)}"
                }
        
        def create_hierarchy_analysis_prompt() -> str:
            """Create system prompt for strict hierarchy quality assessment using only HQ-001 and HQ-002 rules"""
            return """You are an expert Power BI hierarchy analyst. Analyze EXISTING hierarchies using ONLY these two specific scoring rules. Do not add any additional criteria or considerations.

MANDATORY SCORING RULES (follow exactly, no additions):

HQ-001: Table Type Alignment (Maximum 0.4 points)
   - Award 0.4 points: Hierarchy is in a Dimension table (optimal placement)  
   - Award 0.0 points: Hierarchy is in a Fact table (not recommended)
   - This rule ONLY evaluates table placement - nothing else

HQ-002: Business Pattern Quality (Maximum 0.6 points)
   - Evaluate ONLY against Microsoft BI standard business patterns
   - Microsoft Standard Patterns:
     * Geography: 3-7 levels, High→Low (Country→Region→City)
     * Time: 3-5 levels, High→Low (Year→Quarter→Month) 
     * Organizational: 3-6 levels, High→Low (Division→Group→Team)
     * Product: 3-5 levels, High→Low (Category→Family→Product)
     * Industry: 2-4 levels, High→Low (Industry→Sub-Industry)
     * Customer: 2-4 levels, High→Low (Segment→Company)
   - Scoring Guidelines:
     * 0.6: Perfect Microsoft pattern + optimal levels + correct direction
     * 0.45: Microsoft pattern + either optimal levels OR correct direction
     * 0.3: Basic pattern recognition but suboptimal structure
     * 0.0-0.15: No clear pattern or problematic structure

STRICT CONSTRAINTS:
- ONLY use HQ-001 and HQ-002 scoring rules
- ONLY analyze EXISTING hierarchies (no suggestions)
- DO NOT add additional scoring factors
- DO NOT mix criteria between the two rules
- Each rule evaluates one specific aspect only

ISSUE SEVERITY (based on total_score/1.0 percentage):
- CRITICAL: <60% - Poor hierarchy design
- ISSUE: 60-74% - Significant improvements needed  
- WARNING: 75-84% - Minor optimizations recommended
- GOOD: 85%+ - Excellent hierarchy design

Return analysis using ONLY these two rules for EXISTING hierarchies only."""

        def analyze_hierarchies_with_ai(client, hierarchies_batch: list, dataset_context: dict) -> list:
            """Analyze a batch of hierarchies using GPT-4o"""
            try:
                user_prompt = f"""Analyze these EXISTING Power BI hierarchies using AI-powered table classification and ONLY these two specific scoring rules:

Dataset Context: {json.dumps(dataset_context, indent=2)}

Existing Hierarchies with AI Table Classification:
{json.dumps(hierarchies_batch, indent=2)}

ENHANCED SCORING WITH AI TABLE CLASSIFICATION:

HQ-001 Score (Table Type Alignment - Max 0.4 points):
- Use existing fact/dimension analysis results for accurate table classification
- Award 0.4 points if table is classified as "Dimension" 
- Award 0.0 points if table is classified as "Fact"
- Classification is provided in hierarchy data from comprehensive fact/dimension analysis
- This analysis uses advanced AI with relationship patterns, measure density, and business rules

HQ-002 Score (Business Pattern Quality - Max 0.6 points):
- Evaluate ONLY against Microsoft BI standard business patterns
- Consider pattern recognition, level optimality, and AI-determined hierarchy direction
- Microsoft Standard Patterns: Geography, Time, Organizational, Product, Industry, Customer
- Use AI direction analysis results for optimal direction assessment
- This rule ONLY evaluates business pattern quality, nothing else

CRITICAL CONSTRAINTS:
- ONLY analyze EXISTING hierarchies (no suggestions)
- USE AI table classification for HQ-001 scoring accuracy
- ONLY use the two scoring rules above
- DO NOT add additional scoring criteria
- DO NOT mix criteria between rules
- Each rule has ONE specific evaluation focus

For each existing hierarchy, return this EXACT JSON structure:
{{
  "hierarchy_name": "original_name",
  "table_name": "table_name", 
  "table_type": "use ai_table_classification from hierarchy data",
  "ai_classification_confidence": "high/medium/low",
  "level_count": 0,
  "column_path": "level1 > level2 > level3",
  "business_pattern": "geography/time/organizational/product/industry/customer/generic",
  "hierarchy_direction": "use ai_direction_analysis.direction from hierarchy data", 
  "direction_confidence": "use ai_direction_analysis.confidence from hierarchy data",
  "direction_reasoning": "use ai_direction_analysis.direction_reasoning from hierarchy data",
  "level_optimality": "optimal/suboptimal/poor",
  "overall_quality": "Excellent/Good/Fair/Poor",
  "hq_001_score": 0.0,
  "hq_002_score": 0.0,
  "total_score": 0.0,
  "issue_severity": "critical/issue/warning/good",
  "detailed_recommendation": "specific improvement suggestions based only on HQ-001 and HQ-002 including direction optimization",
  "ft_dt_analysis": "brief explanation of why table was classified as Fact/Dimension",
  "direction_optimization": "suggestions for improving hierarchy direction if needed"
}}

Return JSON with "results" array containing analysis for all existing hierarchies."""
                
                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": create_hierarchy_analysis_prompt()},
                        {"role": "user", "content": user_prompt}
                    ],
                    temperature=0.1,
                    response_format={"type": "json_object"},
                    max_tokens=4000
                )
                
                # Parse AI response
                ai_response = json.loads(response.choices[0].message.content)
                
                # Handle different response formats
                if "results" in ai_response:
                    return ai_response["results"]
                elif "hierarchies" in ai_response:
                    return ai_response["hierarchies"]
                elif isinstance(ai_response, list):
                    return ai_response
                else:
                    logger.warning(f"Unexpected AI response format: {list(ai_response.keys())}")
                    return []
                    
            except Exception as e:
                logger.error(f"AI hierarchy analysis failed: {e}")
                return []

        # ================================================================================================
        # MAIN AI-POWERED HIERARCHY ANALYSIS - 8 PHASE PROCESS
        # ================================================================================================
        # Phase 1: Initial Setup & Validation
        # Phase 2: Smart Table Filtering  
        # Phase 3: Hierarchy Discovery & Preparation
        # Phase 4: AI Batch Processing
        # Phase 5: Scoring & Categorization
        # Phase 6: CSV Generation & Storage
        # Phase 7: Statistical Analysis
        # Phase 8: Results Assembly
        # ================================================================================================

        if not self.tabular_editor.connected:
            raise Exception("Tabular server is not connected. Please connect to a dataset first.")
        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"hierarchies_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing AI services")
            
            # Check TabularEditor connection to Power BI dataset
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Not connected to any dataset. Please connect first."}

            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "Failed to initialize AI client. Please check authentication."}

            # Extract workspace and dataset information for context and file naming
            try:
                actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
            except:
                actual_dataset_id = 'Unknown'
                actual_workspace_id = 'Unknown'
            
            # Create workspace information structure for context and CSV generation
            workspace_info = {
                "WorkspaceID": actual_workspace_id,
                "WorkspaceName": getattr(self.tabular_editor, 'current_workspace', 'Unknown'),
                "DatasetID": actual_dataset_id,
                "DatasetName": getattr(self.tabular_editor, 'current_database', 'Unknown')
            }

            # Initialize containers for analysis results and get all available tables
            analysis_results = []
            all_tables = self.tabular_editor.model.Tables
            
            # ================================================================================================
            # PHASE 2: SMART TABLE FILTERING
            # ================================================================================================
            # Apply intelligent table selection based on user preferences
            
            if tables_to_analyze:
                # User-specified table selection
                available_tables = [t.Name for t in all_tables]
                invalid_tables = [t for t in tables_to_analyze if t not in available_tables]
                if invalid_tables:
                    raise Exception(f"Tables not found: {invalid_tables}")
                tables = tables_to_analyze
                logger.info(f"🎯 Analyzing specific tables: {tables}")
            else:
                # Default: analyze all available tables
                tables = [t.Name for t in all_tables]
                logger.info(f"🔍 Analyzing all {len(tables)} tables")
                logger.info(f"📋 First 10 tables: {tables[:10]}")

            # Check for user cancellation at the start
            if self._check_cancellation("Table hierarchies evaluation"):
                return {"error": "Analysis stopped by user", "cancelled": True}
            
            # Initialize debug tracking
            debug_info = {"function_started": True}

            # ================================================================================================
            # PHASE 2.5: FACT/DIMENSION ANALYSIS INTEGRATION
            # ================================================================================================
            # Get consistent table classifications from existing fact/dimension analysis
            
            ui_tracker.set_phase("Table Classification", "Getting table classifications for consistent analysis")
            logger.info("🔄 Getting table classifications to ensure consistency...")
            
            # Cache table classifications for use in hierarchy analysis
            table_classifications = {}
            
            try:
                # Call fact/dimension analysis for table classifications
                logger.info(f"� Running fact/dimension analysis for {len(tables)} tables...")
                fact_dim_analysis = self.evaluate_fact_dimension_analysis(tables_to_analyze, None)
                
                logger.info(f"📊 Fact/dimension analysis result: {type(fact_dim_analysis)} with keys: {list(fact_dim_analysis.keys()) if fact_dim_analysis else 'None'}")
                
                if fact_dim_analysis and "table_analysis" in fact_dim_analysis:
                    table_analysis_results = fact_dim_analysis["table_analysis"]
                    logger.info(f"📋 Processing {len(table_analysis_results)} table results...")
                    
                    for table_result in table_analysis_results:
                        table_name = table_result.get("table_name", "Unknown")
                        classification = table_result.get("classification", "DIMENSION")
                        confidence = table_result.get("confidence", 0.0)
                        reasoning = table_result.get("primary_reasoning", "")
                        
                        # Store classification for use in hierarchy analysis
                        table_classifications[table_name] = {
                            "table_type": classification.upper(),  # Ensure uppercase
                            "confidence": confidence,
                            "reasoning": reasoning
                        }
                        logger.info(f"📋 Cached: {table_name} → {classification} (confidence: {confidence:.2f})")
                
                    logger.info(f"✅ Successfully cached {len(table_classifications)} table classifications")
                else:
                    logger.warning("⚠️ No table_analysis found in fact/dimension results - using fallback")
                    table_classifications = {}
                
            except Exception as e:
                logger.warning(f"⚠️ Fact/dimension analysis failed: {e} - Using fallback classification")
                # Initialize empty cache for fallback behavior
                table_classifications = {}

            # ================================================================================================
            # PHASE 3: HIERARCHY DISCOVERY & PREPARATION
            # ================================================================================================
            # Gather hierarchy metadata and prepare data structures for AI analysis

            # Initialize analysis results
            recommendations = []
            existing_hierarchies_detailed = []
            
            logger.info(f"📊 Starting analysis of {len(tables)} tables for existing hierarchies...")
            logger.info(f"🔍 Table list: {tables[:5]}{'...' if len(tables) > 5 else ''}")  # Debug: Show first few tables
            
            # Debug: Check if we have any table classifications
            logger.info(f"📋 Table classifications available: {len(table_classifications)} entries")
            if table_classifications:
                sample_table = list(table_classifications.keys())[0]
                logger.info(f"📋 Sample classification: {sample_table} → {table_classifications[sample_table]}")

            # Step 1: Get detailed existing hierarchies using Tabular Editor object model
            # IMPORTANT: Only analyzing EXISTING hierarchies as per user requirements
            logger.info("📊 PHASE 3: Fetching detailed existing Power BI hierarchies...")
            try:
                debug_info["step1_started"] = True
                
                # Use Tabular Editor's native object model to find EXISTING hierarchies only
                existing_hierarchies = []
                logger.info(f"🔍 Searching for hierarchies in {len(tables)} tables...")
                
                for table_name in tables:
                    # Get the actual table object from the model using the table name
                    table_obj = next((t for t in all_tables if t.Name == table_name), None)
                    if table_obj:
                        if hasattr(table_obj, 'Hierarchies') and table_obj.Hierarchies:
                            hierarchy_count = len(table_obj.Hierarchies)
                            logger.info(f"📊 Table '{table_name}': Found {hierarchy_count} hierarchies")
                            for hierarchy in table_obj.Hierarchies:
                                 existing_hierarchies.append({
                                    'table_name': table_obj.Name,
                                    'hierarchy_name': hierarchy.Name,
                                    'hierarchy': hierarchy
                                })
                        else:
                            logger.debug(f"📊 Table '{table_name}': No hierarchies found")
                    else:
                        logger.warning(f"⚠️ Table object not found: {table_name}")
                
                hierarchies_result = existing_hierarchies
                logger.info(f"📊 Total hierarchies found: {len(hierarchies_result)}")
                
                if hierarchies_result and len(hierarchies_result) > 0:
                    logger.info(f"📊 Found {len(hierarchies_result)} existing hierarchies via object model")
                    debug_info["object_model_success"] = True
                    debug_info["hierarchy_result_count"] = len(hierarchies_result)
                    debug_info["method_call_success"] = True
                    
                    # Build hierarchy data for AI analysis using object model
                    all_hierarchies_data = []
                    
                    for hierarchy_info in hierarchies_result:
                        # Extract hierarchy information from object model
                        table_name = hierarchy_info['table_name']
                        hierarchy_name = hierarchy_info['hierarchy_name']
                        hierarchy = hierarchy_info['hierarchy']
                        
                        # Check for cancellation during hierarchy processing
                        if self._check_cancellation(f"Processing hierarchy: {hierarchy_name}"):
                            return {"error": "Analysis stopped by user", "cancelled": True}
                        
                        # Get level count and build column path from hierarchy levels
                        level_count = 0
                        column_names = []
                        
                        try:
                            if hasattr(hierarchy, 'Levels'):
                                level_count = len(hierarchy.Levels)
                                for level in hierarchy.Levels:
                                    if hasattr(level, 'Column') and hasattr(level.Column, 'Name'):
                                        column_names.append(level.Column.Name)
                                    elif hasattr(level, 'Name'):
                                        column_names.append(level.Name)
                        except Exception as level_error:
                            logger.debug(f"Could not process levels for hierarchy {hierarchy_name}: {level_error}")
                        
                        # Build column path
                        column_path = " > ".join(column_names) if column_names else "Column details unavailable"
                        
                        logger.info(f"🔍 Found hierarchy '{hierarchy_name}' in table '{table_name}' with {level_count} levels")
                        
                        # Perform AI-powered hierarchy direction analysis
                        logger.info(f"🧭 Analyzing hierarchy direction for '{hierarchy_name}'...")
                        hierarchy_direction_info = {
                            "hierarchy_name": hierarchy_name,
                            "table_name": table_name,
                            "level_count": level_count,
                            "column_path": column_path,
                            "column_names": column_names
                        }
                        
                        ai_direction_analysis = analyze_hierarchy_direction_with_ai(ai_client, hierarchy_direction_info)
                        
                        logger.info(f"🧭 AI determined hierarchy '{hierarchy_name}' direction: {ai_direction_analysis.get('direction', 'Unknown')} (confidence: {ai_direction_analysis.get('confidence', 'unknown')})")
                        
                        # Prepare hierarchy data for AI analysis with enhanced direction analysis
                        hierarchy_data = {
                            "hierarchy_name": hierarchy_name,
                            "table_name": table_name,
                            "level_count": level_count,
                            "column_path": column_path,
                            "table_id": f"table_{table_name}",
                            "hierarchy_id": f"hierarchy_{hierarchy_name}",
                            "ai_direction_analysis": ai_direction_analysis
                        }
                        
                        all_hierarchies_data.append(hierarchy_data)
                    
                    debug_info["processed_count"] = len(all_hierarchies_data)
                    logger.info(f"📊 Successfully processed {len(all_hierarchies_data)} existing hierarchies")
                else:
                    debug_info["no_hierarchies_reason"] = "No hierarchies found in model structure"
                    debug_info["method_call_success"] = False
                    logger.info("📊 No existing hierarchies found in model")
                    all_hierarchies_data = []
                    
            except Exception as e:
                debug_info["method_call_success"] = False
                debug_info["error"] = str(e)
                logger.warning(f"Could not retrieve existing hierarchies from model: {e}")
                all_hierarchies_data = []

            # ================================================================================================
            # PHASE 4: AI BATCH PROCESSING
            # ================================================================================================
            # Send hierarchy data to GPT-4o in optimized batches for intelligent analysis
            
            # Configure batch processing parameters
            batch_size = 10  # Smaller batches for hierarchy analysis
            total_hierarchies = len(all_hierarchies_data)
            
            logger.info(f"🤖 Starting AI analysis of {total_hierarchies} hierarchies in batches of {batch_size}")
            
            # Build dataset context for AI analysis
            dataset_context = {
                "workspace_name": workspace_info["WorkspaceName"],
                "dataset_name": workspace_info["DatasetName"],
                "total_tables": len(tables),
                "total_hierarchies": total_hierarchies,
                "analysis_type": "AI-Powered Hierarchy Quality Assessment"
            }
            
            # Calculate total number of AI processing batches
            total_batches = (total_hierarchies + batch_size - 1) // batch_size if total_hierarchies > 0 else 0
            
            # Start analysis tracking with comprehensive information
            ui_tracker.start_analysis(
                analysis_name="AI-Powered Hierarchy Quality Analysis",
                total_items=total_hierarchies,
                total_batches=total_batches
            )
            
            # Create batch progress tracker for detailed batch management
            batch_tracker = create_batch_tracker(ui_tracker, batch_size) if total_hierarchies > 0 else None
            
            # Process hierarchies through GPT-4o in manageable batches
            if total_hierarchies > 0:
                for i in range(0, total_hierarchies, batch_size):
                    batch_start = i
                    batch_end = min(i + batch_size, total_hierarchies)
                    batch_hierarchies = all_hierarchies_data[batch_start:batch_end]
                    current_batch = (batch_start // batch_size) + 1
                    
                    # Check for user cancellation before each AI batch
                    if self._check_cancellation(f"AI hierarchy analysis batch {current_batch}"):
                        ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                        break
                    
                    # Start batch processing with detailed tracking
                    batch_tracker.start_batch(current_batch, total_batches, batch_hierarchies)
                    ui_tracker.set_phase("AI Batch Processing", f"Processing batch {current_batch} of {total_batches}")
                    
                    # Log batch processing message for UI parsing (specific pattern required by UI regex)
                    logger.info(f"🤖 AI analyzing batch {current_batch} of {total_batches} ({len(batch_hierarchies)} hierarchies)")
                    
                    # Also update UI tracker for comprehensive tracking
                    ui_tracker.update_progress(
                        f"Processing hierarchies batch {current_batch} of {total_batches}",
                        current=current_batch,
                        total=total_batches
                    )
                    
                    
                     # Send batch to GPT-4o for AI-powered analysis against hierarchy quality rules
                    ai_results = analyze_hierarchies_with_ai(ai_client, batch_hierarchies, dataset_context)
                    
                    # ================================================================================================
                    # PHASE 5: SCORING & CATEGORIZATION
                    # ================================================================================================
                    # Process AI responses and calculate severity levels based on scoring rules
                    
                    # Transform AI results into structured analysis entries
                    for ai_result in ai_results:
                        # Get table name and hierarchy information for this specific result
                        table_name = ai_result.get("table_name", "Unknown")
                        hierarchy_name = ai_result.get("hierarchy_name", "Unknown")
                        column_path = ai_result.get("column_path", "")
                        
                        # ================================================================================================
                        # MICROSOFT HIERARCHY PATTERN RECOGNITION
                        # ================================================================================================
                        logger.info(f"🏷️ Identifying Microsoft hierarchy pattern for '{hierarchy_name}'...")
                        
                        # Define Microsoft standard hierarchy patterns
                        ms_hierarchy_patterns = {
                            "Function Hierarchies": {
                                "keywords": ["org", "executive", "exec", "function", "channel"],
                                "patterns": ["Org Exec Summary", "Org Exec", "Function Summary", "Function Detail"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            },
                            "Account Hierarchy": {
                                "keywords": ["account", "cost", "element", "class", "group", "line item"],
                                "patterns": ["Class", "Sub-Class", "Group", "Line Item", "Account"],
                                "type": "Dimension",
                                "confidence_boost": 0.4
                            },
                            "Geography Hierarchy": {
                                "keywords": ["geography", "mars", "sales", "area", "region", "country", "location"],
                                "patterns": ["Area", "Region", "Sub Region", "Country", "City", "Location"],
                                "type": "Dimension", 
                                "confidence_boost": 0.4
                            },
                            "Product Hierarchy": {
                                "keywords": ["product", "division", "category", "family", "pfam", "sku"],
                                "patterns": ["Division", "Category", "Family", "Product", "SKU"],
                                "type": "Dimension",
                                "confidence_boost": 0.4
                            },
                            "Business Hierarchy": {
                                "keywords": ["business", "stream", "unit"],
                                "patterns": ["Business Summary", "Business Unit", "Business Stream"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            },
                            "Segmentation Hierarchy": {
                                "keywords": ["segment", "subsegment", "customer"],
                                "patterns": ["Segment", "Subsegment"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            },
                            "Pricing Hierarchy": {
                                "keywords": ["pricing", "level", "purchase", "user"],
                                "patterns": ["Pricing Level", "Purchase Type", "User Type"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            },
                            "Date Hierarchy": {
                                "keywords": ["date", "fiscal", "calendar", "year", "quarter", "month"],
                                "patterns": ["Year", "Quarter", "Month", "Week", "Date"],
                                "type": "Dimension",
                                "confidence_boost": 0.5
                            },
                            "Company Hierarchy": {
                                "keywords": ["company", "sap", "subsidiary"],
                                "patterns": ["Company Type", "Company"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            },
                            "Responsibility Hierarchy": {
                                "keywords": ["responsibility", "ownership", "reports", "person"],
                                "patterns": ["Reports To", "Person", "Profit Center"],
                                "type": "Dimension",
                                "confidence_boost": 0.3
                            }
                        }
                        
                        # Analyze hierarchy name and column path for Microsoft patterns
                        ms_pattern_detected = "Unknown"
                        ms_confidence_boost = 0.0
                        ms_pattern_evidence = []
                        
                        hierarchy_text = f"{hierarchy_name} {column_path}".lower()
                        
                        for pattern_name, pattern_info in ms_hierarchy_patterns.items():
                            # Check for keyword matches
                            keyword_matches = sum(1 for keyword in pattern_info["keywords"] if keyword in hierarchy_text)
                            
                            # Check for structural pattern matches
                            pattern_matches = sum(1 for pattern in pattern_info["patterns"] if pattern.lower() in hierarchy_text)
                            
                            # Calculate pattern score
                            keyword_score = keyword_matches / len(pattern_info["keywords"])
                            pattern_score = pattern_matches / len(pattern_info["patterns"]) if pattern_info["patterns"] else 0
                            total_score = (keyword_score * 0.6) + (pattern_score * 0.4)
                            
                            if total_score > 0.3:  # Threshold for pattern detection
                                ms_pattern_detected = pattern_name
                                ms_confidence_boost = pattern_info["confidence_boost"] * total_score
                                ms_pattern_evidence.append(f"{pattern_name}: {keyword_matches} keywords, {pattern_matches} patterns (score: {total_score:.2f})")
                                
                                # Strong pattern match overrides default
                                if total_score > 0.6:
                                    break
                        
                        logger.info(f"📋 Microsoft Pattern: {ms_pattern_detected} (boost: +{ms_confidence_boost:.2f})")
                        
                        # ================================================================================================
                        # TABLE CLASSIFICATION USING CACHED FACT/DIMENSION ANALYSIS
                        # ================================================================================================
                        logger.info(f"🔄 Using cached fact/dimension classification for table '{table_name}'...")
                        
                        # Use cached table classification from fact/dimension analysis
                        logger.info(f"🔍 Looking up classification for table '{table_name}'...")
                        
                        if table_name in table_classifications:
                            cached_classification = table_classifications[table_name]
                            ai_table_type = cached_classification["table_type"]
                            classification_confidence = "high" if cached_classification["confidence"] >= 0.8 else ("medium" if cached_classification["confidence"] >= 0.5 else "low")
                            classification_reasoning = f"Using fact/dimension analysis: {ai_table_type} | Confidence: {cached_classification['confidence']:.2f} | Reasoning: {cached_classification['reasoning']}"
                            
                            logger.info(f"✅ Table '{table_name}' classified as {ai_table_type} (confidence: {classification_confidence}) from cached analysis")
                        else:
                            # Fallback classification if table not found in cache
                            logger.warning(f"⚠️ Table '{table_name}' not found in cached classifications - using fallback")
                            
                            try:
                                # Simple fallback: check if table has measures
                                table = next((t for t in self.tabular_editor.model.Tables if t.Name == table_name), None)
                                if table and hasattr(table, 'Measures') and len(table.Measures) > 0:
                                    ai_table_type = "FACT"
                                    classification_reasoning = f"Fallback analysis: Table has {len(table.Measures)} measures - likely Fact table"
                                    logger.info(f"🔧 Fallback: {table_name} → FACT (has {len(table.Measures)} measures)")
                                else:
                                    ai_table_type = "DIMENSION"
                                    classification_reasoning = f"Fallback analysis: Table has no measures - likely Dimension table"
                                    logger.info(f"🔧 Fallback: {table_name} → DIMENSION (no measures)")
                                classification_confidence = "low"
                            except Exception as fallback_error:
                                ai_table_type = "DIMENSION"  # Final fallback
                                classification_reasoning = f"Classification failed: {str(fallback_error)[:50]} - defaulting to Dimension"
                                classification_confidence = "low"
                                logger.error(f"❌ Fallback failed for {table_name}: {fallback_error}")
                        
                        # Add table type to ai_result for use in CSV generation
                        ai_result["table_type"] = ai_table_type
                        ai_result["ai_classification_confidence"] = classification_confidence
                        
                        # Calculate HQ-001 score based on table classification (handle both formats)
                        if ai_table_type.upper() in ["DIMENSION", "DIM"]:
                            hq_001_score = 0.4  # Dimension tables with hierarchies get full HQ-001 score
                        else:
                            hq_001_score = 0.0  # Fact tables with hierarchies get 0 HQ-001 score (concern)
                        
                        # Override the GPT HQ-001 score with evidence-based score
                        ai_result["hq_001_score"] = hq_001_score
                        
                        # Extract HQ-002 score from AI response (business pattern quality)
                        hq_002_score = float(ai_result.get("hq_002_score", 0.0))  # Business pattern (max 0.6)
                        
                        # Calculate composite scores for severity determination
                        calculated_total_score = hq_001_score + hq_002_score
                        calculated_max_score = 0.4 + 0.6  # Sum of max possible scores
                        
                        # Determine issue severity based on overall score percentage
                        score_percentage = (calculated_total_score / calculated_max_score) if calculated_max_score > 0 else 0
                        
                        # Apply severity thresholds with color coding for UI display
                        if score_percentage < 0.60:
                            issue_severity = "critical"     # <60% - Poor hierarchy design
                            severity_priority = 1
                            severity_color_code = "RED"
                            severity_hex_color = "#FF0000"
                        elif 0.60 <= score_percentage <= 0.74:
                            issue_severity = "issue"        # 60-74% - Significant improvements needed
                            severity_priority = 2
                            severity_color_code = "ORANGE"
                            severity_hex_color = "#FFA500"
                        elif 0.75 <= score_percentage <= 0.84:
                            issue_severity = "warning"      # 75-84% - Minor optimizations recommended
                            severity_priority = 3
                            severity_color_code = "YELLOW"
                            severity_hex_color = "#FFFF00"
                        else:  # 0.85 and above
                            issue_severity = "good"         # 85%+ - Excellent hierarchy design
                            severity_priority = 4
                            severity_color_code = "GREEN"
                            severity_hex_color = "#00FF00"
                        
                        # Calculate Score_Category using same logic as original method for backward compatibility
                        if calculated_total_score >= 0.8:
                            score_category = "Excellent"
                        elif calculated_total_score >= 0.6:
                            score_category = "Good" 
                        elif calculated_total_score >= 0.4:
                            score_category = "Fair"
                        else:
                            score_category = "Poor"
                        
                        # Generate Score_Rationale based on final classification and HQ-001 alignment
                        if ai_table_type.upper() in ["DIMENSION", "DIM"]:
                            if hq_001_score >= 0.4:
                                # Dimension table with hierarchy - good alignment
                                if calculated_total_score >= 0.8:
                                    score_rationale = "Excellent: Hierarchy properly placed in Dimension table with high quality patterns"
                                elif calculated_total_score >= 0.6:
                                    score_rationale = "Good: Hierarchy appropriately placed in Dimension table with room for pattern improvements"
                                else:
                                    score_rationale = "The hierarchy is placed in a Dimension table but could benefit from business pattern optimization"
                            else:
                                score_rationale = "Dimension table classification but low HQ-001 score - verify table structure"
                        else:  # Fact table
                            if hq_001_score == 0.0:
                                # Fact table with hierarchy - HQ-001 concern
                                score_rationale = "Consider moving the hierarchy to a Dimension table to align with best practices for hierarchy placement"
                            else:
                                score_rationale = "Fact table with hierarchy - review table classification and structure"
                        
                        # Build streamlined result entry with essential hierarchy analysis data
                        result_entry = {
                            "Table": ai_result.get("table_name", "Unknown"),
                            "Table_Type": ai_result.get("table_type", "Unknown"),
                            "Issue_Severity": issue_severity,
                            "Hierarchy_Name": ai_result.get("hierarchy_name", "Unknown"),
                            "Column_Path": ai_result.get("column_path", "Column details unavailable"),
                            "Business_Pattern_Direction": ai_result.get("hierarchy_direction", "Unknown"),
                            "Level_Count": int(ai_result.get("level_count", 0)),
                            "Dimension_Alignment_Score": hq_001_score,
                            "Business_Pattern_Score": hq_002_score,
                            "Overall_Score": calculated_total_score,
                            "Dimension_Alignment_MaxScore": 0.4,  # H-001: Hierarchies should always be established in dimension tables
                            "Business_Pattern_MaxScore": 0.6,    # H-002: Hierarchies should have clear logical/business pattern
                            "Max_Score": 1.0,             # H-001 (0.4) + H-002 (0.6) = 1.0
                            "Score_Rationale": score_rationale
                        }
                        
                        # Add processed entry to final results collection
                        analysis_results.append(result_entry)
                        existing_hierarchies_detailed.append(result_entry)
                    
                    # Complete batch processing with comprehensive statistics using UI tracker
                    batch_tracker.complete_batch(
                        batch_number=current_batch,
                        total_batches=total_batches,
                        processing_results=ai_results
                    )
                
                # Log processing completion for UI parsing (specific pattern required by UI regex)
                logger.info(f"🤖 Processed AI analysis of {total_batches} batches ({total_hierarchies} hierarchies)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Completed hierarchy analysis - {total_hierarchies} hierarchies processed",
                    current=total_batches,
                    total=total_batches
                )
            
            else:
                logger.info("📊 No existing hierarchies detected in dataset - analysis will focus only on existing hierarchies")
                
                # Only analyze existing hierarchies as per requirements
                # Do not generate suggested hierarchies
                all_hierarchies_data = []
                total_hierarchies = 0
                logger.info("📊 Analysis completed - no existing hierarchies found to analyze")
                
                # Create placeholder entry for CSV generation when no hierarchies exist
                analysis_results = [{
                    'Table': 'Model Analysis',
                    'Table_Type': 'N/A',
                    'Issue_Severity': 'critical',
                    'Hierarchy_Name': 'No existing hierarchies found in the model',
                    'Column_Path': 'Critical: No hierarchies exist in this Power BI model',
                    'Business_Pattern_Direction': 'Missing',
                    'Level_Count': 0,
                    'Dimension_Alignment_Score': 0.0,
                    'Business_Pattern_Score': 0.0,
                    'Overall_Score': 0.0,
                    'Dimension_Alignment_MaxScore': 0.4,  # H-001: Hierarchies should always be established in dimension tables
                    'Business_Pattern_MaxScore': 0.6,    # H-002: Hierarchies should have clear logical/business pattern
                    'Max_Score': 1.0,             # H-001 (0.4) + H-002 (0.6) = 1.0
                    'Score_Rationale': 'CRITICAL: No hierarchies found in model - hierarchies are essential for business intelligence reporting and user navigation'
                }]

            # Generate high-level recommendations based on HQ-001 and HQ-002 scoring logic
            for existing in existing_hierarchies_detailed:
                hierarchy_name = existing.get("Hierarchy_Name", "Unknown")
                table_name = existing.get("Table", "Unknown")
                table_type = existing.get("Table_Type", "Unknown")
                overall_score = existing.get("Overall_Score", 0)
                dimension_score = existing.get("Dimension_Alignment_Score", 0)
                business_score = existing.get("Business_Pattern_Score", 0)
                
                # Generate concise, high-level recommendation based on scoring
                if overall_score >= 0.85:
                    recommendations.append(f"EXCELLENT: Hierarchy '{hierarchy_name}' in table '{table_name}' demonstrates excellent design quality")
                elif overall_score >= 0.75:
                    recommendations.append(f"GOOD: Hierarchy '{hierarchy_name}' in table '{table_name}' is well-designed with minor optimization opportunities")
                elif overall_score >= 0.60:
                    if table_type == "Fact":
                        recommendations.append(f"NEEDS OPTIMIZATION: Hierarchy '{hierarchy_name}' should be moved from Fact table '{table_name}' to a Dimension table")
                    elif business_score < 0.3:
                        recommendations.append(f"NEEDS OPTIMIZATION: Hierarchy '{hierarchy_name}' in table '{table_name}' requires clearer business pattern structure")
                    else:
                        recommendations.append(f"NEEDS OPTIMIZATION: Hierarchy '{hierarchy_name}' in table '{table_name}' has room for improvement")
                else:
                    if table_type == "Fact":
                        recommendations.append(f"CRITICAL: Hierarchy '{hierarchy_name}' in Fact table '{table_name}' must be moved to a Dimension table")
                    else:
                        recommendations.append(f"CRITICAL: Hierarchy '{hierarchy_name}' in table '{table_name}' has significant design issues requiring immediate attention")

            # ================================================================================================
            # PHASE 6: CSV GENERATION & STATISTICAL ANALYSIS
            # ================================================================================================
            # Create comprehensive CSV output with statistical analysis and insights
            
            logger.info("📊 PHASE 6: Generating comprehensive CSV output with statistical analysis...")
            ui_tracker.set_phase("CSV Generation", "Creating comprehensive hierarchy analysis report")
            
            # Initialize statistical tracking variables
            stats = {
                "total_hierarchies": len(analysis_results),
                "severity_counts": {"critical": 0, "issue": 0, "warning": 0, "good": 0},
                "pattern_counts": {},
                "table_type_counts": {},
                "level_distribution": {},
                "avg_scores": {"table_alignment": 0.0, "business_pattern": 0.0, "overall": 0.0}
            }
            
            # Calculate detailed statistics for analysis report
            if analysis_results:
                # Count hierarchies by severity level
                for result in analysis_results:
                    severity = result.get("Issue_Severity", "unknown")
                    # Count critical no-hierarchies case but skip other stats for model-level entries
                    if result.get("Table") == "Model Analysis":
                        # This is the no-hierarchies critical case - count it as critical
                        stats["severity_counts"][severity] = stats["severity_counts"].get(severity, 0) + 1
                    elif result.get("Hierarchy_Name") != "No existing hierarchies found in the model":
                        # Normal hierarchy entries - count all statistics
                        stats["severity_counts"][severity] = stats["severity_counts"].get(severity, 0) + 1
                        
                        # Track pattern distribution
                        pattern = result.get("Business_Pattern", "generic")
                        stats["pattern_counts"][pattern] = stats["pattern_counts"].get(pattern, 0) + 1
                        
                        # Track table type distribution
                        table_type = result.get("Table_Type", "Unknown")
                        stats["table_type_counts"][table_type] = stats["table_type_counts"].get(table_type, 0) + 1
                        
                        # Track level count distribution
                        level_count = result.get("Level_Count", 0)
                        stats["level_distribution"][level_count] = stats["level_distribution"].get(level_count, 0) + 1
                
                # Calculate average scores for insight generation (excluding no-hierarchies entry)
                valid_results = [result for result in analysis_results if result.get("Hierarchy_Name") != "No existing hierarchies found in the model"]
                if valid_results:
                    total_table_alignment = sum(result.get("Dimension_Alignment_Score", 0) for result in valid_results)
                    total_business_pattern = sum(result.get("Business_Pattern_Score", 0) for result in valid_results)
                    total_overall = sum(result.get("Overall_Score", 0) for result in valid_results)
                    result_count = len(valid_results)
                    
                    stats["avg_scores"]["table_alignment"] = total_table_alignment / result_count
                    stats["avg_scores"]["business_pattern"] = total_business_pattern / result_count
                    stats["avg_scores"]["overall"] = total_overall / result_count
                else:
                    # No valid hierarchies for scoring
                    stats["avg_scores"]["table_alignment"] = 0.0
                    stats["avg_scores"]["business_pattern"] = 0.0
                    stats["avg_scores"]["overall"] = 0.0
            
            # Create CSV output with comprehensive analysis data
            # Initialize CSV variables first
            csv_filename = None
            csv_filepath = None
            csv_content = None
            
            # Always generate CSV, even when no hierarchies exist
            try:
                # Generate timestamp for unique file naming
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                workspace_name = self._sanitize_filename(workspace_info.get("WorkspaceName", "Unknown"))
                dataset_name = self._sanitize_filename(workspace_info.get("DatasetName", "Unknown"))
                csv_filename = f"AI_Hierarchy_Analysis_{workspace_name}_{dataset_name}_{timestamp}.csv"
                csv_filepath = os.path.join(KB_FOLDER, csv_filename)
                
                # Define CSV columns - simplified output with essential hierarchy analysis data
                # Core columns (essential hierarchy information)
                csv_columns = [
                    'Table', 'Table_Type', 'Issue_Severity', 'Hierarchy_Name', 'Column_Path',
                    'Business_Pattern_Direction', 'Level_Count', 
                    'Dimension_Alignment_Score', 'Dimension_Alignment_MaxScore', 'Business_Pattern_Score', 'Business_Pattern_MaxScore', 'Overall_Score',
                    'Max_Score',
                    'Score_Rationale'
                ]
                
                # Create DataFrame with comprehensive analysis results
                hierarchy_df = pd.DataFrame(analysis_results, columns=csv_columns)
                
                # Sort by Issue_Severity priority for better readability (handle info level for no-hierarchies case)
                severity_order = {"critical": 1, "issue": 2, "warning": 3, "good": 4, "info": 5}
                hierarchy_df['severity_sort'] = hierarchy_df['Issue_Severity'].map(severity_order)
                hierarchy_df = hierarchy_df.sort_values(['severity_sort', 'Overall_Score']).drop('severity_sort', axis=1)
                
                # Create Excel file with color formatting for Issue_Severity column
                excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(hierarchy_df, csv_filename, 'Issue_Severity')
                
                if excel_content and excel_filename and csv_text_content:
                    # Save Excel file to KnowledgeBase folder
                    excel_filepath = self._save_excel_file(excel_content, excel_filename)
                    
                    # Generate content for frontend
                    csv_content = csv_text_content  # CSV text for UI parsing
                    excel_content_bytes = excel_content  # Excel content bytes for download
                    csv_filepath = excel_filepath
                    csv_filename = excel_filename
                    
                    # Check if this is a no-hierarchies case
                    if analysis_results and analysis_results[0].get("Hierarchy_Name") == "No existing hierarchies found in the model":
                        logger.info(f"✅ Generated CRITICAL hierarchy analysis Excel for model with no hierarchies: {excel_filepath}")
                        logger.info(f"📊 Saved critical finding: No existing hierarchies found in model - {excel_filename}")
                    else:
                        logger.info(f"✅ Generated AI-powered hierarchy analysis Excel file: {excel_filepath}")
                        logger.info(f"📊 Saved {len(analysis_results)} hierarchy analysis results to {excel_filename}")
                else:
                    logger.error("❌ Failed to generate Excel file")
                    csv_filepath = None
                    csv_filename = None
                    csv_content = None
                    excel_content_bytes = None
                
                # Log statistical summary for UI parsing (matches dataset columns pattern)
                logger.info(f"📊 HIERARCHY STATS: Critical: {stats['severity_counts'].get('critical', 0)}, Issues: {stats['severity_counts'].get('issue', 0)}, Warnings: {stats['severity_counts'].get('warning', 0)}, Good: {stats['severity_counts'].get('good', 0)}")
                
            except Exception as excel_error:
                logger.error(f"❌ Failed to generate Excel file: {excel_error}")
                csv_filepath = None
                csv_filename = None
                csv_content = None

            # ================================================================================================
            # PHASE 7: STATISTICAL INSIGHTS & PATTERN ANALYSIS
            # ================================================================================================
            # Generate comprehensive insights based on statistical analysis of hierarchy patterns
            
            logger.info("📊 PHASE 7: Generating statistical insights and pattern analysis...")
            ui_tracker.set_phase("Statistical Analysis", "Analyzing patterns and generating insights")
            
            # Generate insights based on statistical analysis
            insights = []
            
            # Check if we have actual hierarchies or just critical no-hierarchies finding
            has_real_hierarchies = analysis_results and analysis_results[0].get("Hierarchy_Name") != "No existing hierarchies found in the model"
            
            if has_real_hierarchies:
                # Severity distribution insights
                critical_count = stats["severity_counts"].get("critical", 0)
                issue_count = stats["severity_counts"].get("issue", 0)
                warning_count = stats["severity_counts"].get("warning", 0)
                good_count = stats["severity_counts"].get("good", 0)
                total_count = critical_count + issue_count + warning_count + good_count
                
                # Overall health assessment
                critical_percentage = (critical_count / total_count * 100) if total_count > 0 else 0
                issue_percentage = (issue_count / total_count * 100) if total_count > 0 else 0
                
                if critical_percentage > 30:
                    insights.append(f"⚠️ Critical: {critical_percentage:.1f}% of hierarchies have critical quality issues requiring immediate attention")
                elif issue_percentage > 40:
                    insights.append(f"⚠️ Attention needed: {issue_percentage:.1f}% of hierarchies have significant issues that should be addressed")
                elif good_count / total_count > 0.7:
                    insights.append(f"✅ Excellent: {(good_count / total_count * 100):.1f}% of hierarchies demonstrate high-quality design patterns")
            else:
                # Critical no hierarchies case - generate urgent insights
                insights.append("🚨 CRITICAL: No existing hierarchies found in the model")
                insights.append("⚠️ This significantly impacts user experience and reporting capabilities")
                insights.append("🎯 IMMEDIATE ACTION REQUIRED: Create hierarchies for essential business dimensions")
                insights.append("📋 Priority hierarchy patterns: Time (Year/Quarter/Month), Geography (Country/Region/City), Product (Category/Subcategory/Product)")
                insights.append("🔧 Use Power BI Desktop to create hierarchies that align with business reporting needs")
                insights.append("📈 Hierarchies improve navigation, drill-down capabilities, and overall user experience")
            
            # Pattern analysis insights (only for real hierarchies)
            if has_real_hierarchies and stats["pattern_counts"]:
                most_common_pattern = max(stats["pattern_counts"], key=stats["pattern_counts"].get)
                pattern_count = stats["pattern_counts"][most_common_pattern]
                insights.append(f"📈 Most common business pattern: {most_common_pattern} ({pattern_count} hierarchies)")
            
            # Level distribution insights (only for real hierarchies)
            if has_real_hierarchies and stats["level_distribution"]:
                total_count = sum(stats["severity_counts"].values())
                avg_levels = sum(level * count for level, count in stats["level_distribution"].items()) / total_count
                insights.append(f"📊 Average hierarchy depth: {avg_levels:.1f} levels")
                
                # Find optimal level count
                optimal_levels = [level for level, count in stats["level_distribution"].items() if 3 <= level <= 5]
                if optimal_levels:
                    optimal_count = sum(stats["level_distribution"][level] for level in optimal_levels)
                    optimal_percentage = (optimal_count / total_count * 100)
                    insights.append(f"🎯 {optimal_percentage:.1f}% of hierarchies have optimal 3-5 level depth")
            
            # Score-based insights (only for real hierarchies)
            if has_real_hierarchies:
                avg_overall = stats["avg_scores"]["overall"]
                if avg_overall < 0.6:
                    insights.append(f"⚠️ Dataset average quality score is {avg_overall:.2f} - significant improvements recommended")
                elif avg_overall > 0.8:
                    insights.append(f"✅ Dataset demonstrates strong hierarchy quality with average score of {avg_overall:.2f}")
            
            # Table type distribution insights (only for real hierarchies)
            if has_real_hierarchies and stats["table_type_counts"]:
                dimension_hierarchies = stats["table_type_counts"].get("dimension", 0)
                fact_hierarchies = stats["table_type_counts"].get("fact", 0)
                if fact_hierarchies > 0:
                    insights.append(f"⚠️ Found {fact_hierarchies} hierarchies in fact tables - consider moving to dimension tables for better performance")
                if dimension_hierarchies > 0:
                        insights.append(f"✅ {dimension_hierarchies} hierarchies properly placed in dimension tables")
            
            # ================================================================================================
            # PHASE 8: FINAL RESULTS ASSEMBLY
            # ================================================================================================
            # Assemble comprehensive results with all analysis components
            
            logger.info("📊 PHASE 8: Assembling final comprehensive results...")
            ui_tracker.set_phase("Results Assembly", "Finalizing comprehensive analysis results")
            
            # Complete the analysis using UI tracker
            # Filter out placeholder entries for accurate statistics
            actual_analysis_results = [r for r in analysis_results if r.get("Hierarchy_Name") != "No existing hierarchies found in the model"]
            
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=f"Successfully analyzed {len(actual_analysis_results)} hierarchies",
                results_data={
                    "total_hierarchies": len(actual_analysis_results),
                    "csv_filename": csv_filename if analysis_results else None,
                    "existing_hierarchies": len([r for r in actual_analysis_results if r.get("Hierarchy_Type") == "Existing"]),
                    "suggested_hierarchies": len([r for r in actual_analysis_results if r.get("Hierarchy_Type") == "Suggested"])
                }
            )
            
            # Build comprehensive final results
            final_results = {
                "status": "success",
                "method": "AI-Powered Hierarchy Analysis",
                "analysis_type": "comprehensive_hierarchy_evaluation",
                "workspace_info": workspace_info,
                "timestamp": datetime.now().isoformat(),
                "processing_summary": {
                    "total_tables_analyzed": len(tables),
                    "total_hierarchies_found": len(analysis_results),
                    "ai_batches_processed": total_batches,
                    "processing_method": "GPT-4o AI Analysis with Statistical Insights"
                },
                "results": analysis_results,
                "existing_hierarchies": existing_hierarchies_detailed,
                "recommendations": recommendations,
                "statistical_analysis": stats,
                "insights": insights,
                "csv_output": {
                    "filename": csv_filename,
                    "filepath": csv_filepath,
                    "record_count": len(analysis_results),
                    "csv_content": csv_content
                } if csv_filename else None,
                "debug_info": debug_info,
                "analysis_statistics": analysis_stats
            }
            
            # Add CSV content at top level for frontend compatibility
            if csv_filename and csv_content:
                final_results["csv_filename"] = csv_filename
                final_results["csv_file_path"] = csv_filepath
                final_results["csv_content"] = csv_content  # CSV text for UI parsing
                if 'excel_content_bytes' in locals() and excel_content_bytes:
                    final_results["excel_content"] = excel_content_bytes  # Excel binary for download
            else:
                final_results["csv_generation_error"] = "No hierarchies found or Excel generation failed"
            
            # ================================================================================================
            # GENERATE HIGH-LEVEL SUMMARY FOR FRONTEND DASHBOARD
            # ================================================================================================
            # Create analysis_summary structure that matches what _generate_hierarchies_summary expects
            
            # Filter out placeholder entries to get actual hierarchy count
            actual_hierarchies = [r for r in analysis_results if r.get("Hierarchy_Name") != "No existing hierarchies found in the model"]
            
            analysis_summary_for_summary = {
                "workspace": workspace_info["WorkspaceName"],
                "dataset": workspace_info["DatasetName"],
                "tables_analyzed": len(tables),
                "total_existing_hierarchies": len(actual_hierarchies),
                "tables_with_hierarchies": len(set(result.get("Table", "") for result in actual_hierarchies)) if actual_hierarchies else 0,
                "tables_without_hierarchies": len(tables) - (len(set(result.get("Table", "") for result in actual_hierarchies)) if actual_hierarchies else 0),
                "analysis_timestamp": datetime.now().isoformat(),
                "csv_rows_generated": len(analysis_results)
            }
            
            # Map analysis_results to existing_hierarchies_detailed format for summary generation
            # Exclude placeholder entries from the summary
            existing_hierarchies_for_summary = []
            for result in actual_hierarchies:  # Use actual_hierarchies instead of analysis_results
                hierarchy_entry = {
                    "table": result.get("Table", "Unknown"),
                    "hierarchy_name": result.get("Hierarchy_Name", "Unknown"),
                    "table_type": result.get("Table_Type", "Unknown"),
                    "score_category": result.get("Score_Category", "Unknown"),
                    "score_rationale": result.get("Score_Rationale", ""),
                    "total_score": result.get("Overall_Score", 0.0),
                    "level_count": result.get("Level_Count", 0)
                }
                existing_hierarchies_for_summary.append(hierarchy_entry)
            
            # Build hierarchy types for summary (exclude placeholder entries)
            hierarchy_types_for_summary = list(set(result.get("Business_Pattern", "generic") for result in actual_hierarchies))
            
            # Create detailed breakdown for summary
            detailed_breakdown_for_summary = {
                "tables_with_existing_hierarchies": analysis_summary_for_summary["tables_with_hierarchies"],
                "tables_without_hierarchies": analysis_summary_for_summary["tables_without_hierarchies"]
            }
            
            # Update final_results structure to match what generate_analysis_summary expects
            final_results.update({
                "analysis_summary": analysis_summary_for_summary,
                "existing_hierarchies_detailed": existing_hierarchies_for_summary,
                "hierarchy_types_found": hierarchy_types_for_summary,
                "detailed_breakdown": detailed_breakdown_for_summary
            })
            
            # Generate high-level summary for dashboard display using the hierarchies_analysis method
            logger.info("📊 Generating high-level summary for dashboard display...")
            logger.info(f"🔧 HIERARCHIES SUMMARY INPUT: CSV content available: {bool(final_results.get('csv_content'))}")
            if final_results.get('csv_content'):
                logger.info(f"🔧 HIERARCHIES SUMMARY INPUT: CSV content length: {len(final_results['csv_content'])} characters")
                
            high_level_summary = self.tabular_editor.generate_analysis_summary("hierarchies_analysis", final_results)
            logger.info(f"🔧 HIERARCHIES SUMMARY OUTPUT: Generated summary with overall_score={high_level_summary.get('overall_score', 'N/A')}%")
            logger.info(f"🔧 HIERARCHIES SUMMARY OUTPUT: Summary keys: {list(high_level_summary.keys()) if high_level_summary else 'None'}")
            
            # Attach high-level summary to main result
            final_results["high_level_summary"] = high_level_summary
            
            # Extract and set issue counts at top level for frontend accessibility
            if high_level_summary and "detailed_issues" in high_level_summary:
                detailed_issues = high_level_summary["detailed_issues"]
                critical_count = len(detailed_issues.get("critical", []))
                issue_count = len(detailed_issues.get("issue", []))
                warning_count = len(detailed_issues.get("warning", []))
                total_issues = critical_count + issue_count + warning_count
                
                # Set issue counts at multiple levels for frontend compatibility
                final_results["critical_issues"] = critical_count
                final_results["issue_issues"] = issue_count
                final_results["warning_issues"] = warning_count
                final_results["total_issues"] = total_issues
                
                # Also ensure they're in the high_level_summary
                high_level_summary["critical_issues"] = critical_count
                high_level_summary["issue_issues"] = issue_count
                high_level_summary["warning_issues"] = warning_count
                high_level_summary["total_issues"] = total_issues
                
                logger.info(f"📊 Issue counts generated: Critical: {critical_count}, Issue: {issue_count}, Warning: {warning_count}, Total: {total_issues}")
            else:
                # Set default values if no issues detected
                final_results["critical_issues"] = 0
                final_results["issue_issues"] = 0
                final_results["warning_issues"] = 0
                final_results["total_issues"] = 0
                
                if high_level_summary:
                    high_level_summary["critical_issues"] = 0
                    high_level_summary["issue_issues"] = 0
                    high_level_summary["warning_issues"] = 0
                    high_level_summary["total_issues"] = 0
            
            # Log final completion status
            total_time = time.time() - start_time
            logger.info(f"✅ AI-Powered Hierarchy Analysis completed successfully in {total_time:.2f} seconds")
            logger.info(f"📊 Final Results: {len(analysis_results)} hierarchies analyzed, {len(insights)} insights generated")
            
            return final_results
        
        except Exception as e:
            logger.error(f"Failed to evaluate table hierarchies: {e}")
            return {
                "status": "error",
                "error": str(e),
                "method": "AI-Powered Hierarchy Analysis",
                "analysis_type": "comprehensive_hierarchy_evaluation"
            }


    def evaluate_security_compliance(self, progress_callback=None) -> Dict[str, Any]:
        """
        Comprehensive security compliance evaluation with three scoring rules:
        
        Rule 1 - Sensitive Data Detection (Max Score: 0.3)
        Rule 2 - Security Role and Data Access Validation (Max Score: 0.4 × financial tables) 
        Rule 3 - Account Linkage Detection (Max Score: 0.3 × financial tables)
        
        Total Maximum Score: Dynamic based on financial tables found
        
        Returns:
            Dict containing overall security compliance score and detailed analysis
        """
        import pandas as pd
        import json
        import os
        import io
        import time
        from datetime import datetime
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker
        
        def get_ai_client():
            """Get Azure OpenAI client for AI reasoning"""
            try:
                auth_manager = AuthenticationManager.get_instance()
                return auth_manager.get_openai_client()
            except Exception as e:
                logger.error(f"Failed to get OpenAI client: {e}")
                return None
        
        def get_table_sample_data(table_name: str, sample_size: int = 10) -> List[Dict[str, Any]]:
            """Get sample rows from a table for sensitive data analysis"""
            try:
                # Escape table name if it contains spaces
                escaped_table = f"'{table_name}'" if ' ' in table_name else table_name
                
                # Create DAX query to get sample data
                sample_query = f"""
                EVALUATE
                TOPN({sample_size}, {escaped_table})
                """
                
                result = self.tabular_editor.execute_dax_query(sample_query)
                return result if result else []
                
            except Exception as e:
                logger.debug(f"Could not get sample data for {table_name}: {e}")
                return []
        
        def analyze_table_data_with_ai(client, table_data: Dict[str, Any], max_tokens: int = 4000) -> Dict[str, Any]:
            """
            Simple AI analysis for sensitive data detection AND financial data detection with account linkage.
            """
            try:
                # Limit sample data to prevent prompt from being too large
                sample_data_limited = table_data['sample_data'][:3] if len(table_data['sample_data']) > 3 else table_data['sample_data']
                
                prompt = f"""Analyze table: {table_data['table_name']}
Columns: {', '.join(table_data['columns'])}
Sample: {json.dumps(sample_data_limited, default=str)[:500]}

Check for:
- Sensitive data (PII, SSN, phone)
- Financial data (revenue, target, budget) 
- Account linking (Account, TPID, Seller columns)

Return JSON:
{{"sensitive_data_analysis":{{"has_sensitive_data":false,"confidence_score":0.0,"sensitive_columns":[],"sensitivity_type":"None","explanation":"","risk_level":"None"}},"financial_data_analysis":{{"has_financial_data":false,"revenue_columns":[],"target_columns":[],"budget_columns":[],"confidence_score":0.0,"explanation":""}},"account_linkage_analysis":{{"has_account_columns":false,"account_columns":[],"tpid_columns":[],"mssales_id_columns":[],"seller_columns":[],"linkage_quality":"None","explanation":""}}}}"""

                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": "Return only valid JSON. No extra text."},
                        {"role": "user", "content": prompt}
                    ],
                    temperature=0.0,
                    max_tokens=max_tokens
                )
                
                response_content = response.choices[0].message.content.strip()
                
                # Find JSON in response
                json_start = response_content.find('{')
                json_end = response_content.rfind('}') + 1
                
                if json_start != -1 and json_end > json_start:
                    json_content = response_content[json_start:json_end]
                    result = json.loads(json_content)
                    return result
                else:
                    raise Exception("No JSON found in response")
                    
            except Exception as e:
                logger.error(f"❌ AI analysis failed for {table_data['table_name']}: {e}")
                raise
        
        def analyze_security_tables_with_ai(client, security_roles_info: Dict[str, Any], tables_sample_data: Dict[str, List[Dict]]) -> Dict[str, Any]:
            """
            Simple AI analysis of security tables to understand security patterns.
            """
            if not client:
                raise Exception("AI client not available")
            
            rls_tables = security_roles_info.get("tables_with_rls", [])
            if not rls_tables:
                return {
                    "has_security_roles": False,
                    "security_analysis": "No RLS tables found",
                    "security_table_types": [],
                    "detected_security_patterns": []
                }
            
            # Prepare minimal context
            roles_data = []
            for role in security_roles_info.get("roles", []):
                for table_perm in role.get("table_permissions", []):
                    if table_perm["has_rls"]:
                        roles_data.append({
                            "role": role["role_name"],
                            "table": table_perm["table_name"],
                            "filter": table_perm["filter_expression"]
                        })
            
            prompt = f"""Analyze security roles: {json.dumps(roles_data[:5], default=str)}
Tables data: {json.dumps({k: v[:3] for k, v in tables_sample_data.items()}, default=str)[:1000]}

Find security patterns: user/subsidiary, subregion, seller assignment, account-level.

Return JSON:
{{"has_security_roles":true,"security_analysis":"brief analysis","security_table_types":[{{"type":"user_subsidiary","confidence":0.8,"tables_involved":["table1"],"evidence":"evidence","filter_examples":["filter"]}}],"detected_security_patterns":[{{"pattern_name":"name","pattern_type":"user_subsidiary","implementation":"how","tables":["table1"],"effectiveness":"high"}}],"security_recommendations":["rec1"],"mssales_compatibility":{{"compatible":true,"issues":[],"suggestions":[]}}}}"""
            
            response = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {"role": "system", "content": "Return only valid JSON. No extra text."},
                    {"role": "user", "content": prompt}
                ],
                temperature=0.0,
                max_tokens=2000
            )
            
            response_content = response.choices[0].message.content.strip()
            json_start = response_content.find('{')
            json_end = response_content.rfind('}') + 1
            
            if json_start != -1 and json_end > json_start:
                return json.loads(response_content[json_start:json_end])
            else:
                raise Exception("No JSON found in response")
        
        def check_mssales_security_filters(table_name: str, security_analysis: Dict[str, Any] = None) -> Dict[str, Any]:
            """
            Comprehensive MSSales security filtering check following the proper workflow:
            1. Check if ANY security roles are defined in the model
            2. If roles exist, analyze what kind of security data they contain using AI
            3. Get sample data from security tables to understand security patterns
            4. Use analyze_table_filtering_paths to verify financial tables can be filtered by security tables
            """
            try:
                logger.info(f"🔐 Comprehensive security check for table: {table_name}")
                
                # STEP 1: Check if ANY security roles are defined in the model
                security_roles_info = self.tabular_editor.get_security_roles_info()
                
                if not security_roles_info.get("has_security_roles", False):
                    logger.warning(f"❌ No security roles defined in the model")
                    return {
                        "has_security_filtering": False,
                        "security_status": "NO_ROLES_DEFINED",
                        "error": "No security roles defined in the model",
                        "security_analysis": None,
                        "filtering_analysis": None
                    }
                
                logger.info(f"✅ Found {security_roles_info['total_roles']} security roles with {security_roles_info['rls_coverage']} RLS tables")
                
                # STEP 2: Get sample data from security tables (RLS tables)
                security_tables_data = {}
                rls_tables = security_roles_info.get("tables_with_rls", [])
                
                if rls_tables:
                    logger.info(f"📊 Getting sample data from {len(rls_tables)} security tables: {rls_tables}")
                    for sec_table in rls_tables:
                        try:
                            sample_data = get_table_sample_data(sec_table, 10)
                            if sample_data:
                                security_tables_data[sec_table] = sample_data
                                logger.info(f"📋 Got {len(sample_data)} sample rows from {sec_table}")
                        except Exception as e:
                            logger.debug(f"Could not get sample data from {sec_table}: {e}")
                
                # STEP 3: Use AI to analyze security tables if we have security analysis or perform new analysis
                if security_analysis is None and security_tables_data:
                    logger.info("🤖 Analyzing security tables with AI...")
                    ai_client = get_ai_client()
                    if ai_client:
                        security_analysis = analyze_security_tables_with_ai(ai_client, security_roles_info, security_tables_data)
                    else:
                        logger.warning("⚠️ AI client not available for security analysis")
                        security_analysis = {"error": "AI client not available"}
                
                # STEP 4: Use analyze_table_filtering_paths to check if financial table can be filtered
                logger.info(f"🔍 Checking filtering paths from financial table: {table_name}")
                filtering_paths = self.tabular_editor.analyze_table_filtering_paths(table_name)
                
                # Analyze filtering paths against detected security patterns
                filtering_analysis = {
                    "total_filterable_tables": len(filtering_paths),
                    "security_filtering_paths": [],
                    "has_user_subsidiary_filtering": False,
                    "has_subregion_filtering": False,
                    "has_seller_assignment_filtering": False,
                    "has_account_level_filtering": False,
                    "detailed_paths": []
                }
                
                if not filtering_paths.empty:
                    # Get detected security table types from AI analysis
                    security_table_types = security_analysis.get("security_table_types", []) if security_analysis else []
                    detected_security_tables = []
                    
                    for sec_type in security_table_types:
                        detected_security_tables.extend(sec_type.get("tables_involved", []))
                    
                    # Analyze each filtering path
                    for _, row in filtering_paths.iterrows():
                        path = row['Path']
                        target_table = row['TargetTable']
                        path_lower = path.lower()
                        target_lower = target_table.lower()
                        
                        path_info = {
                            "target_table": target_table,
                            "path": path,
                            "security_types": []
                        }
                        
                        # Check against AI-detected security patterns
                        for sec_type in security_table_types:
                            if target_table in sec_type.get("tables_involved", []):
                                path_info["security_types"].append({
                                    "type": sec_type["type"],
                                    "confidence": sec_type["confidence"],
                                    "evidence": sec_type["evidence"]
                                })
                                
                                # Update filtering analysis flags
                                if sec_type["type"] == "user_subsidiary":
                                    filtering_analysis["has_user_subsidiary_filtering"] = True
                                elif sec_type["type"] == "subregion":
                                    filtering_analysis["has_subregion_filtering"] = True
                                elif sec_type["type"] == "seller_assignment":
                                    filtering_analysis["has_seller_assignment_filtering"] = True
                                elif sec_type["type"] == "account_level":
                                    filtering_analysis["has_account_level_filtering"] = True
                        
                        # Also check with traditional keyword matching as fallback
                        if not path_info["security_types"]:
                            if any(term in path_lower or term in target_lower for term in ['user', 'employee', 'person', 'staff', 'subsidiary', 'company', 'organization', 'division']):
                                path_info["security_types"].append({
                                    "type": "user_subsidiary",
                                    "confidence": 0.6,
                                    "evidence": "Keyword matching"
                                })
                                filtering_analysis["has_user_subsidiary_filtering"] = True
                            
                            if any(term in path_lower or term in target_lower for term in ['region', 'subregion', 'country', 'area', 'territory', 'geography']):
                                path_info["security_types"].append({
                                    "type": "subregion",
                                    "confidence": 0.6,
                                    "evidence": "Keyword matching"
                                })
                                filtering_analysis["has_subregion_filtering"] = True
                            
                            if any(term in path_lower or term in target_lower for term in ['seller', 'sales', 'account', 'tpid', 'mssales']):
                                path_info["security_types"].append({
                                    "type": "seller_assignment",
                                    "confidence": 0.6,
                                    "evidence": "Keyword matching"
                                })
                                filtering_analysis["has_seller_assignment_filtering"] = True
                        
                        filtering_analysis["detailed_paths"].append(path_info)
                        
                        if path_info["security_types"]:
                            filtering_analysis["security_filtering_paths"].append(f"{target_table}: {path}")
                
                # Determine overall security status
                has_any_security = (
                    filtering_analysis["has_user_subsidiary_filtering"] or
                    filtering_analysis["has_subregion_filtering"] or
                    filtering_analysis["has_seller_assignment_filtering"] or
                    filtering_analysis["has_account_level_filtering"]
                )
                
                result = {
                    "has_security_filtering": has_any_security,
                    "security_status": "COMPREHENSIVE_SECURITY" if has_any_security else "NO_SECURITY_PATHS",
                    "security_analysis": security_analysis,
                    "filtering_analysis": filtering_analysis,
                    "security_roles_info": {
                        "total_roles": security_roles_info["total_roles"],
                        "tables_with_rls": len(security_roles_info["tables_with_rls"]),
                        "rls_tables": security_roles_info["tables_with_rls"]
                    }
                }
                
                # Log comprehensive results
                if has_any_security:
                    logger.info(f"✅ {table_name} has comprehensive security filtering:")
                    if filtering_analysis["has_user_subsidiary_filtering"]:
                        logger.info(f"  🏢 User/Subsidiary level security detected")
                    if filtering_analysis["has_subregion_filtering"]:
                        logger.info(f"  🌍 Subregion level security detected")
                    if filtering_analysis["has_seller_assignment_filtering"]:
                        logger.info(f"  👤 Seller assignment security detected")
                    if filtering_analysis["has_account_level_filtering"]:
                        logger.info(f"  🏪 Account level security detected")
                else:
                    logger.warning(f"⚠️ {table_name} lacks proper security filtering despite having {security_roles_info['total_roles']} security roles")
                
                return result
                
            except Exception as e:
                logger.error(f"Comprehensive security filtering analysis failed for {table_name}: {e}")
                return {
                    "has_security_filtering": False,
                    "security_status": "ERROR",
                    "error": str(e),
                    "security_analysis": None,
                    "filtering_analysis": None
                }
        
        def check_seller_assignment_ids(columns: List[str]) -> Dict[str, Any]:
            """Check for Account, TPID, TP Account ID, MSSales ID columns"""
            id_columns = []
            column_types = {}
            
            for column in columns:
                col_lower = column.lower()
                if any(term in col_lower for term in ['account', 'tpid', 'tp account id', 'mssales id', 'seller']):
                    id_columns.append(column)
                    # Categorize the type
                    if 'account' in col_lower:
                        column_types[column] = 'Account'
                    elif 'tpid' in col_lower:
                        column_types[column] = 'TPID'
                    elif 'mssales' in col_lower:
                        column_types[column] = 'MSSales ID'
                    elif 'seller' in col_lower:
                        column_types[column] = 'Seller'
            
            return {
                "has_id_columns": len(id_columns) > 0,
                "id_columns": id_columns,
                "column_types": column_types,
                "id_count": len(id_columns)
            }
        
        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"security_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing services")
            logger.info("🔐 Starting security compliance evaluation...")
            
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Tabular editor not connected"}
            
            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "AI client not available for security analysis"}
            
            # Get all tables from the model
            all_tables = self.tabular_editor.list_tables()
            total_tables = len(all_tables)
            
            if total_tables == 0:
                ui_tracker.add_error("No tables found in semantic model", "data_error")
                return {"error": "No tables found in the semantic model"}
            
            logger.info(f"📊 Analyzing {total_tables} tables for security compliance")
            
            # Extract workspace and dataset information for context and file naming
            try:
                actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
            except:
                actual_dataset_id = 'Unknown'
                actual_workspace_id = 'Unknown'
            
            # Create workspace information structure for context and CSV generation
            workspace_info = {
                "WorkspaceID": actual_workspace_id,
                "WorkspaceName": getattr(self.tabular_editor, 'current_workspace', 'Unknown'),
                "DatasetID": actual_dataset_id,
                "DatasetName": getattr(self.tabular_editor, 'current_database', 'Unknown')
            }
            
            # ================================================================================================
            # PHASE 2: SECURITY ROLES ANALYSIS
            # ================================================================================================
            # Perform comprehensive global security analysis once at the beginning
            
            ui_tracker.set_phase("Security Roles Analysis", "Analyzing global security configuration and roles")
            logger.info("🔐 Step 1: Comprehensive security roles analysis...")
            security_roles_info = self.tabular_editor.get_security_roles_info()
            
            # Get sample data from all security tables for AI analysis
            security_tables_data = {}
            if security_roles_info.get("has_security_roles", False):
                rls_tables = security_roles_info.get("tables_with_rls", [])
                logger.info(f"📊 Getting sample data from {len(rls_tables)} security tables")
                
                for sec_table in rls_tables:
                    try:
                        sample_data = get_table_sample_data(sec_table, 15)
                        if sample_data:
                            security_tables_data[sec_table] = sample_data
                            logger.info(f"📋 Got {len(sample_data)} sample rows from security table: {sec_table}")
                    except Exception as e:
                        logger.debug(f"Could not get sample data from {sec_table}: {e}")
                
                # Perform AI analysis of security tables ONCE
                logger.info("🤖 Analyzing security tables with AI...")
                global_security_analysis = analyze_security_tables_with_ai(ai_client, security_roles_info, security_tables_data)
                logger.info(f"✅ Global security analysis finished")
            else:
                logger.warning("❌ No security roles found in the model")
                global_security_analysis = {"has_security_roles": False}
            
            # ================================================================================================
            # PHASE 3: DATA COLLECTION & PREPARATION
            # ================================================================================================
            # Initialize scoring variables and result storage containers
            
            ui_tracker.set_phase("Data Collection & Preparation", "Initializing analysis containers and preparing data structures")
            
            # Initialize scoring for the three security rules
            rule1_total_score = 0.0  # Sensitive Data Detection (max 0.3)
            rule2_total_score = 0.0  # Security Role Validation (max 0.4)
            rule3_total_score = 0.0  # Seller Assignment Cross-Check (max 0.3)
            
            # Analysis results storage containers
            sensitive_data_results = []
            financial_data_results = []
            security_compliance_results = []
            account_linkage_results = []
            
            logger.info(f"📊 Prepared analysis containers for {total_tables} tables")
            
            # ================================================================================================
            # PHASE 4: AI BATCH PROCESSING
            # ================================================================================================
            # Process tables in batches with AI analysis for comprehensive security evaluation
            
            ui_tracker.set_phase("AI Batch Processing", "Analyzing tables with GPT-4o for security compliance")
            
            # Configure batch processing parameters (one table per batch for granular progress)
            batch_size = 1  # One table per batch for granular progress tracking
            total_batches = len(all_tables)
            
            logger.info(f"🛡️ Starting security analysis of {total_tables} tables in batches of {batch_size}")
            
            # Initialize table completion tracking
            self._completed_tables = set()
            
            # Start analysis tracking with comprehensive information
            ui_tracker.start_analysis(
                analysis_name="AI-Powered Security Compliance Analysis",
                total_items=total_tables,
                total_batches=total_batches
            )
            
            # Create batch progress tracker for detailed batch management
            batch_tracker = create_batch_tracker(ui_tracker, batch_size)
            
            # Process tables in AI batches for detailed progress tracking
            for i in range(0, len(all_tables), batch_size):
                batch_start = i
                batch_end = min(i + batch_size, len(all_tables))
                batch_tables = all_tables[batch_start:batch_end]
                current_batch = (batch_start // batch_size) + 1
                
                # Check for user cancellation before each batch
                if self._check_cancellation(f"Security analysis batch {current_batch}"):
                    ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                    break
                
                # Start batch processing with detailed tracking
                batch_tracker.start_batch(current_batch, total_batches, [{"table_name": t} for t in batch_tables])
                
                # Log batch processing message for UI parsing (specific pattern required by UI regex)
                logger.info(f"🛡️ Security analyzing batch {current_batch} of {total_batches} ({len(batch_tables)} tables)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Processing security batch {current_batch} of {total_batches}",
                    current=current_batch,
                    total=total_batches
                )
                
                # Process each table in the current batch
                batch_results = []
                for table_name in batch_tables:
                    try:
                        # Update progress for individual table processing
                        ui_tracker.update_progress(
                            f"Analyzing table {table_name} for security compliance",
                            current=current_batch,
                            total=total_batches,
                            table_name=table_name
                        )
                    
                        # Get table columns and sample data
                        columns = self.tabular_editor.list_table_columns(table_name)
                        sample_data = get_table_sample_data(table_name, 10)
                        
                        table_data = {
                            "table_name": table_name,
                            "columns": columns,
                            "sample_data": sample_data
                        }
                        
                        # COMBINED AI ANALYSIS: Sensitive Data + Financial Data Detection
                        combined_analysis = analyze_table_data_with_ai(ai_client, table_data)
                        
                        # Extract sensitive data analysis (RULE 1)
                        sensitive_analysis = combined_analysis["sensitive_data_analysis"]
                        sensitive_data_results.append({
                            "table_name": table_name,
                            "analysis": sensitive_analysis
                        })
                        
                        # Set Rule 1 to zero if sensitive data found
                        if sensitive_analysis["has_sensitive_data"]:
                            rule1_total_score = -rule1_max_score  # Sensitive data found - no score
                            logger.info(f"🚨 Sensitive data detected in {table_name}: {sensitive_analysis['sensitivity_type']} (penalty: -{penalty:.3f})")
                        
                        # Extract financial data analysis (RULE 2)
                        financial_analysis = combined_analysis["financial_data_analysis"]
                        financial_data_results.append({
                            "table_name": table_name,
                            "analysis": financial_analysis
                        })
                        
                        # Store account linkage analysis for Rule 3 processing later
                        if financial_analysis["has_financial_data"]:
                            account_linkage = combined_analysis.get("account_linkage_analysis", {})
                            account_linkage_results.append({
                                "table_name": table_name,
                                "has_financial_data": True,
                                "account_linkage": account_linkage
                            })
                        
                        # Track table completion for batch statistics
                        self._completed_tables.add(table_name)
                        batch_results.append({
                            "table_name": table_name,
                            "processed": True,
                            "analysis_completed": True
                        })
                    
                    except Exception as e:
                        logger.error(f"Error analyzing table {table_name}: {e}")
                        batch_results.append({
                            "table_name": table_name,
                            "processed": False,
                            "error": str(e)
                        })
                        continue
                
                # Complete batch processing with comprehensive statistics
                batch_tracker.complete_batch(
                    batch_number=current_batch,
                    total_batches=total_batches,
                    processing_results=batch_results
                )
            
            # ================================================================================================
            # PHASE 5: SCORING & CATEGORIZATION
            # ================================================================================================
            # Process AI responses and calculate security compliance scores based on the three rules
            
            ui_tracker.set_phase("Scoring & Categorization", "Processing security rules and calculating compliance scores")
            
            # ===== RULE 2 & RULE 3 PROCESSING: Security Table → Filtering Paths → Financial Tables =====
            logger.info("🔐 Step 2: Processing Rule 2 (MSSales Security) and Rule 3 (Seller Assignment Security)")
            
            # Get financial tables list for Rule 2 and 3 verification
            financial_tables = [r["table_name"] for r in financial_data_results if r["analysis"]["has_financial_data"]]
            logger.info(f"📊 Found {len(financial_tables)} financial tables: {financial_tables}")
            
            # RULE 2: MSSales Security Check (User + Subsidiary/Subregion/Geo)
            logger.info("🏢 Rule 2: Checking MSSales security filtering (User + Subsidiary/Subregion/Geo)")
            mssales_security_tables = []
            mssales_filterable_tables = []
            
            if global_security_analysis.get("has_security_roles", False):
                # Find security tables with user+subsidiary/subregion/geo patterns
                for sec_type in global_security_analysis.get("security_table_types", []):
                    if sec_type["type"] in ["user_subsidiary", "subregion"]:
                        mssales_security_tables.extend(sec_type.get("tables_involved", []))
                
                # Remove duplicates
                mssales_security_tables = list(set(mssales_security_tables))
                logger.info(f"🔍 Found {len(mssales_security_tables)} MSSales security tables: {mssales_security_tables}")
                
                # For each MSSales security table, get filtering paths and check if financial tables are in targets
                for sec_table in mssales_security_tables:
                    try:
                        filtering_paths = self.tabular_editor.analyze_table_filtering_paths(sec_table)
                        if not filtering_paths.empty:
                            target_tables = filtering_paths['TargetTable'].tolist()
                            # Check which financial tables can be filtered from this security table
                            protected_financial_tables = [ft for ft in financial_tables if ft in target_tables]
                            mssales_filterable_tables.extend(protected_financial_tables)
                            
                            if protected_financial_tables:
                                logger.info(f"✅ Security table {sec_table} can filter financial tables: {protected_financial_tables}")
                            else:
                                logger.warning(f"⚠️ Security table {sec_table} cannot filter any financial tables")
                    except Exception as e:
                        logger.error(f"Error analyzing filtering paths for {sec_table}: {e}")
                
                # Remove duplicates from mssales_filterable_tables
                mssales_filterable_tables = list(set(mssales_filterable_tables))
                
                # Rule 2 Scoring: 0.4 points per financial table that can be filtered by MSSales security
                for financial_table in financial_tables:
                    if financial_table in mssales_filterable_tables:
                        rule2_total_score += 0.4
                        logger.info(f"✅ Rule 2: {financial_table} is protected by MSSales security (+0.4 points)")
                    else:
                        penalty = 0.4  # STRICT penalty for unprotected financial tables
                        rule2_total_score -= penalty
                        logger.error(f"🚨 Rule 2: {financial_table} is NOT protected by MSSales security (penalty: -{penalty:.3f})")
                
                # Create security compliance results for each financial table
                for financial_table in financial_tables:
                    is_protected = financial_table in mssales_filterable_tables
                    security_compliance_results.append({
                        "table_name": financial_table,
                        "security_check": {
                            "has_security_filtering": is_protected,
                            "filtering_analysis": {
                                "has_user_subsidiary_filtering": is_protected,
                                "has_subregion_filtering": False,
                                "has_seller_assignment_filtering": False,
                                "has_account_level_filtering": False
                            }
                        }
                    })
            else:
                # No security roles - apply maximum penalty
                penalty = 0.4 * len(financial_tables)
                rule2_total_score -= penalty
                logger.error(f"🚨 Rule 2: No security roles defined - All {len(financial_tables)} financial tables are unprotected (penalty: -{penalty:.3f})")
                
                # Create security compliance results for each financial table (all unprotected)
                for financial_table in financial_tables:
                    security_compliance_results.append({
                        "table_name": financial_table,
                        "security_check": {
                            "has_security_filtering": False,
                            "filtering_analysis": {
                                "has_user_subsidiary_filtering": False,
                                "has_subregion_filtering": False,
                                "has_seller_assignment_filtering": False,
                                "has_account_level_filtering": False
                            }
                        }
                    })
            
            # RULE 3: Account Linkage Security Check (following Rule 2 pattern)
            logger.info("👤 Rule 3: Checking Account Linkage in Financial Tables")
            
            # Rule 3 Scoring: Binary scoring based on account linkage presence in financial tables
            for financial_table in financial_tables:
                # Find account linkage info for this financial table
                table_account_info = None
                for result in account_linkage_results:
                    if result["table_name"] == financial_table:
                        table_account_info = result["account_linkage"]
                        break
                
                # Update security_compliance_results with account linkage info
                for security_result in security_compliance_results:
                    if security_result["table_name"] == financial_table:
                        has_account_columns = table_account_info.get("has_account_columns", False) if table_account_info else False
                        security_result["security_check"]["filtering_analysis"]["has_account_level_filtering"] = has_account_columns
                        
                        # Add detailed account column information
                        if table_account_info:
                            security_result["security_check"]["account_linkage_details"] = {
                                "account_columns": table_account_info.get("account_columns", []),
                                "tpid_columns": table_account_info.get("tpid_columns", []),
                                "mssales_id_columns": table_account_info.get("mssales_id_columns", []),
                                "seller_columns": table_account_info.get("seller_columns", []),
                                "linkage_quality": table_account_info.get("linkage_quality", "None")
                            }
                        break
                
                # Binary scoring: Either 0.3 points or 0 points (no gradients)
                if table_account_info and table_account_info.get("has_account_columns", False):
                    # Financial table HAS account linkage - award full points
                    points = 0.3
                    rule3_total_score += points
                    
                    account_cols = table_account_info.get("account_columns", [])
                    tpid_cols = table_account_info.get("tpid_columns", [])
                    mssales_cols = table_account_info.get("mssales_id_columns", [])
                    seller_cols = table_account_info.get("seller_columns", [])
                    
                    logger.info(f"✅ Rule 3: {financial_table} has account linkage (+{points:.3f} points)")
                    logger.info(f"    📋 Account columns: {account_cols}")
                    logger.info(f"    📋 TPID columns: {tpid_cols}")
                    logger.info(f"    📋 MSSales ID columns: {mssales_cols}")
                    logger.info(f"    📋 Seller columns: {seller_cols}")
                    logger.info(f"    📋 Linkage quality: {table_account_info.get('linkage_quality', 'None')}")
                else:
                    # Financial table has NO account linkage - score is 0
                    logger.error(f"🚨 Rule 3: {financial_table} has financial data but NO account linkage (score: 0)")
                    # No penalty applied - just no points awarded (score remains 0 for this table)
            
            # Calculate DYNAMIC maximum scores based on number of financial tables found
            financial_tables_count = len([r for r in financial_data_results if r["analysis"]["has_financial_data"]])
            
            # DYNAMIC SCORING SYSTEM as per your original requirements:
            rule1_max_score = 0.3  # Fixed: Sensitive Data Detection (starts with 0.3, applies penalties)
            rule2_max_score = 0.4 * max(1, financial_tables_count)  # Dynamic: Security Role Validation (0.4 per financial table)
            rule3_max_score = 0.3 * max(1, financial_tables_count)  # Dynamic: Account Linkage Check (0.3 per financial table)
            
            # Apply base scores and limits with DYNAMIC maximum scores
            rule1_final_score = max(0.0, min(rule1_max_score, rule1_max_score + rule1_total_score))  # Start with 0.3, apply penalties
            rule2_final_score = max(0.0, min(rule2_max_score, rule2_total_score))  # Dynamic maximum based on financial tables
            rule3_final_score = max(0.0, min(rule3_max_score, rule3_total_score))  # Dynamic maximum based on financial tables
            
            # Calculate overall security compliance score with DYNAMIC maximum
            overall_security_score = rule1_final_score + rule2_final_score + rule3_final_score
            max_possible_score = rule1_max_score + rule2_max_score + rule3_max_score  # DYNAMIC maximum score
            compliance_percentage = round((overall_security_score / max_possible_score) * 100, 1) if max_possible_score > 0 else 0.0
            
            logger.info(f"🔢 DYNAMIC SCORING: Financial tables found: {financial_tables_count}")
            logger.info(f"🔢 Rule 1 Max: {rule1_max_score} | Rule 2 Max: {rule2_max_score} | Rule 3 Max: {rule3_max_score}")
            logger.info(f"🔢 Total Dynamic Maximum Score: {max_possible_score}")
            
            # Generate summary
            sensitive_tables_count = len([r for r in sensitive_data_results if r["analysis"]["has_sensitive_data"]])
            financial_tables_count = len([r for r in financial_data_results if r["analysis"]["has_financial_data"]])
            protected_financial_tables = len([r for r in security_compliance_results if r["security_check"]["has_security_filtering"]])
            
            # Account linkage summary
            financial_tables_with_account_linkage = len([r for r in account_linkage_results if r["has_financial_data"] and r["account_linkage"].get("has_account_columns", False)])
            excellent_linkage_tables = len([r for r in account_linkage_results if r.get("account_linkage", {}).get("linkage_quality") == "Excellent"])
            poor_linkage_tables = len([r for r in account_linkage_results if r.get("account_linkage", {}).get("linkage_quality") in ["Poor", "None"]])
            
            # Comprehensive security analysis summary
            security_type_counts = {
                "user_subsidiary": 0,
                "subregion": 0,
                "seller_assignment": 0,
                "account_level": 0
            }
            
            for result_item in security_compliance_results:
                filtering_analysis = result_item["security_check"].get("filtering_analysis", {})
                if filtering_analysis.get("has_user_subsidiary_filtering", False):
                    security_type_counts["user_subsidiary"] += 1
                if filtering_analysis.get("has_subregion_filtering", False):
                    security_type_counts["subregion"] += 1
                if filtering_analysis.get("has_seller_assignment_filtering", False):
                    security_type_counts["seller_assignment"] += 1
                if filtering_analysis.get("has_account_level_filtering", False):
                    security_type_counts["account_level"] += 1
            
            result = {
                "analysis_type": "security_compliance",
                "timestamp": datetime.now().isoformat(),
                "overall_security_score": round(overall_security_score, 3),
                "max_possible_score": max_possible_score,
                "compliance_percentage": compliance_percentage,
                "rule_scores": {
                    "rule1_sensitive_data": {
                        "score": round(rule1_final_score, 3),
                        "max_score": round(rule1_max_score, 3),
                        "description": "S-001: Data Encryption for PII (0.3 points - data has to be encrypted for table columns having PII data)"
                    },
                    "rule2_security_roles": {
                        "score": round(rule2_final_score, 3),
                        "max_score": round(rule2_max_score, 3),
                        "description": f"S-002: MS Sales RLS for Financial Data (0.4 × {financial_tables_count} financial tables - RLS for revenue, ACR, Consumption, Baseline, targets, budgets)"
                    },
                    "rule3_account_linkage": {
                        "score": round(rule3_final_score, 3),
                        "max_score": round(rule3_max_score, 3),
                        "description": f"S-003: Account Assignments RLS (0.3 × {financial_tables_count} financial tables - RLS for revenue, ACR, targets)"
                    }
                },
                "summary": {
                    "total_tables_analyzed": total_tables,
                    "sensitive_tables_found": sensitive_tables_count,
                    "financial_tables_found": financial_tables_count,
                    "protected_financial_tables": protected_financial_tables,
                    "financial_tables_with_account_linkage": financial_tables_with_account_linkage,
                    "excellent_linkage_tables": excellent_linkage_tables,
                    "poor_linkage_tables": poor_linkage_tables,
                    "compliance_level": "Critical" if compliance_percentage < 50 else "Warning" if compliance_percentage < 75 else "Good",
                    "security_roles_summary": {
                        "total_security_roles": security_roles_info.get("total_roles", 0),
                        "tables_with_rls": security_roles_info.get("rls_coverage", 0),
                        "rls_table_names": security_roles_info.get("tables_with_rls", [])
                    },
                    "security_type_coverage": {
                        "user_subsidiary_tables": security_type_counts["user_subsidiary"],
                        "subregion_tables": security_type_counts["subregion"],
                        "seller_assignment_tables": security_type_counts["seller_assignment"],
                        "account_level_tables": security_type_counts["account_level"]
                    }
                },
                "detailed_results": {
                    "global_security_analysis": global_security_analysis,
                    "security_roles_info": security_roles_info,
                    "sensitive_data_analysis": sensitive_data_results,
                    "financial_data_analysis": financial_data_results,
                    "security_compliance_analysis": security_compliance_results,
                    "account_linkage_analysis": account_linkage_results
                },
                "recommendations": []
            }
            
            # ================================================================================================
            # ================================================================================================
            # CRITICAL: GENERATE TABLE-LEVEL SEVERITY COUNTS FOR UI CONSISTENCY 
            # ================================================================================================
            # Replace system-level issue counting with table-level severity counting to match CSV
            
            # Initialize table-level severity counters
            table_critical_count = 0
            table_issue_count = 0  
            table_warning_count = 0
            table_good_count = 0
            
            # Create comprehensive issue messages for UI display (keeping original messages)
            critical_issues = []
            issue_issues = []  # Medium severity issues
            warning_issues = []
            
            # Count table-level severities using the same logic as CSV generation
            logger.info("🔧 DIRECT APPROACH: Counting table-level severities for UI consistency")
            
            # Create lookup dictionaries from analysis results 
            sensitive_lookup = {item["table_name"]: item.get("analysis", {}) for item in sensitive_data_results if isinstance(item, dict)}
            financial_lookup = {item["table_name"]: item.get("analysis", {}) for item in financial_data_results if isinstance(item, dict)}
            account_lookup = {item["table_name"]: item.get("account_linkage", {}) for item in account_linkage_results if isinstance(item, dict)}
            security_lookup = {item["table_name"]: item for item in security_compliance_results if isinstance(item, dict)}
            
            # Get all analyzed tables
            all_analyzed_tables = set()
            all_analyzed_tables.update(sensitive_lookup.keys())
            all_analyzed_tables.update(financial_lookup.keys())
            all_analyzed_tables.update(account_lookup.keys())
            all_analyzed_tables.update(security_lookup.keys())
            
            # Count severity for each table using exact CSV logic
            for table_name in all_analyzed_tables:
                # Get data for this table from lookups
                table_data = sensitive_lookup.get(table_name, {})
                financial_data = financial_lookup.get(table_name, {})
                security_data = security_lookup.get(table_name, {})
                account_data = account_lookup.get(table_name, {})
                
                # Calculate table scores using exact CSV logic
                table_rule1_score = 0.0 if table_data.get("has_sensitive_data", False) else 0.3
                table_rule2_max = 0.4 if financial_data.get("has_financial_data", False) else 0.0
                table_rule2_score = 0.0
                if financial_data.get("has_financial_data", False):
                    security_check = security_data.get("security_check", {})
                    if security_check.get("has_security_filtering", False):
                        table_rule2_score = table_rule2_max
                
                is_financial = financial_data.get("has_financial_data", False)
                has_account_columns = account_data.get("has_account_columns", False)
                table_rule3_max = 0.3 if is_financial and has_account_columns else 0.0
                table_rule3_score = 0.3 if is_financial and has_account_columns else 0.0
                
                table_overall_score = table_rule1_score + table_rule2_score + table_rule3_score
                table_max_score = 0.3 + table_rule2_max + table_rule3_max
                
                # Determine severity using exact CSV logic
                score_percentage = (table_overall_score / table_max_score) if table_max_score > 0 else 1.0
                
                if score_percentage < 0.30:
                    table_critical_count += 1
                    critical_issues.append(f"Table '{table_name}' has critical security issues (score: {score_percentage:.1%})")
                elif score_percentage < 0.50:
                    table_issue_count += 1
                    issue_issues.append(f"Table '{table_name}' has security issues requiring attention (score: {score_percentage:.1%})")
                elif score_percentage < 0.75:
                    table_warning_count += 1
                    warning_issues.append(f"Table '{table_name}' has security warnings (score: {score_percentage:.1%})")
                else:
                    table_good_count += 1
            
            # Add original system-level recommendations for context
            logger.info(f"📊 TABLE SEVERITY COUNTS: Critical={table_critical_count}, Issues={table_issue_count}, Warnings={table_warning_count}, Good={table_good_count}")
            
            # ================================================================================================
            # PLACEHOLDER: RULE-SCORE-BASED RECOMMENDATIONS MOVED TO AFTER CSV GENERATION
            # ================================================================================================
            # Recommendations will be generated after CSV analysis results are available
            
            
            # Add the detailed_issues structure that the UI expects
            result["detailed_issues"] = {
                "critical": critical_issues,
                "issue": issue_issues,
                "warning": warning_issues
            }
            
            # ================================================================================================
            # USE TABLE-LEVEL SEVERITY COUNTS FOR UI (NOT SYSTEM MESSAGE COUNTS)
            # ================================================================================================
            # Use table-level severity counts instead of system-level message counts for consistency
            
            table_level_issue_counts = {
                "critical_issues": table_critical_count,     # Count of CRITICAL severity tables
                "issue_issues": table_issue_count,           # Count of ISSUE severity tables
                "warning_issues": table_warning_count,       # Count of WARNING severity tables  
                "total_issues": table_critical_count + table_issue_count + table_warning_count
            }
            
            # Add to summary
            result["summary"].update(table_level_issue_counts)
            
            # Add to top level for UI compatibility (like other analysis functions)
            result.update(table_level_issue_counts)
            
            logger.info(f"✅ DIRECT FIX: UI now uses table-level severity counts - Critical: {table_critical_count}, Issues: {table_issue_count}, Warnings: {table_warning_count}")
            logger.info(f"✅ Total tables analyzed: {len(all_analyzed_tables)} (Critical: {table_critical_count}, Issues: {table_issue_count}, Warnings: {table_warning_count}, Good: {table_good_count})")
            
            logger.info(f"🔍 Generated detailed issues for security compliance: {len(critical_issues)} critical, {len(issue_issues)} issues, {len(warning_issues)} warnings")
            
            logger.info(f"🔐 Security compliance evaluation finished: {compliance_percentage}% compliant")
            
            # ================================================================================================
            # PHASE 6: CSV GENERATION & STORAGE
            # ================================================================================================
            # Create downloadable CSV file and save to KnowledgeBase folder for persistence
            
            ui_tracker.set_phase("Excel Generation & Storage", "Creating downloadable Excel files and persistent storage")
            
            try:
                # Create detailed table-level analysis for CSV export
                csv_analysis_results = []
                
                # Create lookup dictionaries from list structures
                sensitive_lookup = {item["table_name"]: item.get("analysis", {}) for item in sensitive_data_results if isinstance(item, dict)}
                financial_lookup = {item["table_name"]: item.get("analysis", {}) for item in financial_data_results if isinstance(item, dict)}
                account_lookup = {item["table_name"]: item.get("account_linkage", {}) for item in account_linkage_results if isinstance(item, dict)}
                security_lookup = {item["table_name"]: item for item in security_compliance_results if isinstance(item, dict)}
                
                # Get all analyzed table names
                all_analyzed_tables = set()
                all_analyzed_tables.update(sensitive_lookup.keys())
                all_analyzed_tables.update(financial_lookup.keys())
                all_analyzed_tables.update(account_lookup.keys())
                all_analyzed_tables.update(security_lookup.keys())
                
                # Process each analyzed table for CSV export
                for table_name in all_analyzed_tables:
                    # Get data for this table from lookups
                    table_data = sensitive_lookup.get(table_name, {})
                    financial_data = financial_lookup.get(table_name, {})
                    security_data = security_lookup.get(table_name, {})
                    account_data = account_lookup.get(table_name, {})
                    
                    # Calculate table-level scores based on the three rules
                    table_rule1_score = 0.0  # Sensitive data penalty
                    table_rule1_max = 0.3
                    
                    # Rule 1: Apply penalties for sensitive data
                    if table_data.get("has_sensitive_data", False):
                        table_rule1_score = 0.0
                    else:
                        table_rule1_score = table_rule1_max
                    
                    # Rule 2: Security roles and data access (per table)
                    table_rule2_score = 0.0
                    table_rule2_max = 0.4 if financial_data.get("has_financial_data", False) else 0.0
                    
                    if financial_data.get("has_financial_data", False):
                        # Fix: Access has_security_filtering from nested security_check structure
                        security_check = security_data.get("security_check", {})
                        security_filtering = security_check.get("has_security_filtering", False)
                        if security_filtering:
                            table_rule2_score = table_rule2_max
                    
                    # Rule 3: Account linkage detection (per table) - BINARY SCORING
                    table_rule3_score = 0.0
                    
                    # Max score is 0.3 ONLY if it's a financial table AND has account columns
                    # If it's financial but has no account columns, max score is 0
                    is_financial = financial_data.get("has_financial_data", False)
                    has_account_columns = account_data.get("has_account_columns", False)
                    
                    if is_financial and has_account_columns:
                        # Financial table WITH account linkage - can earn 0.3 points
                        table_rule3_max = 0.3
                        table_rule3_score = 0.3
                    elif is_financial and not has_account_columns:
                        # Financial table WITHOUT account linkage - max score is 0 (not applicable)
                        table_rule3_max = 0.0
                        table_rule3_score = 0.0
                    else:
                        # Non-financial table - not applicable
                        table_rule3_max = 0.0
                        table_rule3_score = 0.0
                    
                    # Calculate overall table score and severity
                    table_overall_score = table_rule1_score + table_rule2_score + table_rule3_score
                    table_max_score = table_rule1_max + table_rule2_max + table_rule3_max
                    
                    # Determine table severity level based on score percentage
                    score_percentage = (table_overall_score / table_max_score) if table_max_score > 0 else 1.0
                    
                    if score_percentage < 0.30:
                        issue_severity = "CRITICAL"
                        severity_priority = 1
                        severity_color = "RED"
                        severity_hex = "#FF0000"
                    elif score_percentage < 0.50:
                        issue_severity = "ISSUE"
                        severity_priority = 2
                        severity_color = "ORANGE"
                        severity_hex = "#FFA500"
                    elif score_percentage < 0.75:
                        issue_severity = "WARNING"
                        severity_priority = 3
                        severity_color = "YELLOW"
                        severity_hex = "#FFFF00"
                    else:
                        issue_severity = "GOOD"
                        severity_priority = 4
                        severity_color = "GREEN"
                        severity_hex = "#00FF00"
                    
                    # Build comprehensive CSV entry
                    csv_entry = {
                        "Table_Name": table_name,
                        "Has_Sensitive_Data": "YES" if table_data.get("has_sensitive_data", False) else "NO",
                        "Sensitive_Data_Type": table_data.get("sensitivity_type", "None"),
                        "Sensitive_Columns": ", ".join(table_data.get("sensitive_columns", [])),
                        "Issue_Severity": issue_severity,
                        "Has_Financial_Data": "YES" if financial_data.get("has_financial_data", False) else "NO",
                        "Financial_Columns": ", ".join(financial_data.get("revenue_columns", []) + financial_data.get("target_columns", []) + financial_data.get("budget_columns", [])),
                        "Has_Security_Filtering": "YES" if security_data.get("security_check", {}).get("has_security_filtering", False) else "NO",
                        "Security_Status": security_data.get("security_status", "UNKNOWN"),
                        "Security_Types": ", ".join([f"{path['security_types'][0]['type']} ({path['security_types'][0]['confidence']:.1f})" for path in security_data.get("security_check", {}).get("filtering_analysis", {}).get("detailed_paths", []) if path.get("security_types")]),
                        "Account_Linkage_Columns": ", ".join(
                            account_data.get("account_columns", []) + 
                            account_data.get("tpid_columns", []) + 
                            account_data.get("mssales_id_columns", []) + 
                            account_data.get("seller_columns", [])
                        ) if account_data.get("has_account_columns") else "None",
                        "Account_Columns": ", ".join(account_data.get("account_columns", [])),
                        "TPID_Columns": ", ".join(account_data.get("tpid_columns", [])),
                        "MSSales_ID_Columns": ", ".join(account_data.get("mssales_id_columns", [])),
                        "Seller_Columns": ", ".join(account_data.get("seller_columns", [])),
                        "Account_Linkage_Quality": account_data.get("linkage_quality", "None"),
                        "Sensitive_Data_Score": round(table_rule1_score, 3),
                        "Sensitive_Data_Max_Score": round(table_rule1_max, 3),
                        "Security_Roles_Score": round(table_rule2_score, 3),
                        "Security_Roles_Max_Score": round(table_rule2_max, 3),
                        "Seller_Assignment_Score": round(table_rule3_score, 3),
                        "Seller_Assignment_Max_Score": round(table_rule3_max, 3),
                        "Overall_Score": round(table_overall_score, 3),
                        "Max_Score": round(table_max_score, 3),
                        "Score_Percentage": round(score_percentage * 100, 1),
                        "Compliance_Level": "Compliant" if score_percentage >= 0.75 else "Non-Compliant",
                        "Severity_Priority": severity_priority,
                        "Severity_Color": severity_color,
                        "Severity_Hex_Color": severity_hex,
                        "Recommendations": self._generate_table_security_recommendation(
                            table_data, 
                            financial_data, 
                            security_data, 
                            account_data,
                            rule_scores={
                                "rule1_score": table_rule1_score,
                                "rule1_max": table_rule1_max,
                                "rule2_score": table_rule2_score,
                                "rule2_max": table_rule2_max,
                                "rule3_score": table_rule3_score,
                                "rule3_max": table_rule3_max
                            }
                        )
                    }
                    
                    csv_analysis_results.append(csv_entry)
                
                # Generate CSV file with same pattern as dataset_columns_analysis
                if csv_analysis_results:
                    import io
                    import os
                    
                    # Convert analysis results to DataFrame for CSV generation
                    df = pd.DataFrame(csv_analysis_results)
                    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                    
                    # Extract workspace and dataset information
                    try:
                        actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                        actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
                        workspace_name = self._sanitize_filename(getattr(self.tabular_editor, 'current_workspace', 'Unknown').replace(" ", ""))
                        dataset_name = self._sanitize_filename(getattr(self.tabular_editor, 'current_database', 'Unknown').replace(" ", ""))
                    except:
                        workspace_name = "Unknown"
                        dataset_name = "Unknown"
                    
                    # Generate timestamped filename
                    csv_filename = f"AI_Security_Compliance_Analysis_{workspace_name}_{dataset_name}_{timestamp}.csv"
                    
                    # Remove specific severity visual columns from Excel export (keep in analysis for UI)
                    columns_to_exclude_from_excel = ['Severity_Priority', 'Severity_Color', 'Severity_Hex_Color']
                    excel_df = df.drop(columns=[col for col in columns_to_exclude_from_excel if col in df.columns])
                    
                    # Create Excel file with color formatting for Issue_Severity column
                    excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(excel_df, csv_filename, 'Issue_Severity')
                    
                    if excel_content and excel_filename and csv_text_content:
                        # Save Excel file to KnowledgeBase folder
                        excel_file_path = self._save_excel_file(excel_content, excel_filename)
                        logger.info(f"✅ Generated security compliance Excel file: {excel_file_path}")
                        
                        # Add Excel information to result
                        result["csv_filename"] = excel_filename
                        result["csv_file_path"] = excel_file_path
                        result["csv_content"] = csv_text_content     # CSV text for UI parsing
                        result["excel_content"] = excel_content     # Excel binary for download
                        result["csv_analysis_results"] = csv_analysis_results
                    else:
                        logger.error("❌ Failed to generate Excel file")
                        result["csv_generation_error"] = "Failed to generate Excel file - check logs for details"
                    
                    # ================================================================================================
                    # PHASE 7: STATISTICAL ANALYSIS
                    # ================================================================================================
                    # Calculate comprehensive summary statistics and generate insights
                    
                    ui_tracker.set_phase("Statistical Analysis", "Computing comprehensive summary statistics and insights")
                    
                    # Calculate comprehensive summary statistics
                    total_csv_tables = len(csv_analysis_results)
                    
                    # Severity distribution from CSV data
                    csv_severity_counts = {
                        "CRITICAL": sum(1 for r in csv_analysis_results if r["Issue_Severity"] == "CRITICAL"),
                        "ISSUE": sum(1 for r in csv_analysis_results if r["Issue_Severity"] == "ISSUE"), 
                        "WARNING": sum(1 for r in csv_analysis_results if r["Issue_Severity"] == "WARNING"),
                        "GOOD": sum(1 for r in csv_analysis_results if r["Issue_Severity"] == "GOOD")
                    }
                    
                    # ================================================================================================
                    # CRITICAL FIX: OVERRIDE UI ISSUE COUNTS WITH CSV TABLE-LEVEL SEVERITY COUNTS
                    # ================================================================================================
                    # Replace system-level issue counts with table-level severity counts for UI/CSV consistency
                    
                    logger.info(f"🔧 CONSISTENCY FIX: Overriding UI issue counts with CSV table-level severity")
                    logger.info(f"📊 CSV Severity Counts - Critical: {csv_severity_counts['CRITICAL']}, Issue: {csv_severity_counts['ISSUE']}, Warning: {csv_severity_counts['WARNING']}, Good: {csv_severity_counts['GOOD']}")
                    
                    # Create consistent issue counts based on CSV table-level severity
                    consistent_issue_counts = {
                        "critical_issues": csv_severity_counts["CRITICAL"],
                        "issue_issues": csv_severity_counts["ISSUE"], 
                        "warning_issues": csv_severity_counts["WARNING"],
                        "total_issues": csv_severity_counts["CRITICAL"] + csv_severity_counts["ISSUE"] + csv_severity_counts["WARNING"]
                    }
                    
                    # Override the previously set issue counts in both summary and top-level result
                    result["summary"].update(consistent_issue_counts)
                    result.update(consistent_issue_counts)
                    
                    # Add CSV severity distribution to result for debugging/reference
                    result["csv_severity_distribution"] = csv_severity_counts
                    
                    logger.info(f"✅ Updated UI issue counts to match CSV: Critical={csv_severity_counts['CRITICAL']}, Issues={csv_severity_counts['ISSUE']}, Warnings={csv_severity_counts['WARNING']}")
                    
                    # Verify the override worked
                    logger.info(f"🔍 Final result counts - critical_issues: {result.get('critical_issues')}, issue_issues: {result.get('issue_issues')}, warning_issues: {result.get('warning_issues')}")
                    
                    # Calculate average scores across all tables
                    if total_csv_tables > 0:
                        avg_rule1_score = sum(r["Sensitive_Data_Score"] for r in csv_analysis_results) / total_csv_tables
                        avg_rule2_score = sum(r["Security_Roles_Score"] for r in csv_analysis_results) / total_csv_tables
                        avg_rule3_score = sum(r["Seller_Assignment_Score"] for r in csv_analysis_results) / total_csv_tables
                        avg_overall_score = sum(r["Overall_Score"] for r in csv_analysis_results) / total_csv_tables
                        avg_score_percentage = sum(r["Score_Percentage"] for r in csv_analysis_results) / total_csv_tables
                        
                        # Count tables meeting quality thresholds (75% of max for each rule)
                        good_rule1_tables = sum(1 for r in csv_analysis_results if r["Sensitive_Data_Score"] >= r["Sensitive_Data_Max_Score"] * 0.75)
                        good_rule2_tables = sum(1 for r in csv_analysis_results if r["Security_Roles_Score"] >= r["Security_Roles_Max_Score"] * 0.75)
                        good_rule3_tables = sum(1 for r in csv_analysis_results if r["Seller_Assignment_Score"] >= r["Seller_Assignment_Max_Score"] * 0.75)
                        
                        # Generate key findings specific to security compliance
                        key_findings = []
                        
                        # Sensitive data findings
                        sensitive_tables = sum(1 for r in csv_analysis_results if r["Has_Sensitive_Data"] == "YES")
                        if sensitive_tables > 0:
                            sensitive_pct = round((sensitive_tables/total_csv_tables)*100, 1)
                            key_findings.append(f"{sensitive_pct}% of tables ({sensitive_tables} tables) contain sensitive data requiring enhanced security controls")
                        
                        # Financial data findings
                        financial_tables = sum(1 for r in csv_analysis_results if r["Has_Financial_Data"] == "YES")
                        if financial_tables > 0:
                            financial_pct = round((financial_tables/total_csv_tables)*100, 1)
                            key_findings.append(f"{financial_pct}% of tables ({financial_tables} tables) contain financial data requiring comprehensive security protection")
                        
                        # Security filtering findings
                        protected_tables = sum(1 for r in csv_analysis_results if r["Has_Security_Filtering"] == "YES")
                        if financial_tables > protected_tables:
                            unprotected = financial_tables - protected_tables
                            unprotected_pct = round((unprotected/financial_tables)*100, 1) if financial_tables > 0 else 0
                            key_findings.append(f"{unprotected_pct}% of financial tables ({unprotected} tables) lack proper security filtering")
                        
                        # Account linkage findings
                        tables_with_linkage = sum(1 for r in csv_analysis_results if r["Account_Linkage_Quality"] not in ["None", "Poor"])
                        if financial_tables > tables_with_linkage:
                            poor_linkage = financial_tables - tables_with_linkage
                            poor_linkage_pct = round((poor_linkage/financial_tables)*100, 1) if financial_tables > 0 else 0
                            key_findings.append(f"{poor_linkage_pct}% of financial tables ({poor_linkage} tables) have poor or missing account linkage")
                        
                        # Overall compliance assessment
                        if avg_score_percentage < 40:
                            key_findings.append(f"Overall security compliance score of {avg_score_percentage:.1f}% indicates critical security vulnerabilities requiring immediate attention")
                        elif avg_score_percentage >= 75:
                            key_findings.append(f"Strong security compliance with {avg_score_percentage:.1f}% overall score, indicating good adherence to security best practices")
                        else:
                            key_findings.append(f"Moderate security compliance at {avg_score_percentage:.1f}% with significant room for improvement in security controls")
                        
                        # Generate security-specific recommendations
                        security_recommendations = []
                        
                        if csv_severity_counts["CRITICAL"] > 0:
                            security_recommendations.append(f"Address {csv_severity_counts['CRITICAL']} CRITICAL security issues immediately - these represent severe vulnerabilities")
                        
                        if sensitive_tables > 0:
                            security_recommendations.append(f"Implement data masking and access controls for {sensitive_tables} tables containing sensitive data")
                        
                        if financial_tables > protected_tables:
                            unprotected = financial_tables - protected_tables
                            security_recommendations.append(f"Configure row-level security (RLS) for {unprotected} unprotected financial tables")
                        
                        if poor_linkage > 0:
                            security_recommendations.append(f"Add Account, TPID, or MSSales ID columns to {poor_linkage} tables with poor account linkage")
                        
                        if avg_score_percentage < 60:
                            security_recommendations.append("Establish comprehensive security governance with regular audits and monitoring")
                        
                        if not key_findings:
                            key_findings.append("Security compliance meets basic standards")
                        if not security_recommendations:
                            security_recommendations.append("Maintain current security standards with regular monitoring")
                    
                    else:
                        avg_rule1_score = avg_rule2_score = avg_rule3_score = avg_overall_score = avg_score_percentage = 0
                        good_rule1_tables = good_rule2_tables = good_rule3_tables = 0
                        key_findings = ["No analysis results available"]
                        security_recommendations = ["Re-run analysis with valid data"]
                    
                    # Enhance the summary section with CSV-based statistics
                    result["summary"].update({
                        "csv_analysis": {
                            "total_tables_in_csv": total_csv_tables,
                            "severity_distribution": csv_severity_counts,
                            "average_scores": {
                                "rule1_sensitive_data": round(avg_rule1_score, 3),
                                "rule2_security_roles": round(avg_rule2_score, 3),
                                "rule3_seller_assignment": round(avg_rule3_score, 3),
                                "overall_score": round(avg_overall_score, 3),
                                "score_percentage": round(avg_score_percentage, 1)
                            },
                            "quality_thresholds_met": {
                                "rule1_good_tables": f"{good_rule1_tables}/{total_csv_tables} ({round((good_rule1_tables/total_csv_tables)*100, 1) if total_csv_tables > 0 else 0}%)",
                                "rule2_good_tables": f"{good_rule2_tables}/{total_csv_tables} ({round((good_rule2_tables/total_csv_tables)*100, 1) if total_csv_tables > 0 else 0}%)",
                                "rule3_good_tables": f"{good_rule3_tables}/{total_csv_tables} ({round((good_rule3_tables/total_csv_tables)*100, 1) if total_csv_tables > 0 else 0}%)"
                            }
                        },
                        "key_findings": key_findings,
                        "security_recommendations": security_recommendations
                    })
                    
                    # ================================================================================================
                    # RULE-SCORE-BASED RECOMMENDATIONS FOR ANALYSIS SUMMARY
                    # ================================================================================================
                    # Generate recommendations based on overall rule score percentages as requested
                    
                    logger.info(f"📊 Using {len(csv_analysis_results)} CSV analysis results for rule-score-based recommendations")
                    
                    # Calculate overall rule scores across all analyzed tables from CSV data
                    total_rule1_score = sum(r["Sensitive_Data_Score"] for r in csv_analysis_results)
                    total_rule1_max = sum(r["Sensitive_Data_Max_Score"] for r in csv_analysis_results)
                    total_rule2_score = sum(r["Security_Roles_Score"] for r in csv_analysis_results)
                    total_rule2_max = sum(r["Security_Roles_Max_Score"] for r in csv_analysis_results)
                    total_rule3_score = sum(r["Seller_Assignment_Score"] for r in csv_analysis_results)
                    total_rule3_max = sum(r["Seller_Assignment_Max_Score"] for r in csv_analysis_results)
                    
                    # Calculate overall rule percentages
                    overall_rule1_percentage = (total_rule1_score / total_rule1_max * 100) if total_rule1_max > 0 else 100
                    overall_rule2_percentage = (total_rule2_score / total_rule2_max * 100) if total_rule2_max > 0 else 100
                    overall_rule3_percentage = (total_rule3_score / total_rule3_max * 100) if total_rule3_max > 0 else 100
                    
                    logger.info(f"🔍 RULE SCORE ANALYSIS: Rule1={overall_rule1_percentage:.1f}%, Rule2={overall_rule2_percentage:.1f}%, Rule3={overall_rule3_percentage:.1f}%")
                    logger.info(f"🔍 RULE DETAILS: Rule1_score={total_rule1_score}/{total_rule1_max}, Rule2_score={total_rule2_score}/{total_rule2_max}, Rule3_score={total_rule3_score}/{total_rule3_max}")
                    
                    # Rule 1: Sensitive Data Recommendations (if overall score < 100%)
                    logger.info(f"🔍 CHECKING RULE 1: {overall_rule1_percentage:.1f}% < 100 AND {total_rule1_max} > 0 = {overall_rule1_percentage < 100 and total_rule1_max > 0}")
                    if overall_rule1_percentage < 100 and total_rule1_max > 0:
                        # Find tables with sensitive data for specific recommendations
                        sensitive_table_examples = []
                        for r in csv_analysis_results:
                            if r["Has_Sensitive_Data"] == "YES" and r["Sensitive_Columns"]:
                                sensitive_table_examples.append(f"{r['Table_Name']} ({r['Sensitive_Columns']})")
                                if len(sensitive_table_examples) >= 2:  # Limit examples
                                    break
                        
                        if sensitive_table_examples:
                            examples_text = "; ".join(sensitive_table_examples)
                            result["recommendations"].append(f"🔐 ENCRYPT sensitive data columns in tables: {examples_text}")
                        else:
                            result["recommendations"].append("🔐 Encrypt detected sensitive data columns to comply with data protection requirements")
                    
                    # Rule 2: Security Roles Recommendations (if overall score < 100%)
                    logger.info(f"🔍 CHECKING RULE 2: {overall_rule2_percentage:.1f}% < 100 AND {total_rule2_max} > 0 = {overall_rule2_percentage < 100 and total_rule2_max > 0}")
                    if overall_rule2_percentage < 100 and total_rule2_max > 0:
                        # Find financial tables needing MSSales RLS
                        financial_tables_needing_rls = []
                        for r in csv_analysis_results:
                            if r["Has_Financial_Data"] == "YES" and r["Has_Security_Filtering"] == "NO":
                                financial_tables_needing_rls.append(r['Table_Name'])
                                if len(financial_tables_needing_rls) >= 3:  # Limit examples
                                    break
                        
                        if financial_tables_needing_rls:
                            tables_text = ", ".join(financial_tables_needing_rls)
                            result["recommendations"].append(f"🔒 Apply MSSales RLS (Row-Level Security) to financial tables with finance columns: {tables_text}")
                        else:
                            result["recommendations"].append("🔒 Apply MSSales RLS (Row-Level Security) for financial data access control")
                    
                    # Rule 3: Seller Assignment Recommendations (if overall score < 100%)
                    logger.info(f"🔍 CHECKING RULE 3: {overall_rule3_percentage:.1f}% < 100 AND {total_rule3_max} > 0 = {overall_rule3_percentage < 100 and total_rule3_max > 0}")
                    if overall_rule3_percentage < 100 and total_rule3_max > 0:
                        # Find financial tables needing account assignment RLS
                        tables_needing_account_rls = []
                        for r in csv_analysis_results:
                            if r["Has_Financial_Data"] == "YES" and not r["Account_Linkage_Columns"]:
                                tables_needing_account_rls.append(r['Table_Name'])
                                if len(tables_needing_account_rls) >= 3:  # Limit examples
                                    break
                        
                        if tables_needing_account_rls:
                            tables_text = ", ".join(tables_needing_account_rls)
                            result["recommendations"].append(f"👥 Apply Account Assignment RLS for proper seller-to-account security in tables with account columns: {tables_text}")
                        else:
                            result["recommendations"].append("👥 Apply Account Assignment RLS for proper seller-to-account security")
                    
                    # Overall compliance recommendations
                    if compliance_percentage < 30:
                        result["recommendations"].append("🚨 CRITICAL: Security compliance critically low - immediate comprehensive security overhaul required")
                    elif compliance_percentage < 50:
                        result["recommendations"].append("⚠️ WARNING: Security compliance below acceptable threshold - significant security improvements needed")
                    elif compliance_percentage >= 75:
                        result["recommendations"].append("✅ GOOD: Security compliance meets basic requirements. Continue monitoring and regular audits.")
                    
                    # If all rules are at 100%, provide maintenance recommendation
                    if overall_rule1_percentage >= 100 and overall_rule2_percentage >= 100 and overall_rule3_percentage >= 100:
                        result["recommendations"].append("✅ EXCELLENT: All security rules achieve 100% compliance - maintain current controls and monitor regularly")
                    
                    logger.info(f"📋 Generated {len(result['recommendations'])} rule-score-based recommendations for Analysis Summary")
                    logger.info(f"🔍 RECOMMENDATIONS DEBUG: Current recommendations = {result['recommendations']}")
                    
                else:
                    logger.warning("No CSV analysis results generated")
                    # Fallback recommendations when CSV data is not available
                    result["recommendations"].append("⚠️ Unable to generate detailed recommendations - analysis data not available")
                    logger.info(f"🔍 FALLBACK RECOMMENDATIONS DEBUG: {result['recommendations']}")
                    
                    # ================================================================================================
                    # FALLBACK: MANUAL TABLE-LEVEL SEVERITY COUNTING FOR CONSISTENCY
                    # ================================================================================================
                    # If CSV generation failed or produced no results, manually count table severities
                    
                    logger.info("🔧 CSV generation failed - performing manual table severity counting for UI consistency")
                    
                    # Manually count table severities from the raw analysis data
                    manual_critical_count = 0
                    manual_issue_count = 0  
                    manual_warning_count = 0
                    manual_good_count = 0
                    
                    # Count based on the same logic as CSV generation
                    all_analyzed_tables = set()
                    all_analyzed_tables.update(item["table_name"] for item in sensitive_data_results if isinstance(item, dict))
                    all_analyzed_tables.update(item["table_name"] for item in financial_data_results if isinstance(item, dict))
                    all_analyzed_tables.update(item["table_name"] for item in account_linkage_results if isinstance(item, dict))
                    all_analyzed_tables.update(item["table_name"] for item in security_compliance_results if isinstance(item, dict))
                    
                    # Create lookups for manual severity calculation
                    sensitive_lookup = {item["table_name"]: item.get("analysis", {}) for item in sensitive_data_results if isinstance(item, dict)}
                    financial_lookup = {item["table_name"]: item.get("analysis", {}) for item in financial_data_results if isinstance(item, dict)}
                    account_lookup = {item["table_name"]: item.get("account_linkage", {}) for item in account_linkage_results if isinstance(item, dict)}
                    security_lookup = {item["table_name"]: item for item in security_compliance_results if isinstance(item, dict)}
                    
                    # Process each table to determine severity (same logic as CSV)
                    for table_name in all_analyzed_tables:
                        table_data = sensitive_lookup.get(table_name, {})
                        financial_data = financial_lookup.get(table_name, {})
                        security_data = security_lookup.get(table_name, {})
                        account_data = account_lookup.get(table_name, {})
                        
                        # Calculate table score using CSV logic
                        table_rule1_score = 0.0 if table_data.get("has_sensitive_data", False) else 0.3
                        table_rule2_max = 0.4 if financial_data.get("has_financial_data", False) else 0.0
                        table_rule2_score = 0.0
                        if financial_data.get("has_financial_data", False):
                            security_check = security_data.get("security_check", {})
                            if security_check.get("has_security_filtering", False):
                                table_rule2_score = table_rule2_max
                        
                        is_financial = financial_data.get("has_financial_data", False)
                        has_account_columns = account_data.get("has_account_columns", False)
                        table_rule3_max = 0.3 if is_financial and has_account_columns else 0.0
                        table_rule3_score = 0.3 if is_financial and has_account_columns else 0.0
                        
                        table_overall_score = table_rule1_score + table_rule2_score + table_rule3_score
                        table_max_score = 0.3 + table_rule2_max + table_rule3_max
                        
                        # Determine severity using CSV logic
                        score_percentage = (table_overall_score / table_max_score) if table_max_score > 0 else 1.0
                        
                        if score_percentage < 0.30:
                            manual_critical_count += 1
                        elif score_percentage < 0.50:
                            manual_issue_count += 1
                        elif score_percentage < 0.75:
                            manual_warning_count += 1
                        else:
                            manual_good_count += 1
                    
                    # Override UI counts with manual table-level severity counts
                    manual_consistent_counts = {
                        "critical_issues": manual_critical_count,
                        "issue_issues": manual_issue_count,
                        "warning_issues": manual_warning_count,
                        "total_issues": manual_critical_count + manual_issue_count + manual_warning_count
                    }
                    
                    result["summary"].update(manual_consistent_counts)
                    result.update(manual_consistent_counts)
                    
                    logger.info(f"🔧 MANUAL CONSISTENCY OVERRIDE: Critical={manual_critical_count}, Issues={manual_issue_count}, Warnings={manual_warning_count}, Good={manual_good_count}")
                    logger.info(f"✅ UI counts manually set to match table-level severity logic")
                    
            except Exception as csv_error:
                logger.error(f"CSV generation failed: {csv_error}")
                result["csv_error"] = f"CSV generation failed: {str(csv_error)}"
            
            # ================================================================================================
            # PHASE 8: RESULTS ASSEMBLY
            # ================================================================================================
            # Combine all analysis components into final structured response for webapp consumption
            
            ui_tracker.set_phase("Results Assembly", "Finalizing analysis results and summaries")
            
            # Update result structure to match dataset_columns_analysis pattern
            result.update({
                "status": "success",
                "total_tables_analyzed": total_tables,
                "analysis_results": result.get("csv_analysis_results", []),  # Individual table assessments
                "ai_powered": True,
                "model_used": "gpt-4o"
            })
            
            # Generate high_level_summary for webapp Analysis Summary panel
            logger.info(f"🔍 PRE-SUMMARY DEBUG: result['recommendations'] = {result.get('recommendations', 'NOT_FOUND')}")
            logger.info(f"🔍 PRE-SUMMARY DEBUG: len(recommendations) = {len(result.get('recommendations', []))}")
            try:
                high_level_summary = self.tabular_editor.generate_analysis_summary("security_analysis", result)
                logger.info(f"✅ Generated high-level summary for security compliance analysis")
                logger.info(f"🔍 POST-SUMMARY DEBUG: high_level_summary['recommendations'] = {high_level_summary.get('recommendations', 'NOT_FOUND')}")
            except Exception as summary_error:
                logger.error(f"Failed to generate high-level summary: {summary_error}")
                # Create a basic summary manually if the automatic generation fails
                high_level_summary = {
                    "analysis_title": "Security Compliance Analysis",
                    "overall_score": result.get("compliance_percentage", 0),
                    "max_score": 100,
                    "total_items_analyzed": result.get("summary", {}).get("total_tables_analyzed", 0),
                    "key_findings": [
                        f"Overall Security Score: {result.get('overall_security_score', 0):.3f}/{result.get('max_possible_score', 1):.3f}",
                        f"Compliance Level: {result.get('summary', {}).get('compliance_level', 'Unknown')}",
                        f"Financial Tables Found: {result.get('summary', {}).get('financial_tables_found', 0)}",
                        f"Protected Financial Tables: {result.get('summary', {}).get('protected_financial_tables', 0)}"
                    ],
                    "recommendations": result.get("recommendations", [])[:3],  # Top 3 recommendations
                    "analysis_type": "security_compliance"
                }
            
            # Preserve detailed issue breakdowns from result for UI compatibility
            if "detailed_issues" in result:
                high_level_summary["detailed_issues"] = result["detailed_issues"]
            
            # Attach high-level summary to main result
            result["high_level_summary"] = high_level_summary
            
            # Complete analysis tracking with comprehensive statistics
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=f"Successfully analyzed {total_tables} tables for security compliance",
                results_data={
                    "total_tables": total_tables,
                    "total_tables_processed": len(self._completed_tables),
                    "csv_filename": result.get("csv_filename", ""),
                    "compliance_percentage": result.get("compliance_percentage", 0),
                    "overall_security_score": result.get("overall_security_score", 0)
                }
            )
            
            # Add analysis statistics to result
            result["analysis_statistics"] = analysis_stats
            
            return result
            
        except Exception as e:
            # Handle errors with UI progress tracker if available
            if 'ui_tracker' in locals():
                ui_tracker.add_error(f"Security analysis failed: {str(e)}", "analysis_error")
                error_stats = ui_tracker.complete_analysis(
                    success=False,
                    summary=f"Analysis failed due to error: {str(e)}"
                )
                logger.error(f"Error in AI-powered security compliance analysis: {str(e)}")
                return {
                    "error": f"Security analysis failed: {str(e)}",
                    "analysis_statistics": error_stats,
                    "analysis_type": "security_compliance",
                    "timestamp": datetime.now().isoformat()
                }
            else:
                logger.error(f"Error in security compliance analysis: {str(e)}")
                return {
                    "error": f"Security compliance evaluation failed: {str(e)}",
                    "analysis_type": "security_compliance",
                    "timestamp": datetime.now().isoformat()
                }

    def evaluate_metadata_analysis(self, tables_to_analyze: list = None) -> dict:
        """
        Comprehensive metadata quality analysis using Python-based DAX expressions.
        
        Step 1: Connect to dataset in workspace
        Step 2: Retrieve metadata information (tables, columns, measures)
        Step 3: Apply scoring logic (0.25 for descriptions, 0 for missing)
        
        Args:
            tables_to_analyze: Optional list of specific table names to analyze
        
        Returns:
            Dictionary containing analysis results with Excel file generation
        """
        try:
            # Step 1: Check if connected to a dataset
            if not self.tabular_editor.connected:
                logger.error("Not connected to any dataset. Please connect first.")
                return {
                    "status": "error",
                    "error": "Not connected to any dataset. Please connect first.",
                    "analysis_type": "metadata_analysis",
                    "timestamp": datetime.now().isoformat()
                }
            
            # Initialize tracking variables
            metadata_results = []
            
            # Track progress - use simplified approach to avoid import issues
            logger.info("🔍 Starting Metadata Analysis - Step 1: Dataset Connected")
            
            class ProgressTracker:
                def update_progress(self, progress, message): 
                    logger.info(f"Progress {progress}%: {message}")
                def add_error(self, message, error_type): 
                    logger.error(f"{error_type}: {message}")
                def complete_analysis(self, success, summary, results_data=None):
                    if success:
                        logger.info(f"Analysis completed successfully: {summary}")
                    else:
                        logger.error(f"Analysis failed: {summary}")
                    return {"success": success, "summary": summary, "results_data": results_data or {}}
            
            ui_tracker = ProgressTracker()
            ui_tracker.update_progress(5, "Step 1: Connected to dataset successfully")
            
            # Step 2: Retrieve metadata information using Python-based DAX expressions
            logger.info("📊 Step 2: Retrieving metadata information using DAX expressions")
            ui_tracker.update_progress(10, "Step 2: Retrieving tables, columns, and measures...")
            
            # Get all tables using INFO functions (confirmed working)
            tables_dax = """
            EVALUATE
            SELECTCOLUMNS(
                INFO.TABLES(),
                "TableName", [Name],
                "Description", [Description]
            )
            """
            
            # Get all columns using INFO functions (confirmed working)
            columns_dax = """
            EVALUATE
            SELECTCOLUMNS(
                INFO.COLUMNS(),
                "TableID", [TableID],
                "ColumnName", [ExplicitName],
                "Description", [Description]
            )
            """
            
            # Get all measures using INFO functions (confirmed working)
            measures_dax = """
            EVALUATE
            SELECTCOLUMNS(
                INFO.MEASURES(),
                "TableID", [TableID],
                "MeasureName", [Name],
                "Description", [Description]
            )
            """
            
            # Execute DAX queries to get metadata
            logger.info("Executing DAX query for tables...")
            tables_result = self.tabular_editor.execute_dax_query(tables_dax)
            logger.info(f"Tables query returned {len(tables_result) if tables_result else 0} rows")
            if tables_result and len(tables_result) > 0:
                logger.info(f"First table row keys: {list(tables_result[0].keys())}")
                logger.info(f"First table row data: {tables_result[0]}")
            ui_tracker.update_progress(25, "Retrieved table metadata")
            
            # Get table ID to name mapping for columns and measures
            table_ids_dax = """
            EVALUATE
            SELECTCOLUMNS(
                INFO.TABLES(),
                "TableID", [ID],
                "TableName", [Name]
            )
            """
            
            logger.info("Getting table ID mappings...")
            table_ids_result = self.tabular_editor.execute_dax_query(table_ids_dax)
            logger.info(f"Table IDs query returned {len(table_ids_result) if table_ids_result else 0} rows")
            if table_ids_result and len(table_ids_result) > 0:
                logger.info(f"First table ID row keys: {list(table_ids_result[0].keys())}")
                logger.info(f"First table ID row data: {table_ids_result[0]}")
            
            # Build the mapping
            table_id_to_name = {}
            if isinstance(table_ids_result, list):
                for row in table_ids_result:
                    # Check all possible key variations
                    table_id = row.get('TableID') or row.get('[TableID]') or row.get('ID') or row.get('[ID]')
                    table_name = row.get('TableName') or row.get('[TableName]') or row.get('Name') or row.get('[Name]')
                    if table_id is not None and table_name:
                        table_id_to_name[table_id] = table_name
                        logger.info(f"Mapped Table ID {table_id} -> {table_name}")
            
            logger.info("Executing DAX query for columns...")
            columns_result = self.tabular_editor.execute_dax_query(columns_dax)
            logger.info(f"Columns query returned {len(columns_result) if columns_result else 0} rows")
            if columns_result and len(columns_result) > 0:
                logger.info(f"First column row keys: {list(columns_result[0].keys())}")
                logger.info(f"First column row data: {columns_result[0]}")
            ui_tracker.update_progress(50, "Retrieved column metadata")
            
            logger.info("Executing DAX query for measures...")
            measures_result = self.tabular_editor.execute_dax_query(measures_dax)
            logger.info(f"Measures query returned {len(measures_result) if measures_result else 0} rows")
            if measures_result and len(measures_result) > 0:
                logger.info(f"First measure row keys: {list(measures_result[0].keys())}")
                logger.info(f"First measure row data: {measures_result[0]}")
            ui_tracker.update_progress(75, "Retrieved measure metadata")
            
            # Step 3: Apply scoring logic to metadata
            logger.info("🎯 Step 3: Applying scoring logic (0.25 for descriptions, 0 for missing)")
            ui_tracker.update_progress(80, "Step 3: Applying scoring logic...")
            
            # Process Tables
            if isinstance(tables_result, list):
                for table_row in tables_result:
                    # Check different possible column name formats
                    table_name = (table_row.get('TableName') or 
                                table_row.get('[TableName]') or 
                                table_row.get('Name') or 
                                table_row.get('[Name]') or '')
                    description = (table_row.get('Description') or 
                                 table_row.get('[Description]') or '')
                    
                    logger.info(f"Processing table: {table_name}, Description: {description}")
                    
                    # Scoring logic: 0.25 if has description, 0 if missing
                    table_desc_score = 0.25 if description.strip() else 0.0
                    has_description = 'Yes' if description.strip() else 'No'
                    issue_severity = 'Good' if description.strip() else 'Critical'
                    
                    metadata_results.append({
                        'Metadata_Type': 'Table',
                        'Element_Name': table_name,
                        'Table_Name': table_name,
                        'Issue_Severity': issue_severity,
                        'Current_Description': description,
                        'Has_Description': has_description,
                        'Table_Description_Score': table_desc_score,
                        'Column_Description_Score': 0.0,
                        'Measure_Description_Score': 0.0,
                        'Overall_Score': table_desc_score,
                        'Max_Score': 0.75,
                        'Recommendations': 'Add table description' if not description.strip() else 'Description present'
                    })
            
            # Process Columns
            if isinstance(columns_result, list):
                for column_row in columns_result:
                    # Check different possible column name formats
                    table_id = (column_row.get('TableID') or 
                              column_row.get('[TableID]') or 
                              column_row.get('ID') or 
                              column_row.get('[ID]'))
                    table_name = table_id_to_name.get(table_id, f'Unknown_Table_{table_id}')
                    column_name = (column_row.get('ColumnName') or 
                                 column_row.get('[ColumnName]') or 
                                 column_row.get('ExplicitName') or 
                                 column_row.get('[ExplicitName]') or 
                                 column_row.get('Name') or 
                                 column_row.get('[Name]') or '')
                    description = (column_row.get('Description') or 
                                 column_row.get('[Description]') or '')
                    
                    logger.info(f"Processing column: {column_name} in table {table_name}, Description: {description}")
                    
                    # Skip system columns
                    if column_name.startswith('RowNumber-'):
                        continue
                    
                    # Scoring logic: 0.25 if has description, 0 if missing
                    column_desc_score = 0.25 if description.strip() else 0.0
                    has_description = 'Yes' if description.strip() else 'No'
                    issue_severity = 'Good' if description.strip() else 'Critical'
                    
                    metadata_results.append({
                        'Metadata_Type': 'Column',
                        'Element_Name': column_name,
                        'Table_Name': table_name,
                        'Issue_Severity': issue_severity,
                        'Current_Description': description,
                        'Has_Description': has_description,
                        'Table_Description_Score': 0.0,
                        'Column_Description_Score': column_desc_score,
                        'Measure_Description_Score': 0.0,
                        'Overall_Score': column_desc_score,
                        'Max_Score': 0.75,
                        'Recommendations': 'Add column description' if not description.strip() else 'Description present'
                    })
            
            # Process Measures
            if isinstance(measures_result, list):
                for measure_row in measures_result:
                    # Check different possible column name formats
                    table_id = (measure_row.get('TableID') or 
                              measure_row.get('[TableID]') or 
                              measure_row.get('ID') or 
                              measure_row.get('[ID]'))
                    table_name = table_id_to_name.get(table_id, f'Unknown_Table_{table_id}')
                    measure_name = (measure_row.get('MeasureName') or 
                                  measure_row.get('[MeasureName]') or 
                                  measure_row.get('Name') or 
                                  measure_row.get('[Name]') or '')
                    description = (measure_row.get('Description') or 
                                 measure_row.get('[Description]') or '')
                    
                    logger.info(f"Processing measure: {measure_name} in table {table_name}, Description: {description}")
                    
                    # Scoring logic: 0.25 if has description, 0 if missing
                    measure_desc_score = 0.25 if description.strip() else 0.0
                    has_description = 'Yes' if description.strip() else 'No'
                    issue_severity = 'Good' if description.strip() else 'Critical'
                    
                    metadata_results.append({
                        'Metadata_Type': 'Measure',
                        'Element_Name': measure_name,
                        'Table_Name': table_name,
                        'Issue_Severity': issue_severity,
                        'Current_Description': description,
                        'Has_Description': has_description,
                        'Table_Description_Score': 0.0,
                        'Column_Description_Score': 0.0,
                        'Measure_Description_Score': measure_desc_score,
                        'Overall_Score': measure_desc_score,
                        'Max_Score': 0.75,
                        'Recommendations': 'Add measure description' if not description.strip() else 'Description present'
                    })
            
            # Filter by tables_to_analyze if specified
            if tables_to_analyze:
                metadata_results = [r for r in metadata_results if r['Table_Name'] in tables_to_analyze]
            
            # Calculate summary statistics
            total_items = len(metadata_results)
            items_with_descriptions = sum(1 for r in metadata_results if r['Has_Description'] == 'Yes')
            total_score = sum(r['Overall_Score'] for r in metadata_results)
            max_possible_score = total_items * 0.25  # Actual scoring is 0.25 per item
            metadata_percentage = (total_score / max_possible_score * 100) if max_possible_score > 0 else 0
            
            ui_tracker.update_progress(90, "Generating Excel file with color coding...")
            
            # Nested Excel generation function
            def generate_metadata_excel(metadata_results: list, total_score: float, max_possible_score: float, metadata_percentage: float) -> str:
                """
                Generate Excel file for metadata analysis results with color coding based on issue severity.
                
                Args:
                    metadata_results: List of metadata analysis results
                    total_score: Total score achieved
                    max_possible_score: Maximum possible score
                    metadata_percentage: Overall metadata coverage percentage
                    
                Returns:
                    str: Path to generated Excel file
                """
                try:
                    # Get current timestamp for filename
                    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                    
                    # Get connected dataset info for filename
                    workspace_name = getattr(self.tabular_editor, 'workspace_name', 'Unknown')
                    dataset_name = getattr(self.tabular_editor, 'dataset_name', 'Unknown')
                    
                    # Clean names for filename
                    clean_workspace = workspace_name.replace(" ", "").replace("-", "").replace("_", "")
                    clean_dataset = dataset_name.replace(" ", "").replace("-", "").replace("_", "")
                    
                    # Generate filename
                    excel_filename = f"Metadata_Analysis_{clean_workspace}_{clean_dataset}_{timestamp}.xlsx"
                    
                    # Get absolute path to KnowledgeBase folder
                    current_dir = os.path.dirname(os.path.abspath(__file__))  # src folder
                    root_dir = os.path.dirname(current_dir)  # go up one level to root
                    kb_folder = os.path.join(root_dir, "KnowledgeBase")
                    
                    # Ensure KnowledgeBase folder exists
                    os.makedirs(kb_folder, exist_ok=True)
                    
                    excel_path = os.path.join(kb_folder, excel_filename)
                    
                    # Create DataFrame and remove DAX_Expression column
                    import pandas as pd
                    df = pd.DataFrame(metadata_results)
                    
                    # Remove DAX_Expression column if it exists
                    if 'DAX_Expression' in df.columns:
                        df = df.drop('DAX_Expression', axis=1)
                    
                    # Create Excel file with formatting
                    try:
                        from openpyxl import Workbook
                        from openpyxl.styles import PatternFill, Font
                        from openpyxl.utils.dataframe import dataframe_to_rows
                        
                        # Create workbook and worksheet
                        wb = Workbook()
                        ws = wb.active
                        ws.title = "Metadata Analysis"
                        
                        # Add data headers and rows directly (no summary section)
                        for r in dataframe_to_rows(df, index=False, header=True):
                            ws.append(r)
                        
                        # Define color fills for severity levels (consistent with other analyses)
                        severity_colors = {
                            'Critical': PatternFill(start_color='E63946', end_color='E63946', fill_type='solid'),  # Dark Red (standard)
                            'Issue': PatternFill(start_color='1E6FE3', end_color='1E6FE3', fill_type='solid'),     # Dark Blue (standard)
                            'Warning': PatternFill(start_color='E6B800', end_color='E6B800', fill_type='solid'),   # Dark Orange (standard)
                            'Good': PatternFill(start_color='00B050', end_color='00B050', fill_type='solid')       # Dark Green (standard)
                        }
                        
                        # White font for better visibility on dark backgrounds (consistent with other analyses)
                        white_font = Font(color="FFFFFF", bold=True)
                        
                        # Apply color coding ONLY to Issue_Severity column
                        severity_col_index = None
                        header_row = 1  # First row since no summary
                        
                        # Find the severity column index
                        for col_idx, cell in enumerate(ws[header_row], 1):
                            if cell.value == 'Issue_Severity':
                                severity_col_index = col_idx
                                break
                        
                        # Apply color coding ONLY to the Issue_Severity column cells
                        if severity_col_index:
                            for row_idx in range(header_row + 1, ws.max_row + 1):
                                severity_cell = ws.cell(row=row_idx, column=severity_col_index)
                                severity_value = severity_cell.value
                                
                                if severity_value in severity_colors:
                                    # Apply color ONLY to the Issue_Severity cell, not the entire row
                                    severity_cell.fill = severity_colors[severity_value]
                                    # Apply white font for better visibility on dark backgrounds (consistent with other analyses)
                                    severity_cell.font = white_font
                        
                        # Style the data headers
                        bold_font = Font(bold=True)
                        header_fill = PatternFill(start_color='D3D3D3', end_color='D3D3D3', fill_type='solid')  # Light Gray
                        
                        for col_idx in range(1, ws.max_column + 1):
                            cell = ws.cell(row=header_row, column=col_idx)
                            cell.font = bold_font
                            cell.fill = header_fill
                        
                        # Auto-adjust column widths
                        for column in ws.columns:
                            max_length = 0
                            column_letter = column[0].column_letter
                            for cell in column:
                                try:
                                    if len(str(cell.value)) > max_length:
                                        max_length = len(str(cell.value))
                                except:
                                    pass
                            adjusted_width = min(max_length + 2, 50)  # Cap at 50 characters
                            ws.column_dimensions[column_letter].width = adjusted_width
                        
                        # Save the workbook
                        wb.save(excel_path)
                        logger.info(f"Metadata analysis Excel saved: {excel_path}")
                        
                    except ImportError:
                        # Fallback to basic Excel without formatting if openpyxl not available
                        # Remove DAX_Expression column if it exists
                        if 'DAX_Expression' in df.columns:
                            df = df.drop('DAX_Expression', axis=1)
                        df.to_excel(excel_path, index=False, sheet_name='Metadata Analysis')
                        logger.info(f"Metadata analysis Excel saved (basic format): {excel_path}")
                    
                    return excel_filename
                    
                except Exception as e:
                    logger.error(f"Error generating metadata Excel: {str(e)}")
                    return f"Error generating Excel: {str(e)}"
            
            # Generate Excel file with color coding using nested function
            excel_filename = generate_metadata_excel(metadata_results, total_score, max_possible_score, metadata_percentage)
            
            # Read Excel file content for webapp download
            excel_content = None
            try:
                # Get the full path to the Excel file
                current_dir = os.path.dirname(os.path.abspath(__file__))  # src folder
                root_dir = os.path.dirname(current_dir)  # go up one level to root
                kb_folder = os.path.join(root_dir, "KnowledgeBase")
                excel_path = os.path.join(kb_folder, excel_filename)
                
                with open(excel_path, 'rb') as f:
                    excel_content = f.read()
                logger.info(f"Excel content read for download: {len(excel_content)} bytes")
            except Exception as e:
                logger.error(f"Failed to read Excel file for download: {str(e)}")
            
            ui_tracker.update_progress(100, f"Metadata analysis completed. Excel saved: {excel_filename}")
            
            # Create analysis summary
            summary = f"Metadata Analysis completed: {items_with_descriptions}/{total_items} items have descriptions ({metadata_percentage:.1f}% coverage)"
            
            # Complete analysis tracking
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=summary,
                results_data={
                    "total_items": total_items,
                    "items_with_descriptions": items_with_descriptions,
                    "excel_filename": excel_filename,
                    "metadata_percentage": metadata_percentage,
                    "total_score": total_score,
                    "max_possible_score": max_possible_score
                }
            )
            
            logger.info("✅ Metadata Analysis completed successfully")
            
            # Build comprehensive summary object for UI compatibility
            summary_for_ui = {
                "analysis_type": "metadata_analysis",
                "overall_score": int(metadata_percentage),
                "total_items": total_items,
                "items_with_descriptions": items_with_descriptions,
                "metadata_coverage": metadata_percentage,
                "total_tables_analyzed": len([r for r in metadata_results if r['Metadata_Type'] == 'Table']),
                "max_possible_score": max_possible_score,
                "overall_percentage": metadata_percentage,
                "tables_with_descriptions": len([r for r in metadata_results if r['Metadata_Type'] == 'Table' and r['Has_Description'] == 'Yes']),
                "table_description_percentage": (len([r for r in metadata_results if r['Metadata_Type'] == 'Table' and r['Has_Description'] == 'Yes']) / len([r for r in metadata_results if r['Metadata_Type'] == 'Table']) * 100) if len([r for r in metadata_results if r['Metadata_Type'] == 'Table']) > 0 else 0,
                "columns_with_descriptions": len([r for r in metadata_results if r['Metadata_Type'] == 'Column' and r['Has_Description'] == 'Yes']),
                "total_columns": len([r for r in metadata_results if r['Metadata_Type'] == 'Column']),
                "column_description_percentage": (len([r for r in metadata_results if r['Metadata_Type'] == 'Column' and r['Has_Description'] == 'Yes']) / len([r for r in metadata_results if r['Metadata_Type'] == 'Column']) * 100) if len([r for r in metadata_results if r['Metadata_Type'] == 'Column']) > 0 else 0,
                "measures_with_descriptions": len([r for r in metadata_results if r['Metadata_Type'] == 'Measure' and r['Has_Description'] == 'Yes']),
                "total_measures": len([r for r in metadata_results if r['Metadata_Type'] == 'Measure']),
                "measure_description_percentage": (len([r for r in metadata_results if r['Metadata_Type'] == 'Measure' and r['Has_Description'] == 'Yes']) / len([r for r in metadata_results if r['Metadata_Type'] == 'Measure']) * 100) if len([r for r in metadata_results if r['Metadata_Type'] == 'Measure']) > 0 else 0,
                "key_findings": [
                    f"• Analyzed {total_items} metadata elements (tables, columns, measures)",
                    f"• {items_with_descriptions} elements have descriptions ({metadata_percentage:.1f}% coverage)",
                    f"• {total_items - items_with_descriptions} elements missing descriptions",
                    f"• Total score: {total_score:.2f}/{max_possible_score:.2f} points"
                ],
                "recommendations": [
                    "Add descriptions for all tables to improve documentation",
                    "Provide column descriptions for better data understanding", 
                    "Document measure calculations and business logic",
                    "Maintain consistent description standards across the model"
                ]
            }
            
            # Build final result structure for UI compatibility
            result = {
                "status": "success",
                "excel_filename": excel_filename,
                "csv_filename": excel_filename,  # Using Excel filename for compatibility
                "excel_content": excel_content,  # Add Excel content for webapp download
                "total_items_analyzed": total_items,
                "metadata_percentage": metadata_percentage,
                "total_score": total_score,
                "max_possible_score": max_possible_score,
                "items_with_descriptions": items_with_descriptions,
                "summary": summary_for_ui,
                "results": [],  # Adding empty results array for compatibility
                "metadata_results": metadata_results,
                "analysis_statistics": analysis_stats,
                "analysis_type": "metadata_analysis",
                "timestamp": datetime.now().isoformat(),
                "ai_powered": False,  # No AI used as requested
                "python_based": True
            }
            
            # Generate high-level summary for UI (like other analyses do)
            high_level_summary = self.tabular_editor.generate_analysis_summary("metadata_analysis", result)
            result["high_level_summary"] = high_level_summary
            
            return result
            
        except Exception as e:
            # Handle errors with UI progress tracker if available
            if 'ui_tracker' in locals():
                ui_tracker.add_error(f"Metadata analysis failed: {str(e)}", "analysis_error")
                error_stats = ui_tracker.complete_analysis(
                    success=False,
                    summary=f"Analysis failed due to error: {str(e)}"
                )
                logger.error(f"Error in metadata analysis: {str(e)}")
                return {
                    "status": "error",
                    "error": f"Metadata analysis failed: {str(e)}",
                    "analysis_statistics": error_stats,
                    "analysis_type": "metadata_analysis",
                    "timestamp": datetime.now().isoformat()
                }
            else:
                logger.error(f"Error in metadata analysis: {str(e)}")
                return {
                    "status": "error", 
                    "error": f"Metadata analysis failed: {str(e)}",
                    "analysis_type": "metadata_analysis",
                    "timestamp": datetime.now().isoformat()
                }

        
class PowerBIMCPServer:
    def __init__(self):
        self.server = Server("MCP")
        
        # Initialize AuthenticationManager once and pass the same instance to all classes
        self.auth_manager = AuthenticationManager()
        
        # Create instances using the shared authentication manager
        self.sql_endpoint = SQLEndpoint(auth_manager=self.auth_manager)
        self.fabric = Fabric(auth_manager=self.auth_manager)
        self.tabular_editor = TabularEditor(fabric_instance=self.fabric, sql_endpoint_instance=self.sql_endpoint, auth_manager=self.auth_manager)
        self.copilot_evaluator = CopilotDataEvaluator(self.tabular_editor, self.sql_endpoint)
        self.is_connected = False
        self.connection_lock = threading.Lock()
        
        # Setup server handlers
        self._setup_handlers()
        
    def _setup_handlers(self):
        @self.server.list_tools()
        async def handle_list_tools() -> List[Tool]:
            return [
            Tool(
                name="initialize_sql_connection",
                description="Initialize SQL connection with server and database details.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "sql_endpoint": {"type": "string"},
                        "sql_database": {"type": "string"}
                    },
                    "required": ["sql_endpoint", "sql_database"]
                }
            ),
            Tool(
                name="get_sql_tables",
                description="Retrieve a list of tables from the SQL database.",
                inputSchema={
                    "type": "object",
                    "properties": {
                    },
                    "required": []
                }
            ),
            Tool(
                name="get_sql_table_schema",
                description="Retrieve the schema of a specific table from the SQL database.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {"type": "string"}
                    },
                    "required": ["table_name"]
                }
            ),
            # REMOVED: update_column_names tool - use safe_rename_with_dependencies instead
            # REMOVED: update_table_name tool - use safe_rename_with_dependencies instead
            Tool(
                name="execute_sql_query",
                description="Execute a SQL query against the database.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "query": {"type": "string"}
                    },
                    "required": ["query"]
                }
            ),
            Tool(
                name="execute_dax_query",
                description="Execute a DAX query against the database.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "dax_query": {"type": "string"}
                    },
                    "required": ["dax_query"]
                }
            ),
            Tool(
                name="get_workspace_info",
                description="Retrieve information about the workspace.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "workspace_identifier": {"type": "string"}
                    },
                    "required": ["workspace_identifier"]
                }
            ),
            Tool(
                name="get_lakehouse_info",
                description="Retrieve information about the lakehouse and sql endpoint.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "workspace_identifier": {"type": "string"},
                        "lakehouse_identifier": {"type": "string"}
                    },
                    "required": ["workspace_identifier", "lakehouse_identifier"]
                }
            ),
            Tool(
                name="refresh_sql_endpoint",
                description="Refresh the metadata of a SQL endpoint.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "workspace_identifier": {"type": "string"},
                        "lakehouse_identifier": {"type": "string"}
                    },
                    "required": ["workspace_identifier", "lakehouse_identifier"]
                }
            ),
            Tool(
                name="connect_dataset",
                description="Connect to a Power BI dataset using workspace_identifier (workspace name or ID) and database_name (dataset name)",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "workspace_identifier": {
                            "type": "string",
                            "description": "The workspace name or workspace ID (not server_name)"
                        },
                        "database_name": {
                            "type": "string",
                            "description": "The Power BI dataset/database name"
                        }
                    },
                    "required": ["workspace_identifier","database_name"]
                }
            ),
            Tool(
                name="disconnect_dataset",
                description="Disconnecting power bi dataset after use",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="list_tables",
                description="List all tables in the connected semantic model.",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="list_all_relationships",
                description="List all relationships in the connected semantic model.",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="refresh_semantic_model",
                description="Refresh a Power BI dataset using workspace_identifier (workspace name or ID) and database_name (dataset name)",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "workspace_identifier": {
                            "type": "string",
                            "description": "The workspace name or workspace ID (not server_name)"
                        },
                        "semantic_model_name": {
                            "type": "string",
                            "description": "The name of the semantic model to refresh"
                        },
                        "refresh_type": {
                            "type": "string",
                            "description": "The type of refresh to perform"
                        }
                    },
                    "required": ["workspace_identifier","semantic_model_name"]
                }
            ),
            Tool(
                name="check_date_table_exists",
                description="Check if a date table exists in the model and return its details. Can check a specific table or all tables.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Optional: specific table name to check. If not provided, checks all tables for date table candidates."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="mark_as_date_table",
                description="Mark a table as a date table in the model with specified date column as key.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table to mark as date table"
                        },
                        "date_column": {
                            "type": "string",
                            "description": "Optional: specific date column to use as key. If not provided, uses the first date column found."
                        }
                    },
                    "required": ["table_name"]
                }
            ),
            Tool(
                name="unmark_date_table",
                description="Remove date table marking from a table.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table to remove date table marking from"
                        }
                    },
                    "required": ["table_name"]
                }
            ),
            Tool(
                name="get_table_properties",
                description="Get all available properties for a specific table with their current values and metadata.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table to inspect"
                        }
                    },
                    "required": ["table_name"]
                }
            ),
            Tool(
                name="get_column_properties",
                description="Get all available properties for a specific column with their current values and metadata.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table containing the column"
                        },
                        "column_name": {
                            "type": "string",
                            "description": "Name of the column to inspect"
                        }
                    },
                    "required": ["table_name", "column_name"]
                }
            ),
            Tool(
                name="get_measure_properties",
                description="Get all available properties for a specific measure with their current values and metadata.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table containing the measure"
                        },
                        "measure_name": {
                            "type": "string",
                            "description": "Name of the measure to inspect"
                        }
                    },
                    "required": ["table_name", "measure_name"]
                }
            ),
            Tool(
                name="classify_all_measures_in_model",
                description="Automatically classify all measures in the entire model with intelligent annotation assignment based on DAX expression analysis.",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="analyze_dependencies",
                description="Analyze dependencies for a given object (table, column, or measure) before renaming to understand impact.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "object_type": {
                            "type": "string",
                            "description": "Type of object to analyze ('table', 'column', 'measure')"
                        },
                        "object_name": {
                            "type": "string", 
                            "description": "Name of the object to analyze"
                        },
                        "table_name": {
                            "type": "string",
                            "description": "Name of the table (required for column and measure analysis)"
                        }
                    },
                    "required": ["object_type", "object_name"]
                }
            ),
            Tool(
                name="dataset_columns_analysis",
                description="Perform comprehensive column analysis for all tables in the dataset. Evaluates column names and data types based on best practices. Generates CSV output with standardized columns.",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="evaluate_measures_analysis",
                description="Comprehensive AI-powered measure quality analysis. Evaluates DAX expressions, naming conventions, and AI quality assessment using GPT-4o. Generates detailed CSV output with severity categorization, statistical analysis, and comprehensive logging.",
                inputSchema={
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            ),
            Tool(
                name="evaluate_security_compliance",
                description="Comprehensive security compliance evaluation with AI-powered analysis. Evaluates sensitive data detection, security role validation, and seller assignment cross-checks using a three-rule scoring system. Generates detailed CSV output with severity assessment and recommendations.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "progress_callback": {
                            "type": "string",
                            "description": "Optional callback function for progress updates during analysis."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="evaluate_fact_dimension_analysis",
                description="Comprehensive fact and dimension table classification analysis. Analyzes table structure, column patterns, measures, and naming conventions to classify tables as fact, dimension, hybrid, or unclear types. Generates detailed CSV output with scoring and recommendations.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "tables_to_analyze": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Optional list of specific table names to analyze. If not provided, analyzes all tables in the dataset."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="evaluate_table_linking",
                description="Comprehensive relationship and table linking analysis. Evaluates existing relationships, analyzes cardinality patterns, identifies potential missing relationships, and provides recommendations for data model optimization. Generates detailed CSV output with relationship quality scoring and improvement suggestions.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "tables_to_analyze": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Optional list of specific table names to analyze relationships for. If not provided, analyzes all tables in the dataset."
                        },
                        "include_potential_relationships": {
                            "type": "boolean",
                            "description": "Whether to analyze and include potential missing relationships. Default is true."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="evaluate_table_hierarchies",
                description="Comprehensive hierarchy evaluation combining existing and suggested hierarchies in one analysis. Detects existing Power BI hierarchies, analyzes schema for potential new hierarchies based on column patterns, identifies logical groupings and parent-child relationships, evaluates common dimension patterns (Time, Geography, Product, Organization), and generates unified CSV differentiating existing vs suggested hierarchies.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "tables_to_analyze": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Optional list of specific table names to analyze hierarchies for. If not provided, analyzes all tables in the dataset."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="evaluate_metadata_analysis",
                description="Comprehensive metadata quality analysis. Evaluates table, column, and measure descriptions to ensure comprehensive documentation and business context. Uses scoring rules MD-001 (table descriptions), MD-002 (column descriptions), and MD-003 (measure descriptions) with maximum score of 0.75 points.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "tables_to_analyze": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Optional list of specific table names to analyze. If not provided, analyzes all tables in the dataset."
                        }
                    },
                    "required": []
                }
            ),
            Tool(
                name="generate_model_diagram",
                description="Generate an ERD (Entity Relationship Diagram) in PNG format documenting the structure of the data model. Shows entities (tables), attributes (columns), primary/foreign keys, relationships with cardinality, and measures. Supports conceptual, logical, and physical ERD levels with detailed entity representation.",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "output_format": {
                            "type": "string",
                            "description": "Output format - always generates PNG visual diagram regardless of this parameter",
                            "default": "visual"
                        },
                        "include_measures": {
                            "type": "boolean",
                            "description": "Include measures in the diagram documentation",
                            "default": True
                        },
                        "include_relationships": {
                            "type": "boolean",
                            "description": "Include relationship details in the diagram",
                            "default": True
                        }
                    },
                    "required": []
                }
            )
        ]
        @self.server.call_tool()
        async def handle_call_tool(name: str, arguments: Optional[Dict[str, Any]]) -> List[TextContent]:
            """Handle tool calls and return results as TextContent"""
            try:
                logger.info(f"Handling tool call: {name}")
                
                if name == "initialize_sql_connection":
                    result = await self._handle_initialize_sql_connection(arguments)
                elif name == "get_sql_tables":
                    result = await self._handle_get_sql_tables(arguments)
                elif name == "get_sql_table_schema":
                    result = await self._handle_get_sql_table_schema(arguments)
                elif name == "execute_sql_query":
                    result = await self._handle_execute_sql_query(arguments)
                elif name == "get_workspace_info":
                    result = await self._handle_get_workspace_info(arguments)
                elif name == "get_lakehouse_info":
                    result = await self._handle_get_lakehouse_info(arguments)
                elif name == "connect_dataset":
                    result = await self._handle_connect_dataset(arguments)
                elif name == "list_tables":
                    result = await self._handle_list_tables(arguments)
                elif name == "disconnect_dataset":
                    result = await self._handle_disconnect_dataset(arguments)
                elif name == "refresh_semantic_model":
                    result = await self._handle_refresh_semantic_model(arguments)
                elif name == "execute_dax_query":
                    result = await self._handle_execute_dax_query(arguments)
                elif name == "list_all_relationships":
                    result = await self._handle_list_all_relationships(arguments)  
                # REMOVED: update_column_names and update_table_name handlers - use safe_rename_with_dependencies instead
                elif name == "check_date_table_exists":
                    result = await self._handle_check_date_table_exists(arguments)
                elif name == "mark_as_date_table":
                    result = await self._handle_mark_as_date_table(arguments)
                elif name == "unmark_date_table":
                    result = await self._handle_unmark_date_table(arguments)
                elif name == "get_column_properties":
                    result = await self._handle_get_column_properties(arguments)
                elif name == "get_measure_properties":
                    result = await self._handle_get_measure_properties(arguments)
                elif name == "get_table_properties":
                    result = await self._handle_get_table_properties(arguments)
                elif name == "classify_all_measures_in_model":
                    result = await self._handle_classify_all_measures_in_model(arguments)
                elif name == "analyze_dependencies":
                    result = await self._handle_analyze_dependencies(arguments)
                elif name == "refresh_sql_endpoint":
                    result = await self._handle_refresh_sql_endpoint(arguments)
                elif name == "dataset_columns_analysis":
                    result = await self._handle_dataset_columns_analysis(arguments)
                elif name == "evaluate_measures_analysis":
                    result = await self._handle_evaluate_copilot_measures(arguments)
                elif name == "evaluate_security_compliance":
                    result = await self._handle_evaluate_security_compliance(arguments)
                elif name == "evaluate_fact_dimension_analysis":
                    result = await self._handle_evaluate_fact_dimension_analysis(arguments)
                elif name == "evaluate_metadata_analysis":
                    result = await self._handle_evaluate_metadata_analysis(arguments)
                elif name == "evaluate_table_linking":
                    result = await self._handle_evaluate_table_linking(arguments)
                elif name == "evaluate_table_hierarchies":
                    result = await self._handle_evaluate_table_hierarchies(arguments)
                elif name == "generate_model_diagram":
                    result = await self._handle_generate_model_diagram(arguments)    
                else:
                    logger.warning(f"Unknown tool: {name}")
                    return [TextContent(type="text", text=f"Unknown tool: {name}")]
                
                # Convert string result to TextContent
                return [TextContent(type="text", text=result)]
                
            except Exception as e:
                logger.error(f"Error executing {name}: {str(e)}", exc_info=True)
                return [TextContent(type="text", text=f"Error executing {name}: {str(e)}")]
    
