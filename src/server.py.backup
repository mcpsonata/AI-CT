    def get_security_roles_info(self) -> Dict[str, Any]:
        """
        Get comprehensive information about security roles defined in the model.
        
        Returns:
            Dictionary containing security roles information and RLS table details
        """
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        try:
            logger.info("🔐 Analyzing security roles in the model...")
            
            # Get all security roles
            roles_info = []
            tables_with_rls = []
            
            if hasattr(self.model, 'Roles') and self.model.Roles:
                for role in self.model.Roles:
                    role_info = {
                        "role_name": role.Name,
                        "description": getattr(role, 'Description', ''),
                        "members": [],
                        "table_permissions": []
                    }
                    
                    # Get role members if available
                    if hasattr(role, 'Members') and role.Members:
                        role_info["members"] = [member.MemberName for member in role.Members if hasattr(member, 'MemberName')]
                    
                    # Get table permissions and RLS filters
                    if hasattr(role, 'TablePermissions') and role.TablePermissions:
                        for table_perm in role.TablePermissions:
                            table_name = table_perm.Table.Name
                            filter_expression = getattr(table_perm, 'FilterExpression', '')
                            
                            perm_info = {
                                "table_name": table_name,
                                "filter_expression": filter_expression,
                                "has_rls": bool(filter_expression and filter_expression.strip())
                            }
                            
                            role_info["table_permissions"].append(perm_info)
                            
                            # Track tables with RLS
                            if perm_info["has_rls"] and table_name not in tables_with_rls:
                                tables_with_rls.append(table_name)
                    
                    roles_info.append(role_info)
                    logger.info(f"📋 Found role: {role.Name} with {len(role_info['table_permissions'])} table permissions")
            
            logger.info(f"✅ Found {len(roles_info)} security roles, {len(tables_with_rls)} tables with RLS")
            
            return {
                "total_roles": len(roles_info),
                "roles": roles_info,
                "tables_with_rls": tables_with_rls,
                "has_security_roles": len(roles_info) > 0,
                "rls_coverage": len(tables_with_rls)
            }
            
        except Exception as e:
            logger.error(f"Failed to analyze security roles: {e}")
            return {
                "total_roles": 0,
                "roles": [],
                "tables_with_rls": [],
                "has_security_roles": False,
                "rls_coverage": 0,
                "error": str(e)
            }
    
    def analyze_table_filtering_paths(self, source_table: str) -> pd.DataFrame:
        """
        Analyze which tables can be filtered from a source table through relationship paths.
        Follows exact Fabric/Spark logic from user's example.
        
        Args:
            source_table: Name of the source table to analyze filtering from
            
        Returns:
            pandas.DataFrame with columns: SourceTable, TargetTable, Path
        """
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        logger.info(f"🔍 Analyzing filtering paths from '{source_table}'...")
        
        # Build graph using exact Fabric logic
        graph = defaultdict(list)
        
        # Process all relationships following the exact Fabric pattern
        for rel in self.model.Relationships:
            if not rel.IsActive:
                continue
                
            from_table = rel.FromTable.Name
            to_table = rel.ToTable.Name
            
            # Get cross filtering behavior
            behavior = str(rel.CrossFilteringBehavior)
            
            # Get multiplicity - use FromCardinality and ToCardinality
            from_cardinality = str(rel.FromCardinality)
            to_cardinality = str(rel.ToCardinality)
            
            # Determine multiplicity string following Fabric pattern
            if from_cardinality == "Many" and to_cardinality == "One":
                multiplicity = "many to one"
            elif from_cardinality == "One" and to_cardinality == "Many":
                multiplicity = "one to many"
            elif from_cardinality == "One" and to_cardinality == "One":
                multiplicity = "one to one"
            elif from_cardinality == "Many" and to_cardinality == "Many":
                multiplicity = "many to many"
            else:
                multiplicity = f"{from_cardinality.lower()} to {to_cardinality.lower()}"
            
            logger.debug(f"Relationship: {from_table} -> {to_table}, Behavior: {behavior}, Multiplicity: {multiplicity}")
            
            # Apply exact Fabric logic for building graph
            if behavior == 'BothDirections':
                graph[from_table].append((to_table, 'bothDirections'))
                graph[to_table].append((from_table, 'bothDirections'))
                logger.debug(f"✅ Added bothDirections: {from_table} ↔ {to_table}")
            elif behavior == 'OneDirection' and multiplicity == 'many to one':
                # OneDirection with many to one - filter flows from "one" side to "many" side
                # So the "one" side (to_table) can filter the "many" side (from_table)
                graph[to_table].append((from_table, 'REVERSE'))
                logger.debug(f"✅ Added REVERSE: {to_table} -> {from_table}")
            else:
                logger.debug(f"⚠️ Skipped relationship {from_table} -> {to_table}: behavior='{behavior}', multiplicity='{multiplicity}'")
        
        # BFS following exact Fabric logic
        logger.info(f"🔄 Finding all filtering paths from '{source_table}'...")
        
        results = []
        visited = set()
        queue = deque()
        queue.append((source_table, [source_table]))
        
        while queue:
            current, path = queue.popleft()
            
            if current in visited:
                continue
            visited.add(current)
            
            # Explore all neighbors
            for neighbor, direction in graph[current]:
                if neighbor not in path:  # Avoid cycles
                    new_path = path + [neighbor]
                    results.append({
                        "SourceTable": source_table,
                        "TargetTable": neighbor,
                        "Direction": direction,
                        "Path": " -> ".join(new_path)
                    })
                    queue.append((neighbor, new_path))
        
        # Convert to final DataFrame format
        final_results = []
        for result in results:
            final_results.append({
                "SourceTable": result["SourceTable"],
                "TargetTable": result["TargetTable"],
                "Path": result["Path"]
            })
        
        # Convert to DataFrame and sort by TargetTable for consistent output
        df = pd.DataFrame(final_results)
        if not df.empty:
            df = df.sort_values("TargetTable").reset_index(drop=True)
            logger.info(f"✅ Found {len(df)} tables that can be filtered from '{source_table}'")
        else:
            logger.info(f"ℹ️ No filterable tables found from '{source_table}'")
        
        return df

class CopilotDataEvaluator:
    """
    Streamlined class for Power BI dataset column analysis.
    Generates one comprehensive CSV file with 14 focused columns for optimal analysis.
    """
    def __init__(self, tabular_editor: TabularEditor, sql_endpoint: SQLEndpoint):
        self.tabular_editor = tabular_editor
        self.sql_endpoint = sql_endpoint

    def _sanitize_filename(self, filename: str) -> str:
        """
        Sanitize filename by removing or replacing invalid characters for Windows file system.
        
        Args:
            filename: Original filename or path component
            
        Returns:
            Sanitized filename safe for Windows file system
        """
        import re
        
        # Define invalid characters for Windows filenames
        # < > : " | ? * are invalid, also control characters 0-31
        invalid_chars = ['<', '>', ':', '"', '|', '?', '*', '/', '\\']
        
        # Replace invalid characters with underscore
        sanitized = filename
        for char in invalid_chars:
            sanitized = sanitized.replace(char, '_')
            
        # Remove control characters (ASCII 0-31)
        sanitized = re.sub(r'[\x00-\x1f]', '_', sanitized)
        
        # Remove leading/trailing whitespace and dots (Windows doesn't like them)
        sanitized = sanitized.strip(' .')
        
        # Ensure filename isn't empty after sanitization
        if not sanitized or sanitized.replace('_', '').strip() == '':
            sanitized = 'Unknown'
            
        # Limit length to prevent path too long errors (Windows has 260 char limit)
        if len(sanitized) > 100:
            sanitized = sanitized[:100]
            
        return sanitized

    def _create_excel_with_formatting(self, df: pd.DataFrame, filename: str, issue_severity_column: str = 'Issue_Severity') -> tuple:
        """
        Create an Excel file with color formatting for Issue_Severity column.
        Also returns CSV text content for UI compatibility.
        
        Args:
            df: DataFrame to export to Excel
            filename: Name of the Excel file
            issue_severity_column: Name of the column containing severity values
            
        Returns:
            tuple: (excel_content_bytes, excel_filename, csv_text_content)
        """
        if not OPENPYXL_AVAILABLE:
            logger.error("openpyxl not available - cannot generate Excel files")
            return None, None
            
        try:
            # Create a new workbook and worksheet
            wb = Workbook()
            ws = wb.active
            ws.title = "Analysis Results"
            
            # Define color fills based on Issue_Severity values
            color_mapping = {
                'good': PatternFill(start_color="00B050", end_color="00B050", fill_type="solid"),    # Dark Green
                'critical': PatternFill(start_color="E63946", end_color="E63946", fill_type="solid"), # Dark Red
                'issue': PatternFill(start_color="1E6FE3", end_color="1E6FE3", fill_type="solid"),    # Dark Blue
                'warning': PatternFill(start_color="E6B800", end_color="E6B800", fill_type="solid")   # Dark Orange
            }
            
            # White font for better visibility on dark backgrounds
            white_font = Font(color="FFFFFF", bold=True)
            
            # Add DataFrame data to worksheet
            for r in dataframe_to_rows(df, index=False, header=True):
                ws.append(r)
            
            # Find the Issue_Severity column index if it exists
            severity_col_idx = None
            if issue_severity_column in df.columns:
                severity_col_idx = df.columns.get_loc(issue_severity_column) + 1  # openpyxl uses 1-based indexing
            
            # Apply formatting if Issue_Severity column exists
            if severity_col_idx:
                # Format header row
                for cell in ws[1]:
                    cell.font = Font(bold=True)
                
                # Apply color formatting to Issue_Severity column (skip header row)
                for row_idx in range(2, ws.max_row + 1):
                    cell = ws.cell(row=row_idx, column=severity_col_idx)
                    if cell.value:
                        cell_value = str(cell.value).lower().strip()
                        if cell_value in color_mapping:
                            cell.fill = color_mapping[cell_value]
                            cell.font = white_font
                
                logger.info(f"✅ Applied color formatting to {issue_severity_column} column in Excel file")
            else:
                logger.warning(f"⚠️ Column '{issue_severity_column}' not found - no color formatting applied")
            
            # Auto-adjust column widths
            for column in ws.columns:
                max_length = 0
                column_letter = column[0].column_letter
                for cell in column:
                    try:
                        if len(str(cell.value)) > max_length:
                            max_length = len(str(cell.value))
                    except:
                        pass
                adjusted_width = min(max_length + 2, 50)  # Cap at 50 characters
                ws.column_dimensions[column_letter].width = adjusted_width
            
            # Save to bytes buffer
            from io import BytesIO
            excel_buffer = BytesIO()
            wb.save(excel_buffer)
            excel_content = excel_buffer.getvalue()
            excel_buffer.close()
            
            # Change file extension to .xlsx
            excel_filename = filename.replace('.csv', '.xlsx')
            
            # Also create CSV text content for UI compatibility
            csv_text_content = df.to_csv(index=False, encoding='utf-8')
            
            logger.info(f"✅ Created Excel file with formatting: {excel_filename}")
            return excel_content, excel_filename, csv_text_content
            
        except Exception as e:
            logger.error(f"❌ Failed to create Excel file: {e}")
            return None, None, None

    def _save_excel_file(self, excel_content: bytes, excel_filename: str) -> str:
        """
        Save Excel content to KnowledgeBase folder.
        
        Args:
            excel_content: Excel file content as bytes
            excel_filename: Name of the Excel file
            
        Returns:
            str: Full path to saved Excel file
        """
        try:
            # Save to KnowledgeBase folder
            knowledge_base_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "KnowledgeBase")
            os.makedirs(knowledge_base_path, exist_ok=True)
            excel_file_path = os.path.join(knowledge_base_path, excel_filename)
            
            with open(excel_file_path, 'wb') as f:
                f.write(excel_content)
            
            logger.info(f"✅ Saved Excel file to: {excel_file_path}")
            return excel_file_path
            
        except Exception as e:
            logger.error(f"❌ Failed to save Excel file: {e}")
            return None

    def _check_cancellation(self, context: str = "analysis") -> bool:
        """
        Universal cancellation check for all analysis functions.
        Returns True if analysis should be cancelled, False if it should continue.
        """
        # Check _should_stop flag
        if hasattr(self, '_should_stop') and getattr(self, '_should_stop', False):
            logger.info(f"🛑 {context} stopped due to _should_stop flag")
            return True
            
        # Check cancellation event
        if hasattr(self, '_cancellation_event'):
            cancellation_event = getattr(self, '_cancellation_event')
            if cancellation_event and cancellation_event.is_set():
                logger.info(f"🛑 {context} cancelled due to cancellation_event")
                return True
                
        # Check _stop_requested flag (additional compatibility)
        if hasattr(self, '_stop_requested') and getattr(self, '_stop_requested', False):
            logger.info(f"🛑 {context} stopped due to _stop_requested flag")
            return True
            
        return False

    def get_dataset_table_count(self) -> int:
        """
        Get total count of tables in the connected dataset.
        Returns 0 if not connected or on error.
        """
        try:
            if not self.tabular_editor.connected:
                logger.warning("Tabular editor not connected - cannot get table count")
                return 0
            
            if not hasattr(self.tabular_editor, 'model') or not self.tabular_editor.model:
                logger.warning("Tabular model not available - cannot get table count")
                return 0
            
            tables = self.tabular_editor.model.Tables
            table_count = len(tables) if tables else 0
            logger.info(f"📊 Dataset contains {table_count} tables")
            return table_count
            
        except Exception as e:
            logger.error(f"Error getting dataset table count: {str(e)}")
            return 0

    # BACKWARD COMPATIBILITY METHODS FOR UI PROGRESS
    # These provide basic functionality while other functions are migrated to UIProgressTracker
    # TODO: Migrate all functions to use src/ui_progress_tracker.py
    
    def _send_progress_update(self, progress_callback, message: str, current: int, total: int):
        """Backward compatibility method - use UIProgressTracker for new code"""
        percentage = round((current / total) * 100, 1) if total > 0 else 0
        logger.info(f"📊 PROGRESS: {message} ({percentage}%)")
        
        if progress_callback and callable(progress_callback):
            try:
                progress_callback({
                    "type": "analysis_progress", 
                    "message": message,
                    "current": current,
                    "total": total,
                    "percentage": percentage
                })
            except Exception as e:
                logger.warning(f"Failed to send progress callback: {str(e)}")
    
    def _force_progress_update(self, message: str, current: int, total: int, analysis_type: str = "ANALYSIS"):
        """Backward compatibility method - use UIProgressTracker for new code"""
        percentage = round((current / total) * 100, 1) if total > 0 else 0
        logger.info(f"🔗 {analysis_type} PROGRESS: {message} ({percentage}%)")

    def Evaluate_Copilot_Measures(self, progress_callback=None) -> pd.DataFrame:
        """List all measures in the connected model with names, expressions, descriptions, and token estimations."""
        # Import required modules
        import tiktoken
        import os
        import io
        import time
        from datetime import datetime
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker
        
        # ================================================================================================
        # MAIN AI-POWERED MEASURES ANALYSIS - 8 PHASE PROCESS
        # ================================================================================================
        # Phase 1: Initial Setup & Validation
        # Phase 2: Data Collection & Preparation
        # Phase 3: Measure Context Building  
        # Phase 4: AI Batch Processing
        # Phase 5: Scoring & Categorization
        # Phase 6: CSV Generation & Storage
        # Phase 7: Statistical Analysis
        # Phase 8: Results Assembly
        # ================================================================================================
        
        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"measures_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing services")
            
            # Check TabularEditor connection to Power BI dataset
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Not connected to any dataset. Please connect first."}
        
            # Initialize the tokenizer for GPT-4o
            try:
                encoding = tiktoken.encoding_for_model("gpt-4o")
            except Exception:
                # Fallback to cl100k_base encoding if model-specific encoding fails
                encoding = tiktoken.get_encoding("cl100k_base")
            
            def get_ai_client():
                """Get Azure OpenAI client from authentication manager"""
                try:
                    auth_manager = AuthenticationManager.get_instance()
                    return auth_manager.get_openai_client()
                except Exception as e:
                    logger.error(f"Failed to get OpenAI client: {e}")
                    return None
            
            def _send_progress_update(self, progress_callback, message, current, total):
                """Send progress update if callback is available"""
                if progress_callback and callable(progress_callback):
                    try:
                        percentage = round((current / total) * 100, 1) if total > 0 else 0
                        progress_callback({
                            "type": "analysis_progress", 
                            "message": message,
                            "current": current,
                            "total": total,
                            "percentage": percentage
                        })
                    except Exception as e:
                        logger.warning(f"Failed to send progress callback: {str(e)}")

            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "Failed to initialize AI client. Please check authentication."}

            # Initialize CSV variables for consistent scoping (similar to dataset_columns_analysis)
            csv_content = None
            csv_file_path = None
            
            # ================================================================================================
            # PHASE 2: DATA COLLECTION & PREPARATION
            # ================================================================================================
            # Gather measure metadata and prepare data structures for AI analysis
            
            ui_tracker.set_phase("Data Collection & Preparation", "Gathering measure metadata from Power BI model")
            
            # Initialize data collection containers
            measures_data = []
            all_tables = self.tabular_editor.model.Tables
            total_tables = len(all_tables)
            
            logger.info(f"📊 Starting data collection from {total_tables} tables")
            
            # Process each table to collect comprehensive measure metadata
            for table_idx, table in enumerate(all_tables, 1):
                table_name = table.Name
                
                # Check for user cancellation before processing each table
                if self._check_cancellation(f"Measure analysis for table: {table_name}"):
                    logger.info(f"🛑 Analysis cancelled at table {table_idx}/{total_tables}: {table_name}")
                    break
                
                # Update progress for UI streaming  
                if progress_callback:
                    self._send_progress_update(progress_callback, f"Collecting measures from table {table_idx} of {total_tables}: {table_name}", table_idx-1, total_tables)
                
                for measure in table.Measures:
                    measure_name = measure.Name
                    expression = measure.Expression if hasattr(measure, 'Expression') and measure.Expression else ''
                    description = measure.Description if hasattr(measure, 'Description') and measure.Description else ''
                    
                    # Calculate token counts for individual fields
                    table_tokens = len(encoding.encode(table_name))
                    measure_tokens = len(encoding.encode(measure_name))
                    expression_tokens = len(encoding.encode(expression))
                    description_tokens = len(encoding.encode(description))
                    
                    # Calculate combined token count for this row
                    combined_text = f"Table: {table_name}, Measure: {measure_name}, Expression: {expression}, Description: {description}"
                    total_row_tokens = len(encoding.encode(combined_text))
                    
                    measures_data.append({
                        'Table': table_name,
                        'Measure': measure_name,
                        'Expression': expression,
                        'Description': description,
                        'Table_Tokens': table_tokens,
                        'Measure_Tokens': measure_tokens,
                        'Expression_Tokens': expression_tokens,
                        'Description_Tokens': description_tokens,
                        'Total_Row_Tokens': total_row_tokens
                    })
            
            df = pd.DataFrame(measures_data)
            
            # ================================================================================================
            # PHASE 3: MEASURE CONTEXT BUILDING
            # ================================================================================================
            # Build comprehensive measure analysis including references and context
            
            ui_tracker.set_phase("Measure Context Building", f"Building analysis context for {len(df)} measures")
        
            # Add duplicate detection columns using vectorized operations
            if len(df) > 0:
                # Use vectorized string operations to normalize expressions
                df['Normalized_Expression'] = df['Expression'].str.strip().str.lower().replace(r'\s+', ' ', regex=True)
                df['Has_Empty_Expression'] = df['Normalized_Expression'].eq('')
                
                # Create expression to measures mapping using groupby (more efficient than loops)
                non_empty_mask = ~df['Has_Empty_Expression']
                expression_counts = df.loc[non_empty_mask, 'Normalized_Expression'].value_counts()
                duplicate_expressions = expression_counts[expression_counts > 1].index
            
            # Use vectorized operations for duplicate detection AND direct reference detection
            df['Has_Duplicate'] = df['Normalized_Expression'].isin(duplicate_expressions).map({True: "Yes", False: "No"})
            df.loc[df['Has_Empty_Expression'], 'Has_Duplicate'] = "No"
            
            # Also mark direct measure references as duplicates (since they're problematic measures)
            # Pattern: Simple direct reference - just [MeasureName]
            direct_reference_mask = df['Normalized_Expression'].str.match(r'^\[([^\]]+)\]$', na=False)
            df.loc[direct_reference_mask, 'Has_Duplicate'] = "Yes"
            
            # Create duplicate measure names mapping (include both duplicates and direct references)
            duplicate_mapping = {}
            for expr in duplicate_expressions:
                measures_with_expr = df.loc[df['Normalized_Expression'] == expr, 'Measure'].tolist()
                duplicate_mapping[expr] = ", ".join(measures_with_expr)
            
            # Add direct references to the mapping
            direct_reference_measures = df.loc[direct_reference_mask, 'Measure'].tolist()
            if direct_reference_measures:
                duplicate_mapping['[Direct Reference]'] = ", ".join(direct_reference_measures)
            
            # Update the mapping for measures marked as duplicates
            for idx, row in df.iterrows():
                if row['Has_Duplicate'] == "Yes":
                    expr = row['Normalized_Expression']
                    if expr in duplicate_mapping:
                        df.loc[idx, 'Duplicate_Measure_Names'] = duplicate_mapping[expr]
                    elif direct_reference_mask.iloc[idx]:
                        # Extract the referenced measure name from the pattern [MeasureName]
                        match = re.match(r'^\[([^\]]+)\]$', expr)
                        if match:
                            referenced_measure = match.group(1)
                            df.loc[idx, 'Duplicate_Measure_Names'] = f"Direct reference to: {referenced_measure}"
                        else:
                            df.loc[idx, 'Duplicate_Measure_Names'] = "Direct reference to another measure"
                    else:
                        df.loc[idx, 'Duplicate_Measure_Names'] = ""
                else:
                    df.loc[idx, 'Duplicate_Measure_Names'] = ""
            
            # Detect measure references (qualified only)
            # Collect all measure names from the model for reference detection
            all_measure_names = set(df['Measure'].str.lower())
            
            # Create lists to store results
            has_qualified_measure_references = []
            qualified_referenced_measures = []
            
            for _, row in df.iterrows():
                expr = row['Normalized_Expression']
                current_measure = row['Measure'].lower()
                found_measures = set()
                
                if expr:
                    # Pattern: Only qualified measure references 'Table'[MeasureName] or Table[MeasureName]
                    qualified_pattern = r"(?:'[^']+'\s*\[([^\]]+)\]|[a-za-z_][a-za-z0-9_]*\s*\[([^\]]+)\])"
                    qualified_matches = re.findall(qualified_pattern, expr, re.IGNORECASE)
                    
                    # Clean and process qualified matches only
                    qualified_measure_matches = [match[0] or match[1] for match in qualified_matches]
                    
                    # Check if any qualified match is actually a measure name (excluding current measure)
                    for match in qualified_measure_matches:
                        clean_match = match.strip().lower()
                        if clean_match in all_measure_names and clean_match != current_measure:
                            found_measures.add(clean_match)
                
                # Store measure reference results
                if found_measures:
                    has_qualified_measure_references.append("Yes")
                    qualified_referenced_measures.append(", ".join(sorted(found_measures)))
                else:
                    has_qualified_measure_references.append("No")
                    qualified_referenced_measures.append("")
            
            # Add qualified measure columns to DataFrame
            df['Has_Qualified_Measure_References'] = has_qualified_measure_references
            df['Qualified_Referenced_Measures'] = qualified_referenced_measures
            
            # Detect ALL measure references (qualified + unqualified)
            has_all_measure_references = []
            all_referenced_measures = []
            
            for _, row in df.iterrows():
                expr = row['Normalized_Expression']
                current_measure = row['Measure'].lower()
                found_all_measures = set()
                
                if expr:
                    # Pattern 1: Qualified measure references 'Table'[MeasureName] or Table[MeasureName]
                    qualified_pattern = r"(?:'[^']+'\s*\[([^\]]+)\]|[a-za-z_][a-za-z0-9_]*\s*\[([^\]]+)\])"
                    qualified_matches = re.findall(qualified_pattern, expr, re.IGNORECASE)
                    
                    # Pattern 2: Unqualified measure references [MeasureName] (not preceded by table name or quote)
                    # This pattern looks for [content] that is NOT preceded by a table name or quote
                    unqualified_pattern = r"(?<!['a-za-z0-9_])\[([^\]]+)\]"
                    unqualified_matches = re.findall(unqualified_pattern, expr, re.IGNORECASE)
                    
                    # Process qualified matches
                    qualified_measure_matches = [match[0] or match[1] for match in qualified_matches]
                    for match in qualified_measure_matches:
                        clean_match = match.strip().lower()
                        if clean_match in all_measure_names and clean_match != current_measure:
                            found_all_measures.add(clean_match)
                    
                    # Process unqualified matches - exclude any that were already captured as qualified
                    qualified_measure_names = {match.strip().lower() for match in qualified_measure_matches}
                    for match in unqualified_matches:
                        clean_match = match.strip().lower()
                        if (clean_match in all_measure_names and 
                            clean_match != current_measure and 
                            clean_match not in qualified_measure_names):
                            found_all_measures.add(clean_match)
                
                # Store all measure reference results
                if found_all_measures:
                    has_all_measure_references.append("Yes")
                    all_referenced_measures.append(", ".join(sorted(found_all_measures)))
                else:
                    has_all_measure_references.append("No")
                    all_referenced_measures.append("")
            
            # Add all measure reference columns to DataFrame
            df['Has_All_Measure_References'] = has_all_measure_references
            df['All_Referenced_Measures'] = all_referenced_measures
            
            # Check if current measure is commonly referenced by others
            has_commonly_referenced = []
            
            # Get unique set of all referenced measure names across all measures
            all_unique_referenced_measures = set()
            for ref_measures_str in all_referenced_measures:
                if ref_measures_str:  # Not empty
                    # Split by comma and clean up measure names
                    measures = [m.strip().lower() for m in ref_measures_str.split(",")]
                    all_unique_referenced_measures.update(measures)
            
            # For each measure, check if its name appears in the unique set of referenced measures
            for _, row in df.iterrows():
                current_measure_name = row['Measure'].lower()
                if current_measure_name in all_unique_referenced_measures:
                    has_commonly_referenced.append("Yes")
                else:
                    has_commonly_referenced.append("No")
            
            # Add the commonly referenced column to DataFrame
            df['Has_Commonly_Used_Measure'] = has_commonly_referenced
            
            # Add explanation column for Has_Commonly_Used_Measure
            commonly_used_explanations = []
            
            for _, row in df.iterrows():
                current_measure_name = row['Measure'].lower()
                if current_measure_name in all_unique_referenced_measures:
                    # Find which measures reference this one
                    referencing_measures = []
                    for check_idx, check_row in df.iterrows():
                        if check_row['All_Referenced_Measures']:
                            referenced_names = [m.strip().lower() for m in check_row['All_Referenced_Measures'].split(",")]
                            if current_measure_name in referenced_names:
                                referencing_measures.append(check_row['Measure'])
                    
                    if referencing_measures:
                        explanation = f"Referenced by {len(referencing_measures)} measure(s): {', '.join(referencing_measures[:3])}"
                        if len(referencing_measures) > 3:
                            explanation += f" and {len(referencing_measures) - 3} more"
                    else:
                        explanation = "Found in referenced measures list but specific referencing measures not identified"
                else:
                    explanation = "Not referenced by any other measures in the model"
                
                commonly_used_explanations.append(explanation)
            
            df['Commonly_Used_Explanation'] = commonly_used_explanations
            
            # Create consolidated recommendations column
            consolidated_recommendations = []
            
            for i, row in df.iterrows():
                recommendations = []
                
                # Check for qualified measure references
                if row['Has_Qualified_Measure_References'] == "Yes":
                    referenced_measures = row['Qualified_Referenced_Measures']
                    recommendations.append(f"Please use unqualified measures references i.e., [Measure Name] instead of Fully Qualified reference i.e., Table[MeasureName] or 'Table'[MeasureName]. Referenced measures: {referenced_measures}")
                
                # Check for duplicate recommendation (now includes direct references)
                if row['Has_Duplicate'] == "Yes":
                    duplicate_reason = row['Duplicate_Measure_Names']
                    if "Direct reference to:" in duplicate_reason:
                        recommendations.append(f"DIRECT REFERENCE: This measure is a simple reference to another measure ({duplicate_reason}) - which will cause confusion to data agents. Please consider removing this measure.")
                    elif "Direct reference to another measure" in duplicate_reason:
                        recommendations.append(f"DIRECT REFERENCE: This measure is a simple reference to another measure - which will cause confusion to data agents. Please consider removing this measure.")
                    else:
                        recommendations.append(f"DUPLICATE EXPRESSION: This measure has identical expression to: {duplicate_reason}")
                
                # Add complexity recommendations if available and not default
                complexity_rec = row.get('Complexity_Recommendations', '')
                if complexity_rec and complexity_rec != "Formula follows Rule 4 complexity best practices":
                    recommendations.append(f"COMPLEXITY: {complexity_rec}")
                
                # Combine all recommendations
                if recommendations:
                    consolidated_recommendations.append(" | ".join(recommendations))
                else:
                    consolidated_recommendations.append("")
            
            # Add the consolidated recommendations column
            df['DAX_Recommendations'] = consolidated_recommendations
            
            # ================================================================================================
            # CONTEXT COLUMN CREATION
            # ================================================================================================
            # Create comprehensive context column with measure and referenced measures information
            
            # Create a lookup dictionary for all measures to get their details
            measure_context_lookup = {}
            for _, row in df.iterrows():
                measure_key = row['Measure'].lower()
                measure_context_lookup[measure_key] = {
                    "table": row['Table'],
                    "name": row['Measure'],
                    "expression": row['Expression'],
                    "description": row.get('Description', '')
                }
            
            # Build context column for each measure
            context_data = []
            for _, row in df.iterrows():
                # Start with main measure context
                main_context = f"{row['Measure']} -> {row['Table']} + {row['Expression']}"
                if row.get('Description', ''):
                    main_context += f" + {row['Description']}"
                
                # Add referenced measures context if available
                referenced_measures_str = row.get('All_Referenced_Measures', '')
                if referenced_measures_str:
                    referenced_contexts = []
                    referenced_names = [name.strip().lower() for name in referenced_measures_str.split(",")]
                    
                    for ref_name in referenced_names:
                        if ref_name in measure_context_lookup:
                            ref_info = measure_context_lookup[ref_name]
                            ref_context = f"{ref_info['name']} -> {ref_info['table']} + {ref_info['expression']}"
                            if ref_info['description']:
                                ref_context += f" + {ref_info['description']}"
                            referenced_contexts.append(ref_context)
                    
                    # Combine main context with referenced contexts
                    if referenced_contexts:
                        full_context = main_context + " | REFERENCES: " + ", ".join(referenced_contexts)
                    else:
                        full_context = main_context
                else:
                    full_context = main_context
                
                context_data.append(full_context)
            
            # Add the Context column to DataFrame
            df['Context'] = context_data
            
            logger.info(f"✅ Context column created with comprehensive measure and reference information")
            
            # Debug: Log examples of Context column format
            if len(df) > 0:
                logger.info("📋 Context Column Examples:")
                for i, (_, row) in enumerate(df.head(3).iterrows()):
                    context_preview = row['Context'][:200] + "..." if len(row['Context']) > 200 else row['Context']
                    logger.info(f"  Example {i+1}: {context_preview}")
                    
                # Count measures with references
                measures_with_refs = len(df[df['All_Referenced_Measures'] != ''])
                logger.info(f"📊 Measures with references: {measures_with_refs}/{len(df)} ({(measures_with_refs/len(df))*100:.1f}%)")

            # ================================================================================================
            # UNQUALIFIED MEASURES SCORING (INDEPENDENT COLUMNS)
            # ================================================================================================
            # Add independent scoring columns for measures without qualified references
            # If Has_Qualified_Measure_References = "No" then score = 0.2, if "Yes" then score = 0.0
            df['Unqualified_Measures_Score'] = df['Has_Qualified_Measure_References'].apply(
                lambda x: 0.2 if x == "No" else 0.0
            )
            
            # Add unique measure calculation scoring column
            # If Has_Duplicate = "Yes" then score = 0.0, if "No" then score = 0.2
            df['Unique_Measure_Calculation_Score'] = df['Has_Duplicate'].apply(
                lambda x: 0.0 if x == "Yes" else 0.2
            )
            
            # Add commonly used measure scoring column
            # If Has_Commonly_Used_Measure = "Yes" then score = 0.3, if "No" then score = 0.0
            df['Commonly_Used_Measure_Score'] = df['Has_Commonly_Used_Measure'].apply(
                lambda x: 0.3 if x == "Yes" else 0.0
            )
            
            logger.info("✅ Added independent scoring columns: Unqualified_Measures_Score, Unique_Measure_Calculation_Score, and Commonly_Used_Measure_Score")

            # ================================================================================================
            # RULE 4: MEASURE COMPLEXITY ANALYSIS (ML-004)
            # ================================================================================================
            
            def classify_measure_calculation(expression: str) -> str:
                """Classify the type of calculation used in a measure."""
                expression_lower = expression.lower()
                
                # Time intelligence functions
                time_intelligence_funcs = ['totalytd', 'totalmtd', 'totalqtd', 'sameperiodlastyear', 
                                          'previousmonth', 'previousyear', 'dateadd', 'datesytd',
                                          'datesmtd', 'datesqtd', 'parallelperiod']
                
                if any(func in expression_lower for func in time_intelligence_funcs):
                    return "time_intelligence"
                
                # Simple aggregations
                simple_agg_funcs = ['sum(', 'count(', 'average(', 'max(', 'min(', 'counta(', 'countrows(']
                if any(func in expression_lower for func in simple_agg_funcs) and len(expression) < 100:
                    return "simple_aggregation"
                
                # Ratio and percentage calculations
                ratio_funcs = ['divide(', 'percentage', '%', 'ratio']
                if any(func in expression_lower for func in ratio_funcs):
                    return "ratio_percentage"
                
                # Complex calculations (multiple functions, long expressions)
                if len(expression) > 200 or expression.count('(') > 5:
                    return "complex_calculation"
                
                # Calculated measures (has some business logic)
                if any(func in expression_lower for func in ['if(', 'switch(', 'calculate(', 'filter(']):
                    return "calculated_measure"
                
            
            def score_measure_complexity(expression: str, calc_type: str) -> float:
                """Score ML-004: Identify and classify complexity using existing classify_measure_calculation (0-1 scale)"""
                # Use the existing classification function for consistency
                if not calc_type:
                    calc_type = classify_measure_calculation(expression)
                
                # Score based on business-relevant calculation types
                # Scoring: High complexity = 0, Medium complexity = 0.5, Low complexity = 1.0
                complexity_scores = {
                    "simple_aggregation": 1.0,      # Low complexity - basic SUM, COUNT, etc. → 0.3 points
                    "ratio_percentage": 1.0,        # Low complexity - clear business logic → 0.3 points
                    "time_intelligence": 1.0,       # Low complexity - standard time calculations → 0.3 points
                    "calculated_measure": 0.5,      # Medium complexity - has business logic → 0.15 points
                    "complex_calculation": 0.0     # High complexity - needs careful handling → 0 points
                }
                
                base_score = complexity_scores.get(calc_type, 0.5)  # Default medium complexity score
                
                # Adjust based on expression complexity indicators
                # Bonus for well-structured expressions (only if not already high complexity)
                if base_score > 0.0 and '\n' in expression and len(expression) > 100:
                    base_score = min(1.0, base_score + 0.1)  # Bonus for good formatting
                
                # Penalty for overly complex expressions - force to high complexity (0 points)
                if len(expression) > 500:
                    base_score = 0.0  # High complexity - excessive length
                elif len(expression) > 300:
                    base_score = min(base_score, 0.5)  # Cap at medium complexity
                
                # Penalty for too many nested functions - force to high complexity (0 points)
                if expression.count('(') > 10:
                    base_score = 0.0  # High complexity - excessive nesting
                elif expression.count('(') > 7:
                    base_score = min(base_score, 0.5)  # Cap at medium complexity
                
                return max(0.0, min(1.0, base_score))  # Ensure 0-1 range
            
            # Apply complexity analysis to all measures
            df['Calculation_Type'] = df['Expression'].apply(classify_measure_calculation)
            complexity_scores = df.apply(
                lambda row: score_measure_complexity(row['Expression'], row['Calculation_Type']), 
                axis=1
            )
            
            # Scale complexity score to match other scoring columns (max 0.3 points for complexity management)
            df['Measure_Complexity_Score'] = complexity_scores * 0.3
            
            # Add Measure_Complexity_Level based on the raw complexity scores
            def get_complexity_level(complexity_score: float) -> str:
                """Convert 0-1 complexity score to Low/Medium/High level"""
                if complexity_score >= 0.8:
                    return "Low"
                elif complexity_score >= 0.4:
                    return "Medium"
                else:
                    return "High"
            
            df['Measure_Complexity_Level'] = complexity_scores.apply(get_complexity_level)
            
            # Add Measure_Complexity_Explanation based on analysis factors
            def generate_complexity_explanation(expression: str, calc_type: str, complexity_score: float) -> str:
                """Generate detailed explanation for complexity classification"""
                explanations = []
                
                # Base calculation type explanation
                if calc_type == "simple_aggregation":
                    explanations.append("Simple aggregation function (SUM, COUNT, AVERAGE, etc.)")
                elif calc_type == "ratio_percentage":
                    explanations.append("Ratio or percentage calculation with clear business logic")
                elif calc_type == "time_intelligence":
                    explanations.append("Time intelligence function (standard date/time calculations)")
                elif calc_type == "calculated_measure":
                    explanations.append("Calculated measure with intermediate business logic")
                elif calc_type == "complex_calculation":
                    explanations.append("Complex calculation with multiple operations and conditions")

                
                # Length-based factors
                expr_len = len(expression)
                if expr_len > 500:
                    explanations.append(f"Excessively long expression ({expr_len} characters)")
                elif expr_len > 300:
                    explanations.append(f"Long expression ({expr_len} characters)")
                elif expr_len > 100:
                    explanations.append(f"Moderate length expression ({expr_len} characters)")
                
                # Nesting complexity
                nesting_count = expression.count('(')
                if nesting_count > 10:
                    explanations.append(f"Excessive function nesting ({nesting_count} nested functions)")
                elif nesting_count > 7:
                    explanations.append(f"High function nesting ({nesting_count} nested functions)")
                elif nesting_count > 3:
                    explanations.append(f"Moderate function nesting ({nesting_count} nested functions)")
                
                # Formatting quality
                if '\n' in expression and expr_len > 100:
                    explanations.append("Well-formatted with line breaks")
                elif expr_len > 100 and '\n' not in expression:
                    explanations.append("Single-line format reduces readability")
                
                # Final complexity determination
                if complexity_score >= 0.8:
                    complexity_reason = "Low complexity due to simple structure and clear purpose"
                elif complexity_score >= 0.4:
                    complexity_reason = "Medium complexity due to moderate business logic or formatting"
                else:
                    complexity_reason = "High complexity due to complex logic, poor structure, or unclear purpose"
                
                # Combine all explanations
                all_explanations = "; ".join(explanations)
                return f"{complexity_reason}. Details: {all_explanations}" if all_explanations else complexity_reason
            
            df['Measure_Complexity_Explanation'] = df.apply(
                lambda row: generate_complexity_explanation(
                    row['Expression'], 
                    row['Calculation_Type'], 
                    complexity_scores[row.name]
                ), 
                axis=1
            )
            
            # Add complexity recommendations based on calculation type and score
            def generate_complexity_recommendations(calc_type: str, complexity_score: float, expression: str) -> str:
                """Generate specific recommendations for measure complexity management"""
                recommendations = []
                expr_upper = expression.upper()
                
                # DAX structure recommendations (specific formatting)
                if complexity_score == 0.0:
                    recommendations.append("CRITICAL - High complexity measure needs restructuring and simplification")
                
                if len(expression) > 200 and '\n' not in expression:
                    recommendations.append("Break long formula into multiple lines for readability")
                
                if 'CALCULATE(' in expr_upper and '\n' not in expression:
                    recommendations.append("Format CALCULATE function: CALCULATE(\\n    expression,\\n    filter1,\\n    filter2\\n)")
                
                if 'FILTER(' in expr_upper and '\n' not in expression:
                    recommendations.append("Break FILTER statements into multiple lines with proper indentation")
                
                if 'SUM(' in expr_upper and len(expression) > 50 and '\n' not in expression:
                    recommendations.append("Format SUM expressions with line breaks when part of complex calculations")
                
                # Specific DAX improvements
                if '/' in expression and 'DIVIDE(' not in expr_upper:
                    recommendations.append("Replace division operator (/) with DIVIDE() function for error handling")
                
                if 'IF(' in expr_upper and 'SWITCH(' not in expr_upper and expression.count('IF(') > 2:
                    recommendations.append("Consider using SWITCH() instead of nested IF() statements")
                
                # Calculation type specific recommendations
                if calc_type == "undocumented":
                    recommendations.append("CRITICAL - Add clear business documentation and consider simplifying unclear calculation pattern")
                elif calc_type == "complex_calculation":
                    recommendations.append("CRITICAL - Break complex calculation into multiple simpler measures for better maintainability")
                elif calc_type == "calculated_measure" and complexity_score <= 0.5:
                    recommendations.append("Consider simplifying business logic or adding better documentation")
                
                return "; ".join(recommendations) if recommendations else "Formula follows measure complexity best practices"
            
            df['Complexity_Recommendations'] = df.apply(
                lambda row: generate_complexity_recommendations(
                    row['Calculation_Type'], 
                    complexity_scores[row.name],  # Use the complexity_scores series directly
                    row['Expression']
                ), 
                axis=1
            )
            
            logger.info("✅ Added Rule 4 Complexity Analysis: Calculation_Type, Measure_Complexity_Score, Measure_Complexity_Level, and Complexity_Recommendations")

            # ================================================================================================
            # AI-POWERED MEASURE QUALITY ANALYSIS
            # ================================================================================================
            # Analyze measures using GPT-4o for 3 specific criteria with intelligent batch processing
            
            def create_measure_analysis_prompt() -> str:
                """Create specialized prompt for AI measure analysis"""
                return """You are an expert Power BI analyst specializing in measure quality assessment. Analyze each measure against these EXACT 3 criteria:

SCORING RULES (Positive scoring - higher scores = better quality):

1. SELF-EXPLANATORY CHECK (Max Score: 0.2)
   - Input: Measure name and comprehensive Context column
   - Logic: If measure name is self-explanatory given the full context = 0.2 score, if NOT self-explanatory = 0.0 score
   - A measure is self-explanatory if someone can reasonably understand its general purpose from the name, considering the business context
   - CRITICAL: Use the Context column which contains: "Measure Name -> Table + Expression + Description | REFERENCES: Referenced measures with their full details"
   - BE REASONABLE: Names like "CurrentUserAliasQuotaCheck", "Select Top Filters", "Date Grain Link" are SELF-EXPLANATORY because:
     * "CurrentUserAliasQuotaCheck" clearly indicates it checks quota for current user alias
     * "Select Top Filters" clearly indicates it selects top filters
     * "Date Grain Link" clearly indicates it links date grains
   - IMPORTANT: Give credit for descriptive names that indicate their general purpose, even if not 100% detailed
   - LIBERAL INTERPRETATION: If the name gives a reasonable indication of what it does, award 0.2 score
   - SPECIAL CASE: For measures that return static icons, Unicode characters, emojis, or simple static strings (like "✓", "📊", "Information", etc.), always award 0.2 score as these are visual/reporting elements with clear purpose
   - ONLY penalize truly cryptic names like "X1", "Calc", "Temp", "ABC123" that give no indication of purpose

2. NAME REFLECTS EXPRESSION/DESCRIPTION (Max Score: 0.4)  
   - Input: Measure name and comprehensive Context column
   - Logic: If measure name reasonably reflects what the Context shows it calculates = 0.4 score, if NOT reflecting = 0.0 score
   - Check if the measure name gives a reasonable indication of the business calculation shown in the Context
   - CRITICAL: The Context column contains the full business logic including referenced measures - use this complete picture to judge if the name reflects the actual calculation
   - BE REASONABLE: Names don't need to describe every technical detail of the expression
   - LIBERAL INTERPRETATION: If the name indicates the general purpose or business function, award 0.4 score
   - Example: "CurrentUserAliasQuotaCheck" reflects checking quotas even if it doesn't mention specific filter logic on TPIDTxt or TP Name Search
   - IMPORTANT: Focus on business purpose, not technical implementation details
   - SPECIAL CASE: For measures returning static icons/strings, always award 0.4 score as the name typically indicates the visual element purpose
   - ONLY penalize when the name gives NO indication of what the measure actually does business-wise

3. AVOID CRYPTIC/ABBREVIATIONS (Max Score: 0.4)
   - Input: Measure name only - STRICTLY analyze ONLY the measure name itself
   - Logic: If NO cryptic abbreviations found = 0.4 score, if CRYPTIC abbreviations found = 0.0 score
   - If you cannot clearly determine from measure name alone = 0.4 score (default to max)
   - BE REASONABLE: Common, well-understood abbreviations are ACCEPTABLE and should get 0.4 score:
     * "#" for "Number of" (universally understood)
     * "TXT" for "Text" (widely used in tech/business)
     * "LINE" for "Line" (clear business term)
     * "Alias" (standard business/tech term)
     * "ID" for "Identifier" (universally understood)
     * "Qty" for "Quantity" (standard business abbreviation)
     * Microsoft Business Abbreviations (ALL ACCEPTABLE - 0.4 score):
       - TPID (Top Parent ID), ACR (Azure Consumed Revenue), ACA (Azure Customer Adds)
       - AHR (Azure Health Report), AM (Account Manager), ATQ (Adjusted Time Quarter)
       - ATU (Account Team Unit), AVG (Average), CEMA (Central and Eastern Europe, Middle East, and Africa)
       - CQ (Current Quarter), CSAM (Customer Success Account Manager), CSP (Cloud Solution Provider)
       - DAU (Daily Active Users), DBF (Deal Based Forecast), ECIF (End Customer Investment Funding)
       - EMEA HQ (Europe, Middle East, and Africa Headquarters), EOP (End of Period)
       - GISV (Global Independent Software Vendors), GTM (Go-To Market), HLS (Health and Life Sciences)
       - MACC (Microsoft Azure Commit to Consume), MAL (Managed Account List), MAU (Monthly Active Users)
       - MPN (Microsoft Partner Network), NNR (Net New Revenue), PAU (Paid Active Users)
       - PBOVTB (Pipeline Based Outlook Variance to Budget), QPC (Qualified Pipeline Coverage)
       - SKU (Stock Keeping Unit), TTM (Trailing Twelve Months), VTB (Variance to Budget)
       - YOY (Year over Year), YTD (Year to Date)
   - ONLY penalize truly cryptic abbreviations that are unclear and not in the acceptable list above
   - Good (0.4): "# of Customers", "User Alias Check", "TXT Field", "Line Items", "Customer ID", "TPID Count", "ACR Revenue", "YTD Sales", "AVG Rating"
   - Bad (0.0): "TotSls", "CustAvg", "RevGrwth", "PipelineTgt" (unless they contain acceptable abbreviations listed above)
   - Focus on abbreviations that make names genuinely unclear, not standard business terms or Microsoft-specific abbreviations

CRITICAL RULE: Always examine the Context column BEFORE scoring. The Context column contains the complete business logic including all referenced measures. Use this comprehensive context to determine if measure names are self-explanatory and reflect their actual calculations. Generic names are acceptable if the context makes their purpose clear.

For each measure, return this EXACT JSON structure:
{
  "measure_name": "original_name",
  "table_name": "table_name",
  "is_self_explanatory_score": 0.2 or 0.0,
  "self_explanatory_explanation": "ALWAYS provide explanation - if score = 0.2 explain WHY it is self-explanatory, if score = 0.0 explain WHY it is not self-explanatory",
  "name_reflects_expression_score": 0.4 or 0.0,
  "name_reflects_explanation": "ALWAYS provide explanation - if score = 0.4 explain WHY the name reflects the calculation, if score = 0.0 explain WHY it does not reflect the calculation", 
  "avoid_abbreviations_score": 0.4 or 0.0,
  "abbreviations_explanation": "ALWAYS provide explanation - if score = 0.4 explain WHY there are no problematic abbreviations, if score = 0.0 explain WHICH abbreviations are problematic"
}

Return JSON with "results" array containing analysis for all measures."""
            
            def estimate_optimal_batch_size(total_tokens: int, measures_count: int) -> int:
                """Estimate optimal batch size based on token analysis with output token limits"""
                if measures_count == 0:
                    return 10
                
                avg_tokens_per_measure = total_tokens / measures_count
                
                # GPT-4o context window considerations with output token limits
                max_input_tokens = 100000  # Conservative limit for GPT-4o input
                max_output_tokens = 3500   # Maximum output tokens as specified
                prompt_overhead = 2000     # Tokens for system prompt and formatting
                
                # Calculate available tokens for input (reserve space for output)
                available_input_tokens = max_input_tokens - prompt_overhead
                
                # Estimate output tokens per measure (JSON structure ~150 tokens per measure)
                estimated_output_per_measure = 150
                
                # Calculate batch size limited by both input and output constraints
                # Adjust for additional context - referenced measures can significantly increase token count
                context_multiplier = 1.5  # Account for referenced measure context
                adjusted_avg_tokens = avg_tokens_per_measure * context_multiplier
                
                input_limited_batch = int(available_input_tokens / adjusted_avg_tokens)
                output_limited_batch = int(max_output_tokens / estimated_output_per_measure)
                
                # Use the more restrictive limit
                estimated_batch_size = min(input_limited_batch, output_limited_batch)
                
                # Apply reasonable bounds (minimum 2 for efficiency, maximum 15 for context-heavy batches)
                return max(2, min(estimated_batch_size, 15))
            
            def analyze_measures_with_ai_retry(client, measures_batch: list, max_retries: int = 3) -> list:
                """Analyze measures with automatic batch splitting on incomplete results"""
                
                def try_analysis(batch: list, attempt: int = 1) -> list:
                    try:
                        # Prepare measures data for AI analysis using the pre-built Context column
                        measures_for_ai = []
                        for measure_data in batch:
                            ai_measure = {
                                "table_name": measure_data.get("Table", ""),
                                "measure_name": measure_data.get("Measure", ""),
                                "context": measure_data.get("Context", "")
                            }
                            measures_for_ai.append(ai_measure)
                        
                        user_prompt = f"""You are analyzing Power BI measures. For each measure, you MUST examine its "context" field and use that comprehensive information to score accurately.

🚨 CRITICAL SCORING RULE: The "context" field contains the complete business logic including all referenced measures. Use this to determine if measure names are self-explanatory and reflect their calculations.

STEP-BY-STEP PROCESS (MANDATORY):
1. Read measure name: e.g., "Pipeline Target"
2. Examine context field: e.g., "Pipeline Target -> KPI + [QPC Goal] * 1.2 + Sales pipeline target | REFERENCES: QPC Goal -> Targets + SUM(Quota[Amount]) + Quarterly performance calculation"
3. Understand complete business purpose: Pipeline Target calculates sales targets using quarterly performance quotas
4. Score accordingly: Name becomes self-explanatory = 0.2, Name reflects calculation = 0.4

SCORING EXAMPLES:

GOOD SCORING (what you MUST do):
- "Pipeline Target" + context shows it calculates pipeline targets using quota measures → 0.2 (self-explanatory with context)
- "Revenue Variance" + context shows it calculates difference between actual and target revenue → 0.4 (name clearly reflects the calculation)

IMPORTANT: Generic names like "Target", "Goal", "Amount" are acceptable if the context makes their purpose clear and aligns with the actual calculation.

🚨 CRITICAL ABBREVIATION RULE: For avoid_abbreviations_score, ONLY look at the measure name itself. Do NOT consider context, expression, or description. If you cannot clearly determine from the measure name alone whether there are abbreviations, DEFAULT TO 0.4 (max score). Only give 0.0 when abbreviations are OBVIOUS and CLEAR in the measure name itself.

YOUR TASK: Use the context field to understand the complete business story, then score based on whether the name makes sense with that full context.

Measures to analyze:
{json.dumps(measures_for_ai, indent=2)}

Return JSON with "results" array containing analysis for ALL {len(measures_for_ai)} measures."""
                        
                        # Debug: Log the actual data being sent to AI for first batch
                        if attempt == 1 and len(batch) > 0:
                            logger.info(f"🤖 Sample AI input data for debugging:")
                            sample_measure = measures_for_ai[0] if measures_for_ai else {}
                            logger.info(f"   Measure: {sample_measure.get('measure_name', 'N/A')}")
                            context_preview = sample_measure.get('context', '')[:150] + "..." if len(sample_measure.get('context', '')) > 150 else sample_measure.get('context', '')
                            logger.info(f"   Context: {context_preview}")
                        
                        response = client.chat.completions.create(
                            model="gpt-4o",
                            messages=[
                                {"role": "system", "content": create_measure_analysis_prompt()},
                                {"role": "user", "content": user_prompt}
                            ],
                            temperature=0.1,
                            response_format={"type": "json_object"},
                            max_tokens=4000
                        )
                        
                        # Parse AI response
                        ai_response = json.loads(response.choices[0].message.content)
                        
                        # Extract results
                        if "results" in ai_response:
                            results = ai_response["results"]
                        elif isinstance(ai_response, list):
                            results = ai_response
                        else:
                            logger.warning(f"Unexpected AI response format: {list(ai_response.keys())}")
                            return []
                        
                        # Validate completeness - check if all measures got results
                        expected_count = len(batch)
                        actual_count = len(results)
                        
                        logger.info(f"🤖 AI Batch Analysis - Expected: {expected_count}, Got: {actual_count}")
                        
                        if actual_count >= expected_count * 0.8:  # Allow 20% tolerance
                            return results
                        else:
                            # Incomplete results - need to split batch
                            logger.warning(f"⚠️ Incomplete AI results: {actual_count}/{expected_count} measures analyzed")
                            return None  # Signal to split batch
                            
                    except Exception as e:
                        logger.error(f"AI analysis attempt {attempt} failed: {e}")
                        return None
                
                # Try analysis with current batch
                results = try_analysis(measures_batch)
                
                if results is not None:
                    return results
                
                # If batch is too small to split further, return partial results
                if len(measures_batch) <= 2:
                    logger.warning(f"Cannot split batch further ({len(measures_batch)} measures), attempting final retry")
                    try:
                        return try_analysis(measures_batch) or []
                    except:
                        return []
                
                # Split batch and process recursively
                logger.info(f"🔄 Splitting batch of {len(measures_batch)} measures into smaller chunks")
                mid = len(measures_batch) // 2
                left_batch = measures_batch[:mid]
                right_batch = measures_batch[mid:]
                
                # Process both halves
                left_results = analyze_measures_with_ai_retry(client, left_batch, max_retries)
                right_results = analyze_measures_with_ai_retry(client, right_batch, max_retries)
                
                # Combine results
                combined_results = left_results + right_results
                logger.info(f"✅ Combined split batches: {len(combined_results)} total results")
                return combined_results
            
            # ================================================================================================
            # PHASE 4: AI BATCH PROCESSING
            # ================================================================================================
            # Send measure data to GPT-4o in optimized batches for intelligent analysis
            
            # Only proceed with AI analysis if we have measures and AI client
            if len(df) > 0 and ai_client:
                # Configure batch processing parameters
                total_tokens = df['Total_Row_Tokens'].sum()
                measures_count = len(df)
                optimal_batch_size = estimate_optimal_batch_size(total_tokens, measures_count)
                
                logger.info(f"🤖 Starting AI analysis of {measures_count} measures in batches of {optimal_batch_size}")
                
                # Calculate total number of AI processing batches
                total_batches = (measures_count + optimal_batch_size - 1) // optimal_batch_size
                
                # Start analysis tracking with comprehensive information
                ui_tracker.start_analysis(
                    analysis_name="AI-Powered Measure Quality Analysis",
                    total_items=measures_count,
                    total_batches=total_batches
                )
                
                # Create batch progress tracker for detailed batch management
                batch_tracker = create_batch_tracker(ui_tracker, optimal_batch_size)
                
                ui_tracker.set_phase("AI Batch Processing", f"Processing {total_batches} batches with AI analysis")
                
                # Convert DataFrame to list of dictionaries for AI processing
                measures_for_analysis = df.to_dict('records')
                
                # Initialize tracking for completed measures
                self._completed_tables = set()
                
                # Process measures in batches with AI analysis
                all_ai_results = []
                
                # Process measures through GPT-4o in manageable batches
                for i in range(0, len(measures_for_analysis), optimal_batch_size):
                    batch_start = i
                    batch_end = min(i + optimal_batch_size, len(measures_for_analysis))
                    batch_measures = measures_for_analysis[batch_start:batch_end]
                    current_batch = (batch_start // optimal_batch_size) + 1
                    
                    # Check for user cancellation before each AI batch
                    if self._check_cancellation(f"AI analysis batch {current_batch}"):
                        ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                        break
                    
                    # Start batch processing with detailed tracking
                    batch_tracker.start_batch(current_batch, total_batches, batch_measures)
                    ui_tracker.set_phase("AI Batch Processing", f"Processing batch {current_batch} of {total_batches}")
                    
                    # Log batch processing message for UI parsing (specific pattern required by UI regex)
                    logger.info(f"🤖 MEASURES PROGRESS: AI analyzing batch {current_batch} of {total_batches} ({len(batch_measures)} measures)")
                    
                    # Also update UI tracker for comprehensive tracking
                    ui_tracker.update_progress(
                        f"Processing measures batch {current_batch} of {total_batches}",
                        current=current_batch,
                        total=total_batches
                    )
                    
                    # Debug: also try direct progress_callback if available
                    if progress_callback:
                        progress_callback(f"🤖 Processing AI Batch {current_batch}/{total_batches}")
                        logger.info(f"✅ Direct progress_callback called for batch {current_batch}/{total_batches}")
                    
                    # Analyze batch with automatic retry and splitting
                    batch_results = analyze_measures_with_ai_retry(ai_client, batch_measures)
                    all_ai_results.extend(batch_results)
                    
                    # Complete batch processing with comprehensive statistics using UI tracker
                    batch_tracker.complete_batch(
                        batch_number=current_batch,
                        total_batches=total_batches,
                        processing_results=batch_results
                    )
                    
                    logger.info(f"✅ Batch {current_batch} complete: {len(batch_results)} results")
                
                # Log processing completion for UI parsing (specific pattern required by UI regex)
                logger.info(f"🤖 MEASURES PROGRESS: Processed AI analysis of {total_batches} batches ({measures_count} measures)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Completed measure analysis - {measures_count} measures processed", 
                    current=total_batches,
                    total=total_batches
                )
                
                logger.info(f"🎯 AI Analysis Complete - Total Results: {len(all_ai_results)}/{len(df)} measures")
                
                # ================================================================================================
                # PHASE 5: SCORING & CATEGORIZATION  
                # ================================================================================================
                # Process AI responses and calculate severity levels based on scoring rules
                
                ui_tracker.set_phase("Scoring & Categorization", "Processing AI analysis results and calculating scores")
                
                # Initialize AI analysis columns with defaults
                df['Is_Self_Explanatory_Score'] = 0.0
                df['Self_Explanatory_Explanation'] = ""
                df['Name_Reflects_Expression_Score'] = 0.0  
                df['Name_Reflects_Explanation'] = ""
                df['Avoid_Abbreviations_Score'] = 0.0
                df['Abbreviations_Explanation'] = ""
                
                # Map AI results back to DataFrame
                ai_results_dict = {}
                for result in all_ai_results:
                    measure_name = result.get("measure_name", "")
                    table_name = result.get("table_name", "")
                    key = f"{table_name}|{measure_name}"
                    ai_results_dict[key] = result
                
                # Update DataFrame with AI results
                for idx, row in df.iterrows():
                    key = f"{row['Table']}|{row['Measure']}"
                    if key in ai_results_dict:
                        ai_result = ai_results_dict[key]
                        
                        df.loc[idx, 'Is_Self_Explanatory_Score'] = float(ai_result.get('is_self_explanatory_score', 0.0))
                        df.loc[idx, 'Self_Explanatory_Explanation'] = ai_result.get('self_explanatory_explanation', '')
                        df.loc[idx, 'Name_Reflects_Expression_Score'] = float(ai_result.get('name_reflects_expression_score', 0.0))
                        df.loc[idx, 'Name_Reflects_Explanation'] = ai_result.get('name_reflects_explanation', '')
                        df.loc[idx, 'Avoid_Abbreviations_Score'] = float(ai_result.get('avoid_abbreviations_score', 0.0))
                        df.loc[idx, 'Abbreviations_Explanation'] = ai_result.get('abbreviations_explanation', '')
                
                logger.info(f"✅ AI analysis integrated into DataFrame - {len(ai_results_dict)} measures updated")
                
            else:
                if len(df) == 0:
                    logger.info("No measures to analyze")
                else:
                    logger.warning("AI client not available - skipping AI analysis")
                
                # Initialize empty AI columns if no analysis performed
                df['Is_Self_Explanatory_Score'] = 0.0
                df['Self_Explanatory_Explanation'] = ""
                df['Name_Reflects_Expression_Score'] = 0.0  
                df['Name_Reflects_Explanation'] = ""
                df['Avoid_Abbreviations_Score'] = 0.0
                df['Abbreviations_Explanation'] = ""

            # ================================================================================================
            # FINAL SCORE CALCULATION - SUM OF ALL INDIVIDUAL SCORES
            # ================================================================================================
            # Add max score columns for each scoring column
            df['Unqualified_Measures_Max_Score'] = 0.2
            df['Unique_Measure_Calculation_Max_Score'] = 0.2
            df['Commonly_Used_Measure_Max_Score'] = 0.3
            df['Measure_Complexity_Max_Score'] = 0.3
            df['Is_Self_Explanatory_Max_Score'] = 0.2
            df['Name_Reflects_Expression_Max_Score'] = 0.4
            df['Avoid_Abbreviations_Max_Score'] = 0.4
            
            # Calculate overall score = sum of all individual score columns
            df['Overall_Score'] = (
                df['Unqualified_Measures_Score'] + 
                df['Unique_Measure_Calculation_Score'] + 
                df['Commonly_Used_Measure_Score'] + 
                df['Measure_Complexity_Score'] + 
                df['Is_Self_Explanatory_Score'] + 
                df['Name_Reflects_Expression_Score'] + 
                df['Avoid_Abbreviations_Score']
            )
            
            # Calculate max overall score = sum of all max score columns
            df['Max_Score'] = (
                df['Unqualified_Measures_Max_Score'] + 
                df['Unique_Measure_Calculation_Max_Score'] + 
                df['Commonly_Used_Measure_Max_Score'] + 
                df['Measure_Complexity_Max_Score'] + 
                df['Is_Self_Explanatory_Max_Score'] + 
                df['Name_Reflects_Expression_Max_Score'] + 
                df['Avoid_Abbreviations_Max_Score']
            )
            
            # Calculate confidence score = overall score / max overall score
            df['Confidence_Score'] = df['Overall_Score'] / df['Max_Score']

            # ================================================================================================
            # ISSUE SEVERITY CALCULATION
            # ================================================================================================
            # Apply severity categorization based on Confidence_Score (0-1 scale)
            
            def determine_measure_severity(confidence: float) -> tuple:
                """Determine severity based on confidence score (0-1 scale)"""
                if confidence < 0.59:
                    return "critical", 1, "RED", "#FF0000"    # <59% - Severe quality issues, immediate attention required
                elif 0.60 <= confidence <= 0.74:
                    return "issue", 2, "ORANGE", "#FFA500"    # 60-74% - Significant problems that need fixing
                elif 0.75 <= confidence <= 0.84:
                    return "warning", 3, "YELLOW", "#FFFF00"  # 75-84% - Minor improvements recommended
                else:  # 0.85 and above
                    return "good", 4, "GREEN", "#00FF00"      # 85%+ - Good quality, meets best practices
            
            # Apply severity determination to all measures (only keep Issue_Severity column)
            severity_data = df['Confidence_Score'].apply(determine_measure_severity)
            df['Issue_Severity'] = [s[0] for s in severity_data]
            # Note: Removed Severity_Priority, Severity_Color_Code, and Severity_Hex_Color columns as they are no longer needed in CSV

            # Add Recommendations column based on explanation columns (inline without separate function)
            # Only include recommendations when individual scores are below maximum values
            recommendations_list = []
            for _, row in df.iterrows():
                recommendations = []
                
                # Use actual content from explanation columns only when scores are below maximum
                
                # 1. Measure_Complexity_Explanation - only if Measure_Complexity_Score < 0.3 (max score)
                if row['Measure_Complexity_Score'] < row['Measure_Complexity_Max_Score']:
                    if pd.notna(row.get('Measure_Complexity_Explanation', '')) and str(row.get('Measure_Complexity_Explanation', '')).strip():
                        complexity_exp = str(row['Measure_Complexity_Explanation']).strip()
                        if complexity_exp and complexity_exp != 'nan':
                            recommendations.append(f"Complexity: {complexity_exp}")
                
                # 2. Complexity_Recommendations - only if Measure_Complexity_Score < max score
                if row['Measure_Complexity_Score'] < row['Measure_Complexity_Max_Score']:
                    if pd.notna(row.get('Complexity_Recommendations', '')) and str(row.get('Complexity_Recommendations', '')).strip():
                        complexity_rec = str(row['Complexity_Recommendations']).strip()
                        if complexity_rec and complexity_rec != 'nan':
                            recommendations.append(f"Complexity Action: {complexity_rec}")
                
                # 3. Commonly_Used_Explanation - only if Commonly_Used_Measure_Score < 0.3 (max score)
                if row['Commonly_Used_Measure_Score'] < row['Commonly_Used_Measure_Max_Score']:
                    if pd.notna(row.get('Commonly_Used_Explanation', '')) and str(row.get('Commonly_Used_Explanation', '')).strip():
                        common_exp = str(row['Commonly_Used_Explanation']).strip()
                        if common_exp and common_exp != 'nan':
                            recommendations.append(f"Pattern Usage: {common_exp}")
                
                # 4. DAX_Recommendations - only if related scores are below max (general DAX recommendations)
                if (row['Measure_Complexity_Score'] < row['Measure_Complexity_Max_Score'] or 
                    row['Commonly_Used_Measure_Score'] < row['Commonly_Used_Measure_Max_Score']):
                    if pd.notna(row.get('DAX_Recommendations', '')) and str(row.get('DAX_Recommendations', '')).strip():
                        dax_rec = str(row['DAX_Recommendations']).strip()
                        if dax_rec and dax_rec != 'nan':
                            recommendations.append(f"DAX Improvement: {dax_rec}")
                
                # 5. Self_Explanatory_Explanation - only if Is_Self_Explanatory_Score < 0.2 (max score)
                if row['Is_Self_Explanatory_Score'] < row['Is_Self_Explanatory_Max_Score']:
                    if pd.notna(row.get('Self_Explanatory_Explanation', '')) and str(row.get('Self_Explanatory_Explanation', '')).strip():
                        self_exp = str(row['Self_Explanatory_Explanation']).strip()
                        if self_exp and self_exp != 'nan':
                            recommendations.append(f"Self-Explanatory: {self_exp}")
                
                # 6. Name_Reflects_Explanation - only if Name_Reflects_Expression_Score < 0.4 (max score)
                if row['Name_Reflects_Expression_Score'] < row['Name_Reflects_Expression_Max_Score']:
                    if pd.notna(row.get('Name_Reflects_Explanation', '')) and str(row.get('Name_Reflects_Explanation', '')).strip():
                        name_exp = str(row['Name_Reflects_Explanation']).strip()
                        if name_exp and name_exp != 'nan':
                            recommendations.append(f"Name Clarity: {name_exp}")
                
                # 7. Abbreviations_Explanation - only if Avoid_Abbreviations_Score < 0.4 (max score)
                if row['Avoid_Abbreviations_Score'] < row['Avoid_Abbreviations_Max_Score']:
                    if pd.notna(row.get('Abbreviations_Explanation', '')) and str(row.get('Abbreviations_Explanation', '')).strip():
                        abbrev_exp = str(row['Abbreviations_Explanation']).strip()
                        if abbrev_exp and abbrev_exp != 'nan':
                            recommendations.append(f"Abbreviations: {abbrev_exp}")
                
                # 8. Technical quality issues - only if scores are below max
                if row['Unqualified_Measures_Score'] < row['Unqualified_Measures_Max_Score']:
                    recommendations.append("Technical: Use unqualified measure references (e.g., [Measure Name] instead of Table[Measure Name])")
                
                if row['Unique_Measure_Calculation_Score'] < row['Unique_Measure_Calculation_Max_Score']:
                    if row['Has_Duplicate'] == "Yes":
                        recommendations.append("Technical: Remove duplicate measure - this calculation already exists elsewhere in the model")
                
                # Join recommendations with " | " separator for readability
                recommendations_list.append(" | ".join(recommendations) if recommendations else "No specific recommendations")
            
            df['Recommendations'] = recommendations_list

            logger.info(f"📊 Measure Quality Analysis Complete - {len(df)} measures processed")
            
            # ================================================================================================
            # COLUMN CLEANUP - Remove unwanted columns before CSV generation
            # ================================================================================================
            # Clean up temporary columns, individual recommendation columns, and token columns
            columns_to_drop = [
                'Normalized_Expression', 'Has_Empty_Expression',
                # Remove all token columns as requested
                'Table_Tokens', 'Measure_Tokens', 'Expression_Tokens', 
                'Description_Tokens', 'Total_Row_Tokens',
                # Remove the raw Complexity_Score column (keep only Measure_Complexity_Score and Measure_Complexity_Level)
                'Complexity_Score',
                # Remove Context column from final CSV (but keep available for AI analysis)
                'Context'
            ]
            # Debug: Log which columns are being dropped
            existing_columns_to_drop = [col for col in columns_to_drop if col in df.columns]
            if existing_columns_to_drop:
                logger.info(f"🧹 Removing columns from final CSV: {', '.join(existing_columns_to_drop)}")
            df.drop(existing_columns_to_drop, axis=1, inplace=True)
            
            # Debug: Log final column count and verify no unwanted columns remain
            remaining_columns = df.columns.tolist()
            unwanted_remaining = [col for col in columns_to_drop if col in remaining_columns]
            if unwanted_remaining:
                logger.warning(f"⚠️ Some unwanted columns still remain: {', '.join(unwanted_remaining)}")
            logger.info(f"📊 Final CSV will contain {len(remaining_columns)} columns")
            
            # ================================================================================================
            # COLUMN REORDERING - Organize columns for better readability
            # ================================================================================================
            # Reorder columns: basic info -> issue severity -> analysis columns -> individual scores -> overall scores -> recommendations at the very end
            desired_column_order = [
                # Basic measure information
                'Table', 'Measure', 'Expression', 'Description',
                
                # Issue severity information (right after description)
                'Issue_Severity',
                
                # Analysis columns
                'Has_Duplicate', 'Duplicate_Measure_Names',
                'Has_Qualified_Measure_References', 'Qualified_Referenced_Measures',
                'Has_All_Measure_References', 'All_Referenced_Measures',
                'Measure_Complexity_Level',  # Add complexity level after All_Referenced_Measures
                'Measure_Complexity_Explanation',  # Add complexity explanation as 13th column
                'Calculation_Type', 'Complexity_Recommendations',  # Add complexity analysis columns
                'Has_Commonly_Used_Measure', 'Commonly_Used_Explanation', 'DAX_Recommendations',
                
                # AI analysis explanations
                'Self_Explanatory_Explanation', 'Name_Reflects_Explanation', 'Abbreviations_Explanation',
                
                # Individual scores paired with their max scores
                'Unqualified_Measures_Score', 'Unqualified_Measures_Max_Score',
                'Unique_Measure_Calculation_Score', 'Unique_Measure_Calculation_Max_Score',
                'Commonly_Used_Measure_Score', 'Commonly_Used_Measure_Max_Score',
                'Measure_Complexity_Score', 'Measure_Complexity_Max_Score',
                'Is_Self_Explanatory_Score', 'Is_Self_Explanatory_Max_Score',
                'Name_Reflects_Expression_Score', 'Name_Reflects_Expression_Max_Score',
                'Avoid_Abbreviations_Score', 'Avoid_Abbreviations_Max_Score',
                
                # Overall scoring
                'Overall_Score', 'Max_Score', 'Confidence_Score',
                
                # Recommendations as the very last column
                'Recommendations'
            ]
            
            # Filter to only include columns that actually exist in the DataFrame
            existing_desired_columns = [col for col in desired_column_order if col in df.columns]
            
            # Add any remaining columns that weren't in our desired order (as fallback)
            remaining_cols = [col for col in df.columns if col not in existing_desired_columns]
            final_column_order = existing_desired_columns + remaining_cols
            
            # Reorder the DataFrame columns
            df = df[final_column_order]
            
            logger.info(f"✅ Reordered columns: Issue severity after description, scores paired with max scores at end")
            
            # ================================================================================================
            # PHASE 6: CSV GENERATION & STORAGE
            # ================================================================================================
            # Create downloadable CSV file and save to KnowledgeBase folder
            
            ui_tracker.set_phase("Excel Generation & Storage", "Generating Excel files and saving to KnowledgeBase")
            
            if len(df) > 0:
                # Get workspace information for file naming
                try:
                    workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
                    dataset_id = getattr(self.tabular_editor, 'current_database_id', 'Unknown')
                    workspace_name = getattr(self.tabular_editor, 'current_workspace', 'Unknown')
                    dataset_name = getattr(self.tabular_editor, 'current_database', 'Unknown')
                except:
                    workspace_id = dataset_id = workspace_name = dataset_name = 'Unknown'
                
                # Generate timestamped filename for unique identification
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                clean_workspace = self._sanitize_filename(workspace_name.replace(" ", "").replace("-", ""))
                clean_dataset = self._sanitize_filename(dataset_name.replace(" ", "").replace("-", ""))
                filename = f"AI_Measures_Analysis_{clean_workspace}_{clean_dataset}_{timestamp}.csv"
                
                # Create Excel file with color formatting for Issue_Severity column
                excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(df, filename, 'Issue_Severity')
                
                if excel_content and excel_filename and csv_text_content:
                    # Save Excel file to KnowledgeBase folder
                    excel_file_path = self._save_excel_file(excel_content, excel_filename)
                    if excel_file_path:
                        logger.info(f"✅ Generated AI-powered measures analysis Excel file: {excel_file_path}")
                        csv_content = csv_text_content  # Store CSV text for UI parsing
                        excel_content_for_result = excel_content  # Store Excel content for download
                        csv_file_path = excel_file_path
                        filename = excel_filename
                    else:
                        logger.error("❌ Failed to save Excel file")
                else:
                    logger.error("❌ Failed to create Excel file")

            # ================================================================================================
            # PHASE 7: STATISTICAL ANALYSIS
            # ================================================================================================
            # Calculate comprehensive summary statistics and generate insights
            
            ui_tracker.set_phase("Statistical Analysis", "Calculating summary statistics and generating insights")
            
            # Calculate core analysis metrics
            total_measures = len(df) if len(df) > 0 else 0
            total_tables_processed = len(set(result.get("Table", "Unknown") for result in df.to_dict('records'))) if len(df) > 0 else 0
            
            if len(df) > 0:
                # Aggregate severity distribution for executive summary
                severity_counts = {
                    "CRITICAL": len(df[df['Issue_Severity'] == 'critical']),
                    "ISSUE": len(df[df['Issue_Severity'] == 'issue']),
                    "WARNING": len(df[df['Issue_Severity'] == 'warning']),
                    "GOOD": len(df[df['Issue_Severity'] == 'good'])
                }
                avg_quality_score = df['Confidence_Score'].mean() * 100  # Convert to percentage
                
                # Calculate DAX pattern issue statistics
                dax_issue_counts = {
                    "Duplicates_and_Direct_References": len(df[df['Has_Duplicate'] == 'Yes']),
                    "Qualified_References": len(df[df['Has_Qualified_Measure_References'] == 'Yes'])
                }
                
                total_dax_issues = sum(dax_issue_counts.values())
                total_severity_issues = severity_counts["CRITICAL"] + severity_counts["ISSUE"] + severity_counts["WARNING"]
                
                # Log comprehensive analysis summary
                logger.info("=" * 80)
                logger.info("🎯 MEASURES ANALYSIS SUMMARY")
                logger.info("=" * 80)
                logger.info(f"📊 Total Measures Analyzed: {total_measures}")
                logger.info(f"📈 Average Quality Score: {avg_quality_score:.1f}%")
                logger.info("")
                logger.info("🚨 SEVERITY DISTRIBUTION:")
                logger.info(f"  🔴 CRITICAL: {severity_counts['CRITICAL']:>3} ({(severity_counts['CRITICAL']/total_measures)*100:>5.1f}%)")
                logger.info(f"  🟠 ISSUE:    {severity_counts['ISSUE']:>3} ({(severity_counts['ISSUE']/total_measures)*100:>5.1f}%)")
                logger.info(f"  🟡 WARNING:  {severity_counts['WARNING']:>3} ({(severity_counts['WARNING']/total_measures)*100:>5.1f}%)")
                logger.info(f"  🟢 GOOD:     {severity_counts['GOOD']:>3} ({(severity_counts['GOOD']/total_measures)*100:>5.1f}%)")
                logger.info(f"  📊 Total Issues: {total_severity_issues}/{total_measures} ({(total_severity_issues/total_measures)*100:.1f}%)")
                logger.info("")
                logger.info("⚡ DAX PATTERN ISSUES:")
                for issue_type, count in dax_issue_counts.items():
                    if count > 0:
                        logger.info(f"  • {issue_type.replace('_', ' ')}: {count}")
                logger.info(f"  📊 Total DAX Issues: {total_dax_issues}")
                logger.info("")
                
                if ai_client:
                    ai_analyzed = len([r for r in df.to_dict('records') if r.get('Is_Self_Explanatory_Score', 0) > 0 or r.get('Name_Reflects_Expression_Score', 0) > 0 or r.get('Avoid_Abbreviations_Score', 0) > 0])
                    logger.info(f"🤖 AI Analysis Coverage: {ai_analyzed}/{total_measures} measures ({(ai_analyzed/total_measures)*100:.1f}%)")
                else:
                    logger.info("🤖 AI Analysis: Not available (no OpenAI client)")
                    
                logger.info("=" * 80)

            # ================================================================================================
            # PHASE 8: RESULTS ASSEMBLY
            # ================================================================================================
            # Combine all analysis components into final structured response for webapp consumption
            
            ui_tracker.set_phase("Results Assembly", "Finalizing analysis results and summaries")
        
            if len(df) > 0:
                # Convert DataFrame to list of dictionaries for detailed analysis
                measures_data = df.to_dict('records')
                
                # Calculate summary statistics
                severity_counts = {
                    "CRITICAL": len(df[df['Issue_Severity'] == 'critical']),
                    "ISSUE": len(df[df['Issue_Severity'] == 'issue']), 
                    "WARNING": len(df[df['Issue_Severity'] == 'warning']),
                    "GOOD": len(df[df['Issue_Severity'] == 'good'])
                }
                
                total_measures = len(df)
                avg_quality_score = df['Confidence_Score'].mean() * 100
                
                # Format detailed issues for UI
                detailed_issues = {
                    "critical": [],
                    "issue": [],
                    "warning": []
                }
                
                for _, row in df.iterrows():
                    measure_name = row['Measure']
                    table_name = row['Table']
                    overall_score = row['Confidence_Score'] * 100
                    severity = row['Issue_Severity']
                    recommendations = row.get('DAX_Recommendations', '')
                    
                    # Create detailed issue description with DAX recommendations and AI reasoning
                    if severity in ['critical', 'issue', 'warning']:
                        issue_desc = f"**{measure_name}** (Table: {table_name})"
                        
                        # Add DAX recommendations if available
                        if recommendations and recommendations.strip():
                            issue_desc += f"\n  📋 DAX Issues: {recommendations}"
                        
                        # Add AI reasoning if available
                        ai_reasons = []
                        if pd.notna(row.get('Self_Explanatory_Explanation', '')) and row['Self_Explanatory_Explanation'].strip():
                            ai_reasons.append(f"Self-Explanatory: {row['Self_Explanatory_Explanation']}")
                        if pd.notna(row.get('Name_Reflects_Explanation', '')) and row['Name_Reflects_Explanation'].strip():
                            ai_reasons.append(f"Name Clarity: {row['Name_Reflects_Explanation']}")
                        if pd.notna(row.get('Abbreviations_Explanation', '')) and row['Abbreviations_Explanation'].strip():
                            ai_reasons.append(f"Abbreviations: {row['Abbreviations_Explanation']}")
                        
                        if ai_reasons:
                            issue_desc += f"\n  🤖 AI Analysis: {' | '.join(ai_reasons)}"
                        
                        detailed_issues[severity].append(issue_desc)
                
                # Generate key findings
                key_findings = []
                if severity_counts["CRITICAL"] > 0:
                    key_findings.append(f"• {severity_counts['CRITICAL']} measures have critical DAX quality issues requiring immediate attention")
                if severity_counts["ISSUE"] > 0:
                    key_findings.append(f"• {severity_counts['ISSUE']} measures have significant quality problems that need fixing")
                if severity_counts["WARNING"] > 0:
                    key_findings.append(f"• {severity_counts['WARNING']} measures have minor improvements needed")

                # Add DAX-specific findings
                dax_issues = []
                if len(df[df['Has_Duplicate'] == 'Yes']) > 0:
                    dax_issues.append(f"• {len(df[df['Has_Duplicate'] == 'Yes'])} measures have duplicate expressions or are direct references to other measures")

                if dax_issues:
                    key_findings.extend(dax_issues[:3])  # Add top 3 DAX issues
                    
                # Generate recommendations
                recommendations = []
                if severity_counts["CRITICAL"] > 0:
                    recommendations.append("Review and fix critical measures with duplicate expressions, direct references, or structural issues")
                if len(df[df['Has_Qualified_Measure_References'] == 'Yes']) > 0:
                    recommendations.append("Use unqualified measure references [MeasureName] instead of qualified 'Table'[MeasureName]")
                
                # Build comprehensive summary object
                summary = {
                    "analysis_type": "measures_analysis",
                    "overall_score": int(avg_quality_score),
                    "severity_distribution": severity_counts,
                    "detailed_issues": detailed_issues,
                    "key_findings": key_findings,  
                    "recommendations": recommendations  
                }
                
                # Build final result structure for UI compatibility
                result = {
                    "status": "success",
                    "total_measures_analyzed": total_measures,
                    "csv_filename": filename if 'filename' in locals() else f"measures_analysis_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv",
                    "csv_file_path": csv_file_path,
                    "csv_content": csv_content,  # CSV text for UI parsing
                    "summary": summary,
                    "measures_data": measures_data,
                    "ai_powered": True,
                    "model_used": "gpt-4o"
                }
                
                # Add Excel content if available
                if 'excel_content_for_result' in locals():
                    result["excel_content"] = excel_content_for_result  # Excel binary for download
                
                # Generate high-level summary for dashboard display  
                high_level_summary = {
                    "analysis_type": "measures_analysis",
                    "overall_score": int(avg_quality_score),
                    "detailed_issues": detailed_issues,
                    "key_findings": key_findings[:5],
                    "recommendations": recommendations[:5],
                    "severity_distribution": severity_counts
                }
                
                # Attach high-level summary to main result
                result["high_level_summary"] = high_level_summary
                
                # Complete analysis tracking with comprehensive statistics
                analysis_stats = ui_tracker.complete_analysis(
                    success=True,
                    summary=f"Successfully analyzed {total_measures} measures from {total_tables_processed} tables",
                    results_data={
                        "total_measures": total_measures,
                        "total_tables": total_tables_processed,
                        "csv_filename": filename,
                        "severity_distribution": summary.get("severity_distribution", {}),
                        "overall_score_percentage": summary.get("overall_score", 0)
                    }
                )
                
                # Add analysis statistics to result
                result["analysis_statistics"] = analysis_stats
                
                logger.info(f"✅ Structured result created with {total_measures} measures for UI consumption")
                return result
            
            else:
                # No measures found
                analysis_stats = ui_tracker.complete_analysis(
                    success=True,
                    summary="No measures found in the dataset"
                )
                return {
                    "status": "success", 
                    "message": "No measures found in the dataset",
                    "total_measures_analyzed": 0,
                    "measures_data": [],
                    "analysis_statistics": analysis_stats,
                    "high_level_summary": {
                        "analysis_type": "measures_analysis",
                        "overall_score": 0,
                        "detailed_issues": {"critical": [], "issue": [], "warning": []},
                        "key_findings": ["No measures found in the connected dataset"],
                        "recommendations": ["Add measures to your Power BI model for analysis"],
                        "severity_distribution": {"CRITICAL": 0, "ISSUE": 0, "WARNING": 0, "GOOD": 0}
                    }
                }
                
        except Exception as e:
            # Handle errors with UI progress tracker if available
            if 'ui_tracker' in locals():
                ui_tracker.add_error(f"AI analysis failed: {str(e)}", "analysis_error")
                error_stats = ui_tracker.complete_analysis(
                    success=False,
                    summary=f"Analysis failed due to error: {str(e)}"
                )
                logger.error(f"Error in AI-powered Evaluate_Copilot_Measures: {str(e)}")
                return {
                    "error": f"AI analysis failed: {str(e)}",
                    "analysis_statistics": error_stats
                }
            else:
                logger.error(f"Error in AI-powered Evaluate_Copilot_Measures: {str(e)}")
                return {"error": f"AI analysis failed: {str(e)}"}

    def dataset_columns_analysis(self, tables_to_analyze: List[str] = None, fast_mode: bool = False, max_columns_per_table: int = None, table_priority: str = "all", progress_callback=None) -> Dict[str, Any]:
        """
        AI-Powered dataset column analysis using GPT-4o for intelligent assessment against Power BI best practices.
        
        Evaluates columns against 5 specific rules:
        - CN-001 (0.35pts): Clear business terms and descriptive names
        - CN-002 (0.30pts): Self-explanatory, avoid abbreviations  
        - CN-003 (0.25pts): Specific and unique within model
        - CN-004 (0.10pts): Consistent case format (PascalCase/Proper Case)
        - CT-001 (1.00pts): Correct data types matching actual data
        
        Args:
            tables_to_analyze: List of specific table names to analyze (if None, analyzes all)
            fast_mode: If True, uses smaller batches and simplified analysis (default: False)
            max_columns_per_table: Maximum columns to analyze per table (if None, analyzes all)
            table_priority: "all", "fact", "dimension", "high_column_count" to prioritize certain tables
        """
        import re
        import pandas as pd
        import os
        import json
        import io
        import time
        from datetime import datetime
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker
        
        def get_ai_client():
            """Get Azure OpenAI client from authentication manager"""
            try:
                auth_manager = AuthenticationManager.get_instance()
                return auth_manager.get_openai_client()
            except Exception as e:
                logger.error(f"Failed to get OpenAI client: {e}")
                return None
        
        def create_analysis_prompt() -> str:
            """Create system prompt for AI column analysis based on exact Power BI rules"""
            return """You are an expert Power BI data analyst specializing in column quality assessment. Analyze column metadata and provide structured scores based on these EXACT criteria:

SCORING RULES (must follow exactly):

1. CN-001 Score (max 0.35): Clear business terms and descriptive names
   - ONLY evaluate if column names use clear business terminology
   - Award full points for descriptive, business-relevant names
   - Generic terms are acceptable if they have consistent, standardized business meaning
   - Deduct points only for truly meaningless terms like "col1", "data1", "value"
   - **ACCEPTABLE BUSINESS ACRONYMS** (do NOT penalize these standard terms):
     * Financial: FY, QTD, YTD, MTD, ATU, ROI, ROE, EBITDA, CAPEX, OPEX
     * Business: KPI, SLA, CRM, ERP, B2B, B2C, API, UI, UX, CEO, CFO, CTO, UPN
     * Time periods: Q1, Q2, Q3, Q4, H1, H2, YOY, MOM, WOW
     * Geographic: APAC, EMEA, LATAM, US, UK, EU, NA
     * Industry standard: SKU, UPC, ISBN, GDP, CPI, VAT, GST
   - **ABBREVIATION PENALTY RULE**: For common abbreviations NOT in the acceptable list above, apply MINIMAL penalty (0.01 deduction) instead of poor score
   - SPECIAL HANDLING FOR KEY COLUMNS: MAXIMUM SCORE for structural key columns
     * Key columns (is_key=true): Award MAXIMUM 0.35 points (structural columns get full CN-001 scoring)
     * ALL dim* columns: Award MAXIMUM 0.35 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, etc.)
     * Any column containing "key", "hierarchy", "DatasetVersion": Award MAXIMUM 0.35 points (structural columns get full CN-001 scoring)
     * Any column ending with "key" (case-insensitive): Award MAXIMUM 0.35 points (ProductKey, CustomerKey, AccountKey, etc.)
     * ID columns (ending with "ID", "Id", or "id"): Apply minimal negative impact - reduce score by 0.01 from calculated score (max becomes 0.34 instead of 0.35)
     * MANDATORY: subsidiaryid, OpportunityID, CustomerID - ALL get normal evaluation with 0.01 penalty for CN-001
     * Key columns are structural and should get maximum scoring for quality
   - Examples of good names: CustomerName, SalesAmount, OrderDate, FieldSubsidiary, FYRevenue, QTDSales, UPNIdentifier
   - Examples of poor names: field1, data, value, col1, x, temp
   - DOES NOT influence Is_Unambiguous_Label - that's CN-003's job

2. CN-002 Score (max 0.30): Self-explanatory, avoid abbreviations
   - Names should be self-explanatory without external explanation
   - Avoid cryptic abbreviations and short forms
   - Very short names (<3 characters) get 0 points unless industry standard
   - **ACCEPTABLE BUSINESS ACRONYMS** (do NOT penalize these standard terms):
     * Financial: FY, QTD, YTD, MTD, ATU, ROI, ROE, EBITDA, CAPEX, OPEX
     * Business: KPI, SLA, CRM, ERP, B2B, B2C, API, UI, UX, CEO, CFO, CTO, UPN
     * Time periods: Q1, Q2, Q3, Q4, H1, H2, YOY, MOM, WOW
     * Geographic: APAC, EMEA, LATAM, US, UK, EU, NA
     * Industry standard: SKU, UPC, ISBN, GDP, CPI, VAT, GST
   - **ABBREVIATION PENALTY RULE**: For common abbreviations NOT in the acceptable list above, apply MINIMAL penalty (0.01 deduction) instead of poor score
   - Generic terms like "Field" are acceptable if they provide clear business context
   - SPECIAL HANDLING FOR KEY COLUMNS: MAXIMUM SCORE for structural key columns
     * Key columns (is_key=true): Award MAXIMUM 0.30 points (structural columns get full CN-002 scoring)
     * ALL dim* columns: Award MAXIMUM 0.30 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, etc.)
     * Any column containing "key", "hierarchy", "DatasetVersion": Award MAXIMUM 0.30 points (structural columns get full CN-002 scoring)
     * Any column ending with "key" (case-insensitive): Award MAXIMUM 0.30 points (ProductKey, CustomerKey, AccountKey, etc.)
     * ID columns (ending with "ID", "Id", or "id"): Apply minimal negative impact - reduce score by 0.01 from calculated score (max becomes 0.29 instead of 0.30)
     * MANDATORY: subsidiaryid, OpportunityID, CustomerID - ALL get normal evaluation with 0.01 penalty for CN-002
     * Key columns are structural and should get maximum scoring for quality
   - Examples of GOOD names: CustomerAccountBalance, FieldSubsidiary, FY2023Revenue, QTDSales, YTDProfit, UPNIdentifier
   - Examples of ACCEPTABLE acronyms: FY, QTD, YTD, KPI, ROI, APAC, SKU, UPN (standard business terms)
   - Examples of POOR names: CustAccBal, amt, qty, pct, cnt (cryptic abbreviations)

3. CN-003 Score (max 0.25): Cross-table overlap detection (ambiguous naming)
   - STRICT RULE: Check ONLY if this column name appears in multiple tables (cross-table overlap)
   - Use the "Duplicate column names with ACTUAL table names" to find exact table list
   - Award FULL POINTS (0.25) if column name appears in only ONE table (no overlap)
   - SPECIAL HANDLING FOR KEY COLUMNS: MAXIMUM SCORE for structural key columns
     * Key columns (is_key=true): Award MAXIMUM 0.25 points (structural columns get full CN-003 scoring)
     * ALL dim* columns: Award MAXIMUM 0.25 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, etc.)
     * Any column containing "key", "hierarchy", "DatasetVersion": Award MAXIMUM 0.25 points (structural columns get full CN-003 scoring)
     * Any column ending with "key" (case-insensitive): Award MAXIMUM 0.25 points (ProductKey, CustomerKey, AccountKey, etc.)
     * ID columns (ending with "ID" only): Apply reduced penalties for cross-table overlap
   - Standard penalty for non-key columns: -0.08 for 2-3 tables, -0.15 for 4-6 tables, -0.20 for 7+ tables
   - Reduced penalty for ID columns: -0.02 for 2-3 tables, -0.04 for 4-6 tables, -0.06 for 7+ tables
   - Minimum score is 0.05 (even with severe overlap, some credit for consistency)
   - In explanation, list the EXACT ACTUAL table names from the "tables" array
   - ONLY CN-003 determines Is_Unambiguous_Label (YES if unique to one table, PARTIAL/NO if appears in multiple tables)
   - FORBIDDEN: Do NOT evaluate business meaning, clarity, generic terms, or self-explanatory aspects

4. CN-004 Score (max 0.10): Consistent case format
   - Use PascalCase or Proper Case with spaces
   - Do not use all lowercase names for business columns
   - Allow spaces if it improves readability (Sales Territory)
   - SPECIAL HANDLING FOR KEY COLUMNS: MAXIMUM SCORE for structural key columns
     * Key columns (is_key=true): Award MAXIMUM 0.10 points (structural columns get full CN-004 scoring)
     * ALL dim* columns: Award MAXIMUM 0.10 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, etc.)
     * Any column containing "key", "hierarchy", "DatasetVersion": Award MAXIMUM 0.10 points (structural columns get full CN-004 scoring)
     * Any column ending with "key" (case-insensitive): Award MAXIMUM 0.10 points (ProductKey, CustomerKey, AccountKey, etc.)
   - Examples: SalesTerritory or "Sales Territory" (good) vs salesterritory (poor)

5. CT-001 Score (max 1.0): Correct data types
   - BINARY SCORING: 1.0 if current_data_type matches suggested_data_type, 0.0 if they don't match
   - If suggested_data_type equals current_data_type: Award FULL 1.0 points
   - If suggested_data_type differs from current_data_type: Award 0.0 points
   - SPECIAL HANDLING FOR KEY COLUMNS: MAXIMUM SCORE for structural key columns
     * Key columns (is_key=true): Award MAXIMUM 1.0 points (structural columns get full CT-001 scoring)
     * ALL dim* columns: Award MAXIMUM 1.0 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, etc.)
     * Any column containing "key", "hierarchy", "DatasetVersion": Award MAXIMUM 1.0 points (structural columns get full CT-001 scoring)
     * Any column ending with "key" (case-insensitive): Award MAXIMUM 1.0 points (ProductKey, CustomerKey, AccountKey, etc.)
   - Use sample values to determine the optimal suggested_data_type

ISSUE SEVERITY LEVELS (based on overall_score/max_score percentage):
- CRITICAL: <30% (Severe quality issues, immediate attention required)
- ISSUE: 30-49% (Significant problems that need fixing)
- WARNING: 50-74% (Minor improvements recommended)
- GOOD: 75%+ (Good quality, meets best practices)

For each column, return this EXACT JSON structure:"""
        
        def get_sample_values(table_name: str, column_name: str) -> list:
            """Get sample values from column for AI analysis"""
            try:
                if not hasattr(self, 'sql_endpoint') or not self.sql_endpoint:
                    return []
                    
                escaped_table = f"'{table_name}'" if ' ' in table_name else table_name
                escaped_column = f"'{column_name}'" if ' ' in column_name else column_name
                
                sample_query = f"""
                EVALUATE
                TOPN(5, SUMMARIZE({escaped_table}, {escaped_table}[{escaped_column}]))
                """
                
                result = self.sql_endpoint.execute_dax_query(sample_query)
                if result and len(result) > 0:
                    return [str(row[0]) if row[0] is not None else "NULL" for row in result[:3]]
                return []
            except Exception as e:
                logger.debug(f"Could not get sample values for {table_name}[{column_name}]: {e}")
                return []
        
        def analyze_columns_with_ai(client, columns_batch: list, dataset_context: dict, all_column_names: list) -> list:
            """Analyze a batch of columns using GPT-4o"""
            try:
                # Create user prompt with column data
                # Provide complete column name context for proper ambiguity checking with actual table names
                column_name_summary = {}
                column_to_tables_map = {}  # Map each column name to list of actual table names
                
                # Build comprehensive mapping of column names to their actual tables
                for table in tables_to_process:
                    table_name = table.Name
                    for col in table.Columns:
                        if not col.Name.startswith("RowNumber-"):
                            col_name = col.Name
                            
                            # Count occurrences
                            if col_name in column_name_summary:
                                column_name_summary[col_name] += 1
                            else:
                                column_name_summary[col_name] = 1
                            
                            # Map column to actual table names
                            if col_name not in column_to_tables_map:
                                column_to_tables_map[col_name] = []
                            column_to_tables_map[col_name].append(table_name)
                
                # Focus on potentially ambiguous names (appearing multiple times) with actual table names
                duplicate_columns_with_tables = {}
                for name, count in column_name_summary.items():
                    if count > 1:
                        duplicate_columns_with_tables[name] = {
                            "count": count,
                            "tables": column_to_tables_map[name]
                        }
                
                unique_columns_sample = list({name: count for name, count in column_name_summary.items() if count == 1}.keys())[:30]
                
                user_prompt = f"""Analyze these Power BI columns against the exact scoring rules:

Dataset Context: {json.dumps(dataset_context, indent=2)}

Column Name Analysis Context:
- Total unique column names: {len(column_name_summary)}
- Duplicate column names with ACTUAL table names: {json.dumps(duplicate_columns_with_tables, indent=2)}
- Sample unique column names: {unique_columns_sample}

Columns to analyze:
{json.dumps(columns_batch, indent=2)}

CRITICAL INSTRUCTIONS:

*** MANDATORY KEY COLUMN MAXIMUM SCORING ***
BEFORE scoring any column, check if it's a KEY COLUMN using these criteria:
1. Column has "is_key": true in its data structure
2. Column name contains "key" anywhere (case-insensitive: key, Key, KEY, etc.)
3. Column name ends with "key" (case-insensitive: ProductKey, AccountKey, CustomerKey, etc.)
4. Column name starts with "dim" (ALL dimension columns are keys)
5. Column name contains "hierarchy" AND ends with "Int64"
6. Column name contains "DatasetVersion" (version keys)
7. Column name matches pattern: *key*, *Key*, *KEY*, dim*, *hierarchy*Int64, *key, *Key, *KEY

If ANY of these conditions are true, the column is a KEY COLUMN and MUST receive MAXIMUM score for ALL rules:
- CN-001: Award MAXIMUM 0.35 points (structural columns get full scoring)
- CN-002: Award MAXIMUM 0.30 points (structural columns get full scoring)
- CN-003: Award MAXIMUM 0.25 points (structural columns get full scoring)
- CN-004: Award MAXIMUM 0.10 points (structural columns get full scoring)
- CT-001: Award MAXIMUM 1.0 points (structural columns get full scoring)

KEY COLUMN EXAMPLES that get MAXIMUM scores for ALL rules:
- dimproducthierarchyInt64, dimsegmenthierarchyInt64 (dim* pattern)
- DatasetVersionkeyInt64, DatasetVersionKey (DatasetVersion pattern)
- dimaccountInt64, dimaccountfieldgInt64 (dim* pattern)
- dimsegmentInt64, dimsegmenthierarchyInt64 (dim* pattern)
- ProductKey, AccountKey, CustomerKey (ending with "key")
- Any column starting with "dim": dimproduct, dimaccount, dimsegment, etc.
- Any column containing "key": ProductKey, AccountKeyField, etc.
- Any column ending with "key": ProductKey, CustomerKey, AccountKey, etc.
- Any column containing "hierarchy": ProductHierarchy, SegmentHierarchy, etc.

*** CRITICAL: ALL dim* COLUMNS ARE STRUCTURAL KEYS - MAXIMUM SCORE MANDATORY ***

*** END KEY COLUMN DETECTION ***

*** MANDATORY ID COLUMN MINIMAL SCORING ***
IF a column is NOT a key column (from above) but ends with "ID", "Id", or "id", it's an ID COLUMN:
- CN-001: Apply normal evaluation but deduct 0.01 from final score (minimal negative impact)
- CN-002: Apply normal evaluation but deduct 0.01 from final score (minimal negative impact)
- CN-003, CN-004, CT-001: Apply normal rules (not affected)

ID COLUMN EXAMPLES with minimal negative impact:
- subsidiaryid → CN-001: normal evaluation - 0.01, CN-002: normal evaluation - 0.01
- OpportunityID → CN-001: normal evaluation - 0.01, CN-002: normal evaluation - 0.01
- CustomerID → CN-001: normal evaluation - 0.01, CN-002: normal evaluation - 0.01
- AccountID → CN-001: normal evaluation - 0.01, CN-002: normal evaluation - 0.01

*** END ID COLUMN DETECTION ***

- CN-001: ONLY evaluate business terminology and clarity (does NOT influence Is_Unambiguous_Label)
  * SPECIAL: Key columns (is_key=true) get MAXIMUM 0.35 points (structural columns get full CN-001 scoring)
  * SPECIAL: ALL dim* columns get MAXIMUM 0.35 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64, etc.)
  * SPECIAL: Any column containing "key", "hierarchy", or "DatasetVersion" get MAXIMUM 0.35 points (structural columns get full CN-001 scoring)
  * SPECIAL: Any column ending with "key" (case-insensitive) get MAXIMUM 0.35 points (ProductKey, CustomerKey, AccountKey, etc.)
  * EXAMPLES: DatasetVersionkeyInt64, dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64 - ALL get MAXIMUM 0.35 for CN-001
  *** MANDATORY ID COLUMN HANDLING ***
  * ID columns (ending with "ID", "Id", or "id"): Apply normal evaluation but deduct 0.01 from final score (minimal negative impact)
  * EXAMPLES: subsidiaryid gets normal score - 0.01, OpportunityID gets normal score - 0.01, CustomerID gets normal score - 0.01
  * ID columns are structural identifiers - apply minimal penalty to normal evaluation
  *** ABBREVIATION HANDLING ***
  * **ACCEPTABLE BUSINESS ACRONYMS** (do NOT penalize these standard terms):
    * Financial: FY, QTD, YTD, MTD, ATU, ROI, ROE, EBITDA, CAPEX, OPEX
    * Business: KPI, SLA, CRM, ERP, B2B, B2C, API, UI, UX, CEO, CFO, CTO, UPN
    * Time: Q1, Q2, Q3, Q4, H1, H2, YOY, MOM, WOW
    * Geographic: APAC, EMEA, LATAM, US, UK, EU, NA
    * Industry: SKU, UPC, ISBN, GDP, CPI, VAT, GST
  * **ABBREVIATION PENALTY RULE**: For common abbreviations NOT in the acceptable list above, apply MINIMAL penalty (0.01 deduction) instead of poor score
- CN-002: ONLY evaluate self-explanatory nature and abbreviations
  * CRITICAL: DO NOT penalize standard business acronyms - these are acceptable:
    * Financial: FY, QTD, YTD, MTD, ATU, ROI, ROE, EBITDA, CAPEX, OPEX
    * Business: KPI, SLA, CRM, ERP, B2B, B2C, API, UI, UX, CEO, CFO, CTO, UPN
    * Time: Q1, Q2, Q3, Q4, H1, H2, YOY, MOM, WOW
    * Geographic: APAC, EMEA, LATAM, US, UK, EU, NA
    * Industry: SKU, UPC, ISBN, GDP, CPI, VAT, GST
  * **ABBREVIATION PENALTY RULE**: For common abbreviations NOT in the acceptable list above, apply MINIMAL penalty (0.01 deduction) instead of poor score
  * ONLY penalize unclear/cryptic abbreviations like: amt, qty, pct, cnt, tot, val, rev, cust, prod
  * SPECIAL: Key columns (is_key=true) get MAXIMUM 0.30 points (structural columns get full CN-002 scoring)
  * SPECIAL: ALL dim* columns get MAXIMUM 0.30 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64, etc.)
  * SPECIAL: Any column containing "key", "hierarchy", or "DatasetVersion" get MAXIMUM 0.30 points (structural columns get full CN-002 scoring)
  * SPECIAL: Any column ending with "key" (case-insensitive) get MAXIMUM 0.30 points (ProductKey, CustomerKey, AccountKey, etc.)
  * EXAMPLES: DatasetVersionkeyInt64, dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64 - ALL get MAXIMUM 0.30 for CN-002
  *** MANDATORY ID COLUMN HANDLING ***
  * ID columns (ending with "ID", "Id", or "id"): Apply normal evaluation but deduct 0.01 from final score (minimal negative impact)
  * EXAMPLES: subsidiaryid gets normal score - 0.01, OpportunityID gets normal score - 0.01, CustomerID gets normal score - 0.01
  * ID columns are structural identifiers - apply minimal penalty to normal evaluation
- CN-003: ONLY check table overlap using the "Duplicate column names with ACTUAL table names" data
  *** CRITICAL: MAXIMUM SCORE FOR KEY COLUMNS ***
  * MANDATORY: Key columns (is_key=true) get MAXIMUM 0.25 points - NO EXCEPTIONS
  * MANDATORY: ALL dim* columns get MAXIMUM 0.25 points - NO EXCEPTIONS (dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64, etc.)
  * MANDATORY: DatasetVersionkeyInt64, DatasetVersionKey get MAXIMUM 0.25 points - NO EXCEPTIONS
  * MANDATORY: Any column containing "key", "hierarchy", or starting with "dim" gets MAXIMUM 0.25 points - NO EXCEPTIONS
  * MANDATORY: Any column ending with "key" (case-insensitive) gets MAXIMUM 0.25 points - NO EXCEPTIONS (ProductKey, CustomerKey, AccountKey, etc.)
  * DO NOT APPLY ANY OVERLAP PENALTIES TO KEY COLUMNS - THEY GET MAXIMUM 0.25 REGARDLESS
  * This is the ONLY rule that determines Is_Unambiguous_Label (but key columns get 0.00)
  * Apply MINIMAL penalties for ID columns (ending in ID only - not key columns)
  * Standard penalty for non-keys: -0.08 (2-3 tables), -0.15 (4-6 tables), -0.20 (7+ tables)
  * Reduced penalty for IDs only: -0.02 (2-3 tables), -0.04 (4-6 tables), -0.06 (7+ tables)
- CN-004: ONLY evaluate case formatting
  * SPECIAL: Key columns (is_key=true) get MAXIMUM 0.10 points (structural columns get full CN-004 scoring)
  * SPECIAL: ALL dim* columns get MAXIMUM 0.10 points (dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64, etc.)
  * SPECIAL: Any column containing "key", "hierarchy", or "DatasetVersion" get MAXIMUM 0.10 points (structural columns get full CN-004 scoring)
  * SPECIAL: Any column ending with "key" (case-insensitive) get MAXIMUM 0.10 points (ProductKey, CustomerKey, AccountKey, etc.)
  * EXAMPLES: DatasetVersionkeyInt64, dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64 - ALL get MAXIMUM 0.10 for CN-004
- CT-001: ONLY evaluate data type accuracy with BINARY scoring (1.0 if types match, 0.0 if they don't)
  *** CRITICAL: MAXIMUM SCORE FOR KEY COLUMNS ***
  * MANDATORY: Key columns (is_key=true) get MAXIMUM 1.0 points - NO EXCEPTIONS
  * MANDATORY: ALL dim* columns get MAXIMUM 1.0 points - NO EXCEPTIONS (dimproducthierarchyInt64, dimsegmenthierarchyInt64, dimaccountfieldgInt64, etc.)
  * MANDATORY: DatasetVersionkeyInt64, DatasetVersionKey get MAXIMUM 1.0 points - NO EXCEPTIONS
  * MANDATORY: Any column containing "key", "hierarchy", or starting with "dim" gets MAXIMUM 1.0 points - NO EXCEPTIONS
  * MANDATORY: Any column ending with "key" (case-insensitive) gets MAXIMUM 1.0 points - NO EXCEPTIONS (ProductKey, CustomerKey, AccountKey, etc.)
  * DO NOT EVALUATE DATA TYPES FOR KEY COLUMNS - THEY GET MAXIMUM 1.0 REGARDLESS OF TYPE MATCH
- DO NOT mix criteria between rules - each rule has ONE specific job

For each column, return a JSON object with this EXACT structure:
{{
  "column_name": "original_name",
  "table_name": "table_name", 
  "current_data_type": "data_type",
  "is_unambiguous_label": "YES/PARTIAL/NO - explanation",
  "is_self_explanatory": "YES/PARTIAL/NO - explanation",
  "suggested_data_type": "recommended_type", 
  "suggested_name": "improved_name",
  "issue_severity": "Calculate based on overall_score/max_score: CRITICAL (<60%), ISSUE (60-75%), WARNING (75-85%), GOOD (85%+)",
  "detailed_recommendation": "specific recommendations",
  "cn_001_score": 0.000,
  "cn_002_score": 0.000, 
  "cn_003_score": 0.000,
  "cn_004_score": 0.000,
  "ct_001_score": 0.000,
  "overall_score": 0.00
}}

Return JSON with "results" array containing analysis for all columns."""
                
                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": create_analysis_prompt()},
                        {"role": "user", "content": user_prompt}
                    ],
                    temperature=0.1,
                    response_format={"type": "json_object"},
                    max_tokens=4000
                )
                
                # Parse AI response
                ai_response = json.loads(response.choices[0].message.content)
                
                # Handle different response formats
                if "results" in ai_response:
                    return ai_response["results"]
                elif "columns" in ai_response:
                    return ai_response["columns"]
                elif isinstance(ai_response, list):
                    return ai_response
                else:
                    logger.warning(f"Unexpected AI response format: {list(ai_response.keys())}")
                    return []
                    
            except Exception as e:
                logger.error(f"AI analysis failed: {e}")
                return []
        
        # ================================================================================================
        # MAIN AI-POWERED ANALYSIS - 8 PHASE PROCESS
        # ================================================================================================
        # Phase 1: Initial Setup & Validation
        # Phase 2: Smart Table Filtering  
        # Phase 3: Data Collection & Preparation
        # Phase 4: AI Batch Processing
        # Phase 5: Scoring & Categorization
        # Phase 6: CSV Generation & Storage
        # Phase 7: Statistical Analysis
        # Phase 8: Results Assembly
        # ================================================================================================
        
        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"columns_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing services")
            
            # Check TabularEditor connection to Power BI dataset
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Not connected to any dataset. Please connect first."}

            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "Failed to initialize AI client. Please check authentication."}

            # Extract workspace and dataset information for context and file naming
            try:
                actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
            except:
                actual_dataset_id = 'Unknown'
                actual_workspace_id = 'Unknown'
            
            # Create workspace information structure for context and CSV generation
            workspace_info = {
                "WorkspaceID": actual_workspace_id,
                "WorkspaceName": getattr(self.tabular_editor, 'current_workspace', 'Unknown'),
                "DatasetID": actual_dataset_id,
                "DatasetName": getattr(self.tabular_editor, 'current_database', 'Unknown')
            }

            # Initialize containers for analysis results and get all available tables
            analysis_results = []
            all_tables = self.tabular_editor.model.Tables
            
            # ================================================================================================
            # PHASE 2: SMART TABLE FILTERING
            # ================================================================================================
            # Apply intelligent table selection based on user preferences and priorities
            
            if tables_to_analyze:
                # User-specified table selection
                tables_to_process = [t for t in all_tables if t.Name in tables_to_analyze]
                logger.info(f"🎯 Analyzing specific tables: {[t.Name for t in tables_to_process]}")
            elif table_priority == "fact":
                # Filter for fact tables: tables with measures or >30% numeric columns
                tables_to_process = []
                for table in all_tables:
                    has_measures = hasattr(table, 'Measures') and len(table.Measures) > 0
                    numeric_cols = sum(1 for col in table.Columns if str(col.DataType) in ['Integer', 'Decimal', 'Double', 'Currency'])
                    if has_measures or numeric_cols > len(table.Columns) * 0.3:
                        tables_to_process.append(table)
                logger.info(f"🏭 Analyzing fact tables: {[t.Name for t in tables_to_process]}")
            elif table_priority == "dimension":
                # Filter for dimension tables: tables without measures and >50% text columns
                tables_to_process = []
                for table in all_tables:
                    has_measures = hasattr(table, 'Measures') and len(table.Measures) > 0
                    text_cols = sum(1 for col in table.Columns if str(col.DataType) in ['String', 'Text'])
                    if not has_measures and text_cols > len(table.Columns) * 0.5:
                        tables_to_process.append(table)
                logger.info(f"📊 Analyzing dimension tables: {[t.Name for t in tables_to_process]}")
            elif table_priority == "high_column_count":
                # Filter for tables with highest column counts (top 10)
                all_tables_with_counts = [(t, len(t.Columns)) for t in all_tables]
                all_tables_with_counts.sort(key=lambda x: x[1], reverse=True)
                tables_to_process = [t[0] for t in all_tables_with_counts[:10]]
                logger.info(f"📈 Analyzing high-column tables: {[(t.Name, len(t.Columns)) for t in tables_to_process]}")
            else:
                # Default: analyze all available tables
                tables_to_process = list(all_tables)
                logger.info(f"🔍 Analyzing all {len(tables_to_process)} tables")
            
            # Validate that filtering produced tables to analyze
            if not tables_to_process:
                return {"error": f"No tables found matching priority '{table_priority}' or filter criteria"}
            
            # ================================================================================================
            # PHASE 3: DATA COLLECTION & PREPARATION
            # ================================================================================================
            # Gather column metadata, sample values, and prepare data structures for AI analysis
            
            # Build comprehensive column inventory for cross-table uniqueness analysis
            all_column_names = []
            for table in tables_to_process:
                for col in table.Columns:
                    if not col.Name.startswith("RowNumber-"):  # Exclude system-generated columns
                        all_column_names.append(col.Name)
            
            # Initialize data collection containers
            all_columns_data = []
            total_tables = len(tables_to_process)
            
            logger.info(f"📊 Starting data collection from {total_tables} tables")
            
            # Process each table to collect comprehensive column metadata
            for table_idx, table in enumerate(tables_to_process, 1):
                table_name = table.Name
                
                # Check for user cancellation before processing each table
                if self._check_cancellation(f"Column analysis for table: {table_name}"):
                    logger.info(f"🛑 Analysis cancelled at table {table_idx}/{total_tables}: {table_name}")
                    break
                
                # Update progress for UI streaming
                progress_message = f"Collecting data from table {table_idx} of {total_tables}: {table_name}"
                
                if progress_callback:
                    self._send_progress_update(progress_callback, progress_message, table_idx-1, total_tables)
                
                # Apply intelligent column sampling if limits are specified
                all_columns = [col for col in table.Columns if not col.Name.startswith("RowNumber-")]
                
                if max_columns_per_table and len(all_columns) > max_columns_per_table:
                    # Smart column sampling strategy - prioritize potentially problematic columns
                    sampled_columns = []
                    
                    # Priority 1: Short names (≤3 chars, likely abbreviations needing analysis)
                    short_name_cols = [col for col in all_columns if len(col.Name) <= 3]
                    sampled_columns.extend(short_name_cols[:max_columns_per_table//3])
                    
                    # Priority 2: Lowercase names (formatting issues that need correction)
                    lowercase_cols = [col for col in all_columns if col.Name.islower() and col not in sampled_columns]
                    sampled_columns.extend(lowercase_cols[:max_columns_per_table//3])
                    
                    # Priority 3: Fill remaining slots with other columns for comprehensive coverage
                    remaining_cols = [col for col in all_columns if col not in sampled_columns]
                    remaining_slots = max_columns_per_table - len(sampled_columns)
                    sampled_columns.extend(remaining_cols[:remaining_slots])
                    
                    columns_to_analyze = sampled_columns
                else:
                    # No limits specified - analyze all columns in the table
                    columns_to_analyze = all_columns
                
                # Build comprehensive column metadata for AI analysis
                for column in columns_to_analyze:
                    column_name = column.Name
                    data_type = str(column.DataType) if hasattr(column, 'DataType') else "Unknown"
                    
                    # Retrieve actual data samples for improved AI accuracy (skipped in fast mode)
                    sample_values = [] if fast_mode else get_sample_values(table_name, column_name)
                    
                    # Create structured column metadata for AI consumption
                    column_data = {
                        "table_name": table_name,
                        "column_name": column_name,
                        "data_type": data_type,
                        "sample_values": sample_values,  # Critical for CT-001 data type validation
                        "is_key": hasattr(column, 'IsKey') and column.IsKey  # Key column identification
                    }
                    
                    all_columns_data.append(column_data)
            
            # ================================================================================================
            # PHASE 4: AI BATCH PROCESSING
            # ================================================================================================
            # Send column data to GPT-4o in optimized batches for intelligent analysis
            
            # Configure batch processing parameters
            batch_size = 25 if fast_mode else 15  # Smaller batches for more detailed analysis
            total_columns = len(all_columns_data)
            
            logger.info(f"🤖 Starting AI analysis of {total_columns} columns in batches of {batch_size}")
            
            # Build dataset context for AI analysis
            dataset_context = {
                "workspace_name": workspace_info["WorkspaceName"],
                "dataset_name": workspace_info["DatasetName"],
                "total_tables": len(tables_to_process),
                "total_columns": total_columns,
                "analysis_mode": "Fast Mode" if fast_mode else "Full Mode"
            }
            
            # Initialize tracking for completed tables
            self._completed_tables = set()
            
            # Calculate total number of AI processing batches
            total_batches = (total_columns + batch_size - 1) // batch_size
            
            # Start analysis tracking with comprehensive information
            ui_tracker.start_analysis(
                analysis_name="AI-Powered Dataset Column Analysis",
                total_items=total_columns,
                total_batches=total_batches
            )
            
            # Create batch progress tracker for detailed batch management
            batch_tracker = create_batch_tracker(ui_tracker, batch_size)
            
            # Process columns through GPT-4o in manageable batches
            for i in range(0, total_columns, batch_size):
                batch_start = i
                batch_end = min(i + batch_size, total_columns)
                batch_columns = all_columns_data[batch_start:batch_end]
                current_batch = (batch_start // batch_size) + 1
                
                # Check for user cancellation before each AI batch
                if self._check_cancellation(f"AI analysis batch {current_batch}"):
                    ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                    break
                
                # Start batch processing with detailed tracking
                batch_tracker.start_batch(current_batch, total_batches, batch_columns)
                ui_tracker.set_phase("AI Batch Processing", f"Processing batch {current_batch} of {total_batches}")
                
                # Log batch processing message for UI parsing (specific pattern required by UI regex)
                logger.info(f"🤖 DATASET COLUMNS PROGRESS: AI analyzing batch {current_batch} of {total_batches} ({len(batch_columns)} columns)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Processing columns batch {current_batch} of {total_batches}",
                    current=current_batch,
                    total=total_batches
                )
                
                 
                # Send batch to GPT-4o for AI-powered analysis against 5 scoring rules
                ai_results = analyze_columns_with_ai(ai_client, batch_columns, dataset_context, all_column_names)
                
                # ================================================================================================
                # PHASE 5: SCORING & CATEGORIZATION
                # ================================================================================================
                # Process AI responses and calculate severity levels based on scoring rules
                
                # Track unique tables processed in this batch for detailed reporting
                batch_tables_processed = set()
                batch_results_count = 0
                
                # Transform AI results into structured analysis entries
                for ai_result in ai_results:
                    # Extract individual rule scores from AI response
                    cn_001_score = float(ai_result.get("cn_001_score", 0.0))  # Business clarity (max 0.35)
                    cn_002_score = float(ai_result.get("cn_002_score", 0.0))  # Self-explanatory (max 0.30)
                    cn_003_score = float(ai_result.get("cn_003_score", 0.0))  # Uniqueness (max 0.25)
                    cn_004_score = float(ai_result.get("cn_004_score", 0.0))  # Formatting (max 0.10)
                    ct_001_score = float(ai_result.get("ct_001_score", 0.0))  # Data type accuracy (max 1.00)
                    
                    # Calculate composite scores for severity determination
                    calculated_overall_score = cn_001_score + cn_002_score + cn_003_score + cn_004_score + ct_001_score
                    calculated_max_score = 0.35 + 0.30 + 0.25 + 0.10 + 1.00  # Sum of max possible scores
                    
                    # Determine issue severity based on overall score percentage
                    score_percentage = (calculated_overall_score / calculated_max_score) if calculated_max_score > 0 else 0
                    
                    # Apply severity thresholds with color coding for UI display
                    if score_percentage < 0.59:
                        issue_severity = "critical"     # <59% - Severe quality issues, immediate attention required
                        severity_priority = 1
                        severity_color_code = "RED"
                        severity_hex_color = "#FF0000"
                    elif 0.60 <= score_percentage <= 0.74:
                        issue_severity = "issue"        # 60-74% - Significant problems that need fixing
                        severity_priority = 2
                        severity_color_code = "ORANGE"
                        severity_hex_color = "#FFA500"
                    elif 0.75 <= score_percentage <= 0.84:
                        issue_severity = "warning"      # 75-84% - Minor improvements recommended
                        severity_priority = 3
                        severity_color_code = "YELLOW"
                        severity_hex_color = "#FFFF00"
                    else:  # 0.85 and above
                        issue_severity = "good"         # 85%+ - Good quality, meets best practices
                        severity_priority = 4
                        severity_color_code = "GREEN"
                        severity_hex_color = "#00FF00"
                    
                    # Build comprehensive result entry with all required fields and fallbacks
                    result_entry = {
                        "Table_Name": ai_result.get("table_name", "Unknown"),
                        "Column_Name": ai_result.get("column_name", "Unknown"),
                        "Current_Data_Type": ai_result.get("current_data_type", "Unknown"),
                        "Issue_Severity": issue_severity,  # Calculated severity level
                        "Is_Unambiguous_Label": ai_result.get("is_unambiguous_label", "NO - Analysis failed"),
                        "Is_Self_Explanatory": ai_result.get("is_self_explanatory", "NO - Analysis failed"),
                        "Suggested_DataType": ai_result.get("suggested_data_type", "Unknown"),
                        "Suggested_Name": ai_result.get("suggested_name", ai_result.get("column_name", "Unknown")),
                        # Individual rule scores with maximum possible scores
                        "Column_Name_Score": cn_001_score,
                        "Column_Name_Max_Score": 0.35,
                        "Column_Selfexplanatory_Score": cn_002_score,
                        "Column_Selfexplanatory_Max_Score": 0.30,
                        "Unique_Column_Score": cn_003_score,
                        "Unique_Column_Max_Score": 0.25,
                        "Column_Format_Score": cn_004_score,
                        "Column_Format_Max_Score": 0.10,
                        "Column_DataType_Score": ct_001_score,
                        "Column_DataType_Max_Score": 1.00,
                        # Composite scores and UI display fields
                        "Overall_score": round(calculated_overall_score, 3),
                        "Max_Score": round(calculated_max_score, 2),
                        "Severity_Priority": severity_priority,
                        "Severity_Color": severity_color_code,
                        "Severity_Hex_Color": severity_hex_color,
                        "Severity_Visual": f"{severity_color_code}: {issue_severity}",
                        # Recommendations moved to last column
                        "Recommendations": ai_result.get("detailed_recommendation", "AI analysis incomplete")
                    }
                    
                    # Add processed entry to final results collection
                    analysis_results.append(result_entry)
                    
                    # Track batch statistics for detailed reporting
                    batch_tables_processed.add(ai_result.get("table_name", "Unknown"))
                    batch_results_count += 1
                
                # Complete batch processing with comprehensive statistics using UI tracker
                batch_tracker.complete_batch(
                    batch_number=current_batch,
                    total_batches=total_batches,
                    processing_results=ai_results
                )
            
            # Log processing completion for UI parsing (specific pattern required by UI regex)
            logger.info(f"🤖 DATASET COLUMNS PROGRESS: Processed AI analysis of {total_batches} batches ({total_columns} columns)")
            
            # Also update UI tracker for comprehensive tracking
            ui_tracker.update_progress(
                f"Completed column analysis - {total_columns} columns processed", 
                current=total_batches,
                total=total_batches
            )
            
            # Set final processing phase
            ui_tracker.set_phase("Results Generation", "Generating CSV files and summary statistics")
            
            # Generate final processing statistics automatically
            total_tables_processed = len(set(result.get("Table_Name", "Unknown") for result in analysis_results))
            
            # ================================================================================================
            # PHASE 6: EXCEL GENERATION & STORAGE
            # ================================================================================================
            # Create downloadable Excel file with color formatting and save to KnowledgeBase folder
            
            # Validate that analysis produced results
            if not analysis_results:
                return {"error": "No analysis results to export"}
            
            # Convert analysis results to DataFrame for Excel generation
            df = pd.DataFrame(analysis_results)
            
            # Remove specific severity visual columns from Excel export (keep in analysis for UI)
            columns_to_exclude_from_excel = ['Severity_Priority', 'Severity_Color', 'Severity_Hex_Color', 'Severity_Visual']
            excel_df = df.drop(columns=[col for col in columns_to_exclude_from_excel if col in df.columns])
            
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            # Sanitize workspace and dataset names to prevent invalid filename characters
            workspace_name = self._sanitize_filename(workspace_info["WorkspaceName"].replace(" ", ""))
            dataset_name = self._sanitize_filename(workspace_info["DatasetName"].replace(" ", ""))
            
            # Generate timestamped filename for unique identification
            filename = f"AI_Dataset_Columns_Analysis_{workspace_name}_{dataset_name}_{timestamp}.csv"
            
            # Create Excel file with color formatting
            excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(excel_df, filename, 'Issue_Severity')
            
            if excel_content and excel_filename and csv_text_content:
                # Save Excel file to KnowledgeBase folder
                excel_file_path = self._save_excel_file(excel_content, excel_filename)
                logger.info(f"✅ Generated AI-powered analysis Excel file: {excel_file_path}")
            else:
                logger.error("❌ Failed to generate Excel file - falling back to error handling")
                return {"error": "Failed to generate Excel file"}
    
            # ================================================================================================
            # PHASE 7: STATISTICAL ANALYSIS
            # ================================================================================================
            # Calculate comprehensive summary statistics and generate insights
            
            # Calculate core analysis metrics
            total_columns = len(analysis_results)
            total_available_columns = sum(len([col for col in table.Columns if not col.Name.startswith("RowNumber-")]) for table in all_tables)
            
            # Aggregate severity distribution for executive summary
            severity_counts = {
                "CRITICAL": sum(1 for r in analysis_results if r["Issue_Severity"] == "critical"),
                "ISSUE": sum(1 for r in analysis_results if r["Issue_Severity"] == "issue"),
                "WARNING": sum(1 for r in analysis_results if r["Issue_Severity"] == "warning"),
                "GOOD": sum(1 for r in analysis_results if r["Issue_Severity"] == "good")
            }
             
            # Count columns meeting key quality criteria
            clear_names = sum(1 for r in analysis_results if r["Is_Unambiguous_Label"].startswith("YES"))
            self_explanatory = sum(1 for r in analysis_results if r["Is_Self_Explanatory"].startswith("YES"))
            
            # Perform detailed statistical analysis if results are available
            if total_columns > 0:
                # Calculate average scores across all 5 AI scoring rules
                avg_cn_001_score = sum(r["Column_Name_Score"] for r in analysis_results) / total_columns
                avg_cn_002_score = sum(r["Column_Selfexplanatory_Score"] for r in analysis_results) / total_columns
                avg_cn_003_score = sum(r["Unique_Column_Score"] for r in analysis_results) / total_columns
                avg_cn_004_score = sum(r["Column_Format_Score"] for r in analysis_results) / total_columns
                avg_ct_001_score = sum(r["Column_DataType_Score"] for r in analysis_results) / total_columns
                avg_overall_score = sum(r["Overall_score"] for r in analysis_results) / total_columns
                
                # Calculate overall quality percentage for executive dashboard  
                max_score = 2.0  # CN-001(0.35) + CN-002(0.30) + CN-003(0.25) + CN-004(0.10) + CT-001(1.0)
                overall_score_percentage = round((avg_overall_score / max_score) * 100, 1)
                
                # Count columns meeting score thresholds (75% of max for each rule)
                good_cn_001 = sum(1 for r in analysis_results if r["Column_Name_Score"] >= 0.26)  # 75% of 0.35
                good_cn_002 = sum(1 for r in analysis_results if r["Column_Selfexplanatory_Score"] >= 0.23)  # 75% of 0.30
                good_cn_003 = sum(1 for r in analysis_results if r["Unique_Column_Score"] >= 0.19)  # 75% of 0.25
                good_cn_004 = sum(1 for r in analysis_results if r["Column_Format_Score"] >= 0.08)  # 75% of 0.10
                good_ct_001 = sum(1 for r in analysis_results if r["Column_DataType_Score"] >= 0.75)  # 75% of 1.0
                
                # Count issues for Key Findings
                critical_issues = severity_counts["CRITICAL"]
                issue_items = severity_counts["ISSUE"]
                warning_issues = severity_counts["WARNING"]
                total_issues = critical_issues + issue_items + warning_issues
                
                # Analyze specific column issues for detailed insights
                unclear_names = [r for r in analysis_results if r["Column_Name_Score"] < 0.26]
                non_explanatory = [r for r in analysis_results if r["Column_Selfexplanatory_Score"] < 0.23]
                formatting_issues = [r for r in analysis_results if r["Column_Format_Score"] < 0.08]
                datatype_issues = [r for r in analysis_results if r["Column_DataType_Score"] < 0.75]
                duplicate_similar = [r for r in analysis_results if r["Unique_Column_Score"] < 0.19]
                
                # Generate detailed Key Findings
                key_findings = []
                
                # Business clarity issues
                if len(unclear_names) > 0:
                    unclear_pct = round((len(unclear_names)/total_columns)*100, 1)
                    key_findings.append(f"• {unclear_pct}% of columns ({len(unclear_names)} columns) have unclear business names that don't clearly indicate their purpose or content to end users")
                
                # Self-explanatory issues  
                if len(non_explanatory) > 0:
                    non_exp_pct = round((len(non_explanatory)/total_columns)*100, 1)
                    key_findings.append(f"• {non_exp_pct}% of columns ({len(non_explanatory)} columns) require domain knowledge to understand, making them less accessible to business users")
                
                # Formatting and naming convention issues
                if len(formatting_issues) > 0:
                    format_pct = round((len(formatting_issues)/total_columns)*100, 1)
                    key_findings.append(f"• {format_pct}% of columns ({len(formatting_issues)} columns) don't follow proper naming conventions (PascalCase, no underscores/spaces)")
                
                # Data type accuracy issues
                if len(datatype_issues) > 0:
                    dtype_pct = round((len(datatype_issues)/total_columns)*100, 1)
                    key_findings.append(f"• {dtype_pct}% of columns ({len(datatype_issues)} columns) may have suboptimal data types affecting performance and accuracy")
                
                # Uniqueness and similarity issues
                if len(duplicate_similar) > 0:
                    dup_pct = round((len(duplicate_similar)/total_columns)*100, 1)
                    key_findings.append(f"• {dup_pct}% of columns ({len(duplicate_similar)} columns) have names too similar to others, potentially causing user confusion")
                
                # Overall quality assessment with improved thresholds
                if overall_score_percentage < 40:
                    key_findings.append(f"Overall column quality score of {overall_score_percentage}% indicates significant naming improvements needed across multiple areas")
                elif overall_score_percentage >= 70:
                    key_findings.append(f"Strong column quality with {overall_score_percentage}% overall score, indicating good adherence to naming best practices")
                else:
                    key_findings.append(f"Moderate column quality at {overall_score_percentage}% with room for improvement in specific naming areas")

                # Generate detailed Recommendations with explanations
                recommendations = []
                
                # Business clarity recommendations
                if len(unclear_names) > 0:
                    recommendations.append(f"Rename {len(unclear_names)} columns with unclear business names to descriptive terms that immediately convey their business purpose (e.g., 'CustomerID' instead of 'ID', 'MonthlyRevenue' instead of 'Amount')")
                
                # Self-explanatory recommendations
                if len(non_explanatory) > 0:
                    recommendations.append(f"Improve {len(non_explanatory)} columns requiring domain knowledge by using universally understood business terms that don't need explanation")
                
                # Formatting recommendations
                if len(formatting_issues) > 0:
                    recommendations.append(f"Standardize {len(formatting_issues)} column names to PascalCase format without underscores or spaces to improve readability and follow Power BI best practices")
                
                # Data type recommendations
                if len(datatype_issues) > 0:
                    recommendations.append(f"Review and optimize data types for {len(datatype_issues)} columns to improve query performance and ensure accurate calculations")
                
                # Uniqueness recommendations  
                if len(duplicate_similar) > 0:
                    recommendations.append(f"Differentiate {len(duplicate_similar)} columns with similar names by adding specific qualifiers to prevent user confusion and selection errors")
                
                # Priority-based recommendations
                if critical_issues > 0:
                    recommendations.append(f"Prioritize addressing {critical_issues} CRITICAL severity columns first as they significantly impact user experience and data comprehension")
                
                # Overall improvement strategy
                if overall_score_percentage < 60:
                    recommendations.append("Implement a column naming standards document and review process to maintain consistent, business-friendly naming conventions across all future model updates")
                
                if not key_findings:
                    key_findings.append("Column naming quality meets standards")
                if not recommendations:
                    recommendations.append("Maintain current naming standards")
                    
            else:
                avg_cn_001_score = avg_cn_002_score = avg_cn_003_score = avg_cn_004_score = avg_ct_001_score = 0
                avg_overall_score = overall_score_percentage = 0
                good_cn_001 = good_cn_002 = good_cn_003 = good_cn_004 = good_ct_001 = 0
                critical_issues = warning_issues = total_issues = 0
                key_findings = ["No analysis results available"]
                recommendations = ["Re-run analysis with valid data"]
            
            summary = {
                "analysis_scope": {
                    "tables_analyzed": len(tables_to_process),
                    "total_tables_available": len(all_tables),
                    "columns_analyzed": total_columns,
                    "total_columns_available": total_available_columns,
                    "analysis_mode": "AI-Powered " + ("Fast Mode" if fast_mode else "Full Mode"),
                    "table_priority": table_priority,
                    "column_limit_per_table": max_columns_per_table
                },
                "total_columns": total_columns,
                "severity_distribution": severity_counts,
                "naming_quality": {
                    "clear_names_count": clear_names,
                    "clear_names_percentage": round((clear_names / total_columns) * 100, 2) if total_columns > 0 else 0
                },
                "clarity_assessment": {
                    "self_explanatory_count": self_explanatory,
                    "self_explanatory_percentage": round((self_explanatory / total_columns) * 100, 2) if total_columns > 0 else 0
                },
                "ai_scoring_statistics": {
                    "average_scores": {
                        "cn_001_business_clarity": round(avg_cn_001_score, 3),
                        "cn_002_self_explanatory": round(avg_cn_002_score, 3),
                        "cn_003_uniqueness": round(avg_cn_003_score, 3),
                        "cn_004_formatting": round(avg_cn_004_score, 3),
                        "ct_001_data_type_accuracy": round(avg_ct_001_score, 3),
                        "overall_score": round(avg_overall_score, 3),
                        "overall_score_percentage": overall_score_percentage,
                        "max_possible_score": max_score
                    },
                    "quality_thresholds_met": {
                        "cn_001_business_clarity": f"{good_cn_001}/{total_columns} ({round((good_cn_001/total_columns)*100, 1) if total_columns > 0 else 0}%)",
                        "cn_002_self_explanatory": f"{good_cn_002}/{total_columns} ({round((good_cn_002/total_columns)*100, 1) if total_columns > 0 else 0}%)",
                        "cn_003_uniqueness": f"{good_cn_003}/{total_columns} ({round((good_cn_003/total_columns)*100, 1) if total_columns > 0 else 0}%)",
                        "cn_004_formatting": f"{good_cn_004}/{total_columns} ({round((good_cn_004/total_columns)*100, 1) if total_columns > 0 else 0}%)",
                        "ct_001_data_type_accuracy": f"{good_ct_001}/{total_columns} ({round((good_ct_001/total_columns)*100, 1) if total_columns > 0 else 0}%)"
                    }
                },
                "issues_summary": {
                    "critical_severity": critical_issues,
                    "issue_severity": issue_items,
                    "warning_severity": warning_issues,
                    "good_quality": severity_counts["GOOD"],
                    "total_issues": total_issues,
                    # UI compatibility fields
                    "critical_issues": critical_issues,
                    "warning_issues": warning_issues,
                    "issue_issues": issue_items,
                    "issues": issue_items  # Add this for frontend compatibility
                },
                "detailed_issues": {
                    "critical": [self._format_detailed_issue(row) 
                               for row in analysis_results if row.get('Issue_Severity') == 'critical'],
                    "warning": [self._format_detailed_issue(row) 
                              for row in analysis_results if row.get('Issue_Severity') == 'warning'],
                    "issue": [self._format_detailed_issue(row) 
                            for row in analysis_results if row.get('Issue_Severity') == 'issue']
                },
                "key_findings": key_findings,
                "recommendations": recommendations
            }
            
            # ================================================================================================
            # PHASE 8: RESULTS ASSEMBLY
            # ================================================================================================
            # Combine all analysis components into final structured response for webapp consumption
            
            ui_tracker.set_phase("Results Assembly", "Finalizing analysis results and summaries")
            
            # Build comprehensive result object with all required components
            result = {
                "status": "success",
                "total_columns_analyzed": total_columns,
                "csv_filename": excel_filename,
                "csv_file_path": excel_file_path,
                "csv_content": csv_text_content,         # CSV text for UI parsing
                "excel_content": excel_content,          # Excel binary for download
                "summary": summary,                      # Detailed statistical analysis
                "analysis_results": analysis_results,   # Individual column assessments
                "ai_powered": True,
                "model_used": "gpt-4o"
            }
            
            # Generate executive-level summary for dashboard display
            high_level_summary = self.tabular_editor.generate_analysis_summary("ai_columns_analysis", result)
            
            # Preserve detailed issue breakdowns from statistical analysis
            if "detailed_issues" in summary:
                high_level_summary["detailed_issues"] = summary["detailed_issues"]
            
            # Attach high-level summary to main result
            result["high_level_summary"] = high_level_summary
            
            # Complete analysis tracking with comprehensive statistics
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=f"Successfully analyzed {total_columns} columns from {total_tables_processed} tables",
                results_data={
                    "total_columns": total_columns,
                    "total_tables": total_tables_processed,
                    "csv_filename": filename,
                    "severity_distribution": summary.get("severity_distribution", {}),
                    "overall_score_percentage": summary.get("ai_scoring_statistics", {}).get("average_scores", {}).get("overall_score_percentage", 0)
                }
            )
            
            # Add analysis statistics to result
            result["analysis_statistics"] = analysis_stats
            
            return result
            
        except Exception as e:
            # Handle errors with UI progress tracker if available
            if 'ui_tracker' in locals():
                ui_tracker.add_error(f"AI analysis failed: {str(e)}", "analysis_error")
                error_stats = ui_tracker.complete_analysis(
                    success=False,
                    summary=f"Analysis failed due to error: {str(e)}"
                )
                logger.error(f"Error in AI-powered dataset_columns_analysis: {str(e)}")
                return {
                    "error": f"AI analysis failed: {str(e)}",
                    "analysis_statistics": error_stats
                }
            else:
                logger.error(f"Error in AI-powered dataset_columns_analysis: {str(e)}")
                return {"error": f"AI analysis failed: {str(e)}"}

    def _generate_table_security_recommendation(self, sensitive_data: Dict[str, Any], financial_data: Dict[str, Any], security_data: Dict[str, Any], account_data: Dict[str, Any], rule_scores: Dict[str, Any] = None) -> str:
        """
        Generate detailed security recommendation for a table based on its security analysis and rule scores.
        Provides specific actions to improve security compliance based on rule score percentages.
        
        Args:
            sensitive_data: Sensitive data analysis results
            financial_data: Financial data analysis results  
            security_data: Security filtering analysis results
            account_data: Account linkage analysis results
            rule_scores: Dictionary containing rule scores and percentages for recommendation logic
        """
        recommendations = []
        
        # If rule_scores provided, use score-based recommendation logic
        if rule_scores:
            rule1_score = rule_scores.get("rule1_score", 0.0)
            rule1_max = rule_scores.get("rule1_max", 0.3)
            rule2_score = rule_scores.get("rule2_score", 0.0)
            rule2_max = rule_scores.get("rule2_max", 0.0)
            rule3_score = rule_scores.get("rule3_score", 0.0)
            rule3_max = rule_scores.get("rule3_max", 0.0)
            
            # Calculate score percentages for each rule
            rule1_percentage = (rule1_score / rule1_max * 100) if rule1_max > 0 else 100
            rule2_percentage = (rule2_score / rule2_max * 100) if rule2_max > 0 else 100
            rule3_percentage = (rule3_score / rule3_max * 100) if rule3_max > 0 else 100
            
            # Rule 1: Sensitive Data Recommendations - only if score below maximum
            if rule1_score < rule1_max and rule1_max > 0:
                sensitive_columns = sensitive_data.get("sensitive_columns", [])
                sensitivity_type = sensitive_data.get("sensitivity_type", "Unknown")
                if sensitive_columns:
                    column_list = ", ".join(sensitive_columns[:3])
                    if sensitivity_type != "None":
                        recommendations.append(f"Implement data masking/encryption for {sensitivity_type.lower()} data in columns: {column_list}")
                    else:
                        recommendations.append(f"Review and secure sensitive columns: {column_list}")
                elif sensitive_data.get("has_sensitive_data", False):
                    recommendations.append(f"Implement appropriate security controls for detected {sensitivity_type.lower()} data")
            
            # Rule 2: Security Roles Recommendations - only if score below maximum
            if rule2_score < rule2_max and rule2_max > 0:
                has_financial = financial_data.get("has_financial_data", False)
                has_security = security_data.get("security_check", {}).get("has_security_filtering", False)
                security_status = security_data.get("security_status", "UNKNOWN")
                
                if has_financial and not has_security:
                    financial_cols = financial_data.get("revenue_columns", []) + financial_data.get("target_columns", []) + financial_data.get("budget_columns", [])
                    if financial_cols:
                        col_list = ", ".join(financial_cols[:2])
                        recommendations.append(f"Configure RLS filters for financial columns: {col_list}")
                    else:
                        recommendations.append("Configure row-level security (RLS) for financial data access control")
                elif has_financial and security_status != "COMPREHENSIVE_SECURITY":
                    recommendations.append("Enhance existing RLS filters to ensure comprehensive financial data protection")
            
            # Rule 3: Seller Assignment Recommendations - only if score below maximum
            if rule3_score < rule3_max and rule3_max > 0:
                has_financial = financial_data.get("has_financial_data", False)
                linkage_quality = account_data.get("linkage_quality", "None")
                
                if has_financial:
                    account_cols = account_data.get("account_columns", [])
                    tpid_cols = account_data.get("tpid_columns", [])
                    mssales_cols = account_data.get("mssales_id_columns", [])
                    
                    if linkage_quality == "None":
                        recommendations.append("Add Account, TPID, or MSSales ID columns to enable seller assignment security")
                    elif linkage_quality == "Poor":
                        existing_cols = account_cols + tpid_cols + mssales_cols
                        if existing_cols:
                            col_list = ", ".join(existing_cols[:2])
                            recommendations.append(f"Improve account linkage quality - enhance columns: {col_list}")
                        else:
                            recommendations.append("Improve account linkage columns for accurate seller-to-account associations")
                    elif linkage_quality == "Moderate":
                        recommendations.append("Add additional account identifier columns for enhanced seller assignment precision")
            
            # Only show maintenance message if NO recommendations were generated (all scores at maximum)
            if not recommendations:
                recommendations.append("All security controls optimal - maintain current configuration")
        
        else:
            # Fallback to original logic if rule_scores not provided
            # Rule 1: Sensitive data recommendations
            if sensitive_data.get("has_sensitive_data", False):
                sensitive_type = sensitive_data.get("sensitivity_type", "Unknown")
                sensitive_columns = sensitive_data.get("sensitive_columns", [])
                if sensitive_columns:
                    recommendations.append(f"Implement data masking for {sensitive_type.lower()} data in columns: {', '.join(sensitive_columns[:3])}")
                else:
                    recommendations.append(f"Review and mask {sensitive_type.lower()} data detected in this table")
            
            # Rule 2: Security roles and filtering recommendations
            if financial_data.get("has_financial_data", False):
                if not security_data.get("has_security_filtering", False):
                    recommendations.append("Configure row-level security (RLS) filters to restrict financial data access based on user permissions")
                else:
                    security_status = security_data.get("security_status", "UNKNOWN")
                    if security_status != "COMPREHENSIVE_SECURITY":
                        recommendations.append("Enhance security filtering to ensure comprehensive data access control")
            
            # Rule 3: Account linkage recommendations
            if financial_data.get("has_financial_data", False):
                linkage_quality = account_data.get("linkage_quality", "None")
                if linkage_quality == "None":
                    recommendations.append("Add Account, TPID, or MSSales ID columns to enable proper seller assignment security")
                elif linkage_quality == "Poor":
                    recommendations.append("Improve account linkage columns to ensure accurate seller-to-account associations")
                elif linkage_quality == "Moderate":
                    recommendations.append("Consider adding additional account identifier columns for enhanced linkage quality")
            
            # Cross-cutting recommendations
            if financial_data.get("has_financial_data", False) and not sensitive_data.get("has_sensitive_data", False):
                recommendations.append("Review financial data columns for potential sensitive information that may need protection")
            
            if not recommendations:
                if financial_data.get("has_financial_data", False):
                    recommendations.append("Financial table with good security compliance - maintain current controls and monitor regularly")
                else:
                    recommendations.append("Non-financial table with acceptable security posture - continue standard monitoring")
        
        return "; ".join(recommendations[:3])  # Limit to top 3 recommendations for CSV readability

    def _format_detailed_issue(self, row: Dict[str, Any]) -> str:
        """
        Format a detailed issue explanation for a column based on its analysis results.
        Provides specific reasons why the column is flagged as Critical/Issue/Warning.
        """
        column_name = row.get('Column_Name', 'Unknown')
        table_name = row.get('Table_Name', 'Unknown')
        overall_score = row.get('Overall_score', 0)
        severity = row.get('Issue_Severity', 'Unknown')
        
        # Get individual scores to identify specific problems
        cn_001_score = row.get('Column_Name_Score', 0)
        cn_002_score = row.get('Column_Selfexplanatory_Score', 0)
        cn_003_score = row.get('Unique_Column_Score', 0)
        cn_004_score = row.get('Column_Format_Score', 0)
        ct_001_score = row.get('Column_DataType_Score', 0)
        
        # Get max scores for comparison
        cn_001_max = row.get('Column_Name_Max_Score', 0.35)
        cn_002_max = row.get('Column_Selfexplanatory_Max_Score', 0.30)
        cn_003_max = row.get('Unique_Column_Max_Score', 0.25)
        cn_004_max = row.get('Column_Format_Max_Score', 0.10)
        ct_001_max = row.get('Column_DataType_Max_Score', 1.0)
        
        # Build detailed explanation
        issues = []
        
        # Check CN-001: Business clarity issues
        if cn_001_score < cn_001_max * 0.75:  # Less than 75% of max score
            if cn_001_score == 0:
                issues.append("❌ Poor business naming - column name doesn't clearly indicate business purpose")
            else:
                issues.append("⚠️ Unclear business naming - name could be more descriptive for business users")
        
        # Check CN-002: Self-explanatory issues
        if cn_002_score < cn_002_max * 0.75:
            if cn_002_score == 0:
                issues.append("❌ Not self-explanatory - requires domain knowledge to understand")
            else:
                issues.append("⚠️ Somewhat unclear - could benefit from more explanatory naming")
        
        # Check CN-003: Uniqueness issues
        if cn_003_score < cn_003_max * 0.75:
            if cn_003_score < cn_003_max * 0.3:
                issues.append("❌ Highly ambiguous - column name appears in many tables causing confusion")
            else:
                issues.append("⚠️ Name similarity - appears in multiple tables, may confuse users")
        
        # Check CN-004: Formatting issues
        if cn_004_score < cn_004_max * 0.75:
            if cn_004_score == 0:
                issues.append("❌ Poor formatting - doesn't follow PascalCase naming conventions")
            else:
                issues.append("⚠️ Formatting inconsistency - minor deviation from naming standards")
        
        # Check CT-001: Data type issues
        if ct_001_score < ct_001_max * 0.75:
            current_type = row.get('Current_Data_Type', 'Unknown')
            suggested_type = row.get('Suggested_DataType', 'Unknown')
            if ct_001_score == 0:
                issues.append(f"❌ Wrong data type - currently {current_type}, should be {suggested_type}")
            else:
                issues.append(f"⚠️ Suboptimal data type - {current_type} could be improved to {suggested_type}")
        
        # Get recommendation if available
        recommendation = row.get('Recommendations', '')
        
        # Format the final message
        severity_emoji = {
            'critical': '🔴',
            'issue': '🟠', 
            'warning': '🟡',
            'good': '🟢'
        }
        
        emoji = severity_emoji.get(severity, '⚪')
        
        if issues:
            issues_text = " | ".join(issues)
            base_message = f"{emoji} {table_name}.{column_name} scored {overall_score:.1f}% - {issues_text}"
        else:
            base_message = f"{emoji} {table_name}.{column_name} scored {overall_score:.1f}%"
        
        # Add recommendation if available and meaningful
        if recommendation and len(recommendation) > 10 and 'analysis' not in recommendation.lower():
            # Truncate long recommendations
            short_recommendation = recommendation[:100] + "..." if len(recommendation) > 100 else recommendation
            return f"{base_message}. Recommendation: {short_recommendation}"
        else:
            return base_message

    def _generate_suggested_hierarchies(self, table_names: list) -> list:
        """
        Generate suggested hierarchies based on table structure analysis when no existing hierarchies are found.
        Analyzes column patterns to identify potential hierarchical relationships.
        """
        suggested_hierarchies = []
        
        try:
            # Get the actual table objects from table names
            all_tables = self.tabular_editor.model.Tables
            table_objects = {t.Name: t for t in all_tables}
            
            for table_name in table_names:
                # Get the table object
                if table_name not in table_objects:
                    logger.debug(f"Table {table_name} not found in model")
                    continue
                    
                table = table_objects[table_name]
                columns = list(table.Columns)
                
                # Look for common hierarchy patterns
                potential_levels = []
                
                # Pattern 1: Date/Time hierarchies (Year, Quarter, Month, Day)
                date_columns = [col for col in columns if 'date' in col.Name.lower() or 'time' in col.Name.lower() or str(col.DataType) == 'DateTime']
                if date_columns:
                    for date_col in date_columns[:1]:  # Take first date column
                        potential_levels.append({
                            "level_name": f"{date_col.Name}_Year",
                            "column_name": date_col.Name,
                            "level_type": "Year"
                        })
                        potential_levels.append({
                            "level_name": f"{date_col.Name}_Quarter", 
                            "column_name": date_col.Name,
                            "level_type": "Quarter"
                        })
                        potential_levels.append({
                            "level_name": f"{date_col.Name}_Month",
                            "column_name": date_col.Name, 
                            "level_type": "Month"
                        })
                
                # Pattern 2: Geographic hierarchies (Country, State, City)
                geo_patterns = ['country', 'state', 'region', 'city', 'location', 'territory']
                geo_columns = [col for col in columns if any(pattern in col.Name.lower() for pattern in geo_patterns)]
                if len(geo_columns) >= 2:
                    geo_columns.sort(key=lambda x: len([p for p in geo_patterns if p in x.Name.lower()]), reverse=True)
                    for i, geo_col in enumerate(geo_columns[:3]):  # Take up to 3 levels
                        potential_levels.append({
                            "level_name": geo_col.Name,
                            "column_name": geo_col.Name,
                            "level_type": f"Geographic_Level_{i+1}"
                        })
                
                # Pattern 3: Product/Category hierarchies
                product_patterns = ['category', 'subcategory', 'brand', 'product', 'item']
                product_columns = [col for col in columns if any(pattern in col.Name.lower() for pattern in product_patterns)]
                if len(product_columns) >= 2:
                    product_columns.sort(key=lambda x: x.Name.lower())
                    for i, prod_col in enumerate(product_columns[:3]):
                        potential_levels.append({
                            "level_name": prod_col.Name,
                            "column_name": prod_col.Name,
                            "level_type": f"Product_Level_{i+1}"
                        })
                
                # Create suggested hierarchy if we found levels
                if potential_levels and len(potential_levels) >= 2:
                    hierarchy_name = f"Suggested_{table_name}_Hierarchy"
                    level_count = min(len(potential_levels), 4)
                    
                    # Create column path in the expected format
                    column_names = [level["column_name"] for level in potential_levels[:4]]
                    column_path = " > ".join(column_names)
                    
                    # Match the expected structure for AI processing
                    suggested_hierarchy = {
                        "hierarchy_name": hierarchy_name,
                        "table_name": table_name, 
                        "level_count": level_count,
                        "column_path": column_path,
                        "table_id": f"suggested_table_{table_name}",
                        "hierarchy_id": f"suggested_hierarchy_{len(suggested_hierarchies)}"
                    }
                    
                    suggested_hierarchies.append(suggested_hierarchy)
                    
        except Exception as e:
            logger.warning(f"Error generating suggested hierarchies: {e}")
        
        logger.info(f"Generated {len(suggested_hierarchies)} suggested hierarchies")
        return suggested_hierarchies

    def _generate_suggested_relationships(self, table_names: list) -> list:
        """
        Generate suggested relationships based on column name matching when no existing relationships are found.
        Looks for foreign key patterns and common naming conventions.
        """
        suggested_relationships = []
        
        try:
            # Get the actual table objects from table names
            all_tables = self.tabular_editor.model.Tables
            table_objects = {t.Name: t for t in all_tables}
            
            # Build column inventory for matching
            table_columns = {}
            for table_name in table_names:
                if table_name in table_objects:
                    table = table_objects[table_name]
                    table_columns[table_name] = [col.Name for col in table.Columns]
            
            # Look for potential relationships
            for from_table_name in table_names:
                if from_table_name not in table_objects:
                    continue
                    
                from_table = table_objects[from_table_name] 
                from_columns = list(from_table.Columns)
                
                for from_col in from_columns:
                    from_col_name = from_col.Name
                    
                    # Skip obvious non-key columns
                    if from_col_name.lower() in ['name', 'description', 'date', 'amount', 'value']:
                        continue
                    
                    # Look for matching columns in other tables
                    for to_table_name in table_names:
                        if to_table_name == from_table_name or to_table_name not in table_objects:
                            continue
                            
                        to_table = table_objects[to_table_name]
                        to_columns = list(to_table.Columns)
                        
                        for to_col in to_columns:
                            to_col_name = to_col.Name
                            
                            # Direct name match
                            if from_col_name == to_col_name:
                                suggested_relationships.append({
                                    "from_table": from_table_name,
                                    "from_column": from_col_name,
                                    "to_table": to_table_name, 
                                    "to_column": to_col_name,
                                    "cardinality": "Many-to-One",
                                    "cross_filter_direction": "Single",
                                    "is_active": True,
                                    "relationship_type": "SUGGESTED"
                                })
                            
                            # ID/Key pattern matching
                            elif (from_col_name.lower().endswith('id') and 
                                  to_col_name.lower().endswith('id') and
                                  from_col_name.lower().replace('id', '') == to_col_name.lower().replace('id', '')):
                                
                                suggested_relationships.append({
                                    "from_table": from_table_name,
                                    "from_column": from_col_name,
                                    "to_table": to_table_name,
                                    "to_column": to_col_name,
                                    "cardinality": "Many-to-One", 
                                    "cross_filter_direction": "Single",
                                    "is_active": True,
                                    "relationship_type": "SUGGESTED"
                                })
                                
        except Exception as e:
            logger.warning(f"Error generating suggested relationships: {e}")
        
        # Remove duplicates
        unique_relationships = []
        seen = set()
        for rel in suggested_relationships:
            key = (rel["from_table"], rel["from_column"], rel["to_table"], rel["to_column"])
            if key not in seen:
                seen.add(key)
                unique_relationships.append(rel)
        
        logger.info(f"Generated {len(unique_relationships)} suggested relationships")
        return unique_relationships
 
    def evaluate_fact_dimension_analysis(self, tables_to_analyze: List[str] = None, progress_callback=None) -> Dict[str, Any]:
        """
        AI-powered comprehensive analysis to classify tables as fact or dimension tables.
        Uses GPT-4o to provide intelligent, context-aware table classification with detailed reasoning.
        
        Args:
            tables_to_analyze: List of specific table names to analyze (if None, analyzes all)
            progress_callback: Optional callback function for progress updates
        """
        import re
        import pandas as pd
        import os
        import json
        import io
        import csv
        import time
        from datetime import datetime
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker

        def get_ai_client():
            """Get Azure OpenAI client from authentication manager"""
            try:
                auth_manager = AuthenticationManager.get_instance()
                return auth_manager.get_openai_client()
            except Exception as e:
                logger.error(f"Failed to get OpenAI client: {e}")
                return None

        def create_fact_dimension_prompt() -> str:
            """Create system prompt for AI fact/dimension table analysis"""
            return """You are an expert Power BI data modeling specialist with deep knowledge of dimensional modeling, star schema design, and business intelligence best practices. Your task is to analyze table metadata and classify each table as either a FACT table or DIMENSION table with detailed reasoning.

ANALYSIS FRAMEWORK:

**FACT TABLE CHARACTERISTICS:**
- Contains business events, transactions, or measurable activities
- Has foreign keys connecting to dimension tables (many-to-one relationships)
- Contains numeric measures that can be aggregated (SUM, COUNT, AVG, etc.)
- Typically has date/time columns for temporal analysis
- High granularity data (many rows)
- Column names often include: Amount, Quantity, Count, Value, Rate, Score
- Table names often include: Sales, Orders, Transactions, Events, Facts, Activities

**DIMENSION TABLE CHARACTERISTICS:**
- Contains descriptive attributes for business entities
- Has primary keys that connect to fact tables (one-to-many relationships)
- Contains textual, categorical, or descriptive data
- Provides context and filtering capabilities for analysis
- Lower granularity data (fewer rows, more stable)
- Column names often include: Name, Description, Category, Type, Status, Code
- Table names often include: Customer, Product, Employee, Location, Time, Category

**CRITICAL CLASSIFICATION RULE:**
**If a table has MORE one-to-many relationships than many-to-one relationships, classify it as a DIMENSION table.**
**If a table has MORE many-to-one relationships than one-to-many relationships, classify it as a FACT table.**
This rule takes priority over other characteristics when relationship counts are clearly different.

**SPECIAL CASES:**
- **Bridge Tables**: Link many-to-many relationships (classify as specialized fact tables)
- **Utility Tables**: Configuration, settings, parameters (classify as dimension tables)
- **Calendar/Date Tables**: Always dimension tables
- **Lookup Tables**: Small reference tables (dimension tables)

**SCORING CRITERIA:**
- **Confidence Score (0-1.0)**: How certain are you about the classification?
  - 0.9-1.0: Extremely confident (clear characteristics)
  - 0.7-0.8: High confidence (most characteristics align)
  - 0.5-0.6: Moderate confidence (mixed characteristics)
  - 0.3-0.4: Low confidence (unclear patterns)
  - 0.0-0.2: Very uncertain (insufficient information)

For each table, analyze and return this EXACT JSON structure:

```json
{
  "table_name": "string",
  "classification": "FACT" or "DIMENSION",
  "confidence_score": 0.0-1.0,
  "primary_reasoning": "Main reason for classification in 1-2 sentences",
  "supporting_evidence": [
    "Evidence point 1",
    "Evidence point 2", 
    "Evidence point 3"
  ],
  "characteristics_analysis": {
    "relationship_pattern": "many-to-one|one-to-many|isolated|mixed",
    "data_nature": "transactional|descriptive|reference|configuration",
    "column_types": "mostly_numeric|mostly_text|mixed|unknown",
    "business_purpose": "events|attributes|lookup|utility"
  },
  "quality_assessment": "EXCELLENT|GOOD|FAIR|POOR",
  "recommendations": [
    "Specific recommendation 1",
    "Specific recommendation 2"
  ],
  "potential_concerns": [
    "Any design concerns or issues"
  ]
}
```

**IMPORTANT RULES:**
1. Every table must be classified as either FACT or DIMENSION (no hybrid/unclear categories)
2. Base decisions on actual table structure, not just naming conventions
3. Consider the broader data model context and relationships
4. Provide specific, actionable recommendations
5. Flag any unusual patterns or potential design issues"""

        def analyze_tables_with_ai(client, tables_data: list, model_context: dict) -> list:
            """Analyze tables using GPT-4o for intelligent classification"""
            try:
                # Create comprehensive table analysis prompt
                tables_summary = []
                for table_data in tables_data:
                    table_summary = f"""
TABLE: {table_data['table_name']}
- Columns ({len(table_data['columns'])}): {', '.join(table_data['columns'][:10])}{'...' if len(table_data['columns']) > 10 else ''}
- Measures ({table_data['measure_count']}): {', '.join(table_data['measures'][:5])}{'...' if len(table_data['measures']) > 5 else ''}
- Data Types: {table_data['column_types_summary']}
- Relationships: {table_data['relationships_summary']}
- Sample Row Count: {table_data.get('estimated_rows', 'Unknown')}"""
                    tables_summary.append(table_summary)

                user_prompt = f"""
DATASET CONTEXT:
- Workspace: {model_context['workspace_name']}
- Dataset: {model_context['dataset_name']}
- Total Tables: {model_context['total_tables']}
- Analysis Mode: AI-Powered Classification

TABLES TO ANALYZE:
{chr(10).join(tables_summary)}

ADDITIONAL CONTEXT:
- Model has {model_context.get('total_relationships', 0)} relationships
- Contains {model_context.get('total_measures', 0)} measures across all tables

CRITICAL ANALYSIS INSTRUCTIONS:
1. **RELATIONSHIP PRIORITY RULE**: Use the relationship counts as the PRIMARY classification factor:
   - If "One-side relationships" > "Many-side relationships" → DIMENSION table
   - If "Many-side relationships" > "One-side relationships" → FACT table
   - If equal or both zero, use other characteristics (measures, column types, etc.)

2. **Pay close attention to the "Relationships" line** in each table summary
3. **Example**: "Many-side: 3, One-side: 1" = FACT table (3 > 1)
4. **Example**: "Many-side: 1, One-side: 4" = DIMENSION table (4 > 1)

Please analyze each table and classify as FACT or DIMENSION with detailed reasoning. Return a JSON object with 'tables' array containing one analysis object per table."""

                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=[
                        {"role": "system", "content": create_fact_dimension_prompt()},
                        {"role": "user", "content": user_prompt}
                    ],
                    temperature=0.1,
                    max_tokens=4000,
                    response_format={"type": "json_object"}
                )

                # Parse AI response
                ai_response = response.choices[0].message.content
                import json
                
                try:
                    ai_results = json.loads(ai_response)
                    if isinstance(ai_results, dict):
                        # Look for tables array in the response
                        if 'tables' in ai_results:
                            ai_results = ai_results['tables']
                        elif 'analyses' in ai_results:
                            ai_results = ai_results['analyses']
                        elif 'results' in ai_results:
                            ai_results = ai_results['results']
                        else:
                            # Convert single dict to array
                            ai_results = [ai_results]
                    
                    logger.info(f"✅ AI analyzed {len(ai_results)} tables successfully")
                    return ai_results
                    
                except json.JSONDecodeError as e:
                    logger.error(f"Failed to parse AI response as JSON: {e}")
                    logger.debug(f"AI Response: {ai_response}")
                    return []

            except Exception as e:
                logger.error(f"AI analysis failed: {e}")
                return []

        def get_table_row_estimate(table_name: str) -> str:
            """Get rough estimate of table row count"""
            try:
                escaped_table = f"'{table_name}'" if ' ' in table_name else table_name
                query = f"EVALUATE ROW(\"RowCount\", COUNTROWS({escaped_table}))"
                result = self.tabular_editor.execute_dax_query(query)
                if result and len(result) > 0:
                    count = result[0].get('[RowCount]', 0)
                    if count > 1000000:
                        return f"~{count//1000000}M+ rows (High volume - likely fact)"
                    elif count > 100000:
                        return f"~{count//1000}K rows (Medium volume)"
                    elif count > 1000:
                        return f"~{count} rows (Low volume - likely dimension)"
                    else:
                        return f"{count} rows (Very small - likely lookup)"
                return "Unknown"
            except:
                return "Unknown"

        try:
            # ================================================================================================
            # INITIALIZE UI PROGRESS TRACKER
            # ================================================================================================
            # Create centralized progress tracker for consistent UI updates
            ui_tracker = create_analysis_tracker(
                progress_callback=progress_callback,
                session_id=f"fact_dimension_analysis_{int(time.time())}"
            )
            
            # ================================================================================================
            # PHASE 1: INITIAL SETUP & VALIDATION
            # ================================================================================================
            # Verify connections and initialize required services for analysis
            
            ui_tracker.set_phase("Initial Setup & Validation", "Verifying connections and initializing AI services")
            
            if not self.tabular_editor.connected:
                ui_tracker.add_error("Not connected to any dataset", "connection_error")
                return {"error": "Not connected to any Power BI dataset"}
           
            # Check for cancellation at the start
            if self._check_cancellation("AI fact and dimension analysis"):
                ui_tracker.add_error("Analysis cancelled by user", "user_cancellation")
                return {"error": "Analysis stopped by user", "cancelled": True}

            # Initialize Azure OpenAI GPT-4o client for AI-powered analysis
            ai_client = get_ai_client()
            if not ai_client:
                ui_tracker.add_error("Failed to initialize AI client", "ai_error")
                return {"error": "AI client not available. Please check Azure OpenAI authentication."}
           
            # Get available tables and apply filters
            if tables_to_analyze:
                available_tables = self.tabular_editor.list_tables()
                invalid_tables = [t for t in tables_to_analyze if t not in available_tables]
                if invalid_tables:
                    ui_tracker.add_error(f"Tables not found: {invalid_tables}", "table_error")
                    raise Exception(f"Tables not found: {invalid_tables}")
                tables = [table for table in available_tables if table in tables_to_analyze]
                logger.info(f"Analyzing specific tables: {len(tables)} tables selected")
            else:
                tables = self.tabular_editor.list_tables()
                logger.info(f"Analyzing all tables: {len(tables)} tables found")
           
            if not tables:
                ui_tracker.add_error("No tables found to analyze", "table_error")
                raise Exception("No tables found to analyze")
           
            # Calculate batch processing parameters
            total_tables = len(tables)
            batch_size = 1  # One table per batch for granular progress tracking
            total_batches = total_tables  # Each table gets its own batch
            
            # Start analysis tracking with comprehensive information
            ui_tracker.start_analysis(
                analysis_name="AI-Powered Fact/Dimension Table Classification",
                total_items=total_tables,
                total_batches=total_batches
            )

            # ================================================================================================
            # PHASE 2: DATA COLLECTION & PREPARATION
            # ================================================================================================
            # Gather table metadata and prepare data structures for AI analysis
            
            ui_tracker.set_phase("Data Collection & Preparation", "Collecting comprehensive metadata from all tables")
            
            # Collect comprehensive table data for AI analysis
            tables_data = []
            
            # Get workspace and dataset information for context
            try:
                actual_dataset_id = self.tabular_editor.model.Database.ID if hasattr(self.tabular_editor.model, 'Database') and hasattr(self.tabular_editor.model.Database, 'ID') else 'Unknown'
                actual_workspace_id = getattr(self.tabular_editor, 'current_workspace_id', 'Unknown')
            except:
                actual_dataset_id = 'Unknown'
                actual_workspace_id = 'Unknown'
            
            workspace_info = {
                "WorkspaceID": actual_workspace_id,
                "WorkspaceName": getattr(self.tabular_editor, 'current_workspace', 'Unknown'),
                "DatasetID": actual_dataset_id,
                "DatasetName": getattr(self.tabular_editor, 'current_database', 'Unknown')
            }
            
            # Get model context
            total_relationships = len(self.tabular_editor.model.Relationships) if hasattr(self.tabular_editor.model, 'Relationships') else 0
            total_measures = sum(len(table.Measures) for table in self.tabular_editor.model.Tables if hasattr(table, 'Measures'))
            
            model_context = {
                "workspace_name": workspace_info["WorkspaceName"],
                "dataset_name": workspace_info["DatasetName"],
                "total_tables": total_tables,
                "total_relationships": total_relationships,
                "total_measures": total_measures
            }
            
            logger.info(f"📊 Model context: {total_relationships} relationships, {total_measures} measures across all tables")

            # Process each table to gather comprehensive data
            for table_idx, table_name in enumerate(tables, 1):
                # Check for cancellation
                if self._check_cancellation(f"Collecting data for table: {table_name}"):
                    logger.info(f"🛑 Analysis cancelled at table {table_idx}/{total_tables}: {table_name}")
                    break
                
                # Update progress with UI tracker
                ui_tracker.update_progress(
                    f"Collecting metadata from table {table_idx} of {total_tables}: {table_name}",
                    current=table_idx,
                    total=total_tables,
                    table_name=table_name
                )

                # Get table object
                table_obj = next((t for t in self.tabular_editor.model.Tables
                                if t.Name.lower() == table_name.lower()), None)
                
                if not table_obj:
                    continue

                # Collect table metadata
                try:
                    table_columns = self.tabular_editor.list_table_columns(table_name)
                except:
                    table_columns = []

                table_measures = [measure.Name for measure in table_obj.Measures] if hasattr(table_obj, 'Measures') else []
                
                # Analyze column types
                numeric_cols = 0
                text_cols = 0
                date_cols = 0
                id_cols = 0
                
                for col_name in table_columns:
                    col_lower = col_name.lower()
                    if any(pattern in col_lower for pattern in ['amount', 'value', 'count', 'sum', 'total', 'quantity', 'number', 'rate', 'percentage', 'score']):
                        numeric_cols += 1
                    elif any(pattern in col_lower for pattern in ['date', 'time', 'created', 'modified', 'start', 'end']):
                        date_cols += 1
                    elif any(pattern in col_lower for pattern in ['id', 'key']):
                        id_cols += 1
                    else:
                        text_cols += 1

                # Analyze relationships
                many_side_rels = 0
                one_side_rels = 0
                
                try:
                    if hasattr(self.tabular_editor, 'model') and self.tabular_editor.model:
                        for relationship in self.tabular_editor.model.Relationships:
                            if hasattr(relationship, 'FromTable') and hasattr(relationship, 'ToTable'):
                                if relationship.FromTable.Name.lower() == table_name.lower():
                                    many_side_rels += 1
                                elif relationship.ToTable.Name.lower() == table_name.lower():
                                    one_side_rels += 1
                except:
                    pass

                # Build comprehensive table data
                table_data = {
                    "table_name": table_name,
                    "columns": table_columns,
                    "measures": table_measures,
                    "measure_count": len(table_measures),
                    "column_count": len(table_columns),
                    "numeric_columns": numeric_cols,
                    "text_columns": text_cols,
                    "date_columns": date_cols,
                    "id_columns": id_cols,
                    "many_side_relationships": many_side_rels,
                    "one_side_relationships": one_side_rels,
                    "column_types_summary": f"Numeric: {numeric_cols}, Text: {text_cols}, Date: {date_cols}, ID/Key: {id_cols}",
                    "relationships_summary": f"Many-side: {many_side_rels}, One-side: {one_side_rels}",
                    "estimated_rows": get_table_row_estimate(table_name)
                }
                
                tables_data.append(table_data)

            # ================================================================================================
            # PHASE 3: AI BATCH PROCESSING
            # ================================================================================================
            # Send table data to GPT-4o in optimized batches for intelligent classification
            
            ui_tracker.set_phase("AI Batch Processing", f"Starting AI analysis in batches of {batch_size} tables")
            
            # Create batch progress tracker for detailed batch management
            batch_tracker = create_batch_tracker(ui_tracker, batch_size)
            
            # Process tables in AI batches (max 10 tables per batch to avoid token limits)
            all_ai_results = []
            
            # Initialize table completion tracking
            self._completed_tables = set()
            
            for i in range(0, len(tables_data), batch_size):
                batch_start = i
                batch_end = min(i + batch_size, len(tables_data))
                batch_tables = tables_data[batch_start:batch_end]
                current_batch = (batch_start // batch_size) + 1
                
                # Check for cancellation
                if self._check_cancellation(f"AI analysis batch {current_batch}"):
                    ui_tracker.add_error(f"Analysis cancelled at batch {current_batch}", "user_cancellation")
                    break
                
                # Start batch processing with detailed tracking
                batch_tracker.start_batch(current_batch, total_batches, batch_tables)
                ui_tracker.set_phase("AI Batch Processing", f"Processing batch {current_batch} of {total_batches}")
                
                # Log batch processing message for UI parsing (specific pattern required by UI regex)
                logger.info(f"🤖 AI analyzing batch {current_batch} of {total_batches} ({len(batch_tables)} tables)")
                
                # Also update UI tracker for comprehensive tracking
                ui_tracker.update_progress(
                    f"Processing tables batch {current_batch} of {total_batches}",
                    current=current_batch,
                    total=total_batches
                )
                
                # Analyze batch with AI
                ai_results = analyze_tables_with_ai(ai_client, batch_tables, model_context)
                all_ai_results.extend(ai_results)
                
                # Track table completion after processing AI results in this batch
                tables_in_batch = set(ai_result.get("table_name", "Unknown") for ai_result in ai_results)
                for table_name in tables_in_batch:
                    if table_name not in self._completed_tables:
                        self._completed_tables.add(table_name)
                
                # Extract table names from batch for detailed reporting
                batch_table_names = [table_data["table_name"] for table_data in batch_tables]
                
                # Complete batch processing with comprehensive statistics using UI tracker
                batch_tracker.complete_batch(
                    batch_number=current_batch,
                    total_batches=total_batches,
                    processing_results=ai_results
                )
            
            # Log processing completion for UI parsing (specific pattern required by UI regex)
            logger.info(f"🤖 FACT DIMENSION PROGRESS: Processed AI analysis of {total_batches} batches ({len(tables)} tables)")
            
            # Also update UI tracker for comprehensive tracking  
            ui_tracker.update_progress(
                f"Completed table classification - {len(tables)} tables processed",
                current=total_batches,
                total=total_batches
            )

            # ================================================================================================
            # PHASE 4: RESULTS PROCESSING & CSV GENERATION
            # ================================================================================================
            # Process AI results and generate comprehensive analysis reports
            
            ui_tracker.set_phase("Results Processing", f"Processing AI analysis results for {len(all_ai_results)} tables")

            # Process AI results into final format
            table_analysis = []
            fact_tables = []
            dimension_tables = []
            hybrid_tables = []  # Keep for backward compatibility
            unclear_tables = []  # Keep for backward compatibility
           
            quality_distribution = {"excellent_tables": 0, "good_tables": 0, "fair_tables": 0, "poor_tables": 0}

            # Create a lookup map for table data
            table_data_lookup = {td["table_name"]: td for td in tables_data}

            for ai_result in all_ai_results:
                table_name = ai_result.get("table_name", "Unknown")
                classification = ai_result.get("classification", "DIMENSION")
                confidence = float(ai_result.get("confidence_score", 0.0))
                
                # Get original table data for detailed metrics
                original_data = table_data_lookup.get(table_name, {})
                
                # Calculate simple fact/dimension scores based on AI confidence and classification
                if classification.upper() == "FACT":
                    fact_score = confidence
                    dimension_score = 1.0 - confidence
                else:
                    fact_score = 1.0 - confidence
                    dimension_score = confidence
                
                # PRIMARY RULE: Use AI classification with FT-001 and DT-001 scoring adjustments
                many_side_count = original_data.get("many_side_relationships", 0)
                one_side_count = original_data.get("one_side_relationships", 0)
                
                # Log relationship analysis for transparency
                if many_side_count > 0 or one_side_count > 0:
                    logger.info(f"📊 RELATIONSHIP ANALYSIS: {table_name} | Many-to-one: {many_side_count}, One-to-many: {one_side_count} | AI Classification Maintained")
                
                # Quality assessment based on confidence with improved thresholds
                if confidence >= 0.90:
                    quality_level = "Excellent"
                    quality_icon = "✅"
                    quality_distribution["excellent_tables"] += 1
                elif confidence >= 0.75:
                    quality_level = "Good"
                    quality_icon = "✅"
                    quality_distribution["good_tables"] += 1
                elif confidence >= 0.50:
                    quality_level = "Fair"
                    quality_icon = "⚠️"
                    quality_distribution["fair_tables"] += 1
                else:
                    quality_level = "Poor"
                    quality_icon = "🔴"
                    quality_distribution["poor_tables"] += 1

                # Categorize tables using the potentially overridden classification
                if classification.upper() == "FACT":
                    fact_tables.append(table_name)
                    primary_type = "Fact Table"
                else:
                    dimension_tables.append(table_name)
                    primary_type = "Dimension Table"

                # Build comprehensive result with detailed metrics
                table_result = {
                    "table_name": table_name,
                    "classification": classification.upper(),
                    "primary_type": primary_type,
                    "fact_score": round(fact_score, 3),
                    "dimension_score": round(dimension_score, 3),
                    "overall_score": round(confidence, 3),  # Use AI confidence as overall score
                    "confidence": round(confidence, 3),
                    "quality_level": quality_level,
                    "quality_icon": quality_icon,
                    "column_count": original_data.get("column_count", 0),
                    "measure_count": original_data.get("measure_count", 0),
                    "numeric_columns": original_data.get("numeric_columns", 0),
                    "text_columns": original_data.get("text_columns", 0),
                    "date_columns": original_data.get("date_columns", 0),
                    "foreign_key_patterns": original_data.get("id_columns", 0),  # Use id_columns as FK patterns
                    "primary_key_patterns": original_data.get("id_columns", 0),  # Use id_columns as PK patterns
                    "many_side_relationships": original_data.get("many_side_relationships", 0),
                    "one_side_relationships": original_data.get("one_side_relationships", 0),
                    "primary_reasoning": ai_result.get("primary_reasoning", "AI analysis completed"),
                    "supporting_evidence": ai_result.get("supporting_evidence", []),
                    "characteristics_analysis": ai_result.get("characteristics_analysis", {}),
                    "recommendations": ai_result.get("recommendations", []),
                    "potential_concerns": ai_result.get("potential_concerns", []),
                    "ai_powered": True
                }
                
                table_analysis.append(table_result)
                
                # Log comprehensive analysis
                evidence_text = "; ".join(ai_result.get("supporting_evidence", [])[:2])
                logger.info(f"🤖 AI ANALYSIS: {table_name} → {primary_type} (confidence: {confidence:.3f}) | "
                           f"Reasoning: {ai_result.get('primary_reasoning', 'N/A')} | "
                           f"Evidence: {evidence_text}")

            # Update progress for CSV generation
            ui_tracker.update_progress(
                f"Generating comprehensive CSV analysis report...",
                current=int(total_tables * 0.9),
                total=total_tables
            )

            # Generate Excel file with color formatting
            excel_content = None
            excel_filename = None
            excel_file_path = None
            try:
                workspace_name = self._sanitize_filename(workspace_info["WorkspaceName"].replace(" ", ""))
                dataset_name = self._sanitize_filename(workspace_info["DatasetName"].replace(" ", ""))
               
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                csv_filename = f"AI_Fact_Dimension_Analysis_{workspace_name}_{dataset_name}_{timestamp}.csv"
               
                def calculate_issue_severity(percentage):
                    """Calculate issue severity based on percentage thresholds"""
                    if percentage < 0.59:
                        return 'Critical'
                    elif 0.60 <= percentage <= 0.74:
                        return 'Issue'
                    elif 0.75 <= percentage <= 0.84:
                        return 'Warning'
                    else:  # 0.85 and above
                        return 'Good'
                
                # Prepare DataFrame for Excel generation
                excel_data = []
                for table in table_analysis:
                    # Calculate percentage from overall_score and max_score (1.0)
                    percentage = table['overall_score'] / 1.0
                    issue_severity = calculate_issue_severity(percentage)
                    
                    excel_data.append({
                        'Table_Name': table['table_name'],
                        'Classification': table['classification'],
                        'Issue_Severity': issue_severity,  # This column will be color-formatted
                        'Fact_Score': table['fact_score'],
                        'Dimension_Score': table['dimension_score'],
                        'Overall_Score': table['overall_score'],
                        'Max_Score': 1.0,  # Max_Score - AI confidence ranges from 0.0 to 1.0
                        'Column_Count': table['column_count'],
                        'Measure_Count': table['measure_count'],
                        'Numeric_Columns': table['numeric_columns'],
                        'Text_Columns': table['text_columns'],
                        'Date_Columns': table['date_columns'],
                        'FK_Patterns': table['foreign_key_patterns'],
                        'PK_Patterns': table['primary_key_patterns'],
                        'Many_Side_Relationships': table['many_side_relationships'],
                        'One_Side_Relationships': table['one_side_relationships'],
                        'Recommendations': '; '.join(table.get('recommendations', []))
                    })
                
                # Create DataFrame and generate Excel file with color formatting
                df = pd.DataFrame(excel_data)
                excel_content, excel_filename, csv_text_content = self._create_excel_with_formatting(df, csv_filename, 'Issue_Severity')
                
                if excel_content and excel_filename and csv_text_content:
                    # Save Excel file to KnowledgeBase folder
                    excel_file_path = self._save_excel_file(excel_content, excel_filename)
                    logger.info(f"✅ Generated AI-powered fact/dimension analysis Excel file: {excel_file_path}")
                else:
                    logger.error("❌ Failed to generate Excel file")
                    
            except Exception as excel_error:
                logger.error(f"Failed to generate Excel file: {excel_error}")

            # Prepare final result
            result = {
                "status": "success",
                "analysis_summary": {
                    "total_tables_analyzed": len(tables),
                    "table_classification_distribution": {
                        "fact_tables": len(fact_tables),
                        "dimension_tables": len(dimension_tables),
                        "hybrid_tables": len(hybrid_tables),
                        "unclear_tables": len(unclear_tables)
                    },
                    "quality_distribution": quality_distribution,
                    "analysis_timestamp": datetime.now().isoformat(),
                    "analysis_method": "AI-Powered using GPT-4o"
                },
                "table_analysis": table_analysis,
                "categorized_tables": {
                    "fact_tables": fact_tables,
                    "dimension_tables": dimension_tables,
                    "hybrid_tables": hybrid_tables,
                    "unclear_tables": unclear_tables
                }
            }
           
            # Add Excel content and file path
            if excel_content and excel_filename and csv_text_content:
                result["csv_filename"] = excel_filename
                result["csv_file_path"] = excel_file_path
                result["csv_content"] = csv_text_content  # CSV text for UI parsing
                result["excel_content"] = excel_content   # Excel binary for download
            else:
                result["csv_generation_error"] = "Failed to generate Excel file - check logs for details"

            # Add AI analysis metadata for consistency with other AI-powered analyses
            result["ai_powered"] = True
            result["model_used"] = "gpt-4o"
           
            # Generate high-level summary
            result["high_level_summary"] = self.tabular_editor.generate_analysis_summary("ai_fact_dimension_analysis", result)
           
            # Complete analysis tracking with comprehensive statistics
            analysis_stats = ui_tracker.complete_analysis(
                success=True,
                summary=f"Successfully analyzed {len(table_analysis)} tables: {len(fact_tables)} fact + {len(dimension_tables)} dimension tables",
                results_data={
                    "total_tables": len(table_analysis),
                    "fact_tables": len(fact_tables),
                    "dimension_tables": len(dimension_tables),
                    "csv_filename": excel_filename,
                    "quality_distribution": quality_distribution,
                    "average_confidence": sum(t['confidence'] for t in table_analysis) / len(table_analysis) if table_analysis else 0
                }
            )
            
            # Add analysis statistics to result
            result["analysis_statistics"] = analysis_stats
            
            # Final processing message (avoid completion detection keywords)
            logger.info(f"📊 AI-powered fact and dimension analysis finished processing! Analyzed {len(table_analysis)} tables: {len(fact_tables)} fact + {len(dimension_tables)} dimension")
           
            return result
           
        except Exception as e:
            # Handle errors with UI progress tracker if available
            if 'ui_tracker' in locals():
                ui_tracker.add_error(f"AI analysis failed: {str(e)}", "analysis_error")
                error_stats = ui_tracker.complete_analysis(
                    success=False,
                    summary=f"Analysis failed due to error: {str(e)}"
                )
                logger.error(f"Error in AI-powered fact/dimension analysis: {str(e)}")
                return {
                    "error": f"AI analysis failed: {str(e)}",
                    "analysis_statistics": error_stats
                }
            else:
                logger.error(f"Error in AI-powered fact/dimension analysis: {str(e)}")
                return {"error": f"AI analysis failed: {str(e)}"}
   
    def _perform_cardinality_validation(self, from_table: str, from_column: str, to_table: str, to_column: str, model_cardinality: str) -> Dict[str, Any]:
        """
        Perform data-driven cardinality validation by analyzing actual data patterns
        """
        try:
            logger.info(f"🔍 Analyzing cardinality for {from_table}.{from_column} -> {to_table}.{to_column}")
            
            # Escape table names for DAX queries
            escaped_from_table = f"'{from_table}'" if ' ' in from_table else from_table
            escaped_to_table = f"'{to_table}'" if ' ' in to_table else to_table
            
            # Query to analyze relationship patterns
            validation_query = f"""
            EVALUATE
            ROW(
                "From_Total_Rows", COUNTROWS({escaped_from_table}),
                "From_Distinct_Values", DISTINCTCOUNT({escaped_from_table}[{from_column}]),
                "To_Total_Rows", COUNTROWS({escaped_to_table}),
                "To_Distinct_Values", DISTINCTCOUNT({escaped_to_table}[{to_column}])
            )
            """
            
            result = self.tabular_editor.execute_dax_query(validation_query)
            
            if result and len(result) > 0:
                data = result[0]
                from_total = data.get('[From_Total_Rows]', 0)
                from_distinct = data.get('[From_Distinct_Values]', 0) 
                to_total = data.get('[To_Total_Rows]', 0)
                to_distinct = data.get('[To_Distinct_Values]', 0)
                
                logger.info(f"📊 Data metrics: From({from_total}/{from_distinct}) To({to_total}/{to_distinct})")
                
                # Determine actual cardinality from data patterns
                from_has_duplicates = from_total > from_distinct
                to_has_duplicates = to_total > to_distinct
                
                if not from_has_duplicates and not to_has_duplicates:
                    # Both sides unique
                    data_cardinality = "One-to-One"
                    validation_status = "VALID - Unique values on both sides"
                    recommended_action = "Perfect one-to-one relationship"
                    
                elif from_has_duplicates and not to_has_duplicates:
                    # From side has duplicates, To side unique
                    data_cardinality = "Many-to-One"
                    validation_status = "VALID - Multiple source records per target record"
                    recommended_action = "Standard fact-to-dimension relationship"
                    
                elif not from_has_duplicates and to_has_duplicates:
                    # From side unique, To side has duplicates
                    data_cardinality = "One-to-Many"
                    validation_status = "VALID - One source record to multiple target records"
                    recommended_action = "Review relationship direction - consider reversing"
                    
                else:
                    # Both sides have duplicates
                    data_cardinality = "Many-to-Many"
                    validation_status = "COMPLEX - Duplicates on both sides"
                    recommended_action = "Consider bridge table or review data quality"
                
                return {
                    "data_cardinality": data_cardinality,
                    "validation_status": validation_status,
                    "recommended_action": recommended_action,
                    "data_metrics": f"From: {from_total} rows ({from_distinct} distinct), To: {to_total} rows ({to_distinct} distinct)"
                }
            
            # If no data returned
            return {
                "data_cardinality": "Analysis Failed",
                "validation_status": "ERROR - No data available for analysis", 
                "recommended_action": "Check if tables contain data",
                "data_metrics": "No data found"
            }
            
        except Exception as e:
            logger.error(f"❌ Cardinality validation failed: {str(e)}")
            return {
                "data_cardinality": "Analysis Failed",
                "validation_status": f"ERROR - {str(e)[:80]}",
                "recommended_action": "Check table/column existence and data access",
                "data_metrics": "Error retrieving data"
            }
            
    def extract_inactive_usage_from_detailed(self, is_active_detailed: str) -> str:
        """Extract usage justification from detailed is_active explanation"""
        if not is_active_detailed or is_active_detailed == "Unknown":
            return "Not_Applicable"
        
        is_active_lower = is_active_detailed.lower()
        if is_active_lower.startswith("yes"):
            return "Not_Applicable"
        elif "used in measure" in is_active_lower or "dax expression" in is_active_lower:
            return "Used_In_Measures"
        elif "not used in any measure" in is_active_lower:
            return "Unjustified"
        else:
            return "Unknown"
    
    def extract_bidirectional_purpose_from_detailed(self, cross_filter_direction: str) -> str:
        """Extract bidirectional purpose based on cross filter direction"""
        if not cross_filter_direction or cross_filter_direction == "Unknown":
            return "Not_Applicable"
        
        if cross_filter_direction.lower() in ["single", "one"]:
            return "Not_Applicable"
        elif cross_filter_direction.lower() in ["both", "bidirectional"]:
            # This could be enhanced to detect security vs other purposes from context
            return "Performance_Issue"  # Default assumption for "Both" direction
        else:
            return "Unknown"
    
    def extract_simple_is_active(self, is_active_detailed: str) -> str:
        """Extract simple Yes/No from detailed is_active explanation"""
        if not is_active_detailed:
            return "Unknown"
        return "Yes" if is_active_detailed.lower().startswith("yes") else "No"
    
    def extract_simple_data_type_compatibility(self, data_type_compatibility_detailed: str) -> str:
        """Extract simple Yes/No from detailed data_type_compatibility explanation"""
        if not data_type_compatibility_detailed:
            return "Unknown"
        return "Yes" if data_type_compatibility_detailed.lower().startswith("yes") else "No"

    def evaluate_table_linking(self, tables_to_analyze: List[str] = None, progress_callback=None) -> Dict[str, Any]:
        """
        AI-Powered table linking evaluation using GPT-4o for intelligent relationship assessment against Power BI best practices.
        
        Evaluates relationships against 4 specific scoring rules:
        - RL-001 (0.3pts): Data Types between the relationships columns are matching
        - RL-002 (0.35pts): Validate that the defined relationship is logically accurate by checking the actual data in the related columns for example, confirming whether a many-to-many relationship is truly appropriate.
        - RL-003 (0.2pts): Are inactive relationships used in the model? If so where and why? Active=0.2, Inactive+Used=<0.2, Inactive+NotUsed=0.0
        - RL-004 (0.15pts): Identifying the bi-directional relationships and score accordingly. If security purpose score good.for anything else score less. Single=0.15, Both+Security=0.15, Both+Other=0.1
        
        Args:
            tables_to_analyze: Optional list of specific tables to analyze. If None, analyzes all tables.
            progress_callback: Optional callback function for progress updates

        Returns:
            Dictionary containing AI-powered relationship analysis, recommendations, and CSV file path
        """
        import re
        import pandas as pd
        import os
        import json
        import io
        import time
        from datetime import datetime
        
        # Initialize timing and constants
        start_time = time.time()
        # Get absolute path to KnowledgeBase folder 
        current_dir = os.path.dirname(os.path.abspath(__file__))  # src folder
        root_dir = os.path.dirname(current_dir)  # go up one level to root
        KB_FOLDER = os.path.join(root_dir, "KnowledgeBase")  # Define knowledge base folder constant
        from src.authentication_manager import AuthenticationManager
        from src.ui_progress_tracker import create_analysis_tracker, create_batch_tracker

        def get_ai_client():
            """Get Azure OpenAI client from authentication manager"""
            try:
                auth_manager = AuthenticationManager.get_instance()
                return auth_manager.get_openai_client()
            except Exception as e:
                logger.error(f"Failed to get OpenAI client: {e}")
                return None

        def create_relationship_analysis_prompt() -> str:
            """Create system prompt for AI relationship analysis with structured scoring rules"""
            return """You are an expert Power BI relationship analyst specializing in dimensional modeling and relationship quality assessment. Analyze relationship metadata and provide structured scores based on these EXACT criteria:

SCORING RULES (must follow exactly):

1. RL-001 Score (max 0.3): Data Types between the relationships columns are matching
   - Analyze from_column_data_type and to_column_data_type for compatibility
   - 0.3 points for perfect data type match (identical data types: String=String, Integer=Integer, etc.)
   - 0.15 points for compatible types with minor differences (Int32 vs Int64, Decimal vs Double)
   - 0.0 points for completely incompatible types (Text vs DateTime, Boolean vs Number, String vs Integer)

2. RL-002 Score (max 0.35): Validate that the defined relationship is logically accurate by checking actual data patterns
   *** CRITICAL: Apply business-optimal scoring based on cardinality type ***
   - many_to_one OR Many-to-One = 0.35 points (OPTIMAL for Power BI dimensional models)
   - one_to_one OR One-to-One = 0.25 points (Good but less optimal than Many-to-One)
   - one_to_many OR One-to-Many = 0.35 points (Acceptable but reverse direction preferred)
   - many_to_many OR Many-to-Many = 0.05 points (Problematic for performance, should be avoided)
   *** IMPORTANT: Score based on actual cardinality type, not just accuracy ***

3. RL-003 Score (max 0.2): Are inactive relationships used in the model. If so where and why?
   *** SIMPLIFIED LOGIC (follow exactly) ***
   - If relationship is ACTIVE (is_active = "Yes"): Award 0.2 points
   - If relationship is INACTIVE and used in other measures: Award less than 0.2 points (0.1-0.15)
   - If relationship is INACTIVE and NOT used in other measures: Award 0.0 points

4. RL-004 Score (max 0.15): Cross filtering direction scoring
   *** SIMPLIFIED LOGIC (follow exactly) ***
   - If Cross_Filter_Direction = "Single": Award 0.15 points
   - If Cross_Filter_Direction = "Both" + security related data: Award 0.15 points
   - If Cross_Filter_Direction = "Both" (all other cases): Award 0.1 points

RELATIONSHIP TYPES:
- EXISTING_OPTIMAL: Existing relationship with high score (>0.85)
- EXISTING_NEEDS_IMPROVEMENT: Existing relationship with issues (0.60-0.84)
- EXISTING_PROBLEMATIC: Existing relationship with major issues (<0.60)
- MISSING_CRITICAL: Missing relationship with high business value (>0.85)
- MISSING_RECOMMENDED: Missing relationship with good value (0.60-0.84)
- MISSING_OPTIONAL: Missing relationship with moderate value (<0.60)

ISSUE SEVERITY LEVELS (based on total_score/max_score percentage):
- CRITICAL: ≤59% (Poor relationship design, immediate attention required)
- ISSUE: 60-74% (Significant improvements needed)  
- WARNING: 75-84% (Minor optimizations recommended)
- GOOD: 85%+ (Excellent relationship design, follows best practices)

