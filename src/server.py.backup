class SQLEndpoint:
    """Handles SQL endpoint connections and queries with authentication manager."""
    
    def __init__(self, auth_manager=None):
        # Use provided authentication manager instance or create new one (fallback)
        self.auth_manager = auth_manager or AuthenticationManager()
        self.engine = None
        self.sql_endpoint = None
        self.sql_database = None
        self.driver = None
        self._connection_lock = threading.Lock()
    
    def initialize_sql_connection(self, sql_endpoint: str, sql_database: str):
        """Initialize the SQL engine with authentication and drivers."""
        with self._connection_lock:
            try:
                if not sql_endpoint or not sql_database:
                    raise ValueError("sql_endpoint and sql_database must be provided")

                self.sql_endpoint = sql_endpoint
                self.sql_database = sql_database
                logger.info(f"Initializing SQL connection to {sql_endpoint}/{sql_database}")

                # Get available SQL Server drivers
                drivers = [d for d in pyodbc.drivers() if 'SQL Server' in d]
                if not drivers:
                    raise RuntimeError("No SQL Server ODBC drivers found. Please install ODBC Driver for SQL Server.")

                # Prefer newer drivers
                preferred_drivers = ['ODBC Driver 18 for SQL Server', 'ODBC Driver 17 for SQL Server']
                self.driver = next((d for d in preferred_drivers if d in drivers), drivers[0])
                logger.info(f"Using SQL Server driver: {self.driver}")

                # Get Power BI access token (correct audience for SQL Database)
                logger.info("Getting Power BI access token for SQL authentication...")
                powerbi_access_token = self.auth_manager.get_powerbi_access_token()

                token_bytes = powerbi_access_token.encode("utf-16-le")
                token_struct = struct.pack(f'<I{len(token_bytes)}s', len(token_bytes), token_bytes)
                SQL_COPT_SS_ACCESS_TOKEN = 1256

                # Build connection string
                connection_string = (
                    f"Driver={{{self.driver}}};"
                    f"Server={self.sql_endpoint},1433;"
                    f"Database={self.sql_database};"
                    f"Encrypt=Yes;"
                    f"TrustServerCertificate=No;"
                )

                logger.info("Creating SQLAlchemy engine with authenticated connection...")
                self.engine = sqlalchemy.create_engine(
                    "mssql+pyodbc://",
                    creator=lambda: pyodbc.connect(
                        connection_string,
                        attrs_before={SQL_COPT_SS_ACCESS_TOKEN: token_struct}
                    )
                )
                
                # Test the connection
                logger.info("Testing SQL connection...")
                test_query = "SELECT 1 as connection_test"
                with self.engine.connect() as conn:
                    result = conn.execute(sqlalchemy.text(test_query))
                    test_result = result.fetchone()
                    if test_result and test_result[0] == 1:
                        logger.info("✅ SQL connection test successful")
                    else:
                        logger.warning("⚠️ SQL connection test returned unexpected result")
                
                return "SQL connection initialized successfully"
            except Exception as e:
                error_msg = f"Failed to initialize SQL connection: {str(e)}"
                logger.error(error_msg)
                return error_msg

    def get_sql_tables(self) -> pd.DataFrame:
        """Get SQL tables using the pre-authenticated SQL engine."""
        if not self.engine:
            raise Exception("SQL connection not initialized. Please call initialize_sql_connection() first.")
        
        try:
            logger.info("Executing query to retrieve SQL tables...")
            query = "SELECT distinct TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.COLUMNS"
            df = pd.read_sql_query(query, self.engine)
            logger.info(f"✅ Successfully retrieved {len(df)} tables from SQL database")
            return df
        except Exception as e:
            error_msg = f"Failed to retrieve SQL tables: {str(e)}"
            logger.error(f"❌ {error_msg}")
            logger.error(f"SQL Endpoint: {self.sql_endpoint}, Database: {self.sql_database}")
            raise Exception(error_msg)
    
    def execute_sql_query(self, query: str) -> pd.DataFrame:
        """Execute any SQL query using the pre-authenticated SQL engine."""
        if not self.engine:
            raise Exception("SQL connection not initialized. Please call initialize_sql_connection() first.")

        try:
            logger.info(f"Executing SQL query: {query[:100]}...")  # Log first 100 chars
            df = pd.read_sql_query(query, self.engine)
            logger.info(f"✅ Query executed successfully, returned {len(df)} rows")
            return df
        except Exception as e:
            error_msg = f"Failed to execute SQL query: {str(e)}"
            logger.error(f"❌ {error_msg}")
            logger.error(f"Query: {query[:200]}...")  # Log more of the failed query
            logger.error(f"SQL Endpoint: {self.sql_endpoint}, Database: {self.sql_database}")
            raise Exception(error_msg)
    
    def get_sql_table_schema(self, table_name: str) -> pd.DataFrame:
        """Get column information for a specific table."""
        query = f"""
        SELECT 
            COLUMN_NAME as column_name,
            DATA_TYPE as data_type
        FROM INFORMATION_SCHEMA.COLUMNS 
        WHERE TABLE_NAME = '{table_name}'
        ORDER BY ORDINAL_POSITION
        """
        return self.execute_sql_query(query)

class Fabric:
    """Handles Microsoft Fabric REST API operations with authentication manager."""
    def __init__(self, auth_manager=None):
        # Use provided authentication manager instance or create new one (fallback)
        self.auth_manager = auth_manager or AuthenticationManager()
        self.access_token = None
    
    def get_workspace_info(self, workspace_identifier: str) -> Dict[str, Any]:
        if not self.access_token:
            self.access_token = self.auth_manager.get_fabric_access_token()
        info = None
        headers = {
            "Authorization": f"Bearer {self.access_token}",
            "Content-Type": "application/json"
        }
 
        # Try to fetch by ID first
        url_by_id = f"https://api.fabric.microsoft.com/v1/workspaces/{workspace_identifier}"
        response = requests.get(url_by_id, headers=headers)
 
        if response.status_code == 200:
            data = response.json()
            info = {
                "workspace_id": data.get("id"),
                "workspace_name": data.get("displayName")
            }
 
        # If not found by ID, try searching by name
        url_list = f"https://api.fabric.microsoft.com/v1/workspaces/"
        response = requests.get(url_list, headers=headers)
 
        if response.status_code == 200:
            workspaces = response.json().get("value", [])
           
            # Clean the input workspace identifier for matching
            clean_identifier = workspace_identifier.strip().lstrip('*').strip()
           
            # First try exact match
            for ws in workspaces:
                ws_name = ws.get("displayName", "")
                if ws_name.lower() == workspace_identifier.lower():
                    info = {
                        "workspace_id": ws.get("id"),
                        "workspace_name": ws_name
                    }
                    break
           
            # Try match without leading special characters
            if not info:
                for ws in workspaces:
                    ws_name = ws.get("displayName", "")
                    if ws_name.lower() == clean_identifier.lower():
                        logger.info(f"Found workspace match after cleaning: '{workspace_identifier}' -> '{ws_name}'")
                        info = {
                            "workspace_id": ws.get("id"),
                            "workspace_name": ws_name
                        }
                        break
           
            # Try partial match (contains)
            if not info:
                for ws in workspaces:
                    ws_name = ws.get("displayName", "")
                    if clean_identifier.lower() in ws_name.lower() or ws_name.lower() in clean_identifier.lower():
                        logger.info(f"Found workspace partial match: '{workspace_identifier}' -> '{ws_name}'")
                        info = {
                            "workspace_id": ws.get("id"),
                            "workspace_name": ws_name
                        }
                        break
 
        if not info:
            # List available workspaces for debugging
            if 'workspaces' in locals():
                available_workspaces = [ws.get("displayName", "") for ws in workspaces[:5]]
                logger.error(f"Workspace '{workspace_identifier}' not found. Available workspaces (first 5): {available_workspaces}")
            raise ValueError(f"Workspace '{workspace_identifier}' not found by ID or name.")
        return info
 
    def get_lakehouse_info(self, workspace_identifier: str, lakehouse_identifier: str) -> Dict[str, Any]:
        if not self.access_token:
            self.access_token = self.tokens['fabric_token']
        info = None
        headers = {
            "Authorization": f"Bearer {self.access_token}",
            "Content-Type": "application/json"
        }
        workspace_info = self.get_workspace_info(workspace_identifier)
        workspace_id = workspace_info.get("workspace_id", None)
        workspace_name = workspace_info.get("workspace_name", None)

        if not workspace_id:
            raise ValueError(f"Workspace '{workspace_identifier}' not found.")
        url_by_id = f"https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/lakehouses/{lakehouse_identifier}"
        response = requests.get(url_by_id, headers=headers)

        if response.status_code == 200:
            data = response.json()
            info = {
                "workspace_id": workspace_id,
                "workspace_name": workspace_name,
                "lakehouse_id": data.get("id"),
                "lakehouse_name": data.get("displayName"),
                "sql_endpoint": data.get("properties",{}).get("sqlEndpointProperties",{}).get("connectionString",""),
                "sql_database":data.get("properties",{}).get("sqlEndpointProperties",{}).get("id","")
            }
        
        url_list = f"https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/lakehouses"
        response = requests.get(url_list, headers=headers)

        if response.status_code == 200:
            lakehouses = response.json().get("value", [])
            for lh in lakehouses:
                if lh.get("displayName", "").lower() == lakehouse_identifier.lower():
                    info = {
                        "workspace_id": workspace_id,
                        "workspace_name": workspace_name,
                        "lakehouse_id": lh.get("id"),
                        "lakehouse_name": lh.get("displayName"),
                        "sql_endpoint": lh.get("properties",{}).get("sqlEndpointProperties",{}).get("connectionString",""),
                        "sql_database":lh.get("properties",{}).get("sqlEndpointProperties",{}).get("id","")
                    }

        if not info:
            raise ValueError(f"Lakehouse '{lakehouse_identifier}' not found by ID or name.")

        return info
        
    def refresh_sql_endpoint(self, workspace_identifier: str, lakehouse_identifier: str) -> Dict[str, Any]:
        """Refresh the SQL endpoint for a lakehouse using Fabric REST API"""
        try:
            if not self.access_token:
               self.access_token = self.auth_manager.get_fabric_access_token()

            sql_endpoint_id = self.get_lakehouse_info(workspace_identifier, lakehouse_identifier).get("sql_database", None)
            workspace_id = self.get_lakehouse_info(workspace_identifier, lakehouse_identifier).get("workspace_id", None)
            if not sql_endpoint_id:
                raise ValueError(f"SQL Endpoint for Lakehouse '{lakehouse_identifier}' not found.")

            endpoint = f"https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/sqlEndpoints/{sql_endpoint_id}/refreshMetadata"

            body = {
                "sqlEndpointId": sql_endpoint_id,
                "workspaceId": workspace_id
            }

            headers = {
                "Authorization": f"Bearer {self.access_token}",
                "Content-Type": "application/json"
            }

            response = requests.post(endpoint, headers=headers, json=body)
            return response.text
        
        except Exception as e:
            pass
            return f"{str(e)}"

class TabularEditor:
    def __init__(self, fabric_instance=None, sql_endpoint_instance=None, auth_manager=None):
        self.connection_string = None
        self.connected = False
        self.executor = ThreadPoolExecutor(max_workers=4)
        self.model = None
        self.connection_lock = threading.Lock()
        
        # CRITICAL FIX: Create a unique TabularServer instance per TabularEditor
        # This prevents shared COM state between different sessions
        try:
            import uuid
            self._instance_id = str(uuid.uuid4())[:8]  # Short ID for logging
            self.tabularserver = TabularServer()
            logger.info(f"🔧 Created new TabularServer COM instance for TabularEditor {self._instance_id}")
        except Exception as e:
            logger.error(f"❌ Failed to create TabularServer COM instance: {e}")
            raise
            
        # Accept instances as parameters to avoid circular dependencies
        self.fabric = fabric_instance
        self.sql_metadata = sql_endpoint_instance
        # Use provided authentication manager instance or create new one (fallback)
        self.auth_manager = auth_manager or AuthenticationManager()
        
        # Initialize connection state variables
        self.current_workspace = 'Unknown'
        self.current_workspace_id = 'Unknown'
        self.current_database = 'Unknown'
        self.current_database_id = 'Unknown'

    def __del__(self):
        """Cleanup COM resources when TabularEditor instance is destroyed"""
        try:
            if hasattr(self, 'tabularserver') and self.tabularserver:
                if hasattr(self.tabularserver, 'Connected') and self.tabularserver.Connected:
                    self.tabularserver.Disconnect()
                    logger.info(f"🧹 Cleaned up TabularServer COM instance for TabularEditor {getattr(self, '_instance_id', 'unknown')}")
        except Exception as e:
            logger.warning(f"⚠️ Error during TabularEditor cleanup: {e}") 

    def connect_dataset(self, workspace_identifier: str, database_name: str) -> dict:
        """Establish connection to Power BI dataset with automatic SQL endpoint discovery"""
        try: 
            logger.info(f"🔌 TabularEditor {self._instance_id} attempting connection to: {database_name} in {workspace_identifier}")
            
            # Check if already connected and disconnect first to prevent "already connected" error
            if self.connected or hasattr(self.tabularserver, 'Connected') and self.tabularserver.Connected:
                logger.info("🔄 Existing connection detected. Disconnecting before establishing new connection...")
                try:
                    self.tabularserver.Disconnect()
                    self.connected = False
                    logger.info("✅ Successfully disconnected from previous connection")
                except Exception as disconnect_error:
                    logger.warning(f"⚠️ Warning during disconnect: {str(disconnect_error)}")
                    # Force reset connection state even if disconnect failed
                    self.connected = False
                    self.model = None
            
            workspace_info = self.fabric.get_workspace_info(workspace_identifier)
            workspace_name = workspace_info.get("workspace_name", None)
            workspace_id = workspace_info.get("workspace_id", None)
            if not workspace_name:
                raise ValueError(f"Workspace '{workspace_identifier}' not found.")

            self.connection_string = (
            f"Provider=MSOLAP;"
            f"Data Source=powerbi://api.powerbi.com/v1.0/myorg/{workspace_name};"
            f"Initial Catalog={database_name};"
            f"Password={self.auth_manager.get_powerbi_access_token()};"
            )
           
            logger.info(f"🔌 TabularEditor {self._instance_id} connecting with connection string: {self.connection_string[:50]}...")
            self.tabularserver.Connect(self.connection_string)
            db = next((database for database in self.tabularserver.Databases 
                      if database.Name == database_name), None)
            if db is None:
                raise Exception(f"{database_name} not found in the provided server.")

            self.model = db.Model
            self.connected = True
            
            # Set connection state variables
            self.current_workspace = workspace_name
            self.current_workspace_id = workspace_id or 'Unknown'
            self.current_database = database_name
            
            logger.info(f"✅ TabularEditor {self._instance_id} connected to model '{db.Name}'.")
            logger.info(f"📊 Workspace: {self.current_workspace} (ID: {self.current_workspace_id})")
            logger.info(f"📊 Dataset: {self.current_database} (Name: {database_name})")
            
            return {
                "success": True,
                "message": f"Successfully connected to dataset '{database_name}' in workspace '{workspace_name}'",
                "workspace_name": workspace_name,
                "workspace_id": self.current_workspace_id,
                "database_name": database_name,
                "model_name": db.Name
            }
            
        except Exception as e:
           # Reset connection state on failure
            self.connected = False
            self.model = None
            
            error_message = str(e)
            logger.error(f"Connection failed: {error_message}")
            
            # Provide more specific error messages for common issues
            if "already connected" in error_message.lower():
                specific_error = "The client is already connected to a dataset. This should have been handled automatically. Please try disconnecting first and then reconnecting."
            elif "not found" in error_message.lower():
                specific_error = f"Dataset '{database_name}' was not found in workspace '{workspace_identifier}'. Please verify the dataset name and workspace."
            elif "unauthorized" in error_message.lower() or "access denied" in error_message.lower():
                specific_error = "Access denied. Please check your permissions for the workspace and dataset."
            elif "authentication" in error_message.lower() or "token" in error_message.lower():
                specific_error = "Authentication failed. Please check your Power BI access token or re-authenticate."
            else:
                specific_error = error_message
            
            raise Exception(f"Connection failed: {specific_error.encode('ascii', 'replace').decode('ascii')}")

    def disconnect_dataset(self):
        """Disconnect from the current Power BI dataset and reset connection state"""
        try:
            if hasattr(self.tabularserver, 'Connected') and self.tabularserver.Connected:
                self.tabularserver.Disconnect()
                logger.info("✅ Disconnected from server.")
            else:
                logger.info("ℹ️ No active connection to disconnect.")
            
            # Reset connection state variables
            self.connected = False
            self.model = None
            self.current_workspace = 'Unknown'
            self.current_workspace_id = 'Unknown'
            self.current_database = 'Unknown'
            self.current_database_id = 'Unknown'
            self.connection_string = None
            
            return "Disconnected from server is successful"
        except Exception as e:
            logger.error(f"❌ Error during disconnect: {str(e)}")
            # Still reset state even if disconnect failed
            self.connected = False
            self.model = None
            self.current_workspace = 'Unknown'
            self.current_workspace_id = 'Unknown'
            self.current_database = 'Unknown'
            self.current_database_id = 'Unknown'
            self.connection_string = None
            return f"Disconnect completed with warning: {str(e)}"
    
    def _finalize_summary_counts(self, summary: Dict[str, Any]) -> Dict[str, Any]:
        """Helper method to set issue counts based on detailed_issues structure."""
        if "detailed_issues" in summary:
            critical_count = len(summary["detailed_issues"].get("critical", []))
            issue_count = len(summary["detailed_issues"].get("issue", []))
            warning_count = len(summary["detailed_issues"].get("warning", []))
            
            summary["critical_issues"] = critical_count
            summary["issue_issues"] = issue_count  # Add issue level count
            summary["issues"] = issue_count  # Also add as 'issues' for compatibility
            summary["warning_issues"] = warning_count
            summary["total_issues"] = critical_count + issue_count + warning_count
        
        return summary
    
    def generate_analysis_summary(self, analysis_type: str, analysis_data: Dict[str, Any]) -> Dict[str, Any]:
        """Generate high-level summary and recommendations for analysis results."""
        summary = {
            "analysis_type": analysis_type,
            "timestamp": datetime.now().isoformat(),
            "overall_score": 0,
            "total_issues": 0,
            "critical_issues": 0,
            "warning_issues": 0,
            "recommendations": [],
            "key_findings": [],
            "score_breakdown": {}
        }
        
        try:
            if analysis_type == "fact_dimension_analysis" or analysis_type == "ai_fact_dimension_analysis":
                result = self._generate_fact_dimension_summary(analysis_data, summary)
            elif analysis_type == "metadata_analysis":
                result = self._generate_metadata_summary(analysis_data, summary)
            elif analysis_type == "relationship_analysis":
                result = self._generate_relationship_summary(analysis_data, summary)
            elif analysis_type == "columns_analysis":
                result = self._generate_columns_summary(analysis_data, summary)
            elif analysis_type == "ai_columns_analysis":
                result = self._generate_ai_columns_summary(analysis_data, summary)
            elif analysis_type == "security_analysis":
                result = self._generate_security_summary(analysis_data, summary)
            elif analysis_type == "hierarchies_analysis":
                result = self._generate_hierarchies_summary(analysis_data, summary)
            else:
                summary["error"] = f"Unknown analysis type: {analysis_type}"
                return summary
                
            # Finalize issue counts for all successful analyses
            return self._finalize_summary_counts(result)
                
                
        except Exception as e:
            summary["error"] = f"Failed to generate summary: {str(e)}"
            
        return summary

    def _generate_fact_dimension_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for AI-powered fact dimension analysis."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("fact_dimension_analysis")
        
        # Extract analysis data
        analysis_summary = analysis_data.get("analysis_summary", {})
        table_analysis = analysis_data.get("table_analysis", [])
        categorized_tables = analysis_data.get("categorized_tables", {})
        
        # Calculate overall score based on table quality distribution
        quality_distribution = analysis_summary.get("quality_distribution", {})
        total_tables = analysis_summary.get("total_tables_analyzed", 0)
        
        if total_tables > 0:
            # Calculate overall score based on actual average confidence from table analysis (matches CSV)
            if table_analysis:
                # Use the actual confidence scores from table analysis to match CSV data
                total_confidence = sum(t.get("confidence", 0) for t in table_analysis)
                avg_confidence = total_confidence / len(table_analysis)
                summary["overall_score"] = round(avg_confidence * 100, 1)  # Convert to percentage
            else:
                summary["overall_score"] = 0
                
            # Get quality distribution for key findings
            excellent_tables = quality_distribution.get("excellent_tables", 0)
            good_tables = quality_distribution.get("good_tables", 0)
            fair_tables = quality_distribution.get("fair_tables", 0)
            poor_tables = quality_distribution.get("poor_tables", 0)
        else:
            summary["overall_score"] = 0
            excellent_tables = good_tables = fair_tables = poor_tables = 0
        
        # Build key findings from analysis results
        key_findings = []
        fact_tables = len(categorized_tables.get("fact_tables", []))
        dimension_tables = len(categorized_tables.get("dimension_tables", []))
        
        key_findings.append(f"• AI analyzed {total_tables} tables using GPT-4o classification")
        key_findings.append(f"• Identified {fact_tables} fact tables and {dimension_tables} dimension tables")
        
        if excellent_tables > 0:
            key_findings.append(f"• {excellent_tables} tables have excellent classification confidence (>90%)")
        if poor_tables > 0:
            key_findings.append(f"• {poor_tables} tables have poor classification confidence or design issues")
        
        # Calculate average confidence from table analysis
        if table_analysis:
            avg_confidence = sum(t.get("confidence", 0) for t in table_analysis) / len(table_analysis)
            key_findings.append(f"• Average AI classification confidence: {avg_confidence:.1%}")
        
        summary["key_findings"] = key_findings
        
        # Generate recommendations based on analysis
        recommendations = []
        
        if poor_tables > 0:
            recommendations.append(f"🚨 Review {poor_tables} tables with poor classification - may need restructuring")
        
        if fair_tables > total_tables * 0.3:  # More than 30% fair tables
            recommendations.append("⚠️ Consider improving table design for clearer fact/dimension patterns")
        
        # Check for specific issues from table analysis
        unclear_tables = [t for t in table_analysis if t.get("confidence", 0) < 0.6]
        if unclear_tables:
            recommendations.append(f"📊 {len(unclear_tables)} tables need clearer fact/dimension characteristics")
        
        # Check for missing relationships or poor design patterns
        isolated_tables = [t for t in table_analysis 
                          if t.get("many_side_relationships", 0) == 0 and t.get("one_side_relationships", 0) == 0]
        if isolated_tables:
            recommendations.append(f"🔗 {len(isolated_tables)} tables appear isolated - check relationship design")
        
        if summary["overall_score"] >= 85:
            recommendations.append("✅ Excellent table classification - well-designed dimensional model")
        elif summary["overall_score"] >= 70:
            recommendations.append("👍 Good table classification with some optimization opportunities")
        else:
            recommendations.append("🔄 Significant improvements needed in dimensional model design")
        
        summary["recommendations"] = recommendations
        
        # Generate detailed issues for the UI using proper scoring thresholds
        critical_issues = []
        warning_issues = []
        issue_issues = []
        
        # Process table analysis for detailed issues with proper score-based categorization
        for table_data in table_analysis:
            table_name = table_data.get("table_name", "Unknown")
            classification = table_data.get("classification", "Unknown")
            confidence = table_data.get("confidence", 0)
            overall_score = table_data.get("overall_score", confidence)  # Use overall_score if available, fallback to confidence
            max_score = 1.0  # Max possible score for fact/dimension analysis
            
            # Calculate score ratio for proper threshold categorization
            score_ratio = overall_score / max_score if max_score > 0 else 0
            recommendations_list = table_data.get("recommendations", [])
            potential_concerns = table_data.get("potential_concerns", [])
            primary_reasoning = table_data.get("primary_reasoning", "")
            
            # Apply proper scoring thresholds: Critical (<0.59), Issue (0.60-0.74), Warning (0.75-0.84), Good (0.85+)
            if score_ratio < 0.59:
                # Critical issues - score ratio below 59%
                issue_text = f"Table '{table_name}' ({classification}): Critical score {score_ratio:.1%} (< 59%)"
                
                if potential_concerns:
                    issue_text += f" | Concerns: {'; '.join(potential_concerns[:2])}"
                elif primary_reasoning:
                    issue_text += f" | Reasoning: {primary_reasoning[:100]}..."
                
                if recommendations_list:
                    issue_text += f" | Actions needed: {'; '.join(recommendations_list[:2])}"
                
                critical_issues.append(issue_text)
                
            elif 0.60 <= score_ratio <= 0.74:
                # Issue level - score ratio 60-74%
                issue_text = f"Table '{table_name}' ({classification}): Issue score {score_ratio:.1%} (60-74%)"
                
                if recommendations_list:
                    issue_text += f" | Improvements needed: {'; '.join(recommendations_list[:2])}"
                elif potential_concerns:
                    issue_text += f" | Concerns: {'; '.join(potential_concerns[:2])}"
                
                issue_issues.append(issue_text)
                
            elif 0.75 <= score_ratio <= 0.84:
                # Warning level - score ratio 75-84%
                issue_text = f"Table '{table_name}' ({classification}): Warning score {score_ratio:.1%} (75-84%)"
                
                if recommendations_list:
                    issue_text += f" | Optimization opportunities: {'; '.join(recommendations_list[:2])}"
                elif primary_reasoning and "mixed" in primary_reasoning.lower():
                    issue_text += " | Mixed characteristics affecting classification certainty"
                
                warning_issues.append(issue_text)
            
            # Score ratio >= 0.85 = Good (no issues to report)
        
        # Add structural issues
        if fact_tables == 0:
            critical_issues.append("No fact tables identified - this prevents transactional analysis and reporting")
        elif fact_tables > dimension_tables * 2:
            warning_issues.append(f"High fact-to-dimension ratio ({fact_tables}:{dimension_tables}) - consider table design review")
        
        if dimension_tables == 0:
            critical_issues.append("No dimension tables identified - this prevents proper data contextualization")
        elif dimension_tables < fact_tables * 0.5:
            warning_issues.append("Low dimension table count - may lack sufficient context for analysis")
        
        # Store detailed issues with proper structure including issue level
        summary["detailed_issues"] = {
            "critical": critical_issues,
            "issue": issue_issues,
            "warning": warning_issues
        }
        
        return summary
    
    def _generate_metadata_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for metadata quality analysis."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("metadata_analysis")
        
        # Extract analysis data - metadata analysis returns data at top level
        analysis_summary = analysis_data.get("summary", analysis_data)  # Fallback to top level
        results = analysis_data.get("results", analysis_data.get("metadata_results", []))
        
        # Get overall statistics - metadata analysis returns these at top level
        total_tables = analysis_summary.get("total_tables_analyzed", 0)  # Use correct field for table count
        overall_score = analysis_data.get("total_score", analysis_summary.get("overall_score", 0))
        max_possible_score = analysis_data.get("max_possible_score", analysis_summary.get("max_possible_score", 0))
        overall_percentage = analysis_data.get("metadata_percentage", analysis_summary.get("overall_percentage", 0))
        
        # Get component statistics from the top level or summary
        tables_with_descriptions = analysis_summary.get("tables_with_descriptions", 0)
        table_description_percentage = analysis_summary.get("table_description_percentage", 0)
        columns_with_descriptions = analysis_summary.get("columns_with_descriptions", 0)
        total_columns = analysis_summary.get("total_columns", 0)
        column_description_percentage = analysis_summary.get("column_description_percentage", 0)
        measures_with_descriptions = analysis_summary.get("measures_with_descriptions", 0)
        total_measures = analysis_summary.get("total_measures", 0)
        measure_description_percentage = analysis_summary.get("measure_description_percentage", 0)
        
        summary["overall_score"] = round(overall_percentage, 1)
        
        # Build key findings
        key_findings = []
        key_findings.append(f"• Analyzed {total_tables} tables for metadata completeness")
        key_findings.append(f"• Tables with descriptions: {tables_with_descriptions}/{total_tables} ({table_description_percentage:.1f}%)")
        key_findings.append(f"• Columns with descriptions: {columns_with_descriptions}/{total_columns} ({column_description_percentage:.1f}%)")
        if total_measures > 0:
            key_findings.append(f"• Measures with descriptions: {measures_with_descriptions}/{total_measures} ({measure_description_percentage:.1f}%)")
        else:
            key_findings.append("• No measures found in the dataset")
        
        summary["key_findings"] = key_findings
        
        # Generate recommendations
        recommendations = []
        
        if table_description_percentage < 100:
            missing_table_desc = total_tables - tables_with_descriptions
            recommendations.append(f"📋 Add descriptions to {missing_table_desc} tables without documentation")
        
        if column_description_percentage < 80:
            recommendations.append(f"📝 Improve column documentation - only {column_description_percentage:.1f}% have descriptions")
        
        if total_measures > 0 and measure_description_percentage < 80:
            recommendations.append(f"🧮 Enhance measure documentation - only {measure_description_percentage:.1f}% have descriptions")
        
        if overall_percentage >= 90:
            recommendations.append("✅ Excellent metadata documentation - model is well-documented")
        elif overall_percentage >= 75:
            recommendations.append("👍 Good metadata coverage with room for improvement")
        elif overall_percentage >= 50:
            recommendations.append("⚠️ Moderate metadata coverage - consider documentation improvements")
        else:
            recommendations.append("🚨 Poor metadata coverage - significant documentation needed")
        
        if table_description_percentage == 100 and column_description_percentage == 100 and measure_description_percentage == 100:
            recommendations.append("🏆 Perfect metadata documentation - all components fully described")
        
        summary["recommendations"] = recommendations
        
        # Generate detailed issues for the UI - process metadata_results directly
        critical_issues = []
        warning_issues = []
        issue_issues = []
        
        # Debug logging to understand the data structure
        logger.info(f"🔍 DEBUG: analysis_data keys: {list(analysis_data.keys())}")
        logger.info(f"🔍 DEBUG: results length: {len(results)}")
        if len(results) > 0:
            logger.info(f"🔍 DEBUG: First result: {results[0]}")
        logger.info(f"🔍 DEBUG: overall_percentage: {overall_percentage}")
        
        # Group metadata results by table for issue generation
        table_groups = {}
        for item in results:
            table_name = item.get("Table_Name", "Unknown")
            if table_name not in table_groups:
                table_groups[table_name] = {"tables": [], "columns": [], "measures": []}
            
            metadata_type = item.get("Metadata_Type", "")
            if metadata_type == "Table":
                table_groups[table_name]["tables"].append(item)
            elif metadata_type == "Column":
                table_groups[table_name]["columns"].append(item)
            elif metadata_type == "Measure":
                table_groups[table_name]["measures"].append(item)
        
        # Process each table group for issues
        for table_name, group in table_groups.items():
            issues = []
            
            # Check table description
            table_items = group["tables"]
            table_missing_desc = any(item.get("Has_Description") == "No" for item in table_items)
            if table_missing_desc:
                issues.append("missing table description")
            
            # Check column descriptions
            column_items = group["columns"]
            if column_items:
                columns_missing_desc = [item for item in column_items if item.get("Has_Description") == "No"]
                if columns_missing_desc:
                    issues.append(f"{len(columns_missing_desc)}/{len(column_items)} columns without descriptions")
            
            # Check measure descriptions  
            measure_items = group["measures"]
            if measure_items:
                measures_missing_desc = [item for item in measure_items if item.get("Has_Description") == "No"]
                if measures_missing_desc:
                    issues.append(f"{len(measures_missing_desc)}/{len(measure_items)} measures without descriptions")
            
            # Determine severity based on overall coverage for this table
            total_elements = len(table_items) + len(column_items) + len(measure_items)
            elements_with_desc = sum(1 for item in table_items + column_items + measure_items 
                                   if item.get("Has_Description") == "Yes")
            coverage_percentage = (elements_with_desc / total_elements * 100) if total_elements > 0 else 0
            
            if issues:  # Only add if there are issues
                issue_text = f"Table '{table_name}': {', '.join(issues)} ({coverage_percentage:.1f}% coverage)"
                
                if coverage_percentage < 25:
                    critical_issues.append(issue_text)
                elif coverage_percentage < 50:
                    issue_issues.append(issue_text)
                elif coverage_percentage < 75:
                    warning_issues.append(issue_text)
        
        # Fallback: If score is very low but no detailed issues found, create generic issues
        if overall_percentage < 20 and len(critical_issues) == 0 and len(issue_issues) == 0 and len(warning_issues) == 0:
            logger.info("🔍 DEBUG: Low score but no detailed issues found - creating fallback issues")
            missing_table_desc = total_tables - tables_with_descriptions
            missing_column_desc = total_columns - columns_with_descriptions  
            missing_measure_desc = total_measures - measures_with_descriptions
            
            if missing_table_desc > 0:
                critical_issues.append(f"{missing_table_desc} tables missing descriptions - no business context provided")
            if missing_column_desc > 0:
                critical_issues.append(f"{missing_column_desc} columns missing descriptions - unclear data meaning")
            if missing_measure_desc > 0:
                critical_issues.append(f"{missing_measure_desc} measures missing descriptions - calculation logic undefined")
                
            logger.info(f"🔍 DEBUG: Added fallback issues - Critical: {len(critical_issues)}")
        
        logger.info(f"🔍 DEBUG: Final issue counts - Critical: {len(critical_issues)}, Issue: {len(issue_issues)}, Warning: {len(warning_issues)}")
        
        # Limit issues to prevent UI overflow
        summary["detailed_issues"] = {
            "critical": critical_issues[:10],
            "issue": issue_issues[:10], 
            "warning": warning_issues[:10]
        }
        
        # Score breakdown for detailed analysis
        summary["score_breakdown"] = {
            "table_documentation": f"{tables_with_descriptions}/{total_tables} ({table_description_percentage:.1f}%)",
            "column_documentation": f"{columns_with_descriptions}/{total_columns} ({column_description_percentage:.1f}%)",
            "measure_documentation": f"{measures_with_descriptions}/{total_measures} ({measure_description_percentage:.1f}%)" if total_measures > 0 else "N/A (no measures)",
            "overall_coverage": f"{overall_percentage:.1f}%"
        }
        
        return summary

    def _generate_relationship_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for relationship analysis."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("relationship_analysis")
       
        analysis_summary = analysis_data.get("analysis_summary", {})
        recommendations = analysis_data.get("recommendations", [])
        existing_rels = analysis_summary.get("existing_relationships", 0)
        potential_rels = analysis_summary.get("smart_potential_relationships", 0)
        isolated_tables = analysis_summary.get("isolated_tables", 0)
        tables_analyzed = analysis_summary.get("tables_analyzed", 0)
       
        # Calculate scores based on actual CSV data if available
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            # Parse CSV to extract Overall_Score values
            try:
                import pandas as pd
                import io
                df = pd.read_csv(io.StringIO(csv_content))
                if 'Overall_Score' in df.columns and len(df) > 0:
                    overall_scores = df['Overall_Score'].dropna()
                    if len(overall_scores) > 0:
                        # Calculate average overall score from CSV (decimal format)
                        avg_csv_score = overall_scores.mean()
                        summary["overall_score"] = round(avg_csv_score * 100, 1)  # Convert to percentage for display
                       
                        # Calculate score breakdown based on CSV data (using decimal thresholds)
                        # High quality: >= 0.8, Medium: 0.6-0.8, Low: < 0.6
                        high_quality_rels = len(overall_scores[overall_scores >= 0.8])
                        medium_quality_rels = len(overall_scores[(overall_scores >= 0.6) & (overall_scores < 0.8)])
                        low_quality_rels = len(overall_scores[overall_scores < 0.6])
                       
                        # Calculate relationship quality distribution
                        total_rels = len(overall_scores)
                        high_quality_pct = (high_quality_rels / total_rels) * 100 if total_rels > 0 else 0
                        connectivity_score = max(0, 100 - (isolated_tables / max(tables_analyzed, 1)) * 100) if tables_analyzed > 0 else 0
                       
                        summary["score_breakdown"] = {
                            "avg_relationship_quality": round(avg_csv_score, 1),
                            "high_quality_relationships": f"{high_quality_rels}/{total_rels} ({high_quality_pct:.1f}%)",
                            "connectivity_score": round(connectivity_score, 1)
                        }
                       
                        logger.info(f"📊 Using CSV-based scoring: Avg={avg_csv_score:.3f} (decimal), {summary['overall_score']:.1f}% (display), "
                                   f"High quality: {high_quality_rels}/{total_rels}, "
                                   f"Medium: {medium_quality_rels}, Low: {low_quality_rels}")
                    else:
                        # Fallback to original scoring
                        summary["overall_score"] = self._calculate_fallback_relationship_score(
                            existing_rels, tables_analyzed, isolated_tables)
                        summary["score_breakdown"] = {"fallback_reason": "No CSV scores available"}
                else:
                    # Fallback to original scoring
                    summary["overall_score"] = self._calculate_fallback_relationship_score(
                        existing_rels, tables_analyzed, isolated_tables)
                    summary["score_breakdown"] = {"fallback_reason": "CSV missing Overall_Score column"}
            except Exception as e:
                logger.warning(f"Failed to parse CSV for scoring: {e}")
                # Fallback to original scoring
                summary["overall_score"] = self._calculate_fallback_relationship_score(
                    existing_rels, tables_analyzed, isolated_tables)
                summary["score_breakdown"] = {"fallback_reason": f"CSV parsing error: {str(e)}"}
        else:
            # Fallback to original scoring
            summary["overall_score"] = self._calculate_fallback_relationship_score(
                existing_rels, tables_analyzed, isolated_tables)
            summary["score_breakdown"] = {"fallback_reason": "No CSV content available"}
       
        # Count issues based on CSV scores if available, otherwise use recommendations
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            try:
                import pandas as pd
                import io
                df = pd.read_csv(io.StringIO(csv_content))
                if 'Overall_Score' in df.columns and len(df) > 0:
                    overall_scores = df['Overall_Score'].dropna()
                   
                    # Updated to match evaluate_table_linking severity logic: Critical (<=0.59), Issue (0.60-0.74), Warning (0.75-0.84)
                    critical_score_issues = len(overall_scores[overall_scores <= 0.59])  # <= 0.59 = critical
                    issue_score_issues = len(overall_scores[(overall_scores >= 0.60) & (overall_scores <= 0.74)])  # 0.60-0.74 = issue
                    warning_score_issues = len(overall_scores[(overall_scores >= 0.75) & (overall_scores <= 0.84)])  # 0.75-0.84 = warning
                   
                    # Include isolated tables as critical issues
                    summary["critical_issues"] = critical_score_issues + isolated_tables
                    summary["issue_issues"] = issue_score_issues  # Add issue count
                    summary["issues"] = issue_score_issues  # Also add as 'issues' for compatibility
                    summary["warning_issues"] = warning_score_issues
                    summary["total_issues"] = summary["critical_issues"] + summary["issue_issues"] + summary["warning_issues"]
                   
                    logger.info(f"📊 Issue counting based on CSV scores: Critical={critical_score_issues} relationships <=0.59 + {isolated_tables} isolated tables, "
                               f"Issue={issue_score_issues} relationships 0.60-0.74, Warning={warning_score_issues} relationships 0.75-0.84")
                else:
                    # Fallback to recommendation-based counting
                    self._count_issues_from_recommendations(summary, recommendations, isolated_tables)
            except Exception as e:
                logger.warning(f"Failed to count issues from CSV: {e}")
                # Fallback to recommendation-based counting
                self._count_issues_from_recommendations(summary, recommendations, isolated_tables)
        else:
            # Fallback to recommendation-based counting
            self._count_issues_from_recommendations(summary, recommendations, isolated_tables)
       
        # Enhanced key findings with comprehensive detailed breakdown (Table Linking Analysis enhancement)
        key_findings = []
       
        # Calculate connectivity metrics
        connected_tables = tables_analyzed - isolated_tables if isolated_tables <= tables_analyzed else tables_analyzed
        coverage_percentage = (connected_tables / tables_analyzed * 100) if tables_analyzed > 0 else 0
       
        # Basic analysis summary with connectivity details
        if isolated_tables > 0:
            key_findings.append(f"• Analyzed {tables_analyzed} tables: {connected_tables} connected ({coverage_percentage:.0f}% coverage), {isolated_tables} isolated")
        else:
            key_findings.append(f"• Analyzed {tables_analyzed} tables: {connected_tables} connected ({coverage_percentage:.0f}% coverage)")
       
        # Enhanced relationship breakdown from CSV if available with comprehensive statistics
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            try:
                import pandas as pd
                import io
                df = pd.read_csv(io.StringIO(csv_content))
               
                # Skip the detailed breakdown that was causing clutter
                # Removed: Total relationships found, cardinality breakdown, and other detailed statistics
               
                # Data type compatibility analysis
                if 'Data_Type_Compatibility' in df.columns:
                    compatible = len(df[df['Data_Type_Compatibility'].str.startswith('Yes', na=False)])
                    incompatible = len(df) - compatible
                    if incompatible > 0:
                        key_findings.append(f"• Data Type Issues: {incompatible} relationships with mismatched column types")
               
                # Active vs Inactive relationships
                if 'Is_Active' in df.columns:
                    active_rels = len(df[df['Is_Active'].str.startswith('Yes', na=False)])
                    inactive_rels = len(df) - active_rels
                    if inactive_rels > 0:
                        key_findings.append(f"• Relationship Status: {active_rels} active, {inactive_rels} inactive relationships")
               
                # Cross-filter direction analysis
                if 'Cross_Filter_Direction' in df.columns:
                    single_filter = len(df[df['Cross_Filter_Direction'] == 'Single'])
                    both_filter = len(df[df['Cross_Filter_Direction'] == 'Both'])
                    if both_filter > 0:
                        key_findings.append(f"• Cross-Filtering: {single_filter} single-direction, {both_filter} bi-directional")
               
                # Score quality distribution
                if 'Overall_Score' in df.columns:
                    high_quality = len(df[df['Overall_Score'] >= 0.8])
                    medium_quality = len(df[(df['Overall_Score'] >= 0.6) & (df['Overall_Score'] < 0.8)])
                    low_quality = len(df[df['Overall_Score'] < 0.6])
                    avg_score = df['Overall_Score'].mean() * 100
                    key_findings.append(f"• Quality Distribution: {high_quality} excellent, {medium_quality} good, {low_quality} needs improvement (avg: {avg_score:.1f}%)")
               
                # Issue severity breakdown
                if 'Issue_Severity' in df.columns:
                    critical = len(df[df['Issue_Severity'] == 'critical'])
                    issues = len(df[df['Issue_Severity'] == 'issue'])
                    warnings = len(df[df['Issue_Severity'] == 'warning'])
                    good = len(df[df['Issue_Severity'] == 'good'])
                    if critical + issues + warnings > 0:
                        key_findings.append(f"• Issues Found: {critical} critical, {issues} issues, {warnings} warnings, {good} good")
                       
            except Exception as e:
                logger.warning(f"Error parsing CSV for enhanced key findings: {e}")
                # Safe fallback - maintain original behavior
                key_findings.append(f"• Found {existing_rels} existing relationships across connected tables")
        else:
            # Original behavior when no CSV data
            key_findings.append(f"• Found {existing_rels} existing relationships across connected tables")
       
        # Enhanced potential relationships analysis with missing relationship insights
        if potential_rels > 0:
            missing_rels = potential_rels - existing_rels if potential_rels > existing_rels else 0
            if missing_rels > 0:
                key_findings.append(f"• Potential Relationships: {potential_rels} verified business relationships identified ({missing_rels} missing)")
                key_findings.append(f"• Improvement Opportunity: {missing_rels} high-priority missing connections could enhance dimensional model")
            else:
                key_findings.append(f"• Potential Relationships: {potential_rels} verified business relationships identified (all implemented)")
       
        # Enhanced isolated tables detail with specific names and impact assessment
        if isolated_tables > 0:
            isolated_table_names = analysis_summary.get("isolated_table_names", [])
            if isolated_table_names and len(isolated_table_names) > 0:
                if isolated_tables <= 3:
                    key_findings.append(f"• Isolated Tables: {', '.join(isolated_table_names)} (critical connectivity issue)")
                else:
                    displayed_names = isolated_table_names[:3]
                    remaining = isolated_tables - 3
                    key_findings.append(f"• Isolated Tables: {', '.join(displayed_names)} and {remaining} others (critical connectivity issue)")
            else:
                # Fallback to original behavior
                key_findings.append(f"• Isolated Tables: {isolated_tables} table(s) without relationships (critical connectivity issue)")
       
        # Overall connectivity assessment with performance implications
        if coverage_percentage >= 80:
            key_findings.append("• Model Assessment: Excellent table connectivity - well-connected dimensional model")
        elif coverage_percentage >= 60:
            key_findings.append("• Model Assessment: Good table connectivity with room for improvement")
        elif coverage_percentage >= 40:
            key_findings.append("• Model Assessment: Moderate connectivity - several tables need relationship connections")
        else:
            key_findings.append("• Model Assessment: Poor connectivity - significant relationship design improvements needed")
       
        # Performance and optimization insights based on relationship patterns
        if csv_content:
            try:
                df = pd.read_csv(io.StringIO(csv_content))
               
                # Many-to-Many relationship performance warning
                if 'Cardinality' in df.columns:
                    many_to_many = len(df[df['Cardinality'] == 'Many-to-Many'])
                    if many_to_many > 0:
                        key_findings.append(f"• Performance Alert: {many_to_many} Many-to-Many relationships detected (may impact query performance)")
               
                # Bi-directional filtering security assessment
                if 'Cross_Filter_Direction' in df.columns:
                    both_direction = len(df[df['Cross_Filter_Direction'] == 'Both'])
                    if both_direction > 0:
                        key_findings.append(f"• Security Review: {both_direction} bi-directional relationships require RLS security validation")
                       
            except Exception:
                pass  # Silently handle any parsing errors
       
        # Assign enhanced key findings to summary with proper formatting
        # Ensure key findings are properly structured as individual list items for sequential display
        summary["key_findings"] = key_findings
       
        # Generate recommendations based on analysis results
        critical_recs = [r for r in recommendations if r.get("priority") == "CRITICAL"]
        high_recs = [r for r in recommendations if r.get("priority") == "HIGH"]
        medium_recs = [r for r in recommendations if r.get("priority") == "MEDIUM"]
       
        # Enhanced score-based recommendations for Table Linking Analysis
        score_based_recommendations = []
        
        # Primary recommendations based on overall score with detailed scoring logic
        overall_score = summary.get("overall_score", 0)
        
        if overall_score >= 85:
            score_based_recommendations.append("✅ EXCELLENT: Relationship structure follows Power BI best practices with high-quality connections")
            score_based_recommendations.append("🔄 MAINTAIN: Continue monitoring relationship performance and maintain current standards")
        elif overall_score >= 75:
            score_based_recommendations.append("✅ GOOD: Solid relationship foundation with minor optimization opportunities")
            score_based_recommendations.append("🔍 OPTIMIZE: Review relationships scoring 60-74% for targeted improvements")
        elif overall_score >= 60:
            score_based_recommendations.append("⚠️ MODERATE: Relationship structure needs improvement for optimal performance")
            score_based_recommendations.append("🔧 IMPROVE: Focus on critical relationships (score <60%) and data type mismatches")
        elif overall_score >= 40:
            score_based_recommendations.append("🚨 POOR: Significant relationship design issues affecting model performance")
            score_based_recommendations.append("🛠️ REDESIGN: Immediate attention required for cardinality and cross-filter direction issues")
        else:
            score_based_recommendations.append("🚨 CRITICAL: Relationship structure requires comprehensive redesign")
            score_based_recommendations.append("🚨 URGENT: Address data connectivity issues, fix inactive relationships, and implement missing connections")
        
        # Specific issue-based recommendations
        if isolated_tables > 0:
            score_based_recommendations.append(f"� CONNECTIVITY: Connect {isolated_tables} isolated table(s) to enable cross-table analysis")
        
        if len(critical_recs) > 0:
            score_based_recommendations.append(f"⚡ CRITICAL: Implement {len(critical_recs)} high-priority relationship(s) immediately")
        
        if potential_rels > existing_rels:
            missing_count = potential_rels - existing_rels
            score_based_recommendations.append(f"💡 EXPAND: Consider adding {missing_count} additional verified relationships for better connectivity")
        
        # CSV-based specific recommendations if data is available
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            try:
                import pandas as pd
                import io
                df = pd.read_csv(io.StringIO(csv_content))
                if len(df) > 0:
                    # Count specific issues from CSV
                    if 'Issue_Severity' in df.columns:
                        critical_count = len(df[df['Issue_Severity'] == 'critical'])
                        issue_count = len(df[df['Issue_Severity'] == 'issue'])
                        if critical_count > 0:
                            score_based_recommendations.append(f"🔴 ADDRESS: {critical_count} critical relationship(s) with scores ≤59% need immediate fixes")
                        if issue_count > 0:
                            score_based_recommendations.append(f"🟠 IMPROVE: {issue_count} relationship(s) scoring 60-74% have improvement opportunities")
                    
                    # Cardinality-specific recommendations
                    if 'Cardinality' in df.columns:
                        many_to_many = len(df[df['Cardinality'].str.contains('Many-to-Many', na=False)])
                        if many_to_many > 0:
                            score_based_recommendations.append(f"⚠️ PERFORMANCE: {many_to_many} Many-to-Many relationship(s) may impact performance - consider restructuring")
                    
                    # Cross-filter direction recommendations
                    if 'Cross_Filter_Direction' in df.columns:
                        both_direction = len(df[df['Cross_Filter_Direction'] == 'Both'])
                        if both_direction > 0:
                            score_based_recommendations.append(f"� SECURITY: {both_direction} bi-directional relationship(s) require RLS security validation")
                            
            except Exception as e:
                logger.debug(f"Could not parse CSV for specific recommendations: {e}")
        
        # Set final recommendations
        summary["recommendations"] = score_based_recommendations
           
        # Generate detailed issues for the View Issue Details section
        summary["detailed_issues"] = self._generate_detailed_issues_from_csv_or_recommendations(
            analysis_data, isolated_tables, critical_recs, high_recs, medium_recs, potential_rels, existing_rels)
       
        return summary
     
    
    def _calculate_fallback_relationship_score(self, existing_rels: int, tables_analyzed: int, isolated_tables: int) -> float:
        """Calculate fallback relationship score when CSV data is not available."""
        # Original scoring logic as fallback
        raw_relationship_coverage = (existing_rels / max(tables_analyzed, 1)) * 100 if tables_analyzed > 0 else 0
        relationship_coverage = min(100, raw_relationship_coverage)
        connectivity_score = max(0, 100 - (isolated_tables / max(tables_analyzed, 1)) * 100) if tables_analyzed > 0 else 0
        
        raw_overall_score = (relationship_coverage * 0.6 + connectivity_score * 0.4)
        return round(min(100.0, max(0.0, raw_overall_score)), 1)
    
    def _count_issues_from_recommendations(self, summary: Dict[str, Any], recommendations: List[Dict], isolated_tables: int):
        """Count issues from recommendations as fallback when CSV data is not available."""
        critical_recs = [r for r in recommendations if r.get("priority") == "CRITICAL"]
        high_recs = [r for r in recommendations if r.get("priority") == "HIGH"]
        medium_recs = [r for r in recommendations if r.get("priority") == "MEDIUM"]
        
        summary["critical_issues"] = len(critical_recs) + isolated_tables
        summary["issue_issues"] = len(high_recs)  # High priority recommendations become issue level
        summary["issues"] = len(high_recs)  # Also add as 'issues' for compatibility
        summary["warning_issues"] = len(medium_recs)
        summary["total_issues"] = summary["critical_issues"] + summary["issue_issues"] + summary["warning_issues"]
    
    
    def _generate_detailed_issues_from_csv_or_recommendations(self, analysis_data: Dict[str, Any], 
                                                           isolated_tables: int, critical_recs: List[Dict],
                                                           high_recs: List[Dict], medium_recs: List[Dict],
                                                           potential_rels: int, existing_rels: int) -> Dict[str, List[str]]:
        """Generate detailed issues from CSV data or fall back to recommendations."""
        critical_issues = []
        issue_issues = []  # Initialize issue_issues at function level
        warning_issues = []
        
        # Enhanced isolated tables issues with detailed information (Table Linking Analysis enhancement)
        if isolated_tables > 0:
            isolated_table_names = analysis_data.get("analysis_summary", {}).get("isolated_table_names", [])
            if isolated_table_names and len(isolated_table_names) > 0:
                # Create detailed issues for each isolated table (limit to avoid UI overload)
                for i, table_name in enumerate(isolated_table_names):
                    if i < 5:  # Limit to first 5 tables for readability
                        critical_issues.append(f"Table '{table_name}': Critical isolation issue - no relationships detected | Impact: Cannot be used in cross-table analysis or filtering | Solution: Identify and create relationships with fact or dimension tables based on common key columns")
                
                # Add summary for remaining tables if more than 5
                if isolated_tables > 5:
                    remaining = isolated_tables - 5
                    critical_issues.append(f"Additional {remaining} isolated tables require relationship connections for proper dimensional modeling")
            else:
                # Safe fallback to original behavior when table names not available
                critical_issues.append(f"Found {isolated_tables} isolated table(s): Critical connectivity issue prevents proper dimensional modeling | Impact: Tables cannot participate in cross-table analysis | Solution: Review table schemas and establish key-based relationships")
                
        # Try to get detailed issues from CSV data
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            try:
                import pandas as pd
                import io
                df = pd.read_csv(io.StringIO(csv_content))
                if 'Overall_Score' in df.columns and 'From_Table' in df.columns and 'To_Table' in df.columns:
                    # Enhanced critical relationships (score <= 0.59) with detailed analysis
                    critical_rels = df[df['Overall_Score'] <= 0.59]
                    for _, row in critical_rels.iterrows():
                        from_table = row.get('From_Table', 'Unknown')
                        to_table = row.get('To_Table', 'Unknown')
                        score = row.get('Overall_Score', 0)
                        max_score = row.get('Max_Score', 1)
                        score_percentage = (score / max_score * 100) if max_score > 0 else 0
                        
                        # Get additional relationship details if available
                        cardinality = row.get('Cardinality', '')
                        relationship_type = row.get('Relationship_Type', 'relationship')
                        business_context = row.get('Business_Context', '')
                        
                        # Build enhanced issue description
                        issue_text = f"Table '{from_table}' → '{to_table}': Critical {relationship_type} issue (score: {score_percentage:.1f}%)"
                        
                        # Add specific problem details if available
                        if cardinality and cardinality.strip():
                            if 'Many-to-Many' in cardinality:
                                issue_text += f" | Problem: {cardinality} cardinality causing data duplication risk"
                            elif 'One-to-One' in cardinality:
                                issue_text += f" | Problem: {cardinality} relationship may indicate design issue"
                            else:
                                issue_text += f" | Cardinality: {cardinality}"
                        
                        # Add business impact and solution
                        if business_context and business_context.strip():
                            # Truncate long business context for readability
                            context_text = business_context[:80] + "..." if len(business_context) > 80 else business_context
                            issue_text += f" | Impact: {context_text}"
                        else:
                            issue_text += f" | Impact: Poor relationship quality affects data model integrity and report accuracy"
                        
                        issue_text += f" | Solution: Review and strengthen relationship design, verify key column data types and referential integrity"
                        
                        critical_issues.append(issue_text)
                    
                    # Enhanced issue relationships (score 0.60-0.74) with optimization details
                    issue_rels = df[(df['Overall_Score'] >= 0.60) & (df['Overall_Score'] <= 0.74)]
                    for _, row in issue_rels.iterrows():
                        from_table = row.get('From_Table', 'Unknown')
                        to_table = row.get('To_Table', 'Unknown')
                        score = row.get('Overall_Score', 0)
                        max_score = row.get('Max_Score', 1)
                        score_percentage = (score / max_score * 100) if max_score > 0 else 0
                        
                        relationship_type = row.get('Relationship_Type', 'relationship')
                        cardinality = row.get('Cardinality', '')
                        
                        issue_text = f"Table '{from_table}' → '{to_table}': {relationship_type.title()} needs improvement (score: {score_percentage:.1f}%)"
                        
                        if cardinality and cardinality.strip():
                            issue_text += f" | Type: {cardinality} relationship"
                        
                        issue_text += f" | Impact: Suboptimal relationship may affect query performance and data accuracy"
                        issue_text += f" | Solution: Optimize relationship configuration, verify key columns, and test relationship strength"
                        
                        issue_issues.append(issue_text)
                    
                    # Enhanced warning relationships (score 0.75-0.84) with optimization opportunities
                    warning_rels = df[(df['Overall_Score'] >= 0.75) & (df['Overall_Score'] <= 0.84)]
                    for _, row in warning_rels.iterrows():
                        from_table = row.get('From_Table', 'Unknown')
                        to_table = row.get('To_Table', 'Unknown')
                        score = row.get('Overall_Score', 0)
                        max_score = row.get('Max_Score', 1)
                        score_percentage = (score / max_score * 100) if max_score > 0 else 0
                        
                        relationship_type = row.get('Relationship_Type', 'relationship')
                        cardinality = row.get('Cardinality', '')
                        
                        warning_text = f"Table '{from_table}' → '{to_table}': {relationship_type.title()} optimization opportunity (score: {score_percentage:.1f}%)"
                        
                        if cardinality and cardinality.strip():
                            warning_text += f" | Type: {cardinality} relationship performing adequately"
                        
                        warning_text += f" | Optimization: Consider fine-tuning relationship properties for optimal performance"
                        
                        warning_issues.append(warning_text)
                    
                    # Add missing relationship opportunities if available in CSV
                    if 'Potential_Relationship' in df.columns:
                        try:
                            potential_relationships = df[df['Potential_Relationship'].str.upper() == 'YES']
                            for _, row in potential_relationships.iterrows():
                                from_table = row.get('From_Table', 'Unknown')
                                to_table = row.get('To_Table', 'Unknown')
                                suggested_keys = row.get('Suggested_Keys', 'common key columns')
                                
                                issue_text = f"Missing relationship opportunity: '{from_table}' → '{to_table}' | Potential connection via {suggested_keys}"
                                issue_text += f" | Impact: Limits cross-table analysis and filtering capabilities"
                                issue_text += f" | Solution: Evaluate business logic and create relationship if appropriate"
                                
                                issue_issues.append(issue_text)
                        except Exception:
                            # Safe fallback if Potential_Relationship column processing fails
                            pass
                    
                    logger.info(f"📊 Generated enhanced detailed issues from CSV: {len(critical_rels)} critical, {len(issue_rels)} issue, {len(warning_rels)} warning relationships")
                    
                else:
                    # CSV exists but doesn't have expected columns - use enhanced fallback
                    logger.info("📊 CSV data available but missing expected columns, using enhanced fallback for detailed issues")
                    self._add_enhanced_fallback_issues(critical_issues, issue_issues, warning_issues, 
                                                     analysis_data, critical_recs, high_recs, medium_recs, potential_rels, existing_rels)
            except Exception as e:
                logger.warning(f"Failed to generate issues from CSV: {e}")
                # Use enhanced fallback for better issue details
                self._add_enhanced_fallback_issues(critical_issues, issue_issues, warning_issues, 
                                                 analysis_data, critical_recs, high_recs, medium_recs, potential_rels, existing_rels)
        else:
            # No CSV data - use enhanced fallback for detailed issues
            logger.info("📊 No CSV data available, using enhanced fallback for detailed issues")
            self._add_enhanced_fallback_issues(critical_issues, issue_issues, warning_issues, 
                                             analysis_data, critical_recs, high_recs, medium_recs, potential_rels, existing_rels)
        
        # Debug: Log what issues were generated
        logger.info(f"🔍 Generated detailed issues - Critical: {len(critical_issues)}, Issues: {len(issue_issues)}, Warnings: {len(warning_issues)}")
        for i, issue in enumerate(critical_issues[:3]):  # Log first 3 critical issues
            logger.info(f"🔍 Critical Issue {i+1}: {issue[:100]}...")
        
        return {"critical": critical_issues, "issue": issue_issues, "warning": warning_issues}    
    def _add_enhanced_fallback_issues(self, critical_issues: List[str], issue_issues: List[str], warning_issues: List[str],
                                    analysis_data: Dict, critical_recs: List[Dict], high_recs: List[Dict], medium_recs: List[Dict],
                                    potential_rels: int, existing_rels: int):
        """Enhanced fallback issues with detailed descriptions for Table Linking Analysis when CSV data is unavailable or incomplete."""
        logger.info("🔧 Generating enhanced fallback issues for Table Linking Analysis")
        
        # Get table information from analysis_data
        all_tables = analysis_data.get('all_tables', [])
        
        # Calculate connectivity metrics
        total_possible_relationships = max(1, len(all_tables) * (len(all_tables) - 1) // 2)
        relationship_coverage = (existing_rels / total_possible_relationships * 100) if total_possible_relationships > 0 else 0
        
        # Identify isolated tables (tables with no relationships)
        isolated_tables = []
        connected_tables = set()
        
        # Check recommendations for connected tables
        for rec in critical_recs + high_recs + medium_recs:
            affected_tables = rec.get('affected_tables', [])
            connected_tables.update(affected_tables)
        
        # Find truly isolated tables
        for table in all_tables:
            if table not in connected_tables:
                isolated_tables.append(table)
        
        # Generate detailed critical issues
        if relationship_coverage < 30:
            critical_issues.append(f"Model connectivity severely limited at {relationship_coverage:.1f}% coverage: "
                                 f"Only {existing_rels} relationships exist out of {total_possible_relationships} possible connections. "
                                 f"Impact: Critical data silos preventing comprehensive reporting. "
                                 f"Solution: Establish key relationships between fact and dimension tables.")
        
        if len(isolated_tables) > 0:
            table_names = "', '".join(isolated_tables[:3])  # Show first 3 tables
            suffix = f" and {len(isolated_tables) - 3} others" if len(isolated_tables) > 3 else ""
            critical_issues.append(f"Isolated tables detected: '{table_names}'{suffix} have no established relationships. "
                                 f"Impact: These tables cannot contribute to cross-table analysis or comprehensive reporting. "
                                 f"Solution: Review table schemas and establish appropriate foreign key relationships.")
        
        # Generate enhanced issues from recommendations
        for i, rec in enumerate(critical_recs[:5]):  # Limit to top 5 critical
            description = rec.get('description', 'Critical relationship issue')
            affected_tables = rec.get('affected_tables', [])
            priority = rec.get('priority', 'CRITICAL')
            
            if affected_tables and len(affected_tables) >= 2:
                issue_text = f"Critical relationship gap between '{affected_tables[0]}' and '{affected_tables[1]}': {description}. "
                issue_text += f"Impact: Prevents comprehensive analysis across these key business entities. "
                issue_text += f"Solution: Establish proper relationship with appropriate cardinality settings."
                critical_issues.append(issue_text)
            else:
                critical_issues.append(f"Critical relationship issue {i+1}: {description}. "
                                     f"Impact: Affects data model integrity and reporting capabilities. "
                                     f"Solution: Review and implement recommended relationship changes.")
        
        # Generate enhanced high-priority issues
        for i, rec in enumerate(high_recs[:5]):  # Limit to top 5 high
            description = rec.get('description', 'High-priority relationship issue')
            affected_tables = rec.get('affected_tables', [])
            
            if affected_tables and len(affected_tables) >= 2:
                issue_text = f"High-priority relationship optimization needed for '{affected_tables[0]}' ↔ '{affected_tables[1]}': {description}. "
                issue_text += f"Impact: Suboptimal query performance and potential data inconsistencies. "
                issue_text += f"Solution: Review relationship configuration and cardinality settings."
                issue_issues.append(issue_text)
            else:
                issue_issues.append(f"High-priority relationship issue {i+1}: {description}. "
                                  f"Impact: May cause performance degradation or reporting inconsistencies. "
                                  f"Solution: Review and optimize relationship configurations.")
        
        # Generate enhanced medium-priority warnings
        for i, rec in enumerate(medium_recs[:5]):  # Limit to top 5 medium
            description = rec.get('description', 'Medium-priority relationship optimization')
            affected_tables = rec.get('affected_tables', [])
            
            if affected_tables and len(affected_tables) >= 2:
                issue_text = f"Relationship optimization opportunity for '{affected_tables[0]}' ↔ '{affected_tables[1]}': {description}. "
                issue_text += f"Impact: Potential for improved query performance and clearer data lineage. "
                issue_text += f"Solution: Consider implementing relationship for enhanced model connectivity."
                warning_issues.append(issue_text)
            else:
                warning_issues.append(f"Relationship optimization opportunity {i+1}: {description}. "
                                    f"Impact: Minor performance or usability improvement potential. "
                                    f"Solution: Evaluate and implement if business value justifies effort.")
        
        # If we still don't have enough detailed issues, generate some guaranteed fallback issues
        if len(critical_issues) == 0 and len(issue_issues) == 0 and len(warning_issues) == 0:
            logger.info("🔧 No issues generated from recommendations, creating guaranteed fallback issues")
            
            # Guaranteed critical issues based on basic analysis
            if existing_rels == 0:
                critical_issues.append(f"No relationships detected in the data model: Critical connectivity failure prevents any cross-table analysis. "
                                     f"Impact: Model cannot support dimensional reporting or filtering across entities. "
                                     f"Solution: Identify common key columns and establish primary-foreign key relationships.")
            
            if len(all_tables) > 1:
                critical_issues.append(f"Model has {len(all_tables)} tables but insufficient connectivity: Isolated table architecture prevents comprehensive reporting. "
                                     f"Impact: Users cannot create reports that span multiple business areas. "
                                     f"Solution: Map business processes to identify natural relationships between entities.")
            
            # Add some analysis-based issues
            issue_issues.append(f"Relationship optimization needed: Current model structure may not support optimal query performance. "
                              f"Impact: Reports may run slowly or return incomplete results. "
                              f"Solution: Review table schemas and implement star/snowflake dimensional modeling patterns.")
            
            warning_issues.append(f"Data model connectivity assessment required: {existing_rels} relationships exist for {len(all_tables)} tables. "
                                f"Impact: May indicate missing business logic connections. "
                                f"Solution: Conduct business requirements review to identify additional relationship needs.")
        
        logger.info(f"🔧 Enhanced fallback generated: {len(critical_issues)} critical, {len(issue_issues)} issues, {len(warning_issues)} warnings")
    
    
    def _add_recommendation_based_issues(self, critical_issues: List[str], issue_issues: List[str], warning_issues: List[str],
                                       critical_recs: List[Dict], high_recs: List[Dict], medium_recs: List[Dict],
                                       potential_rels: int, existing_rels: int):
        """Enhanced issues based on recommendations (fallback method for Table Linking Analysis)."""        
        
        # Enhanced critical relationship issues from recommendations
        for rec in critical_recs:
            description = rec.get('description', 'Unknown issue')
            affected_tables = rec.get('affected_tables', [])
            priority = rec.get('priority', 'CRITICAL')
            
            # Extract additional context if available (safe access)
            business_impact = rec.get('business_impact', 'Affects data model integrity and reporting accuracy')
            suggested_solution = rec.get('suggested_solution', 'Review and implement recommended relationship changes')
            
            if affected_tables and len(affected_tables) >= 2:
                # Format for table pair relationships
                issue_text = f"Table '{affected_tables[0]}' → '{affected_tables[1]}': {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                critical_issues.append(issue_text)
            elif affected_tables and len(affected_tables) == 1:
                # Single table issue
                issue_text = f"Table '{affected_tables[0]}': {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                critical_issues.append(issue_text)
            else:
                # General critical issue with enhanced details
                issue_text = f"Critical relationship issue: {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                critical_issues.append(issue_text)
        
        # Enhanced high priority issues to issue_issues category
        for rec in high_recs:
            description = rec.get('description', 'Unknown issue')
            affected_tables = rec.get('affected_tables', [])
            
            # Extract additional context if available (safe access)
            business_impact = rec.get('business_impact', 'May impact report performance and data connectivity')
            suggested_solution = rec.get('suggested_solution', 'Consider implementing recommended relationship improvements')
            
            if affected_tables and len(affected_tables) >= 2:
                issue_text = f"Table '{affected_tables[0]}' → '{affected_tables[1]}': {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                issue_issues.append(issue_text)
            elif affected_tables and len(affected_tables) == 1:
                issue_text = f"Table '{affected_tables[0]}': {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                issue_issues.append(issue_text)
            else:
                issue_text = f"High priority relationship issue: {description}"
                issue_text += f" | Impact: {business_impact}"
                issue_text += f" | Solution: {suggested_solution}"
                issue_issues.append(issue_text)
            
        # Enhanced medium priority issues to warning_issues
        for rec in medium_recs:
            description = rec.get('description', 'Unknown issue')
            affected_tables = rec.get('affected_tables', [])
            
            # Extract additional context if available (safe access)
            business_impact = rec.get('business_impact', 'Minor impact on model optimization and user experience')
            suggested_solution = rec.get('suggested_solution', 'Consider optimization when time permits')
            
            if affected_tables and len(affected_tables) >= 2:
                warning_text = f"Table '{affected_tables[0]}' → '{affected_tables[1]}': {description}"
                warning_text += f" | Impact: {business_impact}"
                warning_text += f" | Solution: {suggested_solution}"
                warning_issues.append(warning_text)
            elif affected_tables and len(affected_tables) == 1:
                warning_text = f"Table '{affected_tables[0]}': {description}"
                warning_text += f" | Impact: {business_impact}"
                warning_text += f" | Solution: {suggested_solution}"
                warning_issues.append(warning_text)
            else:
                warning_text = f"Medium priority relationship opportunity: {description}"
                warning_text += f" | Impact: {business_impact}"
                warning_text += f" | Solution: {suggested_solution}"
                warning_issues.append(warning_text)
        
        # Enhanced missing relationships analysis
        if potential_rels > existing_rels:
            missing_count = potential_rels - existing_rels
            if missing_count == 1:
                issue_text = f"Missing {missing_count} potential relationship that could improve connectivity"
                issue_text += f" | Impact: Limited cross-table analysis capabilities"
                issue_text += f" | Solution: Evaluate business logic and create appropriate relationship"
                issue_issues.append(issue_text)
            else:
                issue_text = f"Missing {missing_count} potential relationships that could improve connectivity"
                issue_text += f" | Impact: Significant limitations in cross-table analysis and dimensional modeling"
                issue_text += f" | Solution: Review table schemas and implement high-priority relationships based on business requirements"
                issue_issues.append(issue_text)
    
    def _generate_ai_columns_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for AI-powered columns analysis with enhanced insights."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("columns_analysis")
        
        # Extract AI analysis summary with enhanced structure
        analysis_summary = analysis_data.get("summary", {})
        total_columns = analysis_data.get("total_columns_analyzed", 0)
        
        if analysis_summary and total_columns > 0:
            # Get enhanced AI scoring statistics
            ai_scoring_stats = analysis_summary.get("ai_scoring_statistics", {})
            avg_scores = ai_scoring_stats.get("average_scores", {})
            issues_summary = analysis_summary.get("issues_summary", {})
            
            # Use the calculated overall score percentage from our enhanced analysis
            quality_score = avg_scores.get("overall_score_percentage", 0)
            
            # Get priority distribution
            priority_dist = analysis_summary.get("priority_distribution", {})
            critical_issues = issues_summary.get("critical_issues", priority_dist.get("HIGH", 0))
            warning_issues = issues_summary.get("warning_issues", priority_dist.get("MEDIUM", 0))
            total_issues = issues_summary.get("total_issues", critical_issues + warning_issues)
            
            # Use the enhanced key findings and recommendations directly from our analysis
            key_findings = analysis_summary.get("key_findings", [])
            recommendations = analysis_summary.get("recommendations", [])
            
            # Set summary values
            summary["overall_score"] = round(quality_score, 1)
            summary["total_issues"] = total_issues
            summary["critical_issues"] = critical_issues
            summary["warning_issues"] = warning_issues
            summary["key_findings"] = key_findings[:5]  # Limit to top 5 findings
            summary["recommendations"] = recommendations[:5]  # Limit to top 5 recommendations
            
            # Generate detailed issues for the webapp "View Issue Details" section
            detailed_critical_issues = []
            detailed_warning_issues = []
            
            # Get the actual analysis results to create specific column-level issue explanations
            analysis_results = analysis_data.get("analysis_results", [])
            
            if analysis_results:
                # Process critical issues (HIGH priority columns) with clear explanations
                high_priority_columns = [r for r in analysis_results if r.get("Priority") == "HIGH"]
                for result in high_priority_columns[:10]:  # Limit to first 10 to avoid overwhelming UI
                    column_name = result.get("Column_Name", "Unknown")
                    table_name = result.get("Table_Name", "Unknown")
                    issues = []
                    reasons = []
                    
                    # Check specific scores and provide clear explanations
                    if result.get("Column_Name_Score", 1) < 0.26:
                        issues.append("unclear business name")
                        reasons.append("Column name doesn't clearly indicate its business purpose to end users")
                    
                    if result.get("Column_Selfexplanatory_Score", 1) < 0.23:
                        issues.append("requires domain knowledge")
                        reasons.append("Users need specialized knowledge to understand what this column represents")
                    
                    if result.get("Column_Format_Score", 1) < 0.08:
                        issues.append("poor naming conventions")
                        reasons.append("Column doesn't follow PascalCase formatting standards (no spaces/underscores)")
                    
                    if result.get("Column_DataType_Score", 1) < 0.75:
                        issues.append("suboptimal data type")
                        reasons.append("Current data type may impact query performance or calculation accuracy")
                    
                    if result.get("Unique_Column_Score", 1) < 0.19:
                        issues.append("confusing similarity")
                        reasons.append("Column name is too similar to other columns, causing user confusion")
                    
                    if issues:
                        issue_summary = f"'{column_name}' in {table_name}: {', '.join(issues)}"
                        explanation = f"Why critical: {'; '.join(reasons)}"
                        score_info = f"Score: {result.get('Overall_score', 0):.2f}/2.0"
                        
                        detailed_critical_issues.append(f"{issue_summary}. {explanation}. {score_info}")
                
                # Process warning issues (MEDIUM priority columns) with explanations
                medium_priority_columns = [r for r in analysis_results if r.get("Priority") == "MEDIUM"]
                for result in medium_priority_columns[:15]:  # Limit to first 15
                    column_name = result.get("Column_Name", "Unknown")
                    table_name = result.get("Table_Name", "Unknown")
                    issues = []
                    reasons = []
                    
                    # Check specific scores with improvement suggestions
                    cn_score = result.get("Column_Name_Score", 1)
                    if 0.26 <= cn_score < 0.32:
                        issues.append("could improve business clarity")
                        reasons.append("Column name could be more descriptive of its business value")
                    
                    se_score = result.get("Column_Selfexplanatory_Score", 1)
                    if 0.23 <= se_score < 0.27:
                        issues.append("could be more intuitive")
                        reasons.append("Column could benefit from clearer, more universally understood terminology")
                    
                    cf_score = result.get("Column_Format_Score", 1)
                    if 0.08 <= cf_score < 0.09:
                        issues.append("minor formatting improvements")
                        reasons.append("Could better follow PascalCase naming conventions")
                    
                    dt_score = result.get("Column_DataType_Score", 1)
                    if 0.75 <= dt_score < 0.90:
                        issues.append("data type optimization opportunity")
                        reasons.append("Data type could be optimized for better performance")
                    
                    uq_score = result.get("Unique_Column_Score", 1)
                    if 0.19 <= uq_score < 0.22:
                        issues.append("name similarity concerns")
                        reasons.append("Could be differentiated better from similar column names")
                    
                    if issues:
                        issue_summary = f"'{column_name}' in {table_name}: {', '.join(issues)}"
                        explanation = f"Why flagged: {'; '.join(reasons)}"
                        score_info = f"Score: {result.get('Overall_score', 0):.2f}/2.0"
                        
                        detailed_warning_issues.append(f"{issue_summary}. {explanation}. {score_info}")
            
            # Add fallback messages if no specific issues found but counts indicate issues exist
            if not detailed_critical_issues and critical_issues > 0:
                detailed_critical_issues = [f"Found {critical_issues} columns with critical naming issues. These columns have unclear names, require domain knowledge, or have significant formatting problems that impact user experience and data comprehension."]
            
            if not detailed_warning_issues and warning_issues > 0:
                detailed_warning_issues = [f"Found {warning_issues} columns with moderate naming improvements available. These columns could benefit from clearer names, better formatting, or data type optimization."]
            
            # Ensure we always have some content for the UI
            if not detailed_critical_issues:
                detailed_critical_issues = ["No critical column naming issues detected"]
            
            if not detailed_warning_issues:
                detailed_warning_issues = ["No warning-level column naming issues detected"]
            
            summary["detailed_issues"] = {
                "critical": detailed_critical_issues,
                "warning": detailed_warning_issues
            }
            
            # Enhanced score breakdown with all AI scoring components
            summary["score_breakdown"] = {
                "business_clarity": {
                    "score": round(avg_scores.get("cn_001_business_clarity", 0) * 100 / 0.35, 1),
                    "weight": "35%",
                    "description": "How clearly column names indicate business purpose"
                },
                "self_explanatory": {
                    "score": round(avg_scores.get("cn_002_self_explanatory", 0) * 100 / 0.30, 1),
                    "weight": "30%", 
                    "description": "Whether columns are understandable without domain knowledge"
                },
                "uniqueness": {
                    "score": round(avg_scores.get("cn_003_uniqueness", 0) * 100 / 0.25, 1),
                    "weight": "25%",
                    "description": "How distinct column names are from each other"
                },
                "formatting": {
                    "score": round(avg_scores.get("cn_004_formatting", 0) * 100 / 0.10, 1),
                    "weight": "10%",
                    "description": "Adherence to PascalCase naming conventions"
                },
                "data_type_accuracy": {
                    "score": round(avg_scores.get("ct_001_data_type_accuracy", 0) * 100 / 1.0, 1),
                    "weight": "100% of type score",
                    "description": "Appropriateness of assigned data types"
                }
            }
            
            # Generate detailed column-level issues for "View Issue Details" section
            detailed_issues = {"critical": [], "warning": []}
            
            # Get the actual analysis results to extract specific column issues
            analysis_results = analysis_data.get("csv_content")
            if analysis_results and isinstance(analysis_results, str):
                # Parse CSV data to get column details
                import io
                import csv
                csv_reader = csv.DictReader(io.StringIO(analysis_results))
                column_data = list(csv_reader)
                
                # Process each column to identify specific issues
                for row in column_data:
                    column_name = row.get("Column_Name", "Unknown")
                    table_name = row.get("Table_Name", "Unknown")
                    priority = row.get("Priority", "NONE")
                    
                    # Extract scores for detailed explanations
                    business_score = float(row.get("Column_Name_Score", 0))
                    explanatory_score = float(row.get("Column_Selfexplanatory_Score", 0))
                    uniqueness_score = float(row.get("Unique_Column_Score", 0))
                    format_score = float(row.get("Column_Format_Score", 0))
                    datatype_score = float(row.get("Column_DataType_Score", 0))
                    overall_score = float(row.get("Overall_score", 0))
                    
                    # Build detailed issue explanations
                    issues = []
                    
                    if business_score < 0.26:  # 75% of 0.35
                        issues.append(f"Business clarity issue: Column name '{column_name}' doesn't clearly indicate its business purpose (score: {business_score:.2f}/0.35)")
                    
                    if explanatory_score < 0.23:  # 75% of 0.30
                        issues.append(f"Self-explanatory issue: Column '{column_name}' requires domain knowledge to understand (score: {explanatory_score:.2f}/0.30)")
                    
                    if uniqueness_score < 0.19:  # 75% of 0.25
                        issues.append(f"Uniqueness issue: Column '{column_name}' is too similar to other column names, causing confusion (score: {uniqueness_score:.2f}/0.25)")
                    
                    if format_score < 0.08:  # 75% of 0.10
                        issues.append(f"Formatting issue: Column '{column_name}' doesn't follow PascalCase conventions (score: {format_score:.2f}/0.10)")
                    
                    if datatype_score < 0.75:  # 75% of 1.0
                        current_type = row.get("Current_DataType", "Unknown")
                        suggested_type = row.get("Suggested_DataType", "Not specified")
                        issues.append(f"Data type issue: Column '{column_name}' has suboptimal data type '{current_type}', suggested: '{suggested_type}' (score: {datatype_score:.2f}/1.0)")
                    
                    # Add issues to appropriate category
                    if issues and priority == "HIGH":
                        detailed_issues["critical"].append({
                            "title": f"Critical Issues in '{table_name}.{column_name}'",
                            "description": f"Overall Quality Score: {overall_score:.2f}/2.0 ({(overall_score/2.0)*100:.1f}%)",
                            "issues": issues,
                            "impact": "These critical issues significantly impact user experience and data comprehension. Immediate attention required.",
                            "solution": f"Rename '{column_name}' to a more descriptive, business-friendly name that clearly indicates its purpose and follows naming conventions."
                        })
                    elif issues and priority in ["MEDIUM", "LOW"]:
                        detailed_issues["warning"].append({
                            "title": f"Improvement Opportunities in '{table_name}.{column_name}'",
                            "description": f"Overall Quality Score: {overall_score:.2f}/2.0 ({(overall_score/2.0)*100:.1f}%)",
                            "issues": issues,
                            "impact": "These issues may affect model usability and user experience. Recommended for improvement.",
                            "solution": f"Consider improving '{column_name}' naming and formatting to enhance clarity and consistency."
                        })
            
            # Add detailed issues to summary
            summary["detailed_issues"] = detailed_issues
            
        else:
            # Fallback when no analysis data available
            summary["key_findings"] = ["AI-powered column analysis in progress..."]
            summary["overall_score"] = 0
            summary["recommendations"] = ["AI will evaluate naming conventions and provide detailed recommendations"]
            summary["detailed_issues"] = {"critical": [], "warning": []}
        
        return summary
    
   
    def _generate_security_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for security analysis."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("security_analysis")
        
        # Extract real security analysis data
        analysis_summary = analysis_data.get("analysis_summary", {})
        subrule_analysis = analysis_data.get("subrule_analysis", {})
        security_roles = analysis_data.get("security_roles", [])
        recommendations = analysis_data.get("recommendations", [])
        
        # DEBUG: Check what recommendations we received
        logger.info(f"🔍 SUMMARY DEBUG: _generate_security_summary received recommendations = {recommendations}")
        logger.info(f"🔍 SUMMARY DEBUG: len(recommendations) = {len(recommendations)}")
        
        # Calculate overall score from CSV data (same pattern as dataset_columns_analysis)
        csv_analysis_results = analysis_data.get("csv_analysis_results", [])
        
        if csv_analysis_results:
            # Use CSV-based scoring (sum of overall scores / sum of max scores) * 100
            total_overall_score = sum(r["Overall_Score"] for r in csv_analysis_results)
            total_max_score = sum(r["Max_Score"] for r in csv_analysis_results)
            
            if total_max_score > 0:
                overall_score = round((total_overall_score / total_max_score) * 100, 1)
            else:
                overall_score = 0.0
                
            summary["overall_score"] = overall_score
            logger.info(f"📊 Security Overall Score: {total_overall_score:.3f}/{total_max_score:.3f} = {overall_score}%")
            
            # Define rls_coverage for use later in the method
            rls_coverage = analysis_summary.get("rls_coverage_percentage", 0)
        else:
            # Fallback to old calculation if CSV data not available
            subrule_score_percentage = analysis_summary.get("subrule_score_percentage", 0)
            rls_coverage = analysis_summary.get("rls_coverage_percentage", 0)
            
            # Combine subrule score (70%) and RLS coverage (30%) for overall score
            overall_score = round((subrule_score_percentage * 0.7) + (rls_coverage * 0.3), 1)
            summary["overall_score"] = overall_score
        
        # Build meaningful key findings from CSV analysis results
        key_findings = []
        
        # Use CSV data for comprehensive findings if available
        if csv_analysis_results:
            total_tables = len(csv_analysis_results)
            
            # Rule 1: Sensitive Data Analysis
            sensitive_tables = sum(1 for r in csv_analysis_results if r.get("Has_Sensitive_Data") == "YES")
            encrypted_tables = sum(1 for r in csv_analysis_results if r.get("Has_Sensitive_Data") == "YES" and r.get("Sensitive_Data_Score", 0) >= r.get("Sensitive_Data_Max_Score", 0))
            
            if sensitive_tables > 0:
                key_findings.append(f"• Analyzed {total_tables} tables: {sensitive_tables} contain sensitive data requiring encryption protection")
                if encrypted_tables < sensitive_tables:
                    key_findings.append(f"Security Gap: {sensitive_tables - encrypted_tables} sensitive tables lack proper encryption controls")
            else:
                key_findings.append(f"• Analyzed {total_tables} tables: No sensitive data detected requiring special encryption")
            
            # Rule 2: Financial Data Security Analysis
            financial_tables = sum(1 for r in csv_analysis_results if r.get("Has_Financial_Data") == "YES")
            protected_financial = sum(1 for r in csv_analysis_results if r.get("Has_Financial_Data") == "YES" and r.get("Has_Security_Filtering") == "YES")
            
            if financial_tables > 0:
                protection_rate = round((protected_financial / financial_tables) * 100, 1)
                key_findings.append(f"• Financial Data Security: {protected_financial}/{financial_tables} tables ({protection_rate}%) have MSSales Row-Level Security")
                if protected_financial < financial_tables:
                    unprotected = financial_tables - protected_financial
                    key_findings.append(f"• Risk Identified: {unprotected} financial tables exposed without MSSales security filtering")
            
            # Rule 3: Account Assignment Analysis
            account_linked_tables = sum(1 for r in csv_analysis_results if r.get("Has_Financial_Data") == "YES" and r.get("Account_Linkage_Columns"))
            financial_needing_accounts = sum(1 for r in csv_analysis_results if r.get("Has_Financial_Data") == "YES")
            
            if financial_needing_accounts > 0:
                account_rate = round((account_linked_tables / financial_needing_accounts) * 100, 1)
                key_findings.append(f"• Account Assignment Coverage: {account_linked_tables}/{financial_needing_accounts} financial tables ({account_rate}%) have proper account linkage")
            
            # Overall Compliance Summary
            severity_counts = {"Good": 0, "Warning": 0, "Issue": 0, "Critical": 0}
            for r in csv_analysis_results:
                severity = r.get("Severity", "Good")
                severity_counts[severity] = severity_counts.get(severity, 0) + 1
            
            compliance_rate = round((severity_counts["Good"] / total_tables) * 100, 1) if total_tables > 0 else 0
            key_findings.append(f"• Overall Security Compliance: {severity_counts['Good']}/{total_tables} tables ({compliance_rate}%) meet all security requirements")
            
            # Define variables for later use in fallback recommendations
            sensitive_tables = sum(1 for r in csv_analysis_results if r.get("Has_Sensitive_Data") == "YES")
            total_roles = analysis_summary.get("total_roles", 0)
            tables_with_rls = sum(1 for r in csv_analysis_results if r.get("Has_Security_Filtering") == "YES")
        
        else:
            # Fallback to legacy data if CSV not available
            total_tables = analysis_summary.get("total_tables", 0)
            total_roles = analysis_summary.get("total_roles", 0)
            tables_with_rls = analysis_summary.get("tables_with_rls", 0)
            sensitive_tables = analysis_summary.get("sensitive_tables", 0)
            
            if total_tables > 0:
                key_findings.append(f"• Analyzed {total_tables} tables for security compliance")

            if total_roles > 0:
                key_findings.append(f"• Found {total_roles} security roles defined in the model")
            else:
                key_findings.append("• No security roles defined - model completely unprotected")

            if tables_with_rls > 0:
                rls_rate = round((tables_with_rls / total_tables) * 100, 1) if total_tables > 0 else 0
                key_findings.append(f"• Row-Level Security: {tables_with_rls}/{total_tables} tables ({rls_rate}%) protected")
            else:
                key_findings.append("• No Row-Level Security (RLS) filters implemented")
                
            if sensitive_tables > 0:
                key_findings.append(f"• Data Privacy Risk: {sensitive_tables} tables contain sensitive data requiring protection")

        summary["key_findings"] = key_findings if key_findings else ["No security analysis data available"]
        
        # Generate detailed issues based on CSV analysis results for accuracy
        critical_issues = []
        warning_issues = []
        issue_issues = []  # For medium-level issues
        
        # Use CSV-based issue detection if available
        if csv_analysis_results:
            for result in csv_analysis_results:
                table_name = result.get("Table_Name", "Unknown")
                severity = result.get("Severity", "Good")
                
                if severity == "Critical":
                    # Build specific critical issue based on CSV data
                    issue_details = []
                    if result.get("Has_Sensitive_Data") == "YES" and result.get("Sensitive_Data_Score", 0) == 0:
                        issue_details.append("unencrypted sensitive data")
                    if result.get("Has_Financial_Data") == "YES" and result.get("Has_Security_Filtering") == "NO":
                        issue_details.append("unprotected financial data")
                    if result.get("Has_Financial_Data") == "YES" and not result.get("Account_Linkage_Columns"):
                        issue_details.append("missing account assignment")
                    
                    if issue_details:
                        critical_issues.append(f"Table '{table_name}': {', '.join(issue_details)}")
                
                elif severity == "Issue":
                    # Build specific issue-level problems
                    issue_details = []
                    if result.get("Security_Roles_Score", 0) < result.get("Security_Roles_Max_Score", 0):
                        issue_details.append("incomplete MSSales security")
                    if result.get("Seller_Assignment_Score", 0) < result.get("Seller_Assignment_Max_Score", 0):
                        issue_details.append("partial account linkage")
                    
                    if issue_details:
                        issue_issues.append(f"Table '{table_name}': {', '.join(issue_details)}")
                
                elif severity == "Warning":
                    # Build specific warning-level improvements
                    warning_details = []
                    overall_score = result.get("Overall_Score", 0)
                    max_score = result.get("Max_Score", 1)
                    if overall_score / max_score < 0.8:  # Less than 80% of max score
                        warning_details.append("security optimization needed")
                    
                    if warning_details:
                        warning_issues.append(f"Table '{table_name}': {', '.join(warning_details)}")
        
        else:
            # Fallback to legacy system-level issue detection only if no CSV data
            # Categorize recommendations by priority
            for rec in recommendations:
                rec_text = rec if isinstance(rec, str) else rec.get("recommendation", str(rec))
                
                # Critical issues - security gaps
                if any(keyword in rec_text.lower() for keyword in ['no security', 'no rls', 'missing role', 'unprotected', 'exposed']):
                    critical_issues.append(rec_text)
                # Warning issues - improvements needed  
                elif any(keyword in rec_text.lower() for keyword in ['improve', 'enhance', 'consider', 'recommend', 'should']):
                    warning_issues.append(rec_text)
                else:
                    warning_issues.append(rec_text)
            
            # Add system-level issues based on analysis results (legacy)
            if total_roles == 0:
                critical_issues.append("No security roles defined - model is completely unprotected")
            elif total_roles < 3:
                warning_issues.append(f"Only {total_roles} security roles defined - consider adding role-based access")
                
            if rls_coverage < 20:
                critical_issues.append("Very low RLS coverage - sensitive data may be exposed")
            elif rls_coverage < 50:
                warning_issues.append("Moderate RLS coverage - consider expanding row-level security")
                
            if sensitive_tables > 0 and tables_with_rls == 0:
                critical_issues.append(f"Found {sensitive_tables} sensitive tables with no RLS protection")
        
        # Set detailed issues based on CSV-derived issues
        summary["detailed_issues"] = {
            "critical": critical_issues[:10],  # Top 10 critical issues
            "issue": issue_issues[:10],        # Top 10 issue-level problems  
            "warning": warning_issues[:15]     # Top 15 warnings
        }
        
        # Use rule-score-based recommendations from analysis data (priority)
        # Only add generic recommendations if no specific ones exist
        if recommendations:
            # Use the detailed rule-score-based recommendations from analysis
            summary["recommendations"] = recommendations[:]
        else:
            # Add security-specific recommendations as fallback
            security_recommendations = []
            if overall_score < 50:
                security_recommendations.append("🚨 Immediate action required: Implement comprehensive security model")
            elif overall_score < 70:
                security_recommendations.append("⚠️ Security improvements needed: Address key gaps in access control")
            else:
                security_recommendations.append("✅ Good security foundation: Continue monitoring and fine-tuning")
                
            if len(critical_issues) > 0:
                security_recommendations.append(f"Address {len(critical_issues)} critical security gaps immediately")
                
            if rls_coverage < 80 and sensitive_tables > 0:
                security_recommendations.append("Expand Row-Level Security to cover all sensitive tables")
                
            summary["recommendations"] = security_recommendations
        
        # DEBUG: Check what we're returning
        logger.info(f"🔍 SUMMARY DEBUG: _generate_security_summary returning recommendations = {summary.get('recommendations', 'NOT_FOUND')}")
        
        return summary
     
    def _generate_hierarchies_summary(self, analysis_data: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
        """Generate summary for hierarchies analysis."""
        # Add analyzer-specific criteria information
        summary["analysis_criteria"] = self._get_analyzer_specific_criteria("hierarchies_analysis")
        
        # Extract real analysis data
        analysis_summary = analysis_data.get("analysis_summary", {})
        existing_hierarchies = analysis_data.get("existing_hierarchies_detailed", [])
        recommendations = analysis_data.get("recommendations", [])
        hierarchy_types = analysis_data.get("hierarchy_types_found", [])
        breakdown = analysis_data.get("detailed_breakdown", {})
        
        # Build key findings from real data
        key_findings = []
        total_existing = analysis_summary.get("total_existing_hierarchies", 0)
        total_tables = analysis_summary.get("tables_analyzed", 0)
        tables_with_hierarchies = analysis_summary.get("tables_with_hierarchies", 0)
        tables_without = analysis_summary.get("tables_without_hierarchies", 0)
        
        if total_existing > 0:
            key_findings.append(f"• Found {total_existing} existing hierarchies across {tables_with_hierarchies} tables")
        else:
            key_findings.append("• No existing hierarchies found in the model")
            
        if hierarchy_types:
            key_findings.append(f"• Identified {len(hierarchy_types)} different hierarchy patterns")
        
        # Base findings on CSV analysis and scoring rather than simple table count
        csv_content = analysis_data.get("csv_content", "")
        if csv_content:
            try:
                import pandas as pd
                import io
                
                # Parse CSV to get actual analysis results
                csv_lines = csv_content.strip().split('\n')
                csv_lines = [line for line in csv_lines if line.strip()]
                cleaned_csv = '\n'.join(csv_lines)
                df = pd.read_csv(io.StringIO(cleaned_csv))
                
                if len(df) > 0:
                    # Count suggested hierarchies from actual analysis
                    suggested_count = len(df[df.get('Hierarchy_Type', '') == 'Suggested'])
                    existing_count = len(df[df.get('Hierarchy_Type', '') == 'Existing'])
                    
                    # Count opportunities based on scoring rather than simple absence
                    if 'Overall_Score' in df.columns:
                        low_quality = len(df[df['Overall_Score'] < 0.6])  # Below 60% score
                        good_quality = len(df[df['Overall_Score'] >= 0.8])  # Above 80% score
                        
                        if suggested_count > 0:
                            key_findings.append(f"• {suggested_count} potential hierarchy opportunities identified through analysis")
                        
                        if low_quality > 0:
                            key_findings.append(f"• {low_quality} hierarchies need quality improvements (score < 60%)")
                        elif good_quality > 0:
                            key_findings.append(f"• {good_quality} hierarchies show excellent design quality (score ≥ 80%)")
                    else:
                        if suggested_count > 0:
                            key_findings.append(f"• {suggested_count} potential hierarchy opportunities identified")
            except Exception as e:
                # Fallback to original logic if CSV parsing fails
                if tables_without > 0:
                    key_findings.append(f"• {tables_without} tables currently lack hierarchies")
        else:
            # Fallback to original logic if no CSV data
            if tables_without > 0:
                key_findings.append(f"• {tables_without} tables currently lack hierarchies")
            
        # Calculate overall score based on CSV data (same pattern as fact dimension analysis)
        csv_content = analysis_data.get("csv_content", "")
        logger.info(f"🔧 HIERARCHIES SUMMARY: CSV content available: {bool(csv_content)}")
        
        if csv_content:
            logger.info(f"🔧 HIERARCHIES SUMMARY: CSV content length: {len(csv_content)} characters")
            logger.info(f"🔧 HIERARCHIES SUMMARY: Raw CSV content:")
            for i, line in enumerate(csv_content.split('\n')[:10]):  # First 10 lines
                logger.info(f"🔧 LINE {i}: '{line}'")
                
            try:
                import pandas as pd
                import io
                
                # Clean the CSV content to handle any formatting issues
                csv_lines = csv_content.strip().split('\n')
                # Remove any completely empty lines
                csv_lines = [line for line in csv_lines if line.strip()]
                cleaned_csv = '\n'.join(csv_lines)
                
                logger.info(f"🔧 HIERARCHIES SUMMARY: Cleaned CSV lines: {len(csv_lines)}")
                
                df = pd.read_csv(io.StringIO(cleaned_csv))
                logger.info(f"🔧 HIERARCHIES SUMMARY: DataFrame shape: {df.shape}")
                logger.info(f"🔧 HIERARCHIES SUMMARY: DataFrame columns: {list(df.columns)}")
                
                if len(df) > 0:
                    logger.info(f"🔧 HIERARCHIES SUMMARY: First row data: {dict(df.iloc[0])}")
                
                if 'Overall_Score' in df.columns and len(df) > 0:
                    # Calculate overall score as average of CSV Overall_Score values (0-1 scale) converted to percentage
                    overall_scores = df['Overall_Score'].dropna()
                    logger.info(f"🔧 HIERARCHIES SUMMARY: Overall_Score values: {list(overall_scores)}")
                    
                    if len(overall_scores) > 0:
                        avg_score = overall_scores.mean()
                        overall_score = round(avg_score * 100, 1)  # Convert 0-1 to 0-100 percentage
                        logger.info(f"🔧 HIERARCHIES SCORE: SUCCESS - {len(overall_scores)} scores, avg={avg_score:.3f}, percentage={overall_score}%")
                    else:
                        overall_score = 0
                        logger.warning("🔧 HIERARCHIES SUMMARY: No valid Overall_Score values found after dropna()")
                else:
                    overall_score = 0
                    logger.warning(f"🔧 HIERARCHIES SUMMARY: Overall_Score column missing or empty DataFrame. Available columns: {list(df.columns) if len(df) > 0 else 'No data'}")
            except Exception as e:
                logger.warning(f"Failed to calculate score from CSV: {e}")
                # Fallback to hierarchy coverage calculation
                hierarchy_coverage = (tables_with_hierarchies / total_tables * 100) if total_tables > 0 else 0
                if total_existing == 0:
                    overall_score = 0
                elif hierarchy_coverage >= 80:
                    overall_score = 85
                elif hierarchy_coverage >= 60:
                    overall_score = 75
                elif hierarchy_coverage >= 40:
                    overall_score = 65
                elif hierarchy_coverage >= 20:
                    overall_score = 55
                else:
                    overall_score = 45
        else:
            # Fallback to hierarchy coverage calculation
            hierarchy_coverage = (tables_with_hierarchies / total_tables * 100) if total_tables > 0 else 0
            if total_existing == 0:
                overall_score = 0
            elif hierarchy_coverage >= 80:
                overall_score = 85
            elif hierarchy_coverage >= 60:
                overall_score = 75
            elif hierarchy_coverage >= 40:
                overall_score = 65
            elif hierarchy_coverage >= 20:
                overall_score = 55
            else:
                overall_score = 45
            
        summary["key_findings"] = key_findings if key_findings else ["No hierarchy analysis data available"]
        summary["overall_score"] = overall_score
        
        # Extract detailed issues from CSV data (same pattern as fact dimension analysis)
        critical_issues = []
        issue_issues = []
        warning_issues = []
        
        # Read issues from CSV data with Issue_Severity column (like fact dimension analysis)
        logger.info(f"🔧 HIERARCHIES ISSUES: Starting issue detection from CSV data")
        if csv_content:
            try:
                import pandas as pd
                import io
                
                # Clean the CSV content to handle any formatting issues
                csv_lines = csv_content.strip().split('\n')
                csv_lines = [line for line in csv_lines if line.strip()]
                cleaned_csv = '\n'.join(csv_lines)
                
                df = pd.read_csv(io.StringIO(cleaned_csv))
                logger.info(f"🔧 HIERARCHIES ISSUES: DataFrame shape: {df.shape}")
                logger.info(f"🔧 HIERARCHIES ISSUES: DataFrame columns: {list(df.columns)}")
                
                if 'Issue_Severity' in df.columns and len(df) > 0:
                    logger.info(f"🔧 HIERARCHIES ISSUES: Issue_Severity values: {list(df['Issue_Severity'])}")
                    
                    # Count issues by severity from CSV (same pattern as fact dimension analysis)
                    critical_count = len(df[df['Issue_Severity'].str.lower() == 'critical'])
                    issue_count = len(df[df['Issue_Severity'].str.lower() == 'issue'])  
                    warning_count = len(df[df['Issue_Severity'].str.lower() == 'warning'])
                    
                    logger.info(f"🔧 HIERARCHIES ISSUES: Severity counts - Critical: {critical_count}, Issue: {issue_count}, Warning: {warning_count}")
                    
                    # Generate detailed issue descriptions from CSV data
                    for _, row in df.iterrows():
                        severity = str(row.get('Issue_Severity', '')).lower()
                        table_name = row.get('Table', 'Unknown')
                        hierarchy_name = row.get('Hierarchy_Name', 'Unknown')
                        score = row.get('Overall_Score', 0)
                        rationale = row.get('Score_Rationale', '')
                        
                        if severity == 'critical':
                            explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Critical issue identified"
                            explanation += f" | Score: {score:.3f}"
                            if rationale:
                                explanation += f" | Issue: {rationale}"
                            critical_issues.append(explanation)
                        
                        elif severity == 'issue':
                            explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Significant improvement needed"
                            explanation += f" | Score: {score:.3f}"
                            if rationale:
                                explanation += f" | Issue: {rationale}"
                            issue_issues.append(explanation)
                        
                        elif severity == 'warning':
                            explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Minor optimization recommended"
                            explanation += f" | Score: {score:.3f}"
                            if rationale:
                                explanation += f" | Issue: {rationale}"
                            warning_issues.append(explanation)
                    
                    logger.info(f"🔧 HIERARCHIES ISSUES: From CSV - {critical_count} critical, {issue_count} issue, {warning_count} warning")
                else:
                    logger.warning(f"🔧 HIERARCHIES ISSUES: Issue_Severity column missing or empty DataFrame. Available columns: {list(df.columns) if len(df) > 0 else 'No data'}")
                
            except Exception as e:
                logger.warning(f"Failed to read issues from CSV: {e}")
                # Fallback to processing existing hierarchies data directly here (integrated logic)
                logger.warning("🔧 HIERARCHIES ISSUES: CSV processing failed, falling back to existing hierarchies analysis")
                for hierarchy in existing_hierarchies:
                    table_name = hierarchy.get("table", "Unknown")
                    hierarchy_name = hierarchy.get("hierarchy_name", "Unknown")
                    score_category = hierarchy.get("score_category", "Unknown")
                    score_rationale = hierarchy.get("score_rationale", "")
                    total_score = hierarchy.get("total_score", 0)
                    table_type = hierarchy.get("table_type", "Unknown")
                    
                    # CRITICAL ISSUE: Hierarchies should always be established in dimension tables
                    if table_type == "Fact":
                        explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Located in Fact table instead of Dimension table"
                        explanation += f" | Issue: Hierarchies in fact tables are not optimal for business navigation and drill-down analysis"
                        explanation += f" | Score: {total_score:.1f} - {score_category}"
                        explanation += f" | Recommendation: Consider moving hierarchy to appropriate dimension table for better user experience"
                        if score_rationale:
                            explanation += f" | Details: {score_rationale}"
                        critical_issues.append(explanation)
                    
                    # CRITICAL ISSUE: Poor hierarchy design (very low scores)
                    elif "Poor" in score_category or total_score < 0.5:
                        explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Critical quality issues (Score: {total_score:.1f})"
                        explanation += f" | Issue: Poor hierarchy design significantly affects navigation and usability"
                        if "unclear direction" in score_rationale.lower():
                            explanation += f" | Problem: Hierarchy levels are not logically ordered from high to low or low to high"
                        if "not suitable" in score_rationale.lower():
                            explanation += f" | Problem: Table structure is not appropriate for hierarchical navigation"
                        explanation += f" | Recommendation: Review and redesign hierarchy for better business logic and user navigation"
                        critical_issues.append(explanation)
                    
                    # ISSUE: Significant improvements needed (Fair scores)
                    elif "Fair" in score_category or (total_score >= 0.5 and total_score < 0.7):
                        explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Significant improvement needed (Score: {total_score:.1f})"
                        explanation += f" | Issue: Hierarchy has moderate quality issues that should be addressed"
                        if score_rationale:
                            explanation += f" | Areas for improvement: {score_rationale}"
                        explanation += f" | Recommendation: Enhance hierarchy design to improve user experience and analytical value"
                        issue_issues.append(explanation)
                    
                    # WARNING: Minor optimizations (Good scores but not excellent)
                    elif "Good" in score_category or (total_score >= 0.7 and total_score < 0.85):
                        explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Minor optimization opportunities (Score: {total_score:.1f})"
                        explanation += f" | Opportunity: Good hierarchy with room for fine-tuning"
                        if score_rationale:
                            explanation += f" | Optimization areas: {score_rationale}"
                        explanation += f" | Recommendation: Consider minor enhancements for optimal user experience"
                        warning_issues.append(explanation)
        else:
            logger.warning("🔧 HIERARCHIES ISSUES: No CSV content available, using fallback")
            # Fallback to processing existing hierarchies data directly here (integrated logic)
            for hierarchy in existing_hierarchies:
                table_name = hierarchy.get("table", "Unknown")
                hierarchy_name = hierarchy.get("hierarchy_name", "Unknown")
                score_category = hierarchy.get("score_category", "Unknown")
                score_rationale = hierarchy.get("score_rationale", "")
                total_score = hierarchy.get("total_score", 0)
                table_type = hierarchy.get("table_type", "Unknown")
                
                # CRITICAL ISSUE: Hierarchies should always be established in dimension tables
                if table_type == "Fact":
                    explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Located in Fact table instead of Dimension table"
                    explanation += f" | Issue: Hierarchies in fact tables are not optimal for business navigation and drill-down analysis"
                    explanation += f" | Score: {total_score:.1f} - {score_category}"
                    explanation += f" | Recommendation: Consider moving hierarchy to appropriate dimension table for better user experience"
                    if score_rationale:
                        explanation += f" | Details: {score_rationale}"
                    critical_issues.append(explanation)
                
                # CRITICAL ISSUE: Poor hierarchy design (very low scores)
                elif "Poor" in score_category or total_score < 0.5:
                    explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Critical quality issues (Score: {total_score:.1f})"
                    explanation += f" | Issue: Poor hierarchy design significantly affects navigation and usability"
                    if "unclear direction" in score_rationale.lower():
                        explanation += f" | Problem: Hierarchy levels are not logically ordered from high to low or low to high"
                    if "not suitable" in score_rationale.lower():
                        explanation += f" | Problem: Table structure is not appropriate for hierarchical navigation"
                    explanation += f" | Recommendation: Review and redesign hierarchy for better business logic and user navigation"
                    critical_issues.append(explanation)
                
                # ISSUE: Significant improvements needed (Fair scores)
                elif "Fair" in score_category or (total_score >= 0.5 and total_score < 0.7):
                    explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Significant improvement needed (Score: {total_score:.1f})"
                    explanation += f" | Issue: Hierarchy has moderate quality issues that should be addressed"
                    if score_rationale:
                        explanation += f" | Areas for improvement: {score_rationale}"
                    explanation += f" | Recommendation: Enhance hierarchy design to improve user experience and analytical value"
                    issue_issues.append(explanation)
                
                # WARNING: Minor optimizations (Good scores but not excellent)
                elif "Good" in score_category or (total_score >= 0.7 and total_score < 0.85):
                    explanation = f"Table '{table_name}' - Hierarchy '{hierarchy_name}': Minor optimization opportunities (Score: {total_score:.1f})"
                    explanation += f" | Opportunity: Good hierarchy with room for fine-tuning"
                    if score_rationale:
                        explanation += f" | Optimization areas: {score_rationale}"
                    explanation += f" | Recommendation: Consider minor enhancements for optimal user experience"
                    warning_issues.append(explanation)
        
        summary["detailed_issues"] = {
            "critical": critical_issues,
            "issue": issue_issues,
            "warning": warning_issues
        }
       
        # Generate high-level recommendations based on overall analysis like fact_dimension_analysis
        generated_recommendations = []
        
        # Calculate hierarchy quality distribution from existing hierarchies
        excellent_hierarchies = len([h for h in existing_hierarchies if h.get("total_score", 0) >= 0.85])
        good_hierarchies = len([h for h in existing_hierarchies if 0.7 <= h.get("total_score", 0) < 0.85])
        poor_hierarchies = len([h for h in existing_hierarchies if h.get("total_score", 0) < 0.6])
        fact_table_hierarchies = len([h for h in existing_hierarchies if h.get("table_type", "") == "Fact"])
        
        # Generate recommendations based on overall analysis results
        if total_existing == 0:
            generated_recommendations.append("No hierarchies found - Consider creating hierarchies for dimension tables to improve user navigation")
        else:
            if excellent_hierarchies > total_existing * 0.7:  # 70% or more excellent
                generated_recommendations.append("Excellent hierarchy design - well-designed hierarchical structure")
            elif good_hierarchies + excellent_hierarchies > total_existing * 0.6:  # 60% or more good+excellent
                generated_recommendations.append("Good hierarchy quality with some optimization opportunities")
            else:
                generated_recommendations.append("Significant hierarchy improvements needed for better user experience")
        
        if fact_table_hierarchies > 0:
            generated_recommendations.append(f"{fact_table_hierarchies} hierarchies in fact tables - consider moving to dimension tables")
        
        if poor_hierarchies > 0:
            generated_recommendations.append(f"Review {poor_hierarchies} hierarchies with poor design - may need restructuring")
        
        if tables_without > 0 and tables_without > total_tables * 0.3:  # More than 30% tables without hierarchies
            generated_recommendations.append("Many tables could benefit from hierarchies - focus on dimension tables first")
        
        summary["recommendations"] = generated_recommendations
        
        return summary

    def _extract_sql_endpoint_from_model(self) -> Optional[Dict[str, str]]:
        """Extract SQL endpoint and database from semantic model expressions automatically."""
        if not self.connected or not self.model:
            return None
            
        try:
            # Query for model expressions that contain database connections
            dax_query = """
            EVALUATE 
            INFO.EXPRESSIONS()
            """
            
            expressions_result = self.execute_dax_query(dax_query)
            
            # Look for expressions containing Sql.Database connections
            for expression in expressions_result:
                expression_text = expression.get('Expression', '')
                
                # Parse DirectLake connection expressions
                if 'Sql.Database(' in expression_text:
                    # Extract server and database from expressions like:
                    # Sql.Database("server.domain.com", "database_name")
                    
                    # Pattern to match Sql.Database("server", "database")
                    pattern = r'Sql\.Database\s*\(\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\)'
                    match = re.search(pattern, expression_text)
                    
                    if match:
                        sql_endpoint = match.group(1)
                        sql_database = match.group(2)
                        
                        logger.info(f"🔍 Discovered SQL connection in expression '{expression.get('Name', 'Unknown')}'")
                        return {
                            'sql_endpoint': sql_endpoint,
                            'sql_database': sql_database,
                            'source_expression': expression.get('Name', 'Unknown')
                        }
            
            # Alternative: Check partition sources for DirectLake tables
            for table in self.model.Tables:
                for partition in table.Partitions:
                    if hasattr(partition, 'Source') and hasattr(partition.Source, 'Expression'):
                        source_expr = getattr(partition.Source, 'Expression', '')
                        if 'Sql.Database(' in source_expr:
                            pattern = r'Sql\.Database\s*\(\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\)'
                            match = re.search(pattern, source_expr)
                            
                            if match:
                                sql_endpoint = match.group(1)
                                sql_database = match.group(2)
                                
                                logger.info(f"🔍 Discovered SQL connection in table '{table.Name}' partition")
                                return {
                                    'sql_endpoint': sql_endpoint,
                                    'sql_database': sql_database,
                                    'source_expression': f'{table.Name}_partition'
                                }
            
            logger.warning("⚠️ No SQL endpoint information found in model expressions or partitions")
            return None
            
        except Exception as e:
            logger.error(f"❌ Error extracting SQL endpoint from model: {str(e)}")
            return None
    
    def list_tables(self) -> List[str]:
        """List all tables in the connected model."""
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        return [t.Name for t in self.model.Tables]
    
    def list_table_columns(self, table_name: str, include_data_type: bool = False) -> Union[List[str], List[Dict[str, str]]]:
        """
        List all columns in a specific table.
        
        Args:
            table_name: Name of the table to get columns from
            include_data_type: If True, returns list of dicts with column_name and data_type.
                              If False, returns list of column names (strings).
        
        Returns:
            List of column names or list of dictionaries with column info
        """
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        # Find the table
        table = next((t for t in self.model.Tables if t.Name.lower() == table_name.lower()), None)
        if not table:
            raise Exception(f"Table '{table_name}' not found in the model.")
        
        if include_data_type:
            # Return list of dictionaries with column_name and data_type
            return [
                {
                    "column_name": column.Name,
                    "data_type": str(column.DataType) if hasattr(column, 'DataType') else "Unknown"
                }
                for column in table.Columns
            ]
        else:
            # Return list of column names (strings)
            return [column.Name for column in table.Columns]
    
    def get_multiple_sql_tables_schema(self, table_names: List[str]) -> Dict[str, List[Dict[str, str]]]:
        """Helper function to get schema information for multiple sql tables."""
        tables_schema = {}
        for table_name in table_names:
            try:
                schema_df = self.sql_metadata.get_sql_table_schema(table_name)
                tables_schema[table_name] = [
                    {
                        "column_name": row["column_name"],
                        "data_type": row["data_type"]
                    }
                    for _, row in schema_df.iterrows()
                ]
                logger.info(f"Retrieved schema for table: {table_name} with {len(tables_schema[table_name])} columns")
            except Exception as e:
                error_msg = str(e).encode('ascii', 'replace').decode('ascii')
                logger.error(f"Error retrieving schema for table {table_name}: {error_msg}")
                tables_schema[table_name] = []
        return tables_schema
    
    def generate_tmsl_columns(self, columns_schema: List[Dict[str, str]]) -> List[Dict[str, Any]]:
        """Helper function to generate TMSL column definitions from schema information."""
        tmsl_columns = []
        
        # SQL to Analysis Services data type mapping
        type_mapping = {
            'bigint': 'int64',
            'int': 'int64',
            'smallint': 'int64',
            'tinyint': 'int64',
            'bit': 'boolean',
            'decimal': 'decimal',
            'numeric': 'decimal',
            'money': 'decimal',
            'smallmoney': 'decimal',
            'float': 'double',
            'real': 'double',
            'datetime': 'dateTime',
            'datetime2': 'dateTime',
            'smalldatetime': 'dateTime',
            'date': 'dateTime',
            'time': 'dateTime',
            'datetimeoffset': 'dateTime',
            'char': 'string',
            'varchar': 'string',
            'text': 'string',
            'nchar': 'string',
            'nvarchar': 'string',
            'ntext': 'string',
            'binary': 'binary',
            'varbinary': 'binary',
            'image': 'binary',
            'uniqueidentifier': 'string'
        }
        
        for column in columns_schema:
            column_name = column['column_name']
            sql_data_type = column['data_type'].lower()
            
            # Map SQL data type to Analysis Services data type
            as_data_type = type_mapping.get(sql_data_type, 'string')
            
            column_def = {
                "name": column_name,
                "dataType": as_data_type,
                "sourceColumn": column_name
            }
            
            tmsl_columns.append(column_def)
        
        return tmsl_columns
    
    def select_tables_with_schema(self, selected_table_names: List[str] = None) -> Dict[str, Any]:
        """Select specific tables and return their schemas, or return all tables if none specified."""
        available_tables_df = self.sql_metadata.get_sql_tables()
        available_tables = available_tables_df['table_name'].tolist()
        
        if selected_table_names:
            # Validate that all selected tables exist
            invalid_tables = [table for table in selected_table_names if table not in available_tables]
            if invalid_tables:
                raise ValueError(f"The following tables do not exist: {invalid_tables}")
            tables_to_process = selected_table_names
        else:
            tables_to_process = available_tables
        
        logger.info(f"Processing {len(tables_to_process)} tables: {tables_to_process}")
        tables_with_schema = self.get_multiple_sql_tables_schema(tables_to_process)
        
        return {
            "available_tables": available_tables,
            "selected_tables": tables_to_process,
            "tables_schema": tables_with_schema
        }

    def execute_dax_query(self, dax_query: str) -> List[Dict[str, Any]]:
        """Execute a DAX query using AdomdClient"""
        if not self.connection_string:
            raise Exception("Not connected to Power BI.")
        logger.info(f"Executing DAX query:\n{dax_query}")
        results = []
        try:
            conn = AdomdConnection(self.connection_string)
            conn.Open()
            cmd = AdomdCommand(dax_query, conn)
            reader = cmd.ExecuteReader()
            columns = [reader.GetName(i) for i in range(reader.FieldCount)]
            while reader.Read():
                row = {columns[i]: reader.GetValue(i) for i in range(len(columns))}
                results.append(row)
            reader.Close()
            conn.Close()
            logger.info(f"Returned {len(results)} rows.")
            return results
        except Exception as e:
            logger.error(f"DAX query execution failed: {str(e)}")
            raise Exception(f"DAX query execution failed: {str(e)}")
        
    def check_date_table_exists(self, table_name: str = None) -> Dict[str, Any]:
        """Check if a date table exists in the model and return its details."""
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        try:
            date_tables_info = []
            current_date_table = None
            
            # If table_name is specified, check that specific table
            if table_name:
                table = next((t for t in self.model.Tables if t.Name.lower() == table_name.lower()), None)
                if not table:
                    raise Exception(f"Table '{table_name}' not found in the model.")
                
                # Check if it's marked as a date table
                is_date_table = hasattr(table, 'DataCategory') and table.DataCategory == 'Time'
                
                # Look for date columns
                date_columns = []
                for column in table.Columns:
                    if hasattr(column, 'DataType') and column.DataType == DataType.DateTime:
                        date_columns.append({
                            "name": column.Name,
                            "is_key": hasattr(column, 'IsKey') and column.IsKey,
                            "is_hidden": hasattr(column, 'IsHidden') and column.IsHidden
                        })
                
                date_tables_info.append({
                    "table_name": table.Name,
                    "is_date_table": is_date_table,
                    "date_columns": date_columns,
                    "column_count": len(table.Columns)
                })
                
                if is_date_table:
                    current_date_table = table.Name
            else:
                # Check all tables for potential date tables
                for table in self.model.Tables:
                    # Check if it's marked as a date table
                    is_date_table = hasattr(table, 'DataCategory') and table.DataCategory == 'Time'
                    
                    # Look for date columns
                    date_columns = []
                    for column in table.Columns:
                        if hasattr(column, 'DataType') and column.DataType == DataType.DateTime:
                            date_columns.append({
                                "name": column.Name,
                                "is_key": hasattr(column, 'IsKey') and column.IsKey,
                                "is_hidden": hasattr(column, 'IsHidden') and column.IsHidden
                            })
                    
                    # Consider it a potential date table if it has date columns or is marked as Time category
                    if is_date_table or len(date_columns) > 0:
                        date_tables_info.append({
                            "table_name": table.Name,
                            "is_date_table": is_date_table,
                            "date_columns": date_columns,
                            "column_count": len(table.Columns)
                        })
                        
                        if is_date_table:
                            current_date_table = table.Name
            
            result = {
                "current_date_table": current_date_table,
                "potential_date_tables": date_tables_info,
                "total_tables_checked": len(self.model.Tables) if not table_name else 1,
                "has_date_table": current_date_table is not None
            }
            
            logger.info(f"Date table check finished. Found {len(date_tables_info)} potential date tables.")
            return result
            
        except Exception as e:
            logger.error(f"Failed to check date table: {e}")
            raise Exception(f"Failed to check date table: {e}")
    
    def get_column_properties(self, table_name: str, column_name: str) -> Dict[str, Any]:
        """
        Get all available properties for a specific column with their current values and metadata.
        
        Args:
            table_name: Name of the table containing the column
            column_name: Name of the column to inspect
            
        Returns:
            Dictionary with property details including current values, types, and descriptions
        """
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        try:
            # Find the table
            table = next((t for t in self.model.Tables if t.Name.lower() == table_name.lower()), None)
            if not table:
                raise Exception(f"Table '{table_name}' not found in the model.")
            
            # Find the column
            column = next((c for c in table.Columns if c.Name.lower() == column_name.lower()), None)
            if not column:
                raise Exception(f"Column '{column_name}' not found in table '{table_name}'.")
            
            # Define all possible column properties with their metadata
            property_definitions = {
                # Core Properties
                'Name': {'type': 'string', 'description': 'The name of the column', 'editable': True},
                'Description': {'type': 'string', 'description': 'Description of the column', 'editable': True},
                'DataType': {'type': 'DataType', 'description': 'Data type (String, Int64, DateTime, etc.)', 'editable': True},
                'SourceColumn': {'type': 'string', 'description': 'Source column name from data source', 'editable': True},
                
                # Visibility and Behavior
                'IsHidden': {'type': 'boolean', 'description': 'Whether column is hidden from client tools', 'editable': True},
                'IsKey': {'type': 'boolean', 'description': 'Whether column is marked as a key column', 'editable': True},
                'IsUnique': {'type': 'boolean', 'description': 'Whether column contains unique values', 'editable': True},
                'IsAvailableInMdx': {'type': 'boolean', 'description': 'Whether available in MDX queries', 'editable': True},
                'IsNullable': {'type': 'boolean', 'description': 'Whether column can contain null values', 'editable': True},
                
                # Calculated Columns
                'Expression': {'type': 'string', 'description': 'DAX expression for calculated columns', 'editable': True},
                'IsCalculated': {'type': 'boolean', 'description': 'Whether this is a calculated column', 'editable': False},
                
                # Formatting and Display
                'FormatString': {'type': 'string', 'description': 'Format string for display (e.g., "#,0", "mm/dd/yyyy")', 'editable': True},
                'DisplayFolder': {'type': 'string', 'description': 'Display folder in client tools', 'editable': True},
                'SortByColumn': {'type': 'Column', 'description': 'Reference to column to sort by', 'editable': True},
                'DisplayOrdinal': {'type': 'integer', 'description': 'Display order in client tools', 'editable': True},
                
                # Data Category and Summarization
                'DataCategory': {'type': 'string', 'description': 'Data category (e.g., "Time", "Geography")', 'editable': True},
                'SummarizeBy': {'type': 'AggregateFunction', 'description': 'Default aggregation function', 'editable': True},
                'IsDefaultImage': {'type': 'boolean', 'description': 'Whether this is the default image column', 'editable': True},
                'IsDefaultLabel': {'type': 'boolean', 'description': 'Whether this is the default label column', 'editable': True},
                
                # Encoding and Storage
                'EncodingHint': {'type': 'EncodingHintType', 'description': 'Storage encoding hint', 'editable': True},
                'State': {'type': 'ObjectState', 'description': 'Current state of the column', 'editable': False},
                
                # Row Level Security
                'IsPrivate': {'type': 'boolean', 'description': 'Whether column is private (RLS)', 'editable': True},
                
                # Lineage and Dependencies
                'ModifiedTime': {'type': 'DateTime', 'description': 'Last modification time', 'editable': False},
                'RefreshedTime': {'type': 'DateTime', 'description': 'Last refresh time', 'editable': False},
                'StructureModifiedTime': {'type': 'DateTime', 'description': 'Structure modification time', 'editable': False},
                
                # Annotations and Extended Properties
                'Annotations': {'type': 'AnnotationCollection', 'description': 'Custom metadata annotations', 'editable': True},
                'ExtendedProperties': {'type': 'ExtendedPropertyCollection', 'description': 'Extended properties for Power BI', 'editable': True},
                
                # Variations (Advanced)
                'Variations': {'type': 'VariationCollection', 'description': 'Column variations for different contexts', 'editable': True}
            }
            
            result = {
                'column_info': {
                    'table_name': table_name,
                    'column_name': column_name,
                    'column_type': str(type(column).__name__)
                },
                'available_properties': {},
                'current_values': {},
                'editable_properties': [],
                'readonly_properties': []
            }
            
            # Check each property and get its current value
            for prop_name, prop_info in property_definitions.items():
                try:
                    if hasattr(column, prop_name):
                        current_value = getattr(column, prop_name)
                        
                        # Convert complex objects to string representation
                        if current_value is not None:
                            if hasattr(current_value, 'Name'):  # For referenced objects
                                display_value = f"Reference: {current_value.Name}"
                            elif hasattr(current_value, '__str__') and not isinstance(current_value, (str, int, float, bool)):
                                display_value = str(current_value)
                            else:
                                display_value = current_value
                        else:
                            display_value = None
                        
                        result['available_properties'][prop_name] = prop_info
                        result['current_values'][prop_name] = display_value
                        
                        if prop_info['editable']:
                            result['editable_properties'].append(prop_name)
                        else:
                            result['readonly_properties'].append(prop_name)
                    else:
                        result['available_properties'][prop_name] = {
                            **prop_info,
                            'status': 'Not available in this version'
                        }
                except Exception as e:
                    result['available_properties'][prop_name] = {
                        **prop_info,
                        'status': f'Error accessing: {str(e)}'
                    }
            
            logger.info(f"Retrieved {len(result['available_properties'])} properties for column '{column_name}' in table '{table_name}'")
            return result
            
        except Exception as e:
            logger.error(f"Failed to get column properties: {e}")
            raise Exception(f"Failed to get column properties: {e}")
    
    def get_measure_properties(self, table_name: str, measure_name: str) -> Dict[str, Any]:
        """
        Get all available properties for a specific measure with their current values and metadata.
        
        Args:
            table_name: Name of the table containing the measure
            measure_name: Name of the measure to inspect
            
        Returns:
            Dictionary with property details including current values, types, and descriptions
        """
        if not self.connected:
            raise Exception("Tabular server is not connected.")
        
        try:
            # Find the table
            table = next((t for t in self.model.Tables if t.Name.lower() == table_name.lower()), None)
            if not table:
                raise Exception(f"Table '{table_name}' not found in the model.")
            
            # Find the measure
            measure = next((m for m in table.Measures if m.Name.lower() == measure_name.lower()), None)
            if not measure:
                raise Exception(f"Measure '{measure_name}' not found in table '{table_name}'.")
            
            # Define all possible measure properties with their metadata
            property_definitions = {
                # Core Properties
                'Name': {'type': 'string', 'description': 'The name of the measure', 'editable': True},
                'Description': {'type': 'string', 'description': 'Description of the measure', 'editable': True},
                'Expression': {'type': 'string', 'description': 'DAX expression for the measure', 'editable': True},
                
                # Visibility and Behavior
                'IsHidden': {'type': 'boolean', 'description': 'Whether measure is hidden from client tools', 'editable': True},
                'IsSimpleMeasure': {'type': 'boolean', 'description': 'Whether this is a simple measure', 'editable': False},
                
                # Formatting and Display
                'FormatString': {'type': 'string', 'description': 'Format string for display (e.g., "#,0.00", "0.0%")', 'editable': True},
                'DisplayFolder': {'type': 'string', 'description': 'Display folder in client tools', 'editable': True},
                'DisplayOrdinal': {'type': 'integer', 'description': 'Display order in client tools', 'editable': True},
                
                # KPI Properties
                'KPI': {'type': 'KPI', 'description': 'Associated KPI object if this measure is a KPI', 'editable': True},
                
                # Data Category
                'DataCategory': {'type': 'string', 'description': 'Data category for the measure', 'editable': True},
                
                # State and Metadata
                'State': {'type': 'ObjectState', 'description': 'Current state of the measure', 'editable': False},
                'ModifiedTime': {'type': 'DateTime', 'description': 'Last modification time', 'editable': False},
                'RefreshedTime': {'type': 'DateTime', 'description': 'Last refresh time', 'editable': False},
                'StructureModifiedTime': {'type': 'DateTime', 'description': 'Structure modification time', 'editable': False},
                
                # Lineage Information
                'LineageTag': {'type': 'string', 'description': 'Unique lineage identifier', 'editable': True},
                'SourceLineageTag': {'type': 'string', 'description': 'Source lineage identifier', 'editable': True},
                
                # Annotations and Extended Properties
                'Annotations': {'type': 'AnnotationCollection', 'description': 'Custom metadata annotations', 'editable': True},
                'ExtendedProperties': {'type': 'ExtendedPropertyCollection', 'description': 'Extended properties for Power BI', 'editable': True},
                
                # Dependencies and References
                'DependsOn': {'type': 'DependsOnCollection', 'description': 'Objects this measure depends on', 'editable': False},
                'ReferencedBy': {'type': 'ReferencedByCollection', 'description': 'Objects that reference this measure', 'editable': False}
            }
            
            result = {
                'measure_info': {
                    'table_name': table_name,
                    'measure_name': measure_name,
                    'measure_type': str(type(measure).__name__)
                },
                'available_properties': {},
                'current_values': {},
                'editable_properties': [],
                'readonly_properties': []
            }
            
            # Check each property and get its current value
            for prop_name, prop_info in property_definitions.items():
                try:
                    if hasattr(measure, prop_name):
                        current_value = getattr(measure, prop_name)
                        
                        # Convert complex objects to string representation
                        if current_value is not None:
                            if hasattr(current_value, 'Name'):  # For referenced objects
                                display_value = f"Reference: {current_value.Name}"
                            elif hasattr(current_value, '__str__') and not isinstance(current_value, (str, int, float, bool)):
                                display_value = str(current_value)
                            else:
                                display_value = current_value
                        else:
                            display_value = None
                        
                        result['available_properties'][prop_name] = prop_info
                        result['current_values'][prop_name] = display_value
                        
                        if prop_info['editable']:
                            result['editable_properties'].append(prop_name)
                        else:
                            result['readonly_properties'].append(prop_name)
                    else:
                        result['available_properties'][prop_name] = {
                            **prop_info,
                            'status': 'Not available in this version'
                        }
                except Exception as e:
                    result['available_properties'][prop_name] = {
                        **prop_info,
                        'status': f'Error accessing: {str(e)}'
                    }
            
            logger.info(f"Retrieved {len(result['available_properties'])} properties for measure '{measure_name}' in table '{table_name}'")
